<xsd:complexType name="Commodity_Code_DataType">
<xsd:annotation>
<xsd:documentation>Commodity Code Data Element</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a commodity code type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only Spend Categories that do not have text based commodity code can be specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a commodity code with the same length that is defined for the commodity code type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't inactivate a commodity code during creation of the code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit an active spend category.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a commodity code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a commodity code with an alphabetic or numeric value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a parent commodity code that is part of same hierarchy structure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit the same commodity code and commodity code type already setup for the Reference ID, or submit a Reference ID that doesn’t already exist.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
