<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Item_Images" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the item image data should be excluded from the response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachments" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean for Including purchase item attachments data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Item_Inventory_Attributes" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to exclude Item Inventory Attributes from referenced Purchase Item Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Supplier_Item_Information" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to exclude Supplier Item Information from referenced Purchase Item Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Item_Substitute_Information" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to exclude Item Substitute Information from referenced Purchase Item Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
