<xsd:documentation>Worker</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hourly_Rate" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project rate rule hourly rate</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Cost_Rate_Rule_Standard_Cost_Rate_DetailsType">
<xsd:annotation>
<xsd:documentation>Element containing Project Rate Rule Worker Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Clear the Delete option as the Project Cost Rate Rule Standard Cost Rate Detail ID doesn't exist.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Project Cost Rate Rule Standard Cost Rate Detail ID doesn't belong to the rate sheet: [refid].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Delete" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Delete Flag</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Cost_Rate_Rule_Standard_Cost_Rate_Detail_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Cost Rate Rule Standard Cost Rate Sheet ID</xsd:documentation>
