<xsd:complexType name="Remove_Associated_Business_Assets_DataType">
<xsd:annotation>
<xsd:documentation>Contains additional criteria for identifying specific Project Assets to remove Business Assets from.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Transaction_Date_Reference" type="xsd:date">
<xsd:annotation>
<xsd:documentation>The effective date for the transaction that removed the business assets. Applies to each business asset associated with the project asset.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Asset has an event with transaction date after Remove transaction effective date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You've entered a removal date that's earlier than this asset was imported to Workday. Workday won't recalculate any depreciation that was recorded outside of Workday.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This asset has depreciation that was generated by a system other than Workday. Workday only reverses depreciation that's calculated and posted by Workday. To reverse depreciation on this asset, create a journal.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The transaction effective date must be less than or equal to today's date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Removal_Reason_Reference" type="wd:Asset_Removal_ReasonObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the ID or WID for the reason the asset was removed. Applies to each business asset associated with the project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Removal_Comments_Reference" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Comments included with the removal event. Applies to each business asset associated with the project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Remove_Business_Assets_from_Project_Asset_RequestType">
<xsd:annotation>
