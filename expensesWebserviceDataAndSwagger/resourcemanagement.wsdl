<wd:Validation>
<wd:Validation_Message>Invalid value for External Name [ET].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Alternate Item Identifier, [type] has to be less than or equal to [length] characters in length.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
