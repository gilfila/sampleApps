<xsd:documentation>Supplier Invoice for Netting Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_InvoiceObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Remove invoices that are already part of a settlement run or netting transaction that is in draft or in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the invoices with a currency that is different to the currency on the netting transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not include invoices which are direct intercompany</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove invoices or invoice adjustments that are on hold status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove invoices that include 1099-MISC suppliers or change the netting rule to exclude the 1099-MISC supplier.</xsd:documentation>
<wd:Validation_Message>Remove invoices that include 1099-MISC suppliers or change the netting rule to exclude the 1099-MISC supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the invoices from contract workers.</xsd:documentation>
<wd:Validation_Message>Remove the invoices from contract workers.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the invoices with withholding tax payment realization tax code.</xsd:documentation>
<wd:Validation_Message>Remove the invoices with withholding tax payment realization tax code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the invoices from the inactive supplier.</xsd:documentation>
<wd:Validation_Message>Remove the invoices from the inactive supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the invoices that are in match exception.</xsd:documentation>
<wd:Validation_Message>Remove the invoices that are in match exception.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The invoices must be approved and not fully paid.</xsd:documentation>
<wd:Validation_Message>The invoices must be approved and not fully paid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't net down payment invoices when you use Submit Netting Transaction web services.</xsd:documentation>
<wd:Validation_Message>You can't net down payment invoices when you use Submit Netting Transaction web services.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Adjustment_Reference" type="wd:Supplier_Invoice_AdjustmentObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice Adjustment.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Remove invoices or invoice adjustments that are on hold status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not include invoices which are direct intercompany</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove invoices that are already part of a settlement run or netting transaction that is in draft or in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the invoices with a currency that is different to the currency on the netting transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the invoices that are in match exception.</xsd:documentation>
<wd:Validation_Message>Remove the invoices that are in match exception.</wd:Validation_Message>
</wd:Validation>
