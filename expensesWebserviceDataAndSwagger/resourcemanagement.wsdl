<xsd:complexType name="Condition_Item_Data_WWSType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing data for each Condition Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Only the Filter Boolean attribute is as a Comparison Value allowed for this Condition Item. The other Comparison Values like Filter Date, Filter Number, Filter Text, Filter Time, Filter DateTimeZone, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Filter Date attribute is allowed as a Comparison Value for this Condition Item. The other Comparison Values like Filter Boolean, Filter Number, Filter Text, Filter Time, Filter DateTimeZone, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Filter Number attribute is allowed as a Comparison Value for this Condition Item. The other Comparison Values like Filter Boolean, Filter Date, Filter Text, Filter Time, Filter DateTimeZone, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Filter Text attribute is allowed as a Comparison Value for this Condition Item. The other Comparison Values like Filter Boolean, Filter Date, Filter Number, Filter Time, Filter DateTimeZone, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Target CRF Reference element is allowed as a Comparison Value for this Condition Item. The other Comparison Values like Filter Boolean, Filter Date, Filter Number, Filter Text, Filter Time, Filter DateTimeZone, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Target Instance References element is allowed as a Comparison Value for this Condition Item. The other Comparison Values like Filter Boolean, Filter Date, Filter Number, Filter Text, Filter Time, Filter DateTimeZone, and Target CRF Reference must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Target External Field Reference element is required for this Condition Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Target Instance Reference element is required for this Condition Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Filter Time attribute is a Comparison Value for this Condition Item. The other Comparison Values like Filter Date, Filter Number, Filter Text, Filter DateTimeZone, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the Filter DateTimeZone is a Comparison Value for this Condition Item. The other Comparison Values like Filter Date, Filter Number, Filter Text, Filter Time, Target CRF Reference, and Target Instance References must be empty.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Order" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text value for order of Condition Item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="And_Or_Operator_Reference" type="wd:And_Or_OperatorsObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the And Or Operator used on this Condition Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Open_Parentheses" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specify an Open Parentheses for the Condition Item by placing the "(" character here.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Open Parenthesis field can contain only "(" characters.</xsd:documentation>
<wd:Validation_Message>The Open Parenthesis field can contain only "(" characters.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Relational_Operator_Reference" type="wd:Relational_OperatorObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Relational Operator to use for this Condition Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Condition_Entry_Option_Reference" type="wd:Condition_Entry_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Condition Entry Option to use for this Condition Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Parentheses" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specify an Close Parentheses for the Condition Item by placing the ")" character here.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Close Parenthesis field can contain only ")" characters.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Source_External_Field_Reference" type="wd:External_FieldObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the External Field to use as the source for this Condition Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_Condition_Rule_Reference" type="wd:Condition_RuleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Condition Rule to use as the source for this Condition Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:choice>
<xsd:element name="Filter_Boolean" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean value for Filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Filter_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date value for Filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Filter_DateTimeZone" type="wd:Filter_DateTimeZone_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>DateTimeZone value for filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Filter_Time" type="xsd:time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Time value for filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Filter_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Numeric value for Filter Number.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="16"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Filter_Text" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text value for Filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Target_External_Field_Reference" type="wd:External_FieldObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Target External Field for this Condition Item..</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Target_Instance_Reference" type="wd:InstanceObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to specific object to be used in filter for this Condition Rule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Template_DataType">
<xsd:annotation>
<xsd:documentation>Contains the detailed information about a project plan template.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Specify an active worker for the owner field.</xsd:documentation>
<wd:Validation_Message>An active worker needs to be provided for the owner field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If the Use Date Offset is true, specify the Date Offset Reference.</xsd:documentation>
<wd:Validation_Message>Date Offset Type must be given, when Date Offset is set to true.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot delete a phase when it is referenced by a task resource in the task resource template.</xsd:documentation>
<wd:Validation_Message>Phase cannot be deleted because it is referenced by task resources in task resource template [trt]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan_Template_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains a unique identifier for an instance of project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Template_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The name of the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The description details related to the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The owner for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Date_Offset" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the date offset is used for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Date_Offset_Reference" type="wd:Project_Template_Date_Offset_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The date offset type used by the project plan template: either Days or Months.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Phase_Template_Data" type="wd:Project_Plan_Phase_Template_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Phase_Template_DataType">
<xsd:annotation>
<xsd:documentation>Contains project plan phase template information, such as project phase name, ID and task template data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This web service field is no longer supported with Enhanced Resource Management enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Project Phase is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Plan Phase ID: [id] is already in use by a different Project Plan Template: [template].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Phase cannot be changed because it is referenced by task resources in task resource template [trt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Task cannot be deleted because it is referenced by task resources in task resource template [trt]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Plan_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains a unique identifier for an instance of project plan phase.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The order of project plan phase on the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Phase_Name_Data" type="wd:Project_Phase_Name_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The project phase name for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Phase_Reference" type="wd:Project_PhaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The project phase reference for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Template_Data" type="wd:Project_Plan_Task_Template_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Contains project plan task template information, such as project task name, ID, offset dates, milestone flag, etc.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Task_Template_DataType">
<xsd:annotation>
<xsd:documentation>Contains project plan task template information, such as project task name, ID, offset dates, milestone flag, etc.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Task ID: [id] cannot be used more than once.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Plan Task ID: [id] is already in use by a different Project Plan Phase: [phase].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This web service field is no longer supported with Enhanced Resource Management enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Percentage entered must be between 0 to 100%.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Task is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The End Date Offset must be greater than or equal to the Start Date Offset.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If Values are provided for Date Offset, then Date Offset must be Enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This web service field is no longer supported with Enhanced Resource Management enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Task cannot be changed because it is referenced by task resources in task resource template [trt]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Task_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains a unique identifier for an instance of project plan task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The order of project plan task on the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Name_Data" type="wd:Project_Task_Name_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing task name data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Task_Reference" type="wd:Project_TaskObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The instance of a project task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Profile_Reference" type="wd:Project_Member_ResourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The worker group for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_Offset" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The start date offset for the project plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="End_Date_Offset" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The end date offset for the project plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Percent_Complete" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The percent complete for the project plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Non-Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the project is non-billable for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Milestone" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the project plan task is a milestone for the project template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the project plan task is closed for time entry for the project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Utilization" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For informational purposes only to indicate that this project plan task qualifies for utilization calculations.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Additional information for the project plan task of this project plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
