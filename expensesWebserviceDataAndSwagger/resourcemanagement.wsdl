<xsd:annotation>
<xsd:documentation>Text representing the merchant name for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Merchant_Tax_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the merchant tax id for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Country_Reference" type="wd:CountryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the country where the trip ended.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>ISO_3166-1_Alpha-2_Code</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Country and Destination Location combination must be valid.</xsd:documentation>
<wd:Validation_Message>Travel Country [country] is not valid for Destination Location [city].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Country and Destination Location combination must be valid.</xsd:documentation>
<wd:Validation_Message>Travel Country [country] is not valid for Destination Location [Airport].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Region_Reference" type="wd:Country_RegionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the travel region where the trip ended.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Travel Region and Country combination must be valid.</xsd:documentation>
<wd:Validation_Message>Travel Region [region] is invalid for Country [country].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Travel Region and Country of the destination location combination must be valid.</xsd:documentation>
<wd:Validation_Message>Travel Region [region] is invalid for the country of Destination Location [city].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Travel Region and Country of the destination location combination must be valid.</xsd:documentation>
<wd:Validation_Message>Travel Region [region] does not equal Travel Region for Destination Location [Airport].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origination_Location_Reference" type="wd:Travel_LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the travel location where the trip originated from.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Destination_Location_Reference" type="wd:Travel_LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the travel location where the trip ended.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hotel_Reference" type="wd:HotelObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the hotel that was used for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Car_Rental_Agency_Reference" type="wd:Car_Rental_AgencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the car rental agency that was used for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Airline_Reference" type="wd:AirlineObjectType" minOccurs="0">
