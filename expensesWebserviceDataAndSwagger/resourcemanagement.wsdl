</wd:Validation>
<wd:Validation>
<xsd:documentation>There is a pending event for the asset that should be completed before this asset transaction can be processed.</xsd:documentation>
<wd:Validation_Message>There is a pending event for the asset that should be completed before this asset transaction can be processed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Discrete Composite Asset or Components of Non-Discrete Composite Asset cannot be transferred.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't transfer assets for the Type and Accounting Method of the Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Transfer_Data" type="wd:Asset_Transfer_DataType">
<xsd:annotation>
<xsd:documentation>Data values and flags that will be used to update the Business Asset during the Transfer transaction.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Transfer_Asset_ResponseType">
<xsd:annotation>
<xsd:documentation>Root element for the Response on the Put operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Transfer_Reference" type="wd:Business_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Asset specified for Transfer.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Asset_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_DataType">
<xsd:annotation>
<xsd:documentation>Expense Report Data contains all of the information about a Spend Authorization.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Spend Authorization Estimated Amount is required if no Spend Authorization Lines have been entered.</xsd:documentation>
<wd:Validation_Message>The Spend Authorization Estimated Amount is required if no Spend Authorization Lines have been entered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The field End Date is required and must have a value.</xsd:documentation>
<wd:Validation_Message>The field End Date is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter a Start Date that is before the End Date. OR Enter an End Date that is after the Start Date.</xsd:documentation>
<wd:Validation_Message>Enter a Start Date that is before the End Date. OR Enter an End Date that is after the Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend authorization contains more than one instance of the balancing worktag. If you enable cash advances and balancing worktags, all lines of the spend authorization must match.</xsd:documentation>
<wd:Validation_Message>Spend authorization contains more than one instance of the balancing worktag. If you enable cash advances and balancing worktags, all lines of the spend authorization must match.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Reimbursement Payment Type Reference is required and must have a value.</xsd:documentation>
<wd:Validation_Message>The Reimbursement Payment Type Reference is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Cash Advance has been paid and cannot be updated.</xsd:documentation>
<wd:Validation_Message>Cash Advance has been paid and cannot be updated.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must complete at least one Spend Authorization Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Authorization contains different instances of optional balancing worktags. If you enable cash advances and balancing worktags, all lines of the spend authorization must match.</xsd:documentation>
<wd:Validation_Message>Spend Authorization contains different instances of optional balancing worktags. If you enable cash advances and balancing worktags, all lines of the spend authorization must match.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Total Spend Authorization Amount with or without Spend Lines must be greater than zero.</xsd:documentation>
<wd:Validation_Message>The Total Reimbursement Amount must be greater than 0.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Total Cash Advance Requested Amount must be greater than 0.</xsd:documentation>
<wd:Validation_Message>The Total Cash Advance Requested Amount must be greater than 0.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Committee is a required field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The External Committee Member is not active for the Spend Authorization Date. Enter a Spend Authorization Date for an active External Committee Member.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[ecm] is not a member of [committee].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only use Committee if the Expense Payee is an External Committee Member.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't change the spend authorization.</xsd:documentation>
<wd:Validation_Message>You can't change the spend authorization.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't change the expense payee on existing spend authorizations.</xsd:documentation>
<wd:Validation_Message>You can't change the expense payee on existing spend authorizations.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Authorization_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization ID. This is the Spend Authorization unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Reference" type="wd:Expense_PayeeObjectType">
<xsd:annotation>
<xsd:documentation>Reference for a Worker on the Spend Authorization</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Committee_Reference" type="wd:CommitteeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Committee for the Expense Payee of the Spend Authorization.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company or Company Hierarchy</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing and canceling the Spend Authorization inside the Workday application. A Spend Authorization will only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The document number that will be assigned to the Spend Authorization. Leave it blank to have the number auto-assigned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Check_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Budget Check Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reimbursement_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing reimbursement payment type for the payee.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Purpose_Reference" type="wd:Business_PurposeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the business purpose for the spend authorization.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Remaining_Balance" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Remaining Balance Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Estimated Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Cash_Advance_Requested_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Cash Advance Requested Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This field should be left blank since the defaulted currency of the company specified will be used as the currency of the Spend Authorization. This field is READ ONLY.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Justification" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization Justification</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Line_Replacement_Data" type="wd:Spend_Authorization_Line_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Spend_Authorization_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Spend Authorization reference for update and all Spend Authorization data items</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Payee for Spend Authorization must be an Employee, Contingent Worker, or External Committee Member.</xsd:documentation>
<wd:Validation_Message>[payee] is not classified as Employee, Contingent Worker, or External Committee Member.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Authorization for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Data" type="wd:Spend_Authorization_DataType">
<xsd:annotation>
<xsd:documentation>Spend Authorization Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Spend_Authorization_ResponseType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes the Spend Authorization Instance</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Submit_Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Authorization Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all data for one Spend Authorization Line (Expense Item, Quantity, Unit Cost, Billable flag, Worktags, and Memo).</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktag types are invalid: [invalid].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Cash advances are not enabled in your tenant.</xsd:documentation>
<wd:Validation_Message>Cash advances are not enabled in your tenant.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Unit Cost is not enterable for fixed expense items that use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Unit Cost is not enterable for item - [item]. Unit Cost will be calculated based on quantity and information entered for expense item details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Unit Cost is required for non-fixed expense items and fixed expense items that does not use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Unit Cost is required for item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity is required for the expense item.</xsd:documentation>
<wd:Validation_Message>Quantity is required for item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Expense Item Details Reference Element is required for the expense item.</xsd:documentation>
<wd:Validation_Message>The Expense Item Details Reference Element is required for item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Authorization Line: Invalid unit cost for Expense Item. Unit Cost is greater then maximum allowed amount. View the Expense Item details for maximum amount allowed.</xsd:documentation>
<wd:Validation_Message>Invalid Unit Cost for item - [item]. Unit Cost is greater then maximum allowed amount. View the Expense Item details for maximum amount allowed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Authorization Line: Invalid unit cost for fixed amount Expense Item. Unit Cost cannot be changed.</xsd:documentation>
<wd:Validation_Message>Invalid Unit Cost for fixed unit cost item - [item]. Unit Cost cannot be changed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Distance-based expense item attributes can't be used with this web service.</xsd:documentation>
<wd:Validation_Message>Distance-based expense item attributes can't be used with this web service.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Item_Reference" type="wd:Item_DescriptorObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Expense Item for the Spend Authorization Line.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Item_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the Spend Authorization Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost for the Spend Authorization Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is billable.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cash_Advance_Requested" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is a cash advance. This field is only available if cash advances are enabled for the tenant.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as the default value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text describing the use or purpose of the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Transaction Line Budget Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Details_Data" type="wd:Expense_Report_Line_Detail_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Spend Authorization Reference element contains the specific instance set containing the requested Spend Authorization.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Instance set containing the Spend Authorization object.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>This element is the wrapper around a list of elements representing the Spend Authorization Request specific criteria needed to search for instances. All of the elements are "AND" conditions.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Created From Date must be earlier than Created To Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Approved From Date must be earlier than Approved To Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Organization Reference must be Companies or Company Hierarchies</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend Authorization From Date must be earlier than Spend Authorization To Date</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Organization_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company or Company Hierarchy</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Expense Payee.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Type_Reference" type="wd:Payee_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Expense Payee Type on the Spend Authorization - Employee, Contingent Worker, or External Committee Member.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Payee_Type_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization From Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Spend Authorization To Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Created From Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Created To Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approved_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Approved From Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approved_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Approved To Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Spend Authorization response. If this element is not included then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Spend Authorization Reference data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Spend_Authorization_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Spend Authorization data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the attachment data within Spend Authorization Data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Spend_Authorizations_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level request element for all Spend Authorization "Get" operations.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Spend_Authorization_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Request Reference Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Spend_Authorization_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Request Criteria Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Respones Filter Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Spend_Authorization_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Response Group Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Spend_AuthorizationType">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes Spend Authorization instance and data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Authorization Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Data" type="wd:Spend_Authorization_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all the data related to the Spend Authorization.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Spend_Authorization_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing Spend Authorization response data for requested references or criteria and for requested response group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Authorization" type="wd:Spend_AuthorizationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes spend authorization instance and data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Spend_Authorizations_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Spend Authorization response elements including echoed request data and request result data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Spend_Authorization_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Request Reference Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Spend_Authorization_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Request Criteria Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Respones Filter Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Spend_Authorization_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Spend Authorization Response Group Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the Spend Authorization Response Results element, including total results and paging</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Data" type="wd:Spend_Authorization_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the Spend Authorization Response Data element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Business_Document_Line_Split_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Supplier Invoice Line Split data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either Quantity must equal zero or not be present or the Extended Amount must equal Quantity * Unit Cost. Currently [Quantity] * [Unit Cost] does not equal [Extended].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Business Document Line Split for Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For requisition line splits tagged with a capital project worktag, the company of the requisition must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For purchase order line splits tagged with a capital project worktag, the company of the purchase order must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Use Budget Date on line splits to override the defaulted budget date on procurement card transaction verifications and purchase order goods and service lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Line Split Allocation Reference field should only be used when submitting a purchase order or a procurement card transaction verification. When submitting a purchase order, a Purchase Order Line Split must only reference Requisition Line Splits from the Requisition Line that is related to the current Purchase Order Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Document_Line_Split_Reference" type="wd:Business_Document_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Document Line Split Reference. Only to be used with the Get Web Service to grab the Integration ID.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Business Document Line Split Reference field should not be entered during the Submit Web Service. It is only used as a Reference during the Get Web Service.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Line_Split_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity for the split line. This is optional and should be absent when splitting by amount.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The quantity must be a whole number: [qty]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The extended amount for the split line. This is always required and must be correct (quantity * unit cost of parent line).</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a procurement card transaction verification line split.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Split line. This is free form text.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Split_Allocation_Reference" type="wd:Business_Document_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Line Split Allocated From Reference</xsd:documentation>
