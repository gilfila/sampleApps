<xsd:documentation>Reference to a Supplier Classification Field Choice for a Supplier Classification Field that has Supplier Classification Type of Multiple Choice - Multi Select</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Financials_Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
