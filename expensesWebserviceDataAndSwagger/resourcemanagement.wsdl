<xsd:annotation>
<xsd:documentation>Supplier Group ID. This is the Supplier Group unique identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Group_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for a meaningful Supplier Group Name</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Supplier Group Name is already in use.</xsd:documentation>
<wd:Validation_Message>Select a unique Supplier Group Name. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
