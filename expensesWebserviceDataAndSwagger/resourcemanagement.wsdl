<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Stopover_Indicator" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Code indicating whether the destination is a connection point or a final destination for one segment of air travel or for one segment of rail travel.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origin" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Origination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origination_Reference" type="wd:AirportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Origination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date for start of travel for this leg.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Trip_Leg_Fare_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Trip Leg Fare Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Trip_Leg_Fee_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Trip Leg Fee Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Trip_Leg_Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Trip Leg Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Refund_Indicator" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Leg Level Refund Indicator</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Trip_Leg_Details_Name_Match_Data" type="wd:Trip_Leg_Details_Name_Match_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Trip Leg Details Name Match Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Trip_Leg_Details_Name_Match_DataType">
<xsd:annotation>
<xsd:documentation>Trip Leg Details Name Match Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Confidence_Percentage" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Confidence level percentage must between 0 and 100.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="6"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Carrier_Code_Reference" type="wd:Abstract_Spend_Data_NameObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>If a Merchant Reference is provided, it must be a Merchant, or an Alternate Name linked to a Merchant.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Classification_Field_Choice_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all supplier classification field choice data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Referenced supplier classification field choice cannot be in use on a different supplier classification field.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Classification_Field_Choice_Reference" type="wd:Custom_Supplier_Classification_Field_ChoiceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing supplier classification field choice for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Classification_Field_Choice_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unique identifier for the Supplier Classification Field Choice.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a unique ID for the Supplier Classification Field Choice. [ID] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
