<xsd:complexType name="Asset_Useful_Life_for_Reclassify_DataType">
<xsd:annotation>
<xsd:documentation>This data for useful life per book</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can enter only one useful life per book.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
