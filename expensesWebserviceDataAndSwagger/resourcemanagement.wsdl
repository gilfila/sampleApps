<xsd:documentation>Ship-to Contact for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-to Address for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-to Contact for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Bill-to Address for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Terms for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>PO Issue Option for RFQ Award Contract Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Award_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element to capture RFQ Award Line information.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Award_Line_Reference" type="wd:Request_for_Quote_Award_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Reference" type="wd:Request_for_Quote_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Response_Line_Reference" type="wd:Request_for_Quote_Response_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Response Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Awarded_Document_Line_Reference" type="wd:Business_Document_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Award Outcome Business Document Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>RFQ Line Number</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Line_Type_Reference" type="wd:Request_for_Quote_Line_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>RFQ LIne Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item on the RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description on RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category on the RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates the original RFQ Line Quantity</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="RFQ_Line_Quantity_Awarded" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates how much of the RFQ Line Quantity was awarded</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Award_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>RFQ Award Line Quantity</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure on the RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates the original RFQ Line Unit Cost</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="RFQ_Line_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates original RFQ Line Extended Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount_Awarded" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates how much of the original RFQ Line Amount was awarded</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Target_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Target Price of the RFQ Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Price on RFQ Response Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost on RFQ Award Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Award_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount on RFQ Award Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requested_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requested Delivery Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date on RFQ Award Line. This is applicable only to Service Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date on RFQ Award Line. This is applicable only to Service Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Ship-To Address associated with the RFQ Award Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Ship-To Contact associated with the RFQ Award Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Deliver-To Location associated with the RFQ Award Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags on RFQ Award Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>RFQ Award Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Award_Line_Splits_Data" type="wd:Request_for_Quote_Award_Line_Splits_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures RFQ Award Line Splits information</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Line_Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Award_Line_Splits_DataType">
<xsd:annotation>
<xsd:documentation>Element to capture RFQ Award Line Splits information</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Award_Line_Split_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Award_Line_Split_Reference" type="wd:Business_Document_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Request for Quote Line Split Reference. Only to be used with the Get Web Service to retrieve the Integration ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity for the split line. This is optional and should be absent when we split by amount.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended amount for the split line. This is an optional field for split line. If value is present it must be equal to Quantity times Unit Cost of parent line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo on RFQ Award Line Split</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Split_Allocation_Reference" type="wd:Business_Document_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Line Split Allocated From Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags on RFQ Award Line Split</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Request_for_Quote_Award_RequestType">
<xsd:annotation>
<xsd:documentation>Element that contains the RFQ Award Document information. Includes information about RFQ Award header, lines, Splits and Purchase Order or Contract Defaults.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only update RFQ Award Documents that are in Draft Status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Award_Reference" type="wd:Request_for_Quote_AwardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Request for Quote Award Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
<xsd:element name="Request_for_Quote_Award_Data" type="wd:Request_for_Quote_Award_Data_InboundType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Request_for_Quote_Award_ResponseType">
<xsd:annotation>
<xsd:documentation>Element that shows the RFQ Award document worked upon.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Award_Reference" type="wd:Request_for_Quote_AwardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Award Document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Award_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element used to capture information to create a RFQ Award document. It contains Purchase Order or Supplier Contract Defaults, RFQ Award Lines and Line Split information.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Currency entered is not listed as an Accepted Currency by Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Verify that there are approved responses against the RFQ before creating an award document.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Award Date must be on or after the RFQ Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company on RFQ differs from what is used on RFQ Award.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There is no currency conversion rate between the RFQ currency ([rfq currency]) and the RFQ Award currency ([award currency]).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are no approved responses from this supplier [supplier] for the RFQ [rfq document]. Change the supplier and submit the document again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter Purchase Order Defaults for the RFQ Award because the award type is Purchase Order. Remove Supplier Contract Defaults if they exist and submit again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter Supplier Contract Defaults for the RFQ Award because the award type is Supplier Contract. Remove Purchase Order Defaults if they exist and submit again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set Auto-submit Award Outcome Document for Approval to false or change the Award Type to Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company on RFQ Award cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Award Type on RFQ Award cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier on RFQ Award cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>RFQ Reference cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract type [new contract type] does match the contract type [persisted contract type] that exists on the RFQ Award.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The entered supplier [supplier] is inactive. Change the supplier status or choose a different supplier and submit the RFQ Award again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't access the supplier due to your current segment security configuration.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Award_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Award Document</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a valid Reference ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company used to record RFQ Award.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Reference" type="wd:Request_for_QuoteObjectType">
<xsd:annotation>
<xsd:documentation>Reference to RFQ against which the award is created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Supplier on RFQ Award</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Award_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Award Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Award_Reason_Reference" type="wd:Procurement_Award_ReasonObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Award Reason for Request for Quote Award.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Currency on RFQ Award</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Award_Type_Reference" type="wd:Request_for_Quote_Award_TypeObjectType">
<xsd:annotation>
<xsd:documentation>RFQ Award Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Award Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Auto-submit_Award_Outcome_for_Approval" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether to submit the RFQ Award outcome document for approval</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Award_PO_Defaults_Data" type="wd:RFQ_Award_PO_Defaults_Data_InboundType" minOccurs="0"/>
<xsd:element name="RFQ_Award_Contract_Defaults_Data" type="wd:RFQ_Award_Contract_Defaults_Data_InboundType" minOccurs="0"/>
<xsd:element name="Business_Document_Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Request_for_Quote_Award_Line_Data" type="wd:Request_for_Quote_Award_Line_Data_InboundType" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="RFQ_Award_PO_Defaults_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element to capture PO Defaults at the time of creating a RFQ Award document</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't specify a Purchase Order Type that is marked Bill Only on the Request for Quote Award.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a Purchase Order Type that is marked Consignment on the Request for Quote Award.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a purchase order type that is inactive on the request for quote award.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
