<xsd:sequence>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_System_ID_Reference" type="wd:External_Transaction_Source__All_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference identifier of the external system that stores the requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Workday_External_Transaction_Source_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Requisition_Reference_ID" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The requisition reference identifier stored in the external system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A Reference to the Document Status for this Requisition. This field is read-only, and will be ignored on a Put or Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Currency of the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Requisition Type of the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Par_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Par Location of the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Sourcing_Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Requisition Sourcing Buyer for the Requisition</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Sourcing Buyer should not be terminated or not hired in future.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requesting_Inventory_Site_Reference" type="wd:LocationObjectType" minOccurs="0">
