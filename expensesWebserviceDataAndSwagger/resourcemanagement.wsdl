<xsd:documentation>Contains references that identify specific Rate Schedule instances to retrieve.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Rate_Schedule_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Contains additional criteria for identifying specific Rate Schedule instances.</xsd:documentation>
