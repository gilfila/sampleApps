<xsd:documentation>The commodity detail for the spend category. This field can be used as an alternative display name or code value to search for a spend category or spend category hierarchy in Workday.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="wd:RichText" minOccurs="0" maxOccurs="1">
