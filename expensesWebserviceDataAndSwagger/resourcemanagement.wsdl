</xsd:annotation>
</xsd:element>
<xsd:element name="Approving_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Approving Worker for the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_by_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Creating Worker for the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Worktags or Add new Worktags</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
