<xsd:complexType name="Get_Returns_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Return data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Return_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Return_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Utilize the following element to find Returns in the Workday system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Return_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Return_Request_ReferencesType">
