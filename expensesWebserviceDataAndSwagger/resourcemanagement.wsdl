<xsd:sequence>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing purchase item. Specifying the purchase item will default values for the Item Description, Spend Category, Tax Applicability, Unit of Measure, and Unit Cost if these options are defined on the purchase item itself.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Catalog_Item_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract field on the line is required and must match the Contract for the Catalog Item. Supplier Contract on the line: ([line contract]) is different than the expected Catalog Item's Contract: ([item contract]).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract field is required and must match the Contract for the Catalog Item. Supplier Contract: ([header contract]) is different than the expected Catalog Item's Contract: ([item contract]).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the line or select a different item. You can't submit an item that is Restricted from Purchasing.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Purchase_Order_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The line number of the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company of the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Supplier Item Identifier for a Goods Order Line. If the Item Reference is for a Catalog Item or the Requisition Line Reference is for a Web Item, the entered value will be ignored and Supplier Item Identifier from that Item will be used (even if it is blank)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Part_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Part ID. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Part_Auxiliary_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Part Auxiliary ID. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UNSPSC_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UNSPSC Code. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text description of the purchase item. If an item is provided, the description will default from that item. If no item is provided (ad-hoc), the entered free-form text description will be used.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line_Reference" type="wd:Supplier_Contract_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>An optional reference to an existing Supplier Contract Line in the Workday system. This is used to link the Item Order Line with a Supplier Contract Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract specified for the Purchase Order line does not match the Supplier Contract for the Supplier Contract Line: [SC line].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract specified for the Purchase Order does not match the Supplier Contract for the Supplier Contract Line: [line].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The commodity code on spend transactions lines. This is a standard code that identifies a type of good or service you order. For example, the United Nations Standard Products and Services Code (UNSPSC) or the National Institute for Governmental Purchasing (NIGP) code. For purchase items and catalog items, you can only submit active commodity codes already associated to the item. For ad hoc based lines, you can submit any active commodity code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receiving Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tracking_Status_Reference" type="wd:PO_Acknowledgement_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tracking Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Applicability for the Purchase Item. If the item has Tax Code defined, then the Tax Applicability is required.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Tax Applicability Reference is required is Tax Code is specified.</xsd:documentation>
<wd:Validation_Message>Tax Applicability Reference is required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Code for the Purchase Item. The Tax Code is defaulted from the Purchase Order Data element if one is specified.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Tax Code on the line is only allowed if the Tax Option is Calculate Tax Due to Supplier or Calculate Use Tax.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Options_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Packaging String associated with the Item specified on the Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity of the Purchase Item ordered. Quantity will be defaulted to 1 if left blank.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Splitting by quantity is not allowed when the quantity is not a whole number: [qty]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>Reference of the Unit Of Measure for the Purchase Item. The Unit Of Measure will be defaulted based on the Purchase Item if one is specified.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure is invalid for the catalog item. Only defined ordering units of measure for the catalog item can be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid Unit of Measure for the purchase item. This unit of measure is not defined for the supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unit cost of the item specified in the currency associated to the Purchase Order currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requested_as_No_Charge" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>No Charge field on Purchase Order Goods Line. This is a read-only field which is ignored when you submit inbound web services.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Purchase Order line. This amount is automatically calculated by multiplying the Quantity by the Unit Cost in the currency specified on the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lot_Serial_Information_Data" type="wd:Lot_Serial_Information_DataType" minOccurs="0"/>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order Line should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Delivery_Type_Reference" type="wd:Delivery_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of the Delivery Type for the Purchase Items with Inventory Spend Category</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Prepaid flag at the Line level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Your spend category for this line is not eligible for Prepaid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Prepaid Amortization Type is required when the prepaid boolean is set.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Down Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention flag at the Line level</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requested_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The requested delivery date from the related requisition line for the current purchase order or purchase order change order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a purchase order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Contains a reference instance or a Address Reference ID for an existing address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Global_Location_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Global Location Number (GLN) for Ship-to Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Location_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Location Identifier for Ship-to Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ship-to contact worker associated to the line item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requester for the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The location where the items will be delivered.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Remove the item or select a different deliver-to location. You can't submit items that are Restricted from Purchasing for the deliver-to location.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_GLN" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Global Location Number (GLN) for Deliver-To Location</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Location_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Location Identifier for Deliver-to Location</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This field is only enabled for Companies and Tenants which are Opted-In to Consolidate Requisition Lines by Supplier regardless of Supplier Contract.Use this field to assign a specific Supplier Contract to this Spend Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract selected on the Document Line must be for the Supplier on the Document Header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency for the Supplier Contract on the Purchase Order Line must match Currency for the Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract on the Document Line is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You selected an invalid supplier contract for this purchase order line. Select a supplier contract that's valid for the company, supplier, and document date; not undergoing an amendment; and supports manual purchase orders.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Line_Reference" type="wd:Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Requisition Line linked to the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Storage_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing location for the item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Worktags provided are not valid for this transaction</xsd:documentation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Purchase_Order_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Alternate_Item_Identifiers_Data" type="wd:Alternate_Item_Identifiers_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifiers for Procurement Item on Item Order Line.This field is read-only, and will be ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item tags for Procurement Item on Item Order Line.This field is read-only, and will be ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The status of a closed purchase order line. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Information" type="wd:Close_Status_InformationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional information on the status of the closed purchase order (PO) line. Includes information such as the date the PO line was closed, who closed the line, and the reason it was closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Submit Purchase Order Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Document_Number</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Hierarchy_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Project Hierarchy Request Reference Element.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Hierarchy_Reference" type="wd:Project_HierarchyObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Hierarchy Request Reference Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Hierarchy_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Project Hierarchy Request Criteria.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Hierarchy_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Hierarchy Name for Submit Workday Project Hierarchy Web Service Task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Hierarchy_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Project Hierarchy Response Group Element.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Project_Hierarchy_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Project Hierarchy Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_Contract_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Request References</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Order_Contract_Reference" type="wd:Supplier_ContractObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_Contract_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Request Criteria</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Contract Start Date On or After must be earlier than Contract Start Date On or Before.</xsd:documentation>
<wd:Validation_Message>Contract Start Date On or After must be earlier than Contract Start Date On or Before.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Contract End Date On or After must be earlier than Contract End Date On or Before.</xsd:documentation>
<wd:Validation_Message>Contract End Date On or After must be earlier than Contract End Date On or Before.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Organization Reference must be Companies or Company Hierarchies</xsd:documentation>
<wd:Validation_Message>Organization Reference must be Companies or Company Hierarchies</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier reference is for a supplier that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Supplier reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Organization_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to an existing Company or Company Hierarchy</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to an existing Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Contract Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Start_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Effective Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Start_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Effective Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_End_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract End Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_End_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract End Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Order_Contract_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Status. Examples of valid statuses are In Progress, Canceled, Approved, Denied, Draft</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Reference Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Creating Worker for Supplier Order Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_Contract_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Response Group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Order_Contracts_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Supplier Order Contract data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Supplier_Order_Contract_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Supplier_Order_Contract_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Supplier_Order_Contract_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Order Contracts Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_ContractType">
<xsd:annotation>
<xsd:documentation>Element containing supplier contract reference and data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Order_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Order_Contract_Data" type="wd:Supplier_Order_Contract_Data_for_Put_and_GetType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_Contract_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Supplier Order Contract Reference Instance and Supplier Order Contract Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Order_Contract" type="wd:Supplier_Order_ContractType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Contains data for adding a Supplier Order Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Order_Contracts_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Contract response elements including received criteria, references, data based on criteria and grouping, results filter and result summary</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Supplier_Order_Contract_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Supplier_Order_Contract_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Order_Contract_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Supplier_Order_Contract_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Order_Contract_Data_for_Put_and_GetType">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The End Date must be greater than the Start Date.</xsd:documentation>
<wd:Validation_Message>The End Date must be greater than the Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resource Provider must be a Supplier or an Independent Contingent Worker.</xsd:documentation>
<wd:Validation_Message>Resource Provider must be a Supplier or an Independent Contingent Worker.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resource Provider must be active or on hold.</xsd:documentation>
<wd:Validation_Message>Resource Provider must be active or on hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resource Provider reference is for a supplier that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Resource Provider reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Contract_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract ID. This is the unique identifier for supplier order contract.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Provider_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Resource Provider Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Hierarchy_Reference" type="wd:OrganizationObjectType">
<xsd:annotation>
<xsd:documentation>Company Hierarchy Reference. Can only specify either a Company Reference or a Company Hierarchy Reference, not both</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named Buyer for the Supplier Order Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Start_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Total_Contract_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Contract Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency entered is not listed as an Accepted Currency by Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Overview" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Overview</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing of supplier order contract inside the Workday application. Supplier order contract can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Replacement_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Request References</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Utilize the following element to find purchase orders in the Workday system.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Organization Reference must be Companies or Company Hierarchies</xsd:documentation>
<wd:Validation_Message>Organization Reference must be Companies or Company Hierarchies</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Due Date On or After must be earlier than Due Date On or Before.</xsd:documentation>
<wd:Validation_Message>Due Date On or After must be earlier than Due Date On or Before.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Purchase Order Date On or After must be earlier than Purchase Order Date On or Before.</xsd:documentation>
<wd:Validation_Message>Purchase Order Date On or After must be earlier than Purchase Order Date On or Before.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Updated From Date must be earlier than Updated To Date</xsd:documentation>
<wd:Validation_Message>Updated From Date must be earlier than Updated To Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier reference is for a supplier that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Supplier reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When you don't provide an external PO number and PO Type, you must include 1 of these pairs: 1/ On or After PO date and an On or Before PO date. 2/ On or After due date and an On or Before due date. 3/ Updated From date and an Updated To date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Change Type Reference requires Updated From/To dates.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Organization_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company or Company Hierarchy</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier or Contingent Worker</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Purchase Order Types in the system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Number. Allows for search for a partial sub-string match.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="513"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Purchase_Order_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Due Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Due Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Updated_From_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Changed Date on or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Updated_To_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Changed Date on or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Change_Type_Reference" type="wd:Transaction_Log_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the following Purchase Order Changes for search: - Change Order (WID:a602097bdd5b4fa180006baefedcd2c9) - Issue (WID:1b796240e3de4915a3ecaff766d0f704) - Cancel (WID:cf071027bbd74c3cad95b8e1fa42618e)Updated to/from dates are required to search by Change Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Invoice Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Payment Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Receiving Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Shipping Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tracking_Status_Reference" type="wd:PO_Acknowledgement_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Tracking Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Issue Option</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Order Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Reference" type="wd:RequisitionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requesting_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Requesting Worker for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_InvoiceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Creating_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Creating Worker for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approving_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Approving Worker for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Worktags or Add new Worktags</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Starting WD34 External PO Number is used when Purchase Order Type is 'External Warehouse'.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Response Group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the attachment data within Purchase Order Data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Purchase_Orders_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter for getting Purchase Order data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Purchase_Order_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Purchase_Order_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Orders Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Purchase_Order_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Response_DataType">
<xsd:annotation>
<xsd:documentation>Get Purchase Orders Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order" type="wd:Purchase_Order_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all Purchase Order data. A purchase order may have multiple goods and deliverable order lines or one contingent worker order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Purchase_Orders_ResponseType">
<xsd:annotation>
<xsd:documentation>Get Purchase Orders Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Purchase_Order_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Purchase_Order_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Purchase_Order_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Purchase_Order_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_OutboundType">
<xsd:annotation>
<xsd:documentation>Get Purchase Orders Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Data" type="wd:Purchase_Order_Outbound_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Data and all Goods,Service and Project-Based Purchase Order Lines.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order ID. This is the Purchase Order unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing the purchase order inside the Workday application.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_From_Mass_Close" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, indicates that the purchase order is manually excluded from mass close operations.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A unique Workday system generated Purchase Order Number. This value cannot be updated, but it can be used to reference the instance of the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Document Status for this Purchase Order. This field is read-only, and will be ignored on a Put or Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receiving Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tracking_Status_Reference" type="wd:PO_Acknowledgement_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tracking Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company. Sets the Company for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier supplying the goods or services for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Type in the system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an External Purchase Order Number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order-From_Supplier_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Order-from Connection tied to an existing Supplier supplying the goods.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date of the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acknowledgement_Expected" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if this Purchase Order is expecting a POA</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Auto_Sourced" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Defines whether the Purchase Order was created manually or Auto Sourced</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight charges incurred.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Other_Charges" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Other Charges</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference for the Payment Terms you associate with the purchase order. Workday defaults the Payment Terms when you specify terms for a referenced supplier contract, remit-to-connection from a referenced order-from-connection, or from the supplier specified on the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Override Payment Type valid for the Supplier on the Purchase Order. If none is returned, the Default Payment Type for the Supplier is assumed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Returns the reference to the Procurement Card assigned to the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Terms Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Instruction" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Gets Shipping Instruction data for Purchase Order WWS</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_Contract_BaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Option_Reference" type="wd:Tax_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Option.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Issue Option. If not entered, this will be defaulted to XML if the selected Supplier has a Supplier Link and Print otherwise. If Purchase Order Issue Option is External, the Purchase Order will automatically be submitted and marked as Issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Email_Data" type="wd:Default_PO_Issue_Email_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Default PO Issue Email Data allows the user to select emails specified on Purchase Order Issue Email Data to be used as the default Issue Email address on all Purchase Orders.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named buyer for the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact. If value is not provided, Bill-To Contact will default to the name of the person submitting the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Address_Data" type="wd:Bill_To_Address_ReferenceType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact. If value is not provided, Ship-To Contact will default to the name of the person submitting the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Data" type="wd:Ship_To_Address_ReferenceType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Global_Location_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Global Location Number (GLN) for Ship-to Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Location_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Location Identifier for Ship-to Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Link for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text describing the purpose of the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for internal notes that cannot be viewed by the supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set the Prepaid value to true for Prepaid Purchase Order where all lines are Prepaid. If set, the lines cannot be also set to Prepaid individually</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepayment_Release_Type_Reference" type="wd:Prepaid_Amortization_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Prepaid Amortization Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expected_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Expected Amortization Date is used when the Prepaid Amortization Type is set to "Manual"</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Prepaid_Posting_Rules_for_Receipt_Accruals" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use Prepaid Accounting Posting Rules for Receipt Accruals option.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_to_Retain" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent to Retain for Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Retention_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Estimated Retention Release Date for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME_3rd_Party_Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>3rd Party Retention for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention Memo for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment_Terms_Information_Data" type="wd:Down_Payment_Terms_Information_DataType" minOccurs="0"/>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Requisition Type of Requisitions included in Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procedure_Information_Data" type="wd:Procedure_Information_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Procedure Information related to the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Line_Data" type="wd:Item_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Deliverables_Line_Data" type="wd:Project-Based_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Service_Line_Data" type="wd:Service_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Contingent_Worker_Line_Data" type="wd:Contingent_Worker_Order_Line_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Tax_Code_Data" type="wd:Taxable_Code_Application_NO_INPUT_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_And_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Prepaid_Spend_Amortization_Schedule" type="wd:PO_Prepaid_Amortization_Schedule_Outbound_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project-Based_Order_Line_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Project-Based Order Line data. A Purchase Order may have multiple Project-Based order lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project reference is for a project that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the quantities on the split lines ([split qty]) must equal the quantity of the summary line: [qty]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract Line Reference for this Project-Based Order Line is not for a Project-Based Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract Line has been Canceled and cannot be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project for the Supplier Contract Line does not match the Project-Based Order Line Project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract Line supplier is On Hold and may not be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For purchase order lines tagged with a capital project worktag, the company of the purchase order must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Requisition Line referenced is from a Requisition that is Closed or Pending Close.</xsd:documentation>
<wd:Validation_Message>The Requisition Line referenced is from a Requisition that is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract field is required if there are any Contract Lines referenced.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Company on the Requisition Line Reference for this Purchase Order Line must be a valid company for the Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please Enable Multi-Company on Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enter a company that is in the intercompany profile of the company on the purchase order header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Select only Down Payments or Retention, but not both, in the same purchase order line or within the same purchase order.</xsd:documentation>
<wd:Validation_Message>Select only Down Payments or Retention, but not both, in the same purchase order line or within the same purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Select only Down Payments or Prepaid, but not both, in the same purchase order line or within the same purchase order.</xsd:documentation>
<wd:Validation_Message>Select only Down Payments or Prepaid, but not both, in the same purchase order line or within the same purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category must have a Spend Category Usage type of Procurement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Deliverables_Order_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The line number of the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company of the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line_Reference" type="wd:Supplier_Contract_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>An optional reference to an existing Supplier Contract Line in the Workday system. This is used to link the Project-Based Order Line with a Supplier Contract Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Spend Category ([po line spend category]) on the Purchase Order Line does not match the Spend Category ([supp contract line spend category])on the Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract specified for the Purchase Order line does not match the Supplier Contract for the Supplier Contract Line: [SC line].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract specified for the Purchase Order does not match the Supplier Contract for the Supplier Contract Line: [line].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receiving Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Prepaid flag at the Line level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Your spend category for this line is not eligible for Prepaid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Prepaid Amortization Type is required when the prepaid boolean is set.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Down Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention flag at the Line level</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a purchase order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Line_Reference" type="wd:Requisition_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Requisition Line sourced to the Purchase Order Line. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Reference" type="wd:Accounting_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Spend_Category_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Phase_Data" type="wd:Project_Plan_Phase_PO_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element Containing Project Plan Phase Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Project-Based Order Line. This amount is automatically calculated by adding the amounts of the multiple subtasks of the Project-Based Order Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktag types are invalid: [invalid].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This field is only enabled for Companies and Tenants which are Opted-In to Consolidate Requisition Lines by Supplier regardless of Supplier Contract.Use this field to assign a specific Supplier Contract to this Spend Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract on the Document Line is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency for the Supplier Contract on the Purchase Order Line must match Currency for the Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract selected on the Document Line must be for the Supplier on the Document Header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You selected an invalid supplier contract for this purchase order line. Select a supplier contract that's valid for the company, supplier, and document date; not undergoing an amendment; and supports manual purchase orders.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliverables_Purchase_Order_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Close_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The status of a closed purchase order line. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Information" type="wd:Close_Status_InformationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional information on the status of the closed purchase order (PO) line. Includes information such as the date the PO line was closed, who closed the line, and the reason it was closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Contingent_Worker_Order_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Contingent Worker Order Line data. A Purchase Order may only have one contingent worker order line data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The line number of the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Contingent_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Contingent Worker.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Position_Reference" type="wd:PositionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Position.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Position_Time_Type_Reference" type="wd:Position_Time_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Position Time Type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The hire or start date for the contingent worker of the purchase order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The contract end date for the contingent worker of the purchase order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Scheduled_Hours" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The scheduled work hours for the contingent worker of the purchase order line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Contract_Pay_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The contract pay rate for the contingent worker of the purchase order line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Time_Code_Data" type="wd:Time_Card_Factor_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Contingent Worker Order Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receiving Status for Purchase Order Line. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Applicability.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Code.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>You can't specify a third party tax code in the transaction tax code reference.</xsd:documentation>
<wd:Validation_Message>You can't specify a third party tax code in the transaction tax code reference.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Worktags_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Phase_PO_DataType">
<xsd:annotation>
<xsd:documentation>Element Containing Project Plan Phase Data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Project Plan Phase must be a Project Plan Phase for the selected Project.</xsd:documentation>
<wd:Validation_Message>Project Plan Phase must be a Project Plan Phase for the selected Project.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan_Phase_Reference" type="wd:Project_Plan_PhaseObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Plan Phase.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Task_Data" type="wd:Project_Plan_Task_PO_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element Containing Project Plan Task Data. A Project-Based Order Line may have multiple project subtasks of multiple project plan tasks.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Task_PO_DataType">
<xsd:annotation>
<xsd:documentation>Element Containing Project Plan Task Data. A Project-Based Order Line may have multiple project subtasks of multiple project plan tasks.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Project Plan Task must be a Project Plan Task of the selected Project Plan Phase.</xsd:documentation>
<wd:Validation_Message>Project Plan Task must be a Project Plan Task of the selected Project Plan Phase.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan_Task_Reference" type="wd:Project_Plan_TaskObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Plan Task.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Project Plan Task is not among any of the allowed Project Plan Tasks for the Project-Based Contract Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Subtask_Data" type="wd:Project_Subtask_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Project Subtask data. A Project-Based Order Line may have multiple project subtasks.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Subtask_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Project Subtask data. A Project-Based Order Line may have multiple project subtasks.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text description of the project subtask.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Amount" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount for the project subtask.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Time_Card_Factor_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Time Code Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Time_Code_Reference" type="wd:Time_Entry_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Time Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Itemized_Expense_Report_Line_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all data for 1 itemized expense report line (date, expense item, quantity, amount, tax amount, currency, currency rate, converted amount, receipt included, billable, worktags, expense item attributes).</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Expense Report Line: Invalid amount for fixed amount Expense Item. Amount cannot be changed.</xsd:documentation>
<wd:Validation_Message>Expense Report Line: Invalid amount for fixed amount Expense Item. Amount cannot be changed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Report Line: Invalid amount for Expense Item. Amount is greater then maximum allowed amount. View the Expense Item details for maximum amount allowed.</xsd:documentation>
<wd:Validation_Message>Expense Report Line: Invalid amount for Expense Item. Amount is greater then maximum allowed amount. View the Expense Item details for maximum amount allowed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If a fixed expense item is specified, the currency for the item must match the currency set up in the Workday system.</xsd:documentation>
<wd:Validation_Message>If a fixed expense item is specified, the currency for the item must match the currency set up in the Workday system.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Expense Item Details Reference Element is required for the expense item.</xsd:documentation>
<wd:Validation_Message>The Expense Item Details Reference Element is required for expense item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Both the converted amount and currency rate cannot be entered at the same time.</xsd:documentation>
<wd:Validation_Message>Both the converted amount and currency rate cannot be entered at the same time.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>There is no currency rate defined in the system between the transaction currency and the base currency. You will need to manually enter a currency rate on the expense report line.</xsd:documentation>
<wd:Validation_Message>There is no currency rate defined in the system between the transaction currency and the base currency. You will need to manually enter a currency rate on the expense report line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Amount is required for non-fixed expense items and fixed expense items that does not use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Amount is required for expense item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Currency is required for non-fixed expense items and fixed expense items that does not use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Currency is required for expense item - [item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Currency is not enterable for fixed expense items that use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Currency is not enterable for item - [item]. Currency will be determined based on quantity and information entered for expense item details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Amount is not enterable for fixed expense items that use expense rate tables.</xsd:documentation>
<wd:Validation_Message>Amount is not enterable for item - [item]. Amount will be calculated based on quantity and information entered for expense item details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Maximum number of Units allowed under your Allowance Plan was exceeded.</xsd:documentation>
<wd:Validation_Message>Maximum number of Units allowed [allowance number of units] under your Allowance Plan [allowance plan] exceeded by [quantity over].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Expense Report Line Date should be later than, or equal to, the start date of the Allowance Plan associated with the Expense Item selected.</xsd:documentation>
<wd:Validation_Message>The Expense Report Line Date [line date] should be later than, or equal to, the start date of the Allowance Plan [allowance plan] associated with the Expense Item [expense item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>For expense report lines tagged with a capital project worktag, the company of the expense report must equal the company on the capital project.</xsd:documentation>
<wd:Validation_Message>For expense report lines tagged with a capital project worktag, the company of the expense report must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktag types are invalid: [invalid].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity is required on Expense Report Line Itemization.</xsd:documentation>
<wd:Validation_Message>Quantity is required on Expense Report Line Itemization.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Item is required on Expense Report Line Itemization.</xsd:documentation>
<wd:Validation_Message>Expense Item is required on Expense Report Line Itemization.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>To edit Number of Hours on expense reports for per diem expense items, deselect Non-Editable Number of Hours.</xsd:documentation>
<wd:Validation_Message>To edit Number of Hours on expense reports for per diem expense items, deselect Non-Editable Number of Hours.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Report Line Start Date is required.</xsd:documentation>
<wd:Validation_Message>Expense Report Line Start Date is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can only define 'Expense_Report_Line_StartDate' on an expense item with 24-Hour Periods type of Travel Journal.</xsd:documentation>
<wd:Validation_Message>You can only define 'Expense_Report_Line_StartDate' on an expense item with 24-Hour Periods type of Travel Journal.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set up an intercompany relationship between [hdr company] and [line company] using the Edit Company Intercompany Profile task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>To add a company on the expense line, first enable Intercompany Processing on Expense Report Lines for the company on the expense report header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[error]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Report Line: Total amount is greater than the permitted maximum daily amount. View expense item details to determine the permitted maximum daily amount.</xsd:documentation>
<wd:Validation_Message>Expense Report Line: Total amount is greater than the permitted maximum daily amount. View expense item details to determine the permitted maximum daily amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company on the expense line that matches the company on the spend authorization or expense report. The linked spend authorization has commitment accounting enabled and can't be expensed to a different company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Distance-based expense item attributes can't be used with this web service.</xsd:documentation>
<wd:Validation_Message>Distance-based expense item attributes can't be used with this web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contact your compensation administrators so that they can enroll you in the allowance plan associated with this expense item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The expense item selected is not available for the date of the expense. To resolve the error, change the date or contact your administrator for expenses.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contact your administrator to add a currency rate from [Transaction Currency] to the allowance plan currency [Allowance Plan Currency].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Memo field for the [expense item] expense item is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your allowance plan ([allowance plan]) has a limit of [allowance amount] [allowance currency] that you have exceeded by [amount over] [allowance currency]. Request an amount less or equal to the limit</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Line_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Expense Report Line Start Date on an expense item with 24-Hour Periods type of Travel Journal.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Line_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was incurred.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>One or more itemized lines are not within or missing from the date range of the travel journal or there is more than one itemized line per day.</xsd:documentation>
<wd:Validation_Message>One or more itemized lines are not within or missing from the date range of the travel journal or there is more than one itemized line per day.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the expense item the expense is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Item_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit cost for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Tax Code is required when there is a tax amount.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The tax amount to report for the expense. The tax code is defined on the itemized line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the currency the expense was incurred in. Leave blank if you are entering a credit card transaction.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The transaction currency of the itemized line must match the transaction currency of the summary line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion rate between the currency the expense was incurred in and the currency the expense will be reported in. This cannot be used if you are entering the converted amount. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="27"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount the expense is converted to if it was incurred in a different currency. This cannot be used if you are entering the currency rate. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount to report for the expense. This will only be used for viewing.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Included" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not a receipt is included.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Personal_Expense" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense was for personal use.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is billable.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can’t set a transaction as billable and add a billable capital project as a worktag. Clear the Billable check box on the transaction line or remove this worktag: [project/phase/task].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Itemized Expense Report Line WWS Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as the default value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text describing the use or purpose of the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Details_Data" type="wd:Expense_Report_Line_Detail_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the expense item attributes that are set up for the expense. The attributes are configurable for the expense item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reimbursement_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount that represents reimbursement amount in the reimbursement currency. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Recipient_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates the recipient type info (worker, recipient, recipient name). Only one value can be used at a time.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Worker_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the worker or applicant who was a recipient for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The applicant you have entered is not valid. You must use the employee instance for this person.</xsd:documentation>
<wd:Validation_Message>The applicant ([applicant]) you have entered is not valid. You must use the employee instance for this person.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Recipient_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the person who was a recipient for the expense. Only recipients associated with the expense payee will be allowed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The recipient you have entered is not valid for the expense payee</xsd:documentation>
<wd:Validation_Message>The recipient ([recipient]) you have entered is not valid for the expense payee</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Recipient_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the name of the recipient. If the recipient exists already and is associated with the expense payee then it will be used. Otherwise, a new recipient will be created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Local_Person_Name_Detail_DataType">
<xsd:annotation>
<xsd:documentation>Contains the components of a name in local script, such as the First Name and Last Name, for supporting countries.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Local Last Name is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Last Name is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local First Name 2 is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local First Name 2 is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If one local script is submitted, all required local script name fields must be submitted.</xsd:documentation>
<wd:Validation_Message>If one local script is submitted, all required local script name fields must be submitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local First Name is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local First Name is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local Last Name 2 is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Last Name 2 is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local Middle Name is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Middle Name is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local Middle Name 2 is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Middle Name 2 is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Local Last Name 2 field accepts only Kana script.</xsd:documentation>
<wd:Validation_Message>The Local Last Name 2 field accepts only Kana script.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local Secondary Last Name is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Secondary Last Name is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Local Secondary Last Name 2 is not set up for this country.</xsd:documentation>
<wd:Validation_Message>Local Secondary Last Name 2 is not set up for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Local First Name 2 field accepts only Kana script.</xsd:documentation>
<wd:Validation_Message>The Local First Name 2 field accepts only Kana script.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="First_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains First Name in local script, which is generally configured to as Given Name, for supporting Countries.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Middle_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains Middle Name in local script for supporting Countries.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Last_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains Last Name in local script, which is generally configured as Family Name, for supporting Countries.</xsd:documentation>
