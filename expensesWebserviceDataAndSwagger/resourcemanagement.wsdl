</wd:Validation>
<wd:Validation>
<xsd:documentation>This validation requires the customer field when the project references a valid customer contract template.</xsd:documentation>
<wd:Validation_Message>Customer field is required because the project references a valid template for a customer contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>This validation prevents customers from adding a customer contract template to an opportunity project.</xsd:documentation>
<wd:Validation_Message>You can't add a customer contract template to an opportunity project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Billable flag must be checked if Project has either Contract Lines, or Billable Time, or Billable Transactions entered against the Project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>This validation prevents users from erroneously adding a non-configured Worktag Type as a Balancing Worktag.</xsd:documentation>
<wd:Validation_Message>The Balancing Worktag field must meet the type requirements for the Maintain Worktag Balancing Configuration task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Once a transaction has been approved (i.e. accounting into WIP) the company on the capital project cannot be changed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This link isn’t valid. Contact your Security Administrator for the correct link format.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>To enable Display Project in Opportunity Marketplace, contact your system administrator to opt in to Projects in Opportunity Marketplace.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Company Reference field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the End Date field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Customer Reference field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Start Date field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Billable field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Project State Reference field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Locked in Workday field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Project Name field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Overall Percent Complete field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Workday Project ID field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update Worktags Data for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Currency Reference field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Inactive field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Optional Project Hierarchy Reference field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Description field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Probability field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Include Project ID in Name field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the Capital field for a project associated with a quote for an open opportunity: [ID][RefID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the company because this project has an associated project budget.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Workday_Project_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for the Project</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing of the Project inside the Workday application. Project, Project Task and Project Pools can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Hierarchy_Reference" type="wd:Project_HierarchyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Hierarchy - this is required for creating a project.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The project hierarchy provided must be approved.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot change the Project Hierarchy in this web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify the reference ID of a project hierarchy you have access to. You currently don’t have access to this project hierarchy.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Optional_Project_Hierarchy_Reference" type="wd:Project_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Optional project hierarchies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can’t change the Reporting Project Hierarchy for this web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Optional Project Hierarchy ID. At least one of the Optional Project Hierarchy IDs you submitted is invalid for your request.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Event_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>READ ONLY: Project event status (Approved, Canceled, Denied or In Progress)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Associated_Templates_from_Project_Template_Reference" type="wd:Project_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Contract_Template_Reference" type="wd:Customer_Contract_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Customer Contract Template that has project lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for a meaningful Project Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if project is used as a worktag only and not a complete workday project instance</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates the Project is inactive. A project may also be inactivated by a project hierarchy as indicated by the 'Inactivated By Hierarchy Reference'. In which case, the project is considered Inactive even though this Boolean returns False. Changes to an inactive project are ignored. Reactivating a project can only be done on the project if it was explicitly marked 'Inactive' or by reactivating the hierarchy that made the project inactive.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_State_Reference" type="wd:Project_StateObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the state of the project. This can be Opportunity Project or Project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Status_Reference" type="wd:Project_StageObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the status of the project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Project_ID_in_Name" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean value indicating if the Project ID will be included in the display of the Project Name.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Owner_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the worker who owns the project</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency reference. Defaults to the tenant currency if no value is provided.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Plan_Reference" type="wd:Project_Resource_PlanObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Resource Plan Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean indicating whether the Project is billable or non-billable. Defaults to non-billable.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Capital" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean indicating whether the Project is capital or non-capital. Defaults to non-capital.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Display_Project_in_Opportunity_Marketplace" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specifies whether or not the project displays in Opportunity Marketplace.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for a meaningful Project Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Overall_Percent_Complete" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent in decimal format, ex: enter 1 for 100%, .5 for 50%, etc</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Probability" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent in decimal format, ex: enter 1 for 100%, .5 for 50%, etc</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Cannot exceed 1 for Probability. Enter percent in decimal format, ex: enter 1 for 100%, .5 for 50%, etc.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Probability must be equal to zero if the Project State is set to Project. Only allowed for Opportunity Projects.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Risk_Level_Reference" type="wd:Risk_LevelObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a rating indicating the Risk Level of the project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Priority_Reference" type="wd:Work_PriorityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a rating indicating the Work Priority of the project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Importance_Rating_Reference" type="wd:Importance_RatingObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a rating indicating the Importance Rating of the project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Success_Rating_Reference" type="wd:Success_RatingObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Success rating reference for the Project. This value is only persisted if the project's Overall Percent Complete equals 100%.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company that the project is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Reference" type="wd:CustomerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Customer that the Project is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Group_Reference" type="wd:Project_GroupObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Group that the project belongs.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Project_Reference_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field to provide Project Reference description. This is not a Workday reference instance.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The link to an external site.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Problem_Statement" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field providing details of the problem that the project hopes to resolve.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Objective" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field providing details of the overall objective of the project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="In_Scope" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field providing details of what portions of the project are in scope.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Out_of_Scope" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field providing details of what portions of the project are out of scope.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Measures_of_Success" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field providing details of how the project will be measured for success.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Overview" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form rich text field that provides more specific details about the project beyond the brief project description.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Initiative_Reference" type="wd:InitiativeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>READ ONLY: Initiative that the Project belongs to.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Estimated_Budget" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The estimated project budget amount in the currency context identified for the project.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Revenue" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The estimated revenue amount in the currency context identified for the project.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Realized_Revenue" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The realized revenue amount in the currency context identified for the project.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Data" type="wd:Related_Worktag_Widget_DataType" minOccurs="0"/>
<xsd:element name="Balancing_Worktag_Reference" type="wd:Balancing_WorktagObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to existing Balancing Worktag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Optional_Balancing_Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to Existing Optional Balancing Worktag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Dependencies_Reference" type="wd:ProjectObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The list of projects defined as dependencies to this project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Prerequisite_For_Reference" type="wd:Project_AbstractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>READ ONLY: The list of projects defined as prerequisites to this project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Project_RequestType">
<xsd:annotation>
<xsd:documentation>Request Element for Submitting a Project via a Web Service</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Project Reference provided refers to a Project that is not updatable either because the Project was never created or the Project was Canceled or Denied. Project Reference: [id][reference]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; but the Project ID already exists.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Reference provided refers to a Project that is not updatable because the Project already has updates in progress. Project Reference: [id][reference]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:Project_AbstractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project for update only purposes.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Project_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Project MLV Webservice Criticals</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Data" type="wd:Project_DataType">
<xsd:annotation>
<xsd:documentation>The project data element containing project details for V22 and up.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Get Projects Request References</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:Project_AbstractObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Request Criteria for Get Projects.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Customer reference is for a customer that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Customer reference is for a customer that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for the Project</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Hierarchy_Reference" type="wd:Project_HierarchyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Project Hierarchy for which this Project belongs.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project status or statuses (Approved, Canceled, Denied or In Progress)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_who_owns_Project_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the worker who owns the project</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date On or After must be earlier than Start Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date On or After must be earlier than Start Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date On or After must be earlier than End Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date on or before, must be after End Date on or after.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Reference" type="wd:CustomerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Customer Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company that the project is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Group_Reference" type="wd:Project_GroupObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Group that the project belongs.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Initiative_Reference" type="wd:InitiativeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Initiative Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Worktags provided are not valid for this transaction</xsd:documentation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Success_Rating_Reference" type="wd:Success_RatingObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Success Rating reference for Project</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Assigned_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Worker assigned to the Project</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve Billable Projects</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Non-Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve Non-Billable Projects only if true.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Both_Billable_and_Non-Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve both Billable and Non-Billable projects</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:choice>
<xsd:element name="Capital" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve Capital Projects</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Non-Capital" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve Non-Capital Projects</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Both_Capital_and_Non-Capital" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retrieve both Capital and Non-Capital projects</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Response_GroupType">
