<xsd:complexType name="Asset_Share_Response_DataType">
<xsd:annotation>
<xsd:documentation>Element containing the asset share response data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
