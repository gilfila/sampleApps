</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Worker_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the worker or applicant who was an attendee for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>The applicant you have entered is not valid. You must use the employee instance for this person.</xsd:documentation>
<wd:Validation_Message>The applicant ([applicant]) you have entered is not valid. You must use the employee instance for this person.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Passenger_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the person who was a passenger for the expense. Only passengers associated with the expense payee will be allowed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The passenger you have entered is not valid for the expense payee</xsd:documentation>
<wd:Validation_Message>The passenger ([passenger]) you have entered is not valid for the expense payee</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Passenger_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the name of the passenger. If the passenger exists already and is associated with the expense payee then it will be used. Otherwise, a new passenger will be created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
