<wd:Validation>
<wd:Validation_Message>Service lines or deliverable service lines are not allowed for the selected requisition type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The total extended amount of all lines must be greater than or equal to zero.</wd:Validation_Message>
