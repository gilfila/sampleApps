<xsd:documentation>Contains request reference, criteria, filter and response group for getting Spend Category data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Spend_Category_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Spend Categories Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Spend_Category_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Spend Categories Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Spend Categories Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Spend_Category_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Spend Categories Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Spend_CategoryType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Spend Category Instance and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Resource_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Data" type="wd:Spend_Category_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
