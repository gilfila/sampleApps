<xsd:documentation>Reason for Assignment of Central Travel Card Transaction to Assignee</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Worker_Rate_Standard_Cost_Rate_DetailsType">
<xsd:annotation>
<xsd:documentation>Element containing Project Worker Rate Standard Cost rate data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Clear the Delete option as the Project Worker Rate Standard Cost Rate Detail ID doesn't exist.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Project Worker Rate Standard Cost Rate Detail ID doesn't belong to the rate sheet: [refid].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This worker doesn't belong to any company on the snapshot: [Worker]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Delete" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Delete</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Worker_Rate_Standard_Cost_Rate_Detail_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Worker Rate Standard Cost Rate ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType">
