</xsd:annotation>
<xsd:sequence>
<xsd:element name="Time_In" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Time In</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_Out" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Time Out</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_Card_Factor_Reference" type="wd:Time_Entry_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Time Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_In_Time_Out_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Time In Time Out Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Attendee_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates the attendee type info (worker, guest, guest name). Only one value can be used at a time.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Worker_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the worker or applicant who was an attendee for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>The applicant you have entered is not valid. You must use the employee instance for this person.</xsd:documentation>
<wd:Validation_Message>The applicant ([applicant]) you have entered is not valid. You must use the employee instance for this person.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the guest who was an attendee for the expense. Only guests associated with the expense payee will be allowed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The guest you have entered is not valid for the expense payee</xsd:documentation>
<wd:Validation_Message>The guest ([guest]) you have entered is not valid for the expense payee</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the name of the guest. If the guest exists already and is associated with the expense payee then it will be used. Otherwise, a new guest will be created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order reference for update and all Purchase Order data items</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Purchase Order cannot be updated via this web service if any of the following are true: 1) it contains contingent worker lines, 2) it is not in draft status 3) the Supplier referenced is not Active, or 4) the Supplier Contract (if any) does not allow Manual Purchase Orders.</xsd:documentation>
<wd:Validation_Message>[po]: This Purchase Order cannot be updated via this web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order for update only purposes.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Document_Number</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Data" type="wd:Purchase_Order_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Data and all Goods,Service and Project-Based Purchase Order Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
