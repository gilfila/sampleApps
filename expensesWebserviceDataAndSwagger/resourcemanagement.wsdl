<xsd:documentation>Destination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Destination_Reference" type="wd:AirportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Destination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Endorsements" type="xsd:string" minOccurs="0" maxOccurs="1">
