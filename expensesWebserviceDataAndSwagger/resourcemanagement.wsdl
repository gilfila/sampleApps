<xsd:complexType name="Asset_SharesType">
<xsd:annotation>
<xsd:documentation>Element containing a reference to an existing business asset and all its asset share data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Asset_Reference" type="wd:Business_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing business asset for which the asset share data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Share_Response_Data" type="wd:Asset_Share_Response_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
