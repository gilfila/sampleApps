<xsd:annotation>
<xsd:documentation>Reference to the company the expense report is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Repayment Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Amount" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Repayment Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
