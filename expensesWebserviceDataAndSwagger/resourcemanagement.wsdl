</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element Content containing Response Filter.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Response Results</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Data" type="wd:Project_Plan_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Project Plan GET response data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Phase_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Contains project plan data. Project plan consists of phases and tasks. If a phase name is not provided, all tasks identified will still be grouped under a phase. If the element is not included, removal of the phase is assumed and the phase and all tasks will be removed from the project, where valid to do so.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Phase ID: [id] is already in use by a different Project: [project].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Phase Reference is required when creating a new Project Plan Phase for Project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the parent of the project plan phase or project plan task: [phaseID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Phase can't be changed if the Project Plan Phase or any of its descendant Project Plan Phases and Tasks is referenced as a worktag: [phaseID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The project plan phase either has child phases, or the phase, its child phases or tasks are associated with: timesheet entries, time blocks, contract milestones, resource forecasts, project-based service lines, or worktags. You can't delete this project plan phase: [phaseID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must have a Reference ID for the project phase when you update an existing project plan phase.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to delete a project plan phase associated with a quote for an open opportunity: [phaseID]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the phase field for a project plan phase associated with a quote for an open opportunity: [phaseID]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan_Phase_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Phase ID. This is the phase unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specifies the display order of the phase in the project plan.Specify the order using lower case letters.If the maximum number of child phases for a parent is less than or equal to 26, use one letter. Example: a, b, c ... z.If it is less than or equal to 676, use two letters. Example: aa, ab, ac ... zz.If it is less than or equal to 17576, use three letters. Example: aaa, aab, aac, ... zzz.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Phase_Reference" type="wd:Project_PhaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Phase Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Project Plan Phase MLV Webservice Criticals</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Parent_Project_Plan_Phase_Reference" type="wd:Project_Plan_PhaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Parent Project Plan Phase Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The parent of project plan phase doesn't belong to the project. Parent phase: [parentID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify more than 10 sub-levels for your project plan phase. The parent for this phase is already at level 10. Parent phase: [parentID].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Task_Data" type="wd:Project_Plan_Task_WWS_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Contains task data that are grouped under a phase.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Flag indicating that the referenced data should be deleted.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>If Delete is set to true, Replace All must be set to false.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, Replace All must be set to false.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Put_Project_Plan_RequestType">
<xsd:annotation>
<xsd:documentation>Root element for the Request on the Put operation.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Project Reference provided refers to a Project that is not updatable either because the Project was never created or the Project was Canceled or Denied. Project Reference: [id][reference]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Data" type="wd:Project_Plan_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is wrapper element for project plan data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>A Condition Rule cannot already exist for the Reference or Description if the "Add Only" element is TRUE.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Project_Plan_ResponseType">
<xsd:annotation>
<xsd:documentation>Root element for the Response on the Put operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Application_Instance_Related_Exceptions_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Application Instance Related Exceptions Response Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Plan_Task_WWS_DataType">
<xsd:annotation>
<xsd:documentation>This element contains the Project Plan Task Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Milestone Flag must be on when the Task is currently in use as a Milestone.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Task End Date cannot be before the Task Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Task cannot be changed if the Project Plan Task is referenced as a Worktag.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Task Name can't be changed if the Project Plan Task has time entered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>End Date is required for contract milestones tasks marked complete. See task [task].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Plan Task ID: [id] is already in use by a different Project Plan Phase: [phase].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Task Reference is required when creating a new Project Plan Task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Non-Billable Flag cannot be updated on a Non-Billable Project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Project Task ID. This ID is restricted to a different project hierarchy. Project Task ID:[id]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>% Complete cannot be greater than 100%.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must have a Reference ID for the project task when you update an existing project plan task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the custom task name field for a project plan task associated with a quote for an open opportunity: [task]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the task field for a project plan task associated with a quote for an open opportunity: [task]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the start date field for a project plan task associated with a quote for an open opportunity: [task]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to update the end date field for a project plan task associated with a quote for an open opportunity: [task]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to delete a project plan task associated with a quote for an open opportunity: [task]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan_Task_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Task ID. This is the task unique identifier within a phase.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specifies the display order of the task within the phase of a project plan.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Reference" type="wd:Project_TaskObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Task Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Project Plan Task MLV Webservice Criticals</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Custom_Task_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Custom Task Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Task Start Date cannot be after Project End Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Task End Date cannot be after the Project End Date.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Task End Date cannot be before the Task Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This milestone task is associated to a contract. Confirm that end date should be greater than today's date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_Complete" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent in decimal format, ex: enter 1 for 100%, .5 for 50%, etc</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Non-Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Non-Billable</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Milestone" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates if the task is a project milestone.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Checking the task Closed will prevent any additional time to be reported for the specified task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Utilization" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For informational purposes only to indicate that this project plan task qualifies for utilization calculations.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text capturing comments about the task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Attachment File</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Flag indicating that the referenced data should be deleted.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>If Delete is set to true, Replace All must be set to false.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, Replace All must be set to false.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Project_Plan_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element for Project plan data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Project Plan Template cannot be submitted when current phases/tasks are present</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>These tasks are associated with timesheet entries, time blocks, contract milestones, resource forecasts, project-based service lines, or worktags. You can't delete these project plan tasks: [tasks].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid project plan phase. You specified a descendant as the parent of an ancestor, creating a circular reference in the phase hierarchy: [phases]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>These phases have an associated transaction or are used as a worktag. You can't delete these project plan phases: [phases].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Task ID: [id] cannot be used more than once.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't allow you to replace a project plan associated with a quote for an open opportunity: [project]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project ID. This is unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Template_Reference" type="wd:Project_Plan_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Plan Template (Not available in GET Operation)</xsd:documentation>
</xsd:annotation>
</xsd:element>
