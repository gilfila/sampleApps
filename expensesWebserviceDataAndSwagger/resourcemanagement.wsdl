</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Line_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was incurred.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Booking_Record_Reference" type="wd:Travel_Booking_RecordObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the travel booking record where the expense was reported.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The travel booking record is not expensable.</xsd:documentation>
<wd:Validation_Message>The travel booking record is not expensable.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can only enter travel booking records for the expense payee that's selected on the expense report.</xsd:documentation>
<wd:Validation_Message>You can only enter travel booking records for the expense payee that's selected on the expense report.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The travel booking record isn't mapped to the expense item. Map its travel type to the expense item on the Maintain Travel Type Mapping task.</xsd:documentation>
<wd:Validation_Message>The travel booking record isn't mapped to the expense item. Map its travel type to the expense item on the Maintain Travel Type Mapping task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Expense_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the credit card that the expense was paid with. This can only be used for credit cards that require manual entry.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Credit_Card_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>The credit card entered does not allow transactions to be entered manually.</xsd:documentation>
<wd:Validation_Message>The credit card entered does not allow transactions to be entered manually.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The credit card entered is not active.</xsd:documentation>
<wd:Validation_Message>The credit card entered is not active.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The credit card entered does not belong to the expense payee that was entered.</xsd:documentation>
<wd:Validation_Message>The credit card entered does not belong to the expense payee that was entered.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_Transaction_Reference" type="wd:Credit_Card_TransactionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the credit card transaction where the expense was reported. This cannot be used at the same time as the credit card reference or the mobile expense reference.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The credit card transaction entered has already been used.</xsd:documentation>
<wd:Validation_Message>The credit card transaction entered has already been used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The credit card transaction entered is not for the expense payee that was entered.</xsd:documentation>
<wd:Validation_Message>The credit card transaction entered is not for the expense payee that was entered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The selected transaction is invalid. The company of the credit card transaction doesn't have a configured intercompany profile with the expense report company. Select a valid transaction or contact your Expenses Administrator.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Mobile_Expense_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the mobile expense where the expense was reported. This cannot be used at the same time as the credit card reference or the expense credit card transaction reference.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>One or more mobile expense entered has already been used.</xsd:documentation>
<wd:Validation_Message>One or more mobile expense entered has already been used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>One or more mobile expense entered is not for the expense payee that was entered.</xsd:documentation>
<wd:Validation_Message>One or more mobile expense entered is not for the expense payee that was entered.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Reference" type="wd:Item_DescriptorObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the expense item the expense is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Item_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit cost for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Tax Code is required when there is a tax amount.</xsd:documentation>
<wd:Validation_Message>Tax Code is required when there is a tax amount.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount for Expense Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the currency the expense was incurred in. Leave blank if you are entering a credit card transaction.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Enter a manual credit card transaction currency that matches the billing currency of the credit card account. If the currencies differ, verify the expense report reimbursement currency matches the billing currency of the credit card account.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion rate between the currency the expense was incurred in and the currency the expense will be reported in. This cannot be used if you are entering the converted amount. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="27"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount the expense is converted to if it was incurred in a different currency. This cannot be used if you are entering the currency rate. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount to report for the expense. This will only be used for viewing.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Itemized_Lines_Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total amount of the converted amounts for the itemized lines. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Included" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not a receipt is included.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Personal_Expense" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense was for personal use.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The personal flag cannot be set for the credit card item and amount combination.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is billable.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can’t set a transaction as billable and add a billable capital project as a worktag. Clear the Billable check box on the transaction line or remove this worktag: [project/phase/task].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Line level Company Override</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as the default value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[job requisition worktag validation for WS]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text describing the use or purpose of the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Available_Spend_Authorization_Line_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Spend Authorization Line to be linked to the Expense Report Line. Only applicable if Commitment Accounting is enabled for the company.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Commitment Accounting is not enabled for this Company. Cannot link a Spend Authorization Line to an Expense Report Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Expense Report is marked as the Final Expense Report for Spend Authorization. Cannot link a Spend Authorization Line with an Expense Report Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Available Spend Authorization Line entered does not exist for the selected Spend Authorization</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Available Spend Authorization Line used on Expense Report Line [item] - [unit cost] [currency] has been fully liquidated. Select another Spend Authorization Line or leave blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Unit Cost is negative, cannot link Spend Authorization Line</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Details_Data" type="wd:Expense_Report_Line_Detail_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the expense item attributes that are set up for the expense. The attributes are configurable for the expense item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Itemized_Expense_Report_Lines_Data" type="wd:Itemized_Expense_Report_Line_WWS_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the itemized lines that further describe the current expense line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reimbursement_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount that represents reimbursement amount in the reimbursement currency. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
