<xsd:annotation>
<xsd:documentation>Nature of Actions Request References Element</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Project_Plan_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
