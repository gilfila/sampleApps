<xsd:documentation>This element content contains the echoed Guests Request Reference Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Guest_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Guests Request Criteria Element</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Guest_Response_GroupType" minOccurs="0">
