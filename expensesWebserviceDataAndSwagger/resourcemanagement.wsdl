<xsd:documentation>Weekly Allocation Data element for Resource Forecast Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Delete Flag</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Resource_Forecast_Line_Allocation__HV__DataType">
<xsd:annotation>
<xsd:documentation>Weekly Allocation Data for Resource Forecast Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This period start date is a duplicate: [date]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Forecasted Hours cannot be empty.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For the weekly configuration, you must use a Monday for the period start date: [period start date].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For the daily configuration, you must use a weekday for the period start date: [period start date].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For the monthly configuration, use the first day of the month for the period start date: [period start date].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Period_Start_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Period start date for weekly allocation data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecasted_Hours" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Forecasted hours for weekly allocation data</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Related_Worktags_by_Worktag_Type_DataType">
<xsd:annotation>
<xsd:documentation>Allowed and Default Related Worktags Data by Worktag Type.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote] you cannot specify allowed values as they are not enabled in ‘Maintain Related Worktag Usage’.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], Default Worktag field is "Required".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktag Type: [AWT] is not allowed for Taggable Type: [TT]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], Delete Allowed Value cannot be 'Y' when all allowed values are being replaced.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], when default value and allowed values are being replaced, allowed values in file must be empty or include default value specified in file.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], when allowed values are being replaced but existing default value is not being replaced or deleted, allowed values in file must be empty or include existing default value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], you cannot have a 'Default Value' on more than one row.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], when default value is being replaced, persisted allowed values must be empty or include default value specified in file.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Worktag Type can't be used more than once in this request: '[AWT]'.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Worktag_Type_Reference" type="wd:Accounting_Worktag_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Worktag Type Reference ID cannot be duplicated within one request. Valid ID types for all worktag types that can be configured for a related worktag taggable type may include: BUSINESS_SITE, BUSINESS_UNIT, COST_CENTER, CUSTOM_ORGANIZATION_01-10, CUSTOM_WORKTAG_1-10, FUND, GIFT, GRANT, INVESTOR, OPPORTUNITY, PROGRAM, PROJECT, PROJECT_PHASE, PROJECT_TASK, REGION, SALES_ITEM.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Required_On_Transaction" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if the Worktag Type will be required on a transaction when a value for the worktag type that has related values is entered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Required_On_Transaction_For_Validation" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if 'Required on Transaction' is enabled in either 'Maintain Related Worktag Usage' or on the Worktag instance. When you generate an EIB template with data, 'y' is returned when either boolean is true. This boolean is informational only in the 'Put' operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Worktag_Data" type="wd:Default_Worktag_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to existing Default Realted Worktag or Add new Default Related Worktag</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Replace_All_Allowed_Values" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate that all existing allowed values are to be deleted. When set to true ('y' in EIB), if allowed values are also specified, they will become the new set of allowed values.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Allowed_Worktag_Data" type="wd:Allowed_Worktag_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Allowed Related Worktags or Add new Allowed Related Worktags</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Allowed_Worktag_DataType">
<xsd:annotation>
<xsd:documentation>Reference to existing Allowed Related Worktags or Add new Allowed Related Worktags</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Worktag Type of Allowed Worktag "[AW]" does not match the Worktag Type: "[WT]"</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], an allowed value must be specified when Delete Allowed Value = 'Y'.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], specified default value must match an existing allowed value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], when existing default value is being replaced, default value in file must match an allowed value in file or an existing allowed value</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as an allowed value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[concatenated validation message for constraint provider]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[validation message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Allowed_Worktag_Reference" type="wd:Accounting_Worktag_and_Aggregation_DimensionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>IMPORTANT: You must check 'Separate Type Column' for this field in your EIB template to see values when you generate a template with data or to configure related worktags for multiple worktag types. The list of valid ID types for this column exceeds the size limit of an Excel validation list so ID types must be entered as text. Valid ID types for this column may include: Business_Unit_Hierarchy_ID, Business_Unit_ID, Cost_Center_Reference_ID, Custom_Organization_Reference_ID, Custom_Worktag_1-5_ID, Custom_Worktag_06-15_ID, Fund_Hierarchy_ID, Fund_ID, Gift_Hierarchy_ID, Gift_Reference_ID, Grant_Hierarchy_ID, Grant_ID, Investor_ID, Location_ID, Opportunity_Reference_ID, Organization_Reference_ID, Program_Hierarchy_ID, Program_ID, Project_Hierarchy_ID, Project_ID, Project_Phase_Name_ID, Project_Task_Name_ID, Region_Reference_ID, Sales_Item_Group_ID, Sales_Item_ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete_Allowed_Value" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Boolean to indicate that specified allowed values are to be deleted. At least 1 existing allowed value must be specified When set to true (or 'y' in EIB). Cannot be set to true if 'Replace All Allowed Values' is set to true.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Default_Worktag_DataType">
<xsd:annotation>
<xsd:documentation>Reference to existing Default Realted Worktag or Add new Default Related Worktag</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Worktag Type of Default Worktag "[AW]" does not match the Worktag Type: "[WT]".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktag Aggregation Dimension: '[wt]' is not allowed in the default worktag field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For '[AWT]' on [T-New Instance] '[TT]'[colon] [squote][T][squote], Delete Default Value cannot be 'Y' when a default is required or the default value is not the existing value or if its blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For [T-New Instance] '[TT]'[colon] [squote][T][squote]: Default value "[AWT]:[AW]" does not allow [Default Text Singular or Plural]: [Target Worktags].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as the default value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[concatenated validation message for constraint provider]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[validation message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Default_Worktag_Reference" type="wd:Accounting_Worktag_and_Aggregation_DimensionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>IMPORTANT: You must check 'Separate Type Column' for this field in your EIB template to see values when you generate a template with data or to configure related worktags for multiple worktag types. The list of valid ID types for this column exceeds the size limit of an Excel validation list so ID types must be entered as text. Valid ID types for this column may include: Business_Unit_ID, Cost_Center_Reference_ID, Custom_Organization_Reference_ID, Custom_Worktag_1-5_ID, Custom_Worktag_06-15_ID, Fund_ID, Gift_Reference_ID, Grant_ID, Investor_ID, Location_ID, Opportunity_Reference_ID, Organization_Reference_ID, Program_ID, Project_ID, Project_Phase_Name_ID, Project_Task_Name_ID, Region_Reference_ID, Sales_Item_Group_ID, Sales_Item_ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete_Default_Value" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if existing default value is to be deleted. The existing default value must be correctly specified. Do not set to true (or 'y' in EIB) to replace the existing default value.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Related_Worktag_Widget_DataType">
<xsd:annotation>
<xsd:documentation>Reference to the existing Allowed or Default Related Worktags.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[One of Project OR Project Plan Phase OR Project Plan Task Allowed]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Related_Worktags_by_Type_Data" type="wd:Related_Worktags_by_Worktag_Type_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Allowed and Default Related Worktags Data by Worktag Type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Replace_All" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>All existing related worktags (both allowed and default) are replaced with the ones specified in the request. It will supersede any "remove all" or delete option set to True by worktag type. When True, a default value must be provided for all worktag types that are configured with 'Default Required' in the 'Maintain Related Worktag Usage'.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_Repayment_DataType">
<xsd:annotation>
<xsd:documentation>Cash Advance Repayment Data contains all of the enterable information about a Cash Advance Repayment</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Cash Advance Available Balance is [Cash Advance Available Balance in Repayment Currency]. Repayment Amount must be less than or equal to the Available Balance. Cash Advance Available Balance includes applied cash advance amount on an expense report not fully approved for this worker. Cancel the related expense report or enter a new Repayment Amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cash Advance Repayment currency must be either the currency for the business document or the company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Cash Advance Repayment ID. This is the Cash Advance Repayment unique identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType">
<xsd:annotation>
<xsd:documentation>Required field representing the Spend Authorization being repaid by the Cash Advance Repayment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the Cash Advance Repayment is being recorded</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Amount" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount being repaid with this Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Currency for the Cash Advance Repayment. Restricted to Company or Spend Authorization currency</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Type_Reference" type="wd:Payment_TypeObjectType">
<xsd:annotation>
<xsd:documentation>Payment Type for the Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference information for the Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Cash_Advance_Repayment_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Spend Authorization reference for update and all Cash Advance Repayment data items</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment_Reference" type="wd:Cash_Advance_RepaymentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Cash Advance Repayment for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cash_Advance_Repayment_Data" type="wd:Cash_Advance_Repayment_DataType">
<xsd:annotation>
<xsd:documentation>Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Cash_Advance_Repayment_ResponseType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Cash Advance Repayment Instance</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment_Reference" type="wd:Cash_Advance_RepaymentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a specific Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_Repayment_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Cash Advance Repayment Reference element contains the specific Cash Advance Repayment requested. The ID is the value and the Type attribute is either the Lookup ID type or the Workday ID (GUID) for the reference to the Cash Advance Repayment.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment_Reference" type="wd:Cash_Advance_RepaymentObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Business Object containing the Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_Repayment_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Request criteria for retrieving specific Cash Advance Repayment objects</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_Repayment_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Cash Advance Repayment response. If this element is not included then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Cash Advance Repayment Reference data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Cash_Advance_Repayments_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level request element for all Cash Advance Repayment "Get" operations</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Cash_Advance_Repayment_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Cash_Advance_Repayment_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Cash_Advance_Repayment_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_RepaymentType">
<xsd:annotation>
<xsd:documentation>Cash Advance Repayment contains all of the information about a Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment_Reference" type="wd:Cash_Advance_RepaymentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a specific Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company for Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Required field representing the Spend Authorization being repaid by the Cash Advance Repayment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the person who the cash advance repayment is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Type_Reference" type="wd:Payee_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Expense Payee Type on the Spend Authorization - Employee, Contingent Worker, or External Committee Member.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the Cash Advance Repayment is being recorded</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount being repaid with this Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency for the Cash Advance Repayment. Restricted to Company or Spend Authorization currency</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Type for the Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Repayment_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference information for the Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for Cash Advance Repayment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_to_Expense_Advance_Account" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount to Credit Expense Advance Account</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Balancing_Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to Balancing Worktag</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Exchange_Gain__Loss__to_Record" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency Gain (Loss) to Record</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cash_Advance_Repayment_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing Cash Advance Repayment response data for requested references or criteria and for requested response group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cash_Advance_Repayment" type="wd:Cash_Advance_RepaymentType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Cash_Advance_Repayments_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Cash Advance Repayment response elements including echoed request data and request result data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Cash_Advance_Repayment_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Cash_Advance_Repayment_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Cash_Advance_Repayment_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Cash_Advance_Repayment_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Lease_Supplier_Contract_Details_DataType">
<xsd:annotation>
<xsd:documentation>Element that contains Lease Supplier Contract Details.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Compound Period doesn't apply to your lease contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If your Contract Type is a lease contract, you must enable Automatically Generate Expense Recognition Schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If your Contract Type is a lease contract, you must enable Automatically Generate Supplier Invoice Schedule and Installments.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Lease_Term" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lease Term. This field is to be returned for Get Supplier Contracts and not entered for Submit Supplier Contract. Value will not be persisted if entered.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="15"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Compound_Period_Reference" type="wd:Frequency_BehaviorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Compound Period</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Compound Period is not applicable to your contract type</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Frequency_Reference" type="wd:Frequency_BehaviorObjectType">
<xsd:annotation>
<xsd:documentation>Payment Frequency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Use a payment frequency that is available for use with supplier invoice schedules using lease contract types.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your lease contract type requires payment frequency of monthly or greater.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your contract term must be greater than your payment frequency. Example: You can't create a contract that's 2 months in length with a quarterly payment frequency.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="First_Payment_Installment_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>First Payment Installment Date. Input the first payment installment date, including rent free installment periods, which are not prepaid lease payments made prior to the contract start date.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You must input a First Payment Installment Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>First Payment Installment Day is not applicable to this Supplier Contract Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your First Payment Installment Date must be between your Contract Start and Contract End dates.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>When you select the Additional Payment checkbox, we include additional installment to the payment information grid</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify T on the Additional Payment field when you create a lease-type supplier contract with a variable payment schedule. You can only add an additional payment when Workday doesn't generate the correct number of payment installments on your expense recognition schedule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Interest_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Interest Rate (%)</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Interest Rate is not applicable to your contract type</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must input an interest rate for your lease contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your Interest Rate must be below 100</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Fixed_Payment_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Fixed Payment Amount to apply to each installment of the Lease Contract.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Fixed Payment Amount is required for your contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter Fixed Payment Amount with this contract type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lessor_Incentive" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Initial Incentive for the Lessor under this contract, if any.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Lessor Incentives is not applicable to short term operating leases.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must input the Lessor Incentive as an absolute value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Initial_Direct_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Initial Direct Cost for the Lessor under this contract, if any.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Initial Direct Costs is not applicable to short term operating leases.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Negative value not allowed for Initial Direct Cost: [Initial Direct Cost]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Accounting_Method_Reference" type="wd:Lease_Accounting_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Accounting Method for the Lease Contract. Controls which information is required for the contract and the eventual accounting generated by downstream transactions.Straight Line Expense: ACCOUNTING_METHOD_SL_EXPROU Asset Operating Expense: ACCOUNTING_METHOD_ROU_OPEXROU Asset Depreciation Expense: ACCOUNTING_METHOD_ROU_DEPEX</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Your contract type requires an accounting method</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Accounting Method is not applicable to your contract type</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select an accounting method of ROU Asset Operating Expense or Straight Line Expense if your contract type is operating lease, and doesn't allow you to receive contract lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select an accounting method of ROU Asset Depreciation Expense if your contract type is operating lease, and does allow you to receive contract lines.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Automatically_Generate_Supplier_Invoice_Schedule_And_Installments" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Automatically Generate Supplier Invoice Schedule And Installments</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Automatically_Generate_Expense_Recognition_Schedule_And_Installments" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Automatically Generate Expense Recognition Schedule And Installments</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Recognition_Method_Reference" type="wd:Schedule_Distribution_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense Recognition Method for the lease contracts. Determines the method through which Expense Recognition schedule will be generated</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an Expense Recognition Method on your lease type supplier contracts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Expense Recognition Method only applies to lease type supplier contracts</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter Number of Days or Spread Even as your Expense Recognition Method.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid_Lease_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Lease Contract has been prepaid and whether the prepaid amount should be included as part of the ROU Asset value.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Prepaid Lease Payment is not applicable to your contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select Prepaid Lease Payment to enter a prepaid lease payment date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid_Lease_Payment_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The prepaid lease payment date is required for prepaid leases with fixed payment type. The prepaid date must be before the lease contract start date and no earlier than 1 year before the lease contract start date.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Workday automatically provides the prepaid lease payment date based on information you enter into your payment lines</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If you select Prepaid Lease Payment, you must enter a Prepaid Lease Payment Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your prepaid lease payment date must be within a year of the contract start date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your prepaid lease payment date must be on or before the contract start date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Number_of_Payments" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Number of Payments. This field is to be returned for Get Supplier Contracts and not entered for Submit Supplier Contract. Value will not be persisted if entered.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Interest" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Interest. This field is to be returned for Get Supplier Contracts and not entered for Submit Supplier Contract. Value will not be persisted if entered.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lease_Liability_-_Read_Only" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Workday automatically calculates the Lease Liability value based on the information provided and entered data in this field will be ignored.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Lease Liability is not applicable to your contract type</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="ROU_Asset_-_Read_Only" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Workday automatically calculates the ROU Asset Value based on the information provided and entered data in this field will be ignored.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>ROU Asset field is not applicable for your contract type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Lease_Payments_-_Read_Only" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Workday automatically calculates the value of Total Lease Payments based on information you provide and entered data in this field will be ignored.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Non_Effective_Dated_Web_Service_Additional_DataType">
<xsd:annotation>
<xsd:documentation>Non Effective Dated Web Service Additional Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Counting_Attributes_DataType">
<xsd:annotation>
<xsd:documentation>Attributes related to Inventory Count for the Site/Item combination.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Enter a valid Inventory ABC Classification</xsd:documentation>
<wd:Validation_Message>Enter a valid Inventory ABC Classification</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Inventory_ABC_Classification_Reference" type="wd:Inventory_ABC_ClassificationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Inventory ABC Classification for the Site and Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_in_Count" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The option of including Count</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Order Request References</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Change_Order_Reference" type="wd:Purchase_Order_Change_OrderObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Utilize the following element to find purchase order change orders in the Workday system.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Purchase Order References</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Order Response Group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the attachment data within Purchase Order Change Order Data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Purchase_Order_Change_Orders_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter for getting Purchase Order Change Order data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Purchase_Order_Change_Order_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Order Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Purchase_Order_Change_Order_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Orders Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Order Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Purchase_Order_Change_Order_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Order Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_OutboundType">
<xsd:annotation>
<xsd:documentation>Element containing all Purchase Order Change Order data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Change_Order_Reference" type="wd:Purchase_Order_Change_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Change_Order_Data" type="wd:Purchase_Order_Change_Order_Outbound_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Change Order Data and Lines on the Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_Response_DataType">
<xsd:annotation>
<xsd:documentation>Get Purchase Order Change Orders Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Change_Order" type="wd:Purchase_Order_Change_Order_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all Purchase Order Change Order data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Purchase_Order_Change_Orders_ResponseType">
<xsd:annotation>
<xsd:documentation>Get Purchase Orders Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Purchase_Order_Change_Order_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Purchase_Order_Change_Order_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Purchase_Order_Change_Order_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Purchase_Order_Change_Order_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_Change_Order_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Change Order reference for update and all Purchase Order Change Order Item</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This Web Service is set to Add Only. A new change order cannot be created when there is already an active change order.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Change_Order_Reference" type="wd:Purchase_Order_Change_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Change Order for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Change_Order_Data" type="wd:Purchase_Order_Change_Order_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update to the change order</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_Change_Order_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Submit Purchase Order Change Order Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Change_Order_Reference" type="wd:Purchase_Order_Change_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Change Order Data and the Lines to be Changed</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Change Order cannot be created because Purchase Order is not issued.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field Buyer is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Prepaid Amortization Type has value but there is no prepaid line(s), either remove Prepaid Amortization Type or enter prepaid line(s).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Use Prepaid Posting Rules for Receipt Accruals is only allowed if the Prepaid boolean is set.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The expected amortization date is only allowed if prepaid amortization type is "Manual". It must also take place in the future.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a valid Issue Option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Due Date cannot be before the Purchase Order Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field Document Date is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If there are Freight Charges, then there must be at least one line with a Spend Category that has Allocate Freight.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If there are Other Charges, then there must be at least one line with a Spend Category that has Allocate Other Charges.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Tax Amount must be positive if the Tax Option is 'Enter Tax Due to Supplier'.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter a tax amount in the header if you select Enter Tax Due to Supplier as the tax option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select a tax applicability with a default tax recoverability. The default tax recoverability that you specify must be Nonrecoverable and Allocates Nonrecoverable Tax.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Override Payment Type Reference provided is not an acceptable payment type for the Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Change Order cannot be created for this Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't update this Change Order because it is not in a valid state for update.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select at least one line for retention if percent to retain is entered</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Purchase Order Date that is within the supplier contract's effective date range.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change or remove the supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't add a supplier contract if an active invoice exists.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency for the Purchase Order must match the Currency for the Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The supplied Supplier Contract is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract selected must be for the Supplier on the purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract referenced cannot be an Amendment or History.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Issue Email Wrapper Data may not be specified when the Purchase Order Issue Option is not Email.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Make sure Enable Healthcare Options in Tenant Setup - Financials is selected and the designated Purchase Order Type supports Procedure Information.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Prepaid and Retention fields aren't supported on Bill Only purchase order change orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Document Link URL entered does not comply with URL restrictions set for this Field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t enter service lines on consignment change orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't set retention or prepaid terms on a consignment change order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't specify a third party tax code in the transaction tax code reference.</xsd:documentation>
<wd:Validation_Message>You can't specify a third party tax code in the transaction tax code reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You selected an invalid supplier contract for this purchase order. Select a supplier contract that's valid for the company, supplier, and document date; not undergoing an amendment; and supports manual purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter the original External Reference Number on the purchase order. You can't change the External Reference Number value.</xsd:documentation>
<wd:Validation_Message>Enter the original External Reference Number on the purchase order. You can't change the External Reference Number value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't create service lines for External Warehouse type purchase orders.</xsd:documentation>
<wd:Validation_Message>You can't create service lines for External Warehouse type purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a total extended amount that's greater than or equal to zero. The sum of all lines can't be negative.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't cancel the last open purchase order line. An open goods or service line is required on the change order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You submitted a reason code that doesn't exist.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't submit a change order with a purchase order type that is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Down payment term cannot be less than sum of down payment invoice(s) already created.</xsd:documentation>
<wd:Validation_Message>Down payment term cannot be less than sum of down payment invoice(s) already created.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Select at least one line for a down payment if you enter a percent or down payment amount.</xsd:documentation>
<wd:Validation_Message>Select at least one line for a down payment if you enter a percent or down payment amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If at least one line has down payment, you must enter a percent or an amount.</xsd:documentation>
<wd:Validation_Message>If at least one line has down payment, you must enter a percent or an amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't create a change order with down payment terms if you have worktag balancing enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a purchase order type that has the same configuration as the current purchase order type. For example, if the original purchase order type was marked Bill Only, you can’t remove it from the purchase order change order.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order to be changed</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Change Order Reference and Purchase Order Reference do not match.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The purchase order failed custom validations.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Change Order ID. This is the Purchase Order Change Order unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft. If Purchase Order Issue Option is External, the Purchase Change Order will automatically be submitted and marked as Issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Reason_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference to a Change Order Reason code that describes the change performed by the change order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Reason_Comments" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comments that describe the change performed by the change order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing tenanted Purchase Order Type in the system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an External Purchase Order Number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date of the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acknowledgement_Expected" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if this Purchase Order is expecting a POA</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The acknowledgement expected flag is not allowed when it is turned off in the tenant.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a positive Freight Amount value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Other_Charges" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Other Charges</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a positive Other Charges value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference for the Payment Terms associated with the Purchase Order. The Payment Terms will be defaulted if one is specified for the Supplier specified on the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Override Payment Type acceptable for the Supplier referenced on the Purchase Order. If provided, it must be a valid payment type for the Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Terms Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Instruction" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipping Instruction Data on Purchase Order Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_Contract_BaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order_From_Supplier_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Order-from Connection tied to an existing Supplier supplying the goods.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Read only field. This is the currency reference on the purchase order.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The currency on the Change Order must match the currency on the original purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Option_Reference" type="wd:Tax_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Option.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Issue Option. If Purchase Order Issue Option is External, the Purchase Order Change Order will automatically be submitted and marked as Issued.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase Order Issue Option "External" may only be used on new or Draft Purchase Orders.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Email_Replacement_Data" type="wd:Default_PO_Issue_Email_Replacement_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default PO Issue Email Replacement Data allows the user to change the Supplier PO Issue Email on the Purchase Order Change Order. If the element is omitted, no changes are made. If the element is supplied then the Supplier PO Issue Emails are updated with the emails specified in this element's subelements. If none are specified, the Supplier PO Issue Email is cleared.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named buyer for the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Address_Data" type="wd:Bill_To_Address_Reference_for_Change_Order_WSType" minOccurs="0"/>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Data" type="wd:Ship_To_Address_ReferenceType" minOccurs="0"/>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Link for Purchase Order Change Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text describing the purpose of the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for internal notes that cannot be viewed by the supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_To_Retain" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent to Retain for Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Retention_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Estimated Retention Release Date for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Third_Party_Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>3rd Party Retention for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention Memo for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment_Terms" type="wd:Down_Payment_Terms_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Down Payment Terms for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepayment_Release_Type_Reference" type="wd:Prepaid_Amortization_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Prepaid Amortization Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expected_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Expected Amortization Date is used when the Prepaid Amortization Type is set to "Manual"</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Prepaid_Posting_Rules_for_Receipt_Accruals" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use Prepaid Accounting Posting Rules for Receipt Accruals option.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procedure_Information_Data" type="wd:Procedure_Information_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Procedure Information associated with the Bill Only Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Goods_Line_Data" type="wd:Change_Order_Item_Order_Line_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Change_Order_Service_Line_Data" type="wd:Change_Order_Service_Order_Line_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_And_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Change_Order_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Change Order Data and Lines on the Change Order</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Change Order ID. This is the Purchase Order Change Order unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A unique Workday system generated Purchase Order Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order_Version" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Change Order Version</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Change_Order_Reason_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference to a Change Order Reason code that describes the change performed by the change order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Reason_Comments" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comments that describe the change performed by the change order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Change Order Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier supplying the goods or services for the Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Type in the system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an External Purchase Order Number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order_From_Supplier_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Order-From Supplier Connection.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date of the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acknowledgement_Expected" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if this Purchase Order is expecting a POA</xsd:documentation>
</xsd:annotation>
</xsd:element>
