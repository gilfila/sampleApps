</xsd:annotation>
</xsd:element>
<xsd:element name="Multiply_Result_by_Quantity_" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag indicating if the quantity entered on the expense report line is a factor in the adjustment calculation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Passenger_DataType">
<xsd:annotation>
