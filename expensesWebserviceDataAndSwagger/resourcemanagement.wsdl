<xsd:documentation>All expense items linked to the rate table.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Rate_Table_Effective_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Effective Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
