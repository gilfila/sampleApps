<xsd:documentation>Contains a reference to the withholding tax status. This describes how the business entity is classified in taxation for a given location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>If true, Workday deletes the tax status.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Tax_Status_Widget_DataType">
<xsd:annotation>
<xsd:documentation>Tax Status Widget Element to include Tax Status information</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>If Delete is set to true, Replace All must be set to false in Tax Status Widget Data.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, Replace All must be set to false in Tax Status Widget Data.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Tax_Status_Data" type="wd:Tax_Status_WWS_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Tax Status Data WWS element to specify 1 or more Tax Statuses for a company.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Replace_All" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Replace All boolean to replace (True) or update (False) Tax Status information for a Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Intermediary_Bank_Account_DataType">
<xsd:annotation>
<xsd:documentation>Intermediary Bank Account information including Order, Bank Account Type, Currency, Routing Transit Number, etc.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Support for submitting intermediary bank accounts is only on the Put Ad Hoc Payee, Submit Supplier and Submit Customer web services.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a primary intermediary bank address.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify only 1 intermediary bank address as primary.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Business for Type. Business is the only valid value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify the same country for the intermediary bank account and the associated intermediary bank addresses.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Country field is required for this bank account</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must specify a valid Intermediary Bank Account ID with reference to Settlement Bank Account if Delete flag is set to be true. (ID for Intermediary Bank Account:[ID])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid IBAN number.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For addresses on settlement or intermediary bank accounts, specify Remit To in the Use For and Use For Tenanted fields.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an IBAN in uppercase characters without spaces.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
