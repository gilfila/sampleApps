</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Purchase Order Provided may not be canceled because it is closed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Purchase Order provided may not be canceled because it is Pending Close.</xsd:documentation>
