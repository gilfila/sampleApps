<xsd:element name="Supervisory_Organization_Reference" type="wd:OrganizationObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Supervisory Organization to search for Payroll Timesheets Total Hours in.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Workers to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date which specifies to find timesheets that start on or after this date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date which specifies to find timesheets that start on or before this date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Timesheet_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to status to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period_Reference" type="wd:PeriodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Periods to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Time_In_Time_Out_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Get Payroll Timesheets Time In Time Out response. If this element is not included then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Payroll Timesheet Time In Time Out Reference data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Payroll_Timesheets_Time_In_Time_Out_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level wrapper element for Payroll Timesheet Time In Time Out "Get" operations.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Payroll_Timesheet_Time_In_Time_Out_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Payroll_Timesheet_Time_In_Time_Out_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Payroll_Timesheet_Time_In_Time_Out_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Time_In_Time_OutType">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes a reference to the timesheet and all the data for the timesheet.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Time_In_Time_Out_Reference" type="wd:Payroll_Timesheet_Time_In_Time_OutObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to this timesheet object.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Time_In_Time_Out_Data" type="wd:Payroll_Timesheet_Time_In_Time_Out_Data_WWSType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Time_In_Time_Out_Response_DataType">
<xsd:annotation>
<xsd:documentation>A wrapper element that contains all the Payroll Timesheet Time In Time Out objects returned by the web service for the criteria and/or references provided.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Time_In_Time_Out" type="wd:Payroll_Timesheet_Time_In_Time_OutType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Payroll_Timesheets_Time_In_Time_Out_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Payroll Timesheet Time In Time Out response elements including echoed request data and request result.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Payroll_Timesheet_Time_In_Time_Out_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Payroll Timesheet Time In Time Out Request References element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Payroll_Timesheet_Time_In_Time_Out_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Payroll Timesheet Time In Time Out Request Criteria element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Payroll_Timesheet_Time_In_Time_Out_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Payroll Timesheet Time In Time Out Response Group element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Payroll_Timesheet_Time_In_Time_Out_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Time_In_Time_Out_Data_WWSType">
<xsd:annotation>
<xsd:documentation>Encapsulates all the data for a Payroll Timesheet Time In Time Out. Contains the ID, Time Zone, Worker, Period, and all the time tracking information for each day on the timesheet.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Time_In_Time_Out_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>ID for the Payroll Timesheet Time In Time Out. This is a unique identifier for this timesheet.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing and canceling the timesheet inside the Workday application. Timesheet can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_Zone_Reference" type="wd:Time_ZoneObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the time zone specified on the timesheet.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference for the Worker this timesheet is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period_Reference" type="wd:PeriodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Period this timesheet is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Day_Time_In_Time_Out_Replacement_Data" type="wd:Payroll_Timesheet_Day_Time_In_Time_Out_WWSType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Day_Time_In_Time_Out_WWSType">
<xsd:annotation>
<xsd:documentation>This element encapsulates a day tracked on a timesheet. It contains 0 or more "Payroll Timesheet Day Time In Time Out Hours" representing intervals of time worked and tracked against specific time codes.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date for this day being tracked on the timesheet.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The date for the day on the timesheet must be within the date range of the Period selected.</xsd:documentation>
<wd:Validation_Message>The date for the day on the timesheet ([timesheet day date]) must be within the date range of the Period selected: [period start] to [period end]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Day_Time_In_Time_Out_Hours" type="wd:Payroll_Timesheet_Day_Time_In_Time_Out_Hours_WWSType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Day_Time_In_Time_Out_Hours_WWSType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates one interval of time worked within a day on a Time In Time Out timesheet, including the Time In, Time Out, Time Code, and Memo.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The time interval specified by Time In and Time Out cannot overlap with a time sequence on a current or previously entered Timesheet.</xsd:documentation>
<wd:Validation_Message>The time sequence entered for [time in] and [time out] overlaps with a time sequence on the current Timesheet.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Time In cannot be later than Time Out</xsd:documentation>
<wd:Validation_Message>Time In cannot be later than Time Out</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Time_In" type="xsd:dateTime" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Time In (starting time) for this work interval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_Out" type="xsd:dateTime" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Time Out (ending time) for this work interval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Time_Code_Reference" type="wd:Time_Entry_CodeObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the Time Code for this work interval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Time Code selected must be used by Earnings.</xsd:documentation>
<wd:Validation_Message>Time Code selected must be used by Earnings.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional Memo for the work interval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_Hours_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>This element is a wrapper containing references to Payroll Timesheet Total Hours.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Total_Hours_Reference" type="wd:Payroll_Timesheet_Total_HoursObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Payroll Timesheet Total Hours.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_Hours_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>This element contains the search criteria to use to find Payroll Timesheets Total Hours. Criteria include Supervisory Organization, Worker, Timesheet Status, and Period.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supervisory_Organization_Reference" type="wd:OrganizationObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Supervisory Organization to search for Timesheets in.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Workers to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date to find Timesheets with a Period that starts on or after the date specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date to find Timesheets with a Period that starts on or before the date specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Timesheet_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to status to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period_Reference" type="wd:PeriodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Periods to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_Hours_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Get Payroll Timesheets Total Hours response. If this element is not included then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Payroll Timesheet Total Hours Reference data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Payroll_Timesheets_Total_Hours_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level wrapper element for Payroll Timesheet Total Hours "Get" operations.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Payroll_Timesheet_Total_Hours_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Payroll_Timesheet_Total_Hours_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Payroll_Timesheet_Total_Hours_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_HoursType">
<xsd:annotation>
<xsd:documentation>This element is a wrapper for a single Payroll Timesheet Total Hours. It contains a reference to the timesheet, and all the data in a sub-element.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Total_Hours_Reference" type="wd:Payroll_Timesheet_Total_HoursObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Payroll Timesheet Total Hours.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Total_Hours_Data" type="wd:Payroll_Timesheet_Total_Hours_Data_WWSType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_Hours_Response_DataType">
<xsd:annotation>
<xsd:documentation>This element is a wrapper containing one sub-element for each Payroll Timesheet Total Hours that was returned by the search criteria in the web service Request.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Total_Hours" type="wd:Payroll_Timesheet_Total_HoursType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Payroll_Timesheets_Total_Hours_ResponseType">
<xsd:annotation>
<xsd:documentation>This element is the top-level wrapper containing all the same data that was on the web service request, as well as the Payroll Timesheets Total Hours that were found from the search criteria.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Payroll_Timesheet_Total_Hours_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Payroll_Timesheet_Total_Hours_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Payroll_Timesheet_Total_Hours_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Payroll_Timesheet_Total_Hours_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Total_Hours_Data_WWSType">
<xsd:annotation>
<xsd:documentation>This element encapsulates all the data associated with a single Payroll Timesheet Total Hours. The data includes the ID, Status, Worker, Period, and additional data for each Line on the timesheet.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Payroll_Timesheet_Total_Hours_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unique ID for this Payroll Timesheet Total Hours.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing and canceling the timesheet inside the Workday application. Timesheet can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the Worker this timesheet is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period_Reference" type="wd:PeriodObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the Period this timesheet covers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Line_Replacement_Data" type="wd:Payroll_Timesheet_Line_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Line_DataType">
<xsd:annotation>
<xsd:documentation>This element encapsulates data for a Payroll Timesheet Line, which contains multiple days' worth of timesheet information. A Payroll Timesheet Line is for one Time Code, a Position, and a Cost Center, and can contain a memo.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Only one Timesheet Line per reporting criteria is permitted.</xsd:documentation>
<wd:Validation_Message>Only one Timesheet Line per reporting criteria is permitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Time_Code_Reference" type="wd:Time_Entry_CodeObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the Time Code for this line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Time Code selected must be used by Earnings.</xsd:documentation>
<wd:Validation_Message>Time Code selected must be used by Earnings.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cost_Center_Reference" type="wd:Cost_CenterObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Cost Center this line is being tracked to.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Position_Reference" type="wd:PositionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Position for this line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Position for the Timesheet line must be a valid position for the Worker on the Timesheet effective as of the Timesheet Period's End Date. The Position field is ignored if multiple positions is not configured in Tenant Setup, or if the Worker only has one assigned position.</xsd:documentation>
<wd:Validation_Message>The Position for the Timesheet line must be a valid position for the Worker on the Timesheet effective as of the Timesheet Period's End Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional memo for the Timesheet line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payroll_Timesheet_Day_Total_Hours_Data" type="wd:Payroll_Timesheet_Day_Total_Hours_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Payroll_Timesheet_Day_Total_Hours_DataType">
<xsd:annotation>
<xsd:documentation>This element encapsulates data for a single Payroll Timesheet Day. It contains the date of the day being tracked, and the total hours worked.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The date for the day on a Timesheet Line must be unique to other dates on the same Timesheet Line.</xsd:documentation>
<wd:Validation_Message>The date for the day on a Timesheet Line must be unique to other dates on the same Timesheet Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Timesheet_Day_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date this day contains hours for.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The date for the day on the timesheet must be within the date range of the Period selected.</xsd:documentation>
<wd:Validation_Message>The date for the day on the timesheet ([timesheet day date]) must be within the date range of the Period selected: [period start] to [period end]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hours_Worked" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total hours worked on this day.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Encapsulates references to Project Timesheet</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Timesheet_Reference" type="wd:Project_TimesheetObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References specified to instances of Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Project Timesheet Request Criteria</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supervisory_Organization_Reference" type="wd:OrganizationObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Supervisory Organization to search for Timesheets in.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Workers to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date to find Timesheets with a Period that starts on or after the date specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date to find Timesheets with a Period that starts on or before the date specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to status to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period_Reference" type="wd:PeriodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Periods to find timesheets for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Worksheets" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate to exclude Timesheet Types of Project Worksheets. 1 = Exclude Worksheets, 0 = Include Worksheets</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Project_Timesheets_RequestType">
<xsd:annotation>
<xsd:documentation>Get Project Timesheet Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Project_Timesheet_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Encapsulates references to Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Project_Timesheet_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains request criteria that can be specified to find particular instances of Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_TimesheetType">
<xsd:annotation>
<xsd:documentation>Project Timesheet</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Timesheet_Reference" type="wd:Project_TimesheetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to this timesheet object.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Timesheet_Data" type="wd:Project_Timesheet_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulates all the data for a Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_Response_DataType">
<xsd:annotation>
<xsd:documentation>Project Timesheet Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Timesheet" type="wd:Project_TimesheetType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Project_Timesheets_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Project Timesheet response elements including echoed request data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Project_Timesheet_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References specified to instances of Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Project_Timesheet_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Project_Timesheet_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_DataType">
<xsd:annotation>
<xsd:documentation>This element encapsulates all the data associated with a single Project Timesheet.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Period for Project Timesheet must have Period Schedule usage type of Timesheet.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Another Timesheet exists for this Period and Worker. Only one Project Timesheet per Period and Worker is permitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Period can not be changed for an existing Timesheet</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worker can not be changed for an existing Project Timesheet</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please add at least one Timesheet Line</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Existing timesheet is a Project Timesheet, value for Timesheet Type is Project Worksheet must be 0 (false).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Existing timesheet is a Project Worksheet, value for Timesheet Type is Project Worksheet must be 1 (true).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The total hours from all default lines exceed 24 hours.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Timesheet_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unique ID for the Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing and canceling the timesheet inside the Workday application. Timesheet can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Worker this timesheet is for.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Period__Reference" type="wd:PeriodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Period this timesheet covers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Timesheet_Type_is_Project_Worksheet" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate if the Timesheet Type is a Project Worksheet. 1 = Project Worksheet, 0 = Project Timesheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Timesheet_Line_Replacement_Data" type="wd:Project_Timesheet_Line_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_Line_DataType">
<xsd:annotation>
<xsd:documentation>This element encapsulates data for a Project Timesheet Line, which contains multiple days' worth of timesheet information.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Only one worktag for each type is allowed for each timesheet line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only Time Codes not configured for use by earnings can be used for Project Timesheets</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one Line per Timesheet can have the same Time Code and Activity combination.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Customer, Revenue Category, and Sales Item worktag types are not allowed when using a billable time code because these values come from the contract line that the project time will be billed by.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Time_Code_Reference" type="wd:Time_Entry_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Time Code for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Activity_Reference" type="wd:ActivityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Activity for this line. Activity can be a Project or a Project Task.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Project_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Please enter a valid Activity. Since the Time Code is billable, the Activity must be a project task directly assigned to the worker for this Timesheet.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The project or project task is closed for time entry. If you need to enter time for this project or project task, contact the project manager or project administrator for [Task].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worker must be directly or indirectly assigned to an Activity (Project or Project Plan Task) in order to log time against that Activity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Either a shared or direct Resource Plan must exist for the Project in order to log time against the Project or Task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Worktags provided are not valid for this transaction</xsd:documentation>
<wd:Validation_Message>[types] is not valid for a Timesheet. Please use worktags that are valid for a Timesheet.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_Complete" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Decimal value for Proposed Percent Complete of the Project Task selected. This value can be set via the Timesheet under certain condition and is then copied to the Project Task on Approval of the Timesheet.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The value for Percent Complete Proposed can only be set where the Task is not 100% already on the Project and that Task is directly assigned to the worker.</xsd:documentation>
<wd:Validation_Message>The value for Percent Complete Proposed can only be set where the Task is not 100% already on the Project and that Task is directly assigned to the worker.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Proposed Percent Complete Complete cannot be greater than 100%. Percent complete is in decimal format value can not be greater than 1.00.</xsd:documentation>
<wd:Validation_Message>Proposed Percent Complete Complete cannot be greater than 100%. Percent complete is in decimal format value can not be greater than 1.00.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional memo for the Timesheet line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worksheet_Allocation_Percent" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Time allocation percent for a Project Worksheet Line. Indicates the percentage of time an employee spent on an activity for the specific time period. Applies to Project Worksheets only.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="6"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Project_Timesheet_Day" type="wd:Project_Timesheet_Day_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Timesheet_Day_DataType">
<xsd:annotation>
<xsd:documentation>vThis element encapsulates data for a single Project Timesheet Day</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The date for the day on a Timesheet Line must be unique to other dates on the same Timesheet Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date this day contains hours for.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The date for the day on the timesheet ([timesheet day date]) must be within the date range of the Period selected: [period start] to [period end]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a valid activity for the date. The hours you entered are outside the date range for your selected activity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hours" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total hours worked on this day.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Timesheet_RequestType">
<xsd:annotation>
<xsd:documentation>ancel Timesheet Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Timesheet can not be canceled. A Timesheet must be in Draft or In Progress status in order to be canceled. Approved and Denied Timesheets can not be canceled.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Timesheet_Reference" type="wd:TimesheetObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Timesheet</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Project_Timesheet_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cancel_Timesheet_ResponseType">
<xsd:annotation>
<xsd:documentation>Cancel Timesheet Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Timesheet_Reference" type="wd:TimesheetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Canceled Timesheet</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Project_Timesheet_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_Profile_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Travel Profile data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>At least one of the selected business assets is not issued to the selected worker for Travel Profile.</xsd:documentation>
<wd:Validation_Message>At least one of the selected business assets is not issued to the selected worker for Travel Profile.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Worker</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Vehicle_Type_Reference" type="wd:Vehicle_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Vehicle Type. For the selected worker, this vehicle type is the default value for vehicle type on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Reference" type="wd:Business_AssetObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Business Asset allocated to the selected worker.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fuel_Type_Reference" type="wd:Fuel_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Fuel Type. For the selected worker, this fuel type is the default value for fuel type on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Engine_Capacity_Reference" type="wd:Engine_CapacityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Engine Capacity. For the selected worker, this engine capacity is the default value for engine capacity on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Vehicle_Plan_Reference" type="wd:Vehicle_PlanObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Vehicle Plan. For the selected worker, this vehicle plan is the default value for vehicle plan on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Airline_Reference" type="wd:AirlineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Airline. For the selected worker, this airline is the default value for airline on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Car_Rental_Agency_Reference" type="wd:Car_Rental_AgencyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Car Rental Agency. For the selected worker, this car rental agency is the default value for car rental agency on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hotel_Reference" type="wd:HotelObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Hotel. For the selected worker, this hotel is the default value for hotel on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Country_Reference" type="wd:CountryObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Travel Country. For the selected worker, this travel country is the default value for country on an expense report line item detail.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Worker_Travel_Profile_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Expense_Item_Accumulator_Balance_Data" type="wd:Expense_Item_Accumulator_Balance_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Profile_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing reference instances for Travel Profile</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Profile_Reference" type="wd:Unique_IdentifierObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Travel Profile</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Profile_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing Travel Profile request criteria</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Travel_Profile_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Travel Profile response grouping options</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Travel_Profiles_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Travel Profile data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Travel_Profile_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Travel_Profile_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Travel_Profile_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_ProfileType">
<xsd:annotation>
<xsd:documentation>Element containing a set of returned travel profiles and a subelement containing their associated data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Profile_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Worker Travel Profile</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Profile_Data" type="wd:Travel_Profile_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Profile_Response_DataType">
<xsd:annotation>
<xsd:documentation>Element containing the actual Travel Profiles data requested.It contains one element: Travel Profile, which in turn contains the instance set of Travel Profiles which are returned.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Profile" type="wd:Travel_ProfileType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Travel_Profiles_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing the response for the Travel Profile request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Travel_Profile_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Travel_Profile_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Travel_Profile_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Travel_Profile_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing the actual Travel Profiles data requested.It contains one element: Travel Profile, which in turn contains the instance set of Travel Profiles which are returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Worker_Travel_Profile_Attachment_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing all Worker Travel Profile Attachment data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="File" type="xsd:base64Binary" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>File content in binary format.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Comment" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Content_Type">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Content Type of the Attachment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="80"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:attribute>
<xsd:attribute name="Filename">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Filename of the Attachment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="255"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:attribute>
<xsd:attribute name="Attachment_Encoding" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Encoding of the Attachment.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute name="Compressed" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Boolean attribute identifying whether the Attachment is compressed.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Expense_Report_Credit_Card_Transactions_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Expense Credit Card Transaction data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Reference" type="wd:Expense_ReportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense report reference.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The document number that will be assigned to the expense report. Leave it blank to have the number auto-assigned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the person who the expense report is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Line_Credit_Card_Transaction_Data" type="wd:Expense_Report_Line_Credit_Card_Transaction_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Expense_Report_Line_Credit_Card_Transaction_DataType">
<xsd:annotation>
<xsd:documentation>Element containing the expense report line's credit card transaction data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Line_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was incurred.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_Transaction_Reference" type="wd:Credit_Card_TransactionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the expense credit card transaction for the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Posted_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was posted.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The transaction number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_Reference" type="wd:Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the credit card that the expense was paid with.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total amount in the transaction currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Non-Personal_Transaction_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total amount not marked as personal expense in the transaction currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Transaction_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the transaction currency.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Transaction_Billing_Currency_Conversion_Data" type="wd:Credit_Card_Transaction_Billing_Currency_Conversion_DataType" minOccurs="0"/>
<xsd:element name="Market_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The market code for the credit card transaction for the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Corporate_Account_Reference" type="wd:Corporate_Credit_Card_AccountObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The corporate account for the credit card transaction for the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Credit_Card_Transaction_Billing_Currency_Conversion_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all the credit card transaction billing currency conversion data for the expense report line</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Currency_Exchange_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency exchange rate from the transaction currency to the billing currency</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="32"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Billing_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total amount in the billing currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Non-Personal_Billing_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total amount not marked as personal expense in the billing currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Billing_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the billing currency.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Image_DataType">
<xsd:annotation>
<xsd:documentation>Image Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Image_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID of Image</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Filename" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Filename of Image</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="255"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="File" type="xsd:base64Binary" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>File associated with Image</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternative_Text" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specify an image description in the Alternative Text field for workers that use assistive technology. Character limit: 60.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Expense_Report_WWS_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Expense Report Data contains all the information about an Expense Report -.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Report ID. This is the Expense Report unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Payee_Reference" type="wd:Expense_PayeeObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the person who the expense report is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the currency that the expense report will be reported in. This must match the currency for the company.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the company the expense report is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing and canceling the invoice inside the Workday application. Invoice can only be updated from the web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The document number that will be assigned to the expense report. Leave it blank to have the number auto-assigned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense report was created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Approval_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense report was approved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The status of the expense report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Check_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Budget Check Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Committee_Reference" type="wd:CommitteeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Returns the Committee if Expense Payee is an External Committee Member</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Job_Application_Reference" type="wd:Job_ApplicationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Job Application Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Purpose_Reference" type="wd:Business_PurposeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the business purpose for the expense report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>READ ONLY. The total amount of the expense report.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Expense_Report_Total_Reimbursement_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total reimbursement amount of the expense report.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Cash_Advance_Applied_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total cash advance applied amount for the expense report.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Prior_Balance_Applied" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Prior Balance Applied from this Expense Report to a negative reimbursable Expense Report.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Payment_Type_Reference" type="wd:Payment_TypeObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the payment type for the expense report. This is how the expense payee will be paid.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Authorization_Reference" type="wd:Spend_AuthorizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the spend authorization that gives pre-approval for the expense report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Final_Expense_Report_for_Spend_Authorization" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True if this is the Final Expense Report to be used with the related Spend Authorization</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the supplier of the person who the expense report is for if that person is a contingent worker.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text describing the use and purpose of the expense report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Parent_Expense_Report_Reference" type="wd:Expense_ReportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Parent Expense Report for this Expense Report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Child_Expense_Reports_Reference" type="wd:Expense_ReportObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Child Expense Reports for this Expense Report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Lines_Reference_Data" type="wd:Expense_Report_Line_WWS_Outbound_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Expense_Report_Line_WWS_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all data for 1 expense report line (date, credit card, credit card transaction, expense item, quantity, amount, currency, currency rate, converted amount, receipt included, billable, worktags, expense item attributes).</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Line_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was incurred.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Booking_Record_Reference" type="wd:Travel_Booking_RecordObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the travel booking record where the expense was reported.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Expense_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the credit card that the expense was paid with. This can only be used for credit cards that require manual entry.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_Transaction_Reference" type="wd:Credit_Card_TransactionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the credit card transaction where the expense was reported. This cannot be used at the same time as the credit card reference or the mobile expense reference.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Mobile_Expense_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the mobile expense where the expense was reported. This cannot be used at the same time as the credit card reference or the expense credit card transaction reference.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Reference" type="wd:Item_DescriptorObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the expense item the expense is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit cost for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount for Expense Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the currency the expense was incurred in. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion rate between the currency the expense was incurred in and the currency the expense will be reported in. This cannot be used if you are entering the converted amount. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="27"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount the expense is converted to if it was incurred in a different currency. This cannot be used if you are entering the currency rate. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount to report for the expense. This will only be used for viewing.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Itemized_Lines_Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total amount of the converted amounts for the itemized lines. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Included" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not a receipt is included.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Personal_Expense" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense was for personal use.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is billable.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense Report Line Override Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text describing the use or purpose of the expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Available_Spend_Authorization_Line_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Spend Authorization Line to be linked to the Expense Report Line. Only applicable if Commitment Accounting is enabled for the company.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Send_Back_Reason_For_Line" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reason for sending back this Expense Report Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Details_Data" type="wd:Expense_Report_Line_Detail_DataType" minOccurs="0"/>
<xsd:element name="Itemized_Expense_Report_Lines_Data" type="wd:Itemized_Expense_Report_Line_WWS_Outbound_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Reimbursement_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount that represents reimbursement amount in the reimbursement currency. This field is READ ONLY.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Reimbursable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense is reimbursable.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Itemized_Expense_Report_Line_WWS_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all data for 1 itemized expense report line (date, expense item, quantity, amount, tax amount, currency, currency rate, converted amount, receipt included, billable, worktags, expense item attributes).</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Line_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Report Line Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Line_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the expense was incurred.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Reference" type="wd:Item_DescriptorObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the expense item the expense is for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit cost for the expense report line. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Applicability.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The tax amount to report for the expense. The tax code is defined on the itemized line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the currency the expense was incurred in. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion rate between the currency the expense was incurred in and the currency the expense will be reported in. This cannot be used if you are entering the converted amount. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="27"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount the expense is converted to if it was incurred in a different currency. This cannot be used if you are entering the currency rate. Leave blank if you are entering a credit card transaction.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount to report for the expense. This will only be used for viewing.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Included" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not a receipt is included.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Personal_Expense" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag that represents whether or not the expense was for personal use.</xsd:documentation>
</xsd:annotation>
</xsd:element>
