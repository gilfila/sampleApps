<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Adjustment_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Header level comment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Reference" type="wd:ReceiptObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Receipt being Adjusted by Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Ship_Notice_Reference" type="wd:Advanced_Ship_NoticeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tracking_Number_Data" type="wd:Tracking_Number_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Tracking Number recorded on Receipt.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Order_Ref" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Reference recorded on Receipt Adjustment.This field is outbound only; any data submitted will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Ref" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Reference recorded for Receipt Adjustment. This field is outbound only; any data submitted will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_of_Lading_for_Receipt" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill of Lading recorded on Receipt Adjustment. This field is outbound only; any data submitted will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_of_Lading_Quantity_for_Receipt" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill of Lading Quantity recorded on Receipt Adjustment. This field is outbound only; any data submitted will be ignored.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="20"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Currency used in Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_by_Person_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Person that created the Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Document Status of the Receipt Adjustment. This field is outbound only; any data submitted will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Receipt_Line_Data" type="wd:Receipt_Adjustment_Item_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing data for Item Receipt Adjustment Line data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Receipt_Line_Data" type="wd:Receipt_Adjustment_Service_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing data for Service Receipt Adjustment Line data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_with_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Receipt_Adjustment_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Receipt Adjustment response grouping options</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Receipt_Adjustment_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Receipt Adjustment Information</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Adjustment" type="wd:Receipt_AdjustmentType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Receipt_Adjustment_ResponseType">
<xsd:annotation>
<xsd:documentation>Cancel Receipt Adjustment Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cancel_Receipt_Adjustment_Reference" type="wd:Receipt_AdjustmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cancel_Receipt_Adjustment_RequestType">
<xsd:annotation>
<xsd:documentation>Cancel Receipt Adjustment Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This receipt adjustment cannot be cancelled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Procurement Conditional Rules prevent this Receipt Adjustment from being Canceled.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Adjustment_Reference" type="wd:Receipt_AdjustmentObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Receipt_Adjustment_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Receipt Adjustment Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Adjustment_Reference" type="wd:Receipt_AdjustmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Receipt Adjustment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Receipt_Adjustment_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Receipt Adjustment reference for update, and all Receipt Adjustment data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted. This may happen if you have if you have both the Add Only flag on and pass in a Receipt Adjustment Reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Receipt Adjustment is not in Draft Status so it cannot be submitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Adjustment_Reference" type="wd:Receipt_AdjustmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Receipt Adjustment</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either Receipt Adjustment Reference or Receipt Reference are required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Receipt_Adjustment_Data" type="wd:Receipt_Adjustment_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Receipt Adjustment data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update. If an existing instance is found and this flag is set there will be an error.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Receipt_Adjustment_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Receipt Adjustment data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Reference" type="wd:ReceiptObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Receipt being Adjusted by Receipt Adjustment</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Receipt provided is not eligible for Adjustment</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Receipt_Line_Data" type="wd:Receipt_Adjustment_Item_LineType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all editable fields for Receipt Adjustment Item Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Item Receipt Line References must be unique.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Receipt_Line_Data" type="wd:Receipt_Adjustment_Service_LineType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all editable fields for Receipt Adjustment Service Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Service Receipt Line References must be unique.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Receipt_Adjustment_Item_LineType">
<xsd:annotation>
<xsd:documentation>Element containing all editable fields for Receipt Adjustment Item Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>There is not enough quantity to perform the adjustment for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a conversion factor between ordering and stocking quantities to complete the adjustment for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an adjustment quantity that is a whole number for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t complete an adjustment with duplicate items, units of measure, or stocking locations for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must link a purchase item to the catalog item before you complete the adjustment for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t submit Lot and Serial Data for multiple Lots/Stocking locations or Serial coming from Put Away for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Lot Number is required for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Total Lot Quantity does not match Actual Quantity Received for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Serial Number is required for [Item Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The item from the Receipt Line [line] isn’t eligible for Receipt Adjustment because the Conversion Factor on Inventory Transaction Unit of Measure has been changed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a receipt quantity that, when combined with quantity already received, isn’t greater than the purchase order quantity for this purchase order type: [order type].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Line_Reference" type="wd:Unique_IdentifierObjectType">
<xsd:annotation>
<xsd:documentation>Receipt Line Reference to be adjusted</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[Receipt Line], is not eligible to be adjusted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[Adjusted quantity not valid based on paid invoices]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Quantity cannot be adjusted for [Receipt Line].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Actual_Quantity_Received" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Actual Quantity Received for this Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Quantity cannot be set to negative value for [Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set the quantity to zero and create a new receipt. You can’t make receipt adjustments for lot or serial controlled items or for multiple stocking locations.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Adjustment_Reason_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Adjustment Reason for this Receipt Adjustment Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Receipt Adjustment Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Line_Lot_Data" type="wd:Receipt_Adjustment_Item_Line_LotType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Receipt Line Item Lot Quantity Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Receipt_Adjustment_Service_LineType">
<xsd:annotation>
<xsd:documentation>Element containing all editable fields for Receipt Adjustment Service Line</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receipt_Line_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receipt Line Reference to be adjusted</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[Receipt Line], is not eligible to be adjusted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[Adjusted amount not valid based on paid invoices]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Amount cannot be adjusted for [Receipt Line]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Actual_Amount_Received" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Actual Amount Received for this Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Amount cannot be set to negative value for [Receipt Line]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Adjustment_Reason_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Adjustment Reason for this Receipt Adjustment Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Receipt Adjustment Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Use this to include or exclude certain pieces of data in the response. This is not currently supported.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include reference or not</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Commodity_Code_Type_ResponseType">
<xsd:annotation>
<xsd:documentation>Response for Put Commodity Code Type</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Commodity_Code_Type_Reference" type="wd:Commodity_Code_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Commodity Code Type updated or created</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_TypeType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Commodity_Code_Type_Reference" type="wd:Commodity_Code_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Commodity Code Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Type_Data" type="wd:Commodity_Code_Type_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Commodity_Code_Type_RequestType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The "Add Only" flag is set, but the Commodity Code Type already exists.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Commodity_Code_Type_Reference" type="wd:Commodity_Code_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Commodity Code Type for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Type_Data" type="wd:Commodity_Code_Type_DataType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Request References</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Commodity_Code_Type_Reference" type="wd:Commodity_Code_TypeObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Commodity Code Type to be retrieved</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_Level_DataType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't change the level length or level order when a commodity code type is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Level_Order" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Commodity Code Type is composed of multiple levels. This attribute indicates the hierarchy order among those levels.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Level_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the level</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Level_Length" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Number of characters in the level</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Commodity_Code_Types_RequestType">
<xsd:annotation>
<xsd:documentation>Commodity Code Types Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Commodity_Code_Type_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Commodity_Code_Type_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Commodity_Code_Type_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_Response_DataType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Commodity_Code_Type" type="wd:Commodity_Code_TypeType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Commodity Code Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Commodity_Code_Types_ResponseType">
<xsd:annotation>
<xsd:documentation>Commodity Code Types Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Commodity_Code_Type_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Commodity_Code_Type_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Commodity_Code_Type_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Commodity_Code_Type_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Commodity_Code_Type_DataType">
<xsd:annotation>
<xsd:documentation>Commodity Code Type Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a length for each level, so that the total level length equals the length for the code type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The same Level Order cannot be used by more than one Commodity Code Type Level.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the number of levels when a commodity code type is already in use.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a unique commodity code type name.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for Commodity Code Type.</xsd:documentation>
</xsd:annotation>
