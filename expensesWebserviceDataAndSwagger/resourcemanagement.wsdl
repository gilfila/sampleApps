</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:Project_AbstractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Project_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
