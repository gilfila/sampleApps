<xsd:complexType name="Project_Portfolio_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Project Portfolio WWS Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a parent project portfolio that you have access to that isn’t itself or a child of this project portfolio.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a parent project portfolio.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the reporting currency of a project portfolio if it or any of the children have a funding amount assigned.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency should match the parent project portfolio.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Your End Date must be after the Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a currency or specify a parent project portfolio.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a Funding Status of Approved, Awaiting Review, Denied, or Draft.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You don't have permission to update this project portfolio.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Project Portfolio Owner you entered is invalid. Enter an active worker with a primary employment position or profile view, and that you have access to.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
