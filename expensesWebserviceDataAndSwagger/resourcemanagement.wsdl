<xsd:documentation>Bill To Address for RFQ Award PO Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
