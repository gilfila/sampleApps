</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Invoice_Types_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level request element for all Invoice Type "get" operations.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Invoice_Type_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Invoice Type Request Reference element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Invoice_Type_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Invoice Type Request Criteria element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Response Filter element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Invoice_Type_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Invoice Type Response Group Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Invoice_Type_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Invoice Type response. If this element is not included, then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Invoice Type Reference data is to be included in the response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Invoice_Type_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Invoice Type data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Invoice_Type_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Request criteria for retrieving specific Invoice Types.</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Invoice_Type_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>The Invoice Type Request Reference element contains the specific instance containing the requested Invoice Type.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Invoice_Type_Reference" type="wd:Invoice_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Business Object containing the Invoice Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Invoice_Types_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Invoice Type response elements including echoed request data and request result data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Invoice_Type_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the echoed Invoice Type Request Reference element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Invoice_Type_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Invoice Type Request Criteria element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reponse_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Response Filter element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Invoice_Type_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Invoice Type Response Group element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the Invoice Type Response Results element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Data" type="wd:Invoice_Type_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the Invoice Type Response Data element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Invoice_Type_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing Invoice Type response data for requested references or criteria and for requested response group.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Invoice_Type" type="wd:Invoice_TypeType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes Invoice Type instance and data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Invoice_TypeType">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes Invoice Type instance and data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Invoice_Type_Reference" type="wd:Invoice_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Type_Data" type="wd:Invoice_Type_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all of the data related to the Invoice Type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Invoice_Type_DataType">
<xsd:annotation>
<xsd:documentation>Element that encapsulates all of the data related to the Invoice Type.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The combination of the Invoice Type Name and the related Country must be unique.</xsd:documentation>
<wd:Validation_Message>Enter a unique Invoice Type Value. [Value] is already in use for [Country].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Invoice Type is currently in use, you cannot change the country.</xsd:documentation>
<wd:Validation_Message>The Invoice Type is currently in use, you cannot change the country.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Invoice_Type_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Type ID. This is the Invoice Type unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Type_Value" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The name of the Invoice Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Country_Reference" type="wd:CountryObjectType">
<xsd:annotation>
<xsd:documentation>The country for this Invoice Type. Any country is available to choose. This cannot be edited once the Invoice Type is in use.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Type_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The description of the Invoice Type. This is not required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Usage_Location_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The usage location of the Invoice Type. If this is left blank, the Invoice Type will not be available anywhere. Only in the chosen usage locations will the Invoice Type be available for selection.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Type_Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This boolean attribute activates or deactivates the Invoice Type. If an Invoice Type in inactive, it will no longer show up in its usage locations.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Type_In_Use" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This field identifies if the invoice type is in use within Workday. The field is only for informational purposes and is ignored by Workday if it's used to submit data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Service_Lines_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Simple Service Purchase Order Line data. A Purchase Order may have multiple simple service purchase order lines.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for Purchase Order LinecXML Notes:Request/OrderRequest/OrderRequestHeader/ItemOut@quantity</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Line Unit CostcXML Notes:Request/OrderRequest/OrderRequestHeader/ItemOut/ItemDetail/UnitPrice</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Line Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Ship_To" type="wd:Ship_To_Address_for_Issue_Purchase_Order_Outbound_Sub_ViewType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Ship To Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact" type="wd:Ship_To_Contact_Info_for_Issue_Purchase_Order_Outbound_Sub_ViewType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Contains Contact Information (Email, Phone, Fax) for Ship-To of Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The location where the items will be delivered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description as provided by Supplier, or Purchase Order Line Memo if no description is presentcXML Notes:Request/OrderRequest/OrderRequestHeader/ItemOut/ItemDetail/Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UNSPSC_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UNSPSC code as provided by the Supplier or if missing, the start UNSPSC code on the Spend Category UNSPSC range.cXML Notes:Request/OrderRequest/OrderRequestHeader/ItemOut/ItemDetail/Classification@domain[UNSPSC]</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The line number of the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Alternate_Item_Identifier" type="wd:Alternate_Item_Identifier_for_PO_issue_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Adhoc" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Returns True if PO line does not correspond to a Cart Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order Line should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cost_Center_Reference" type="wd:Cost_CenterObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Cost Center on Purchase Order Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Worktags_Data" type="wd:Purchase_Oder_Line_Worktags_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Returns the Worktags on Purchase Order line along with Spend Category, Location and Item (Purchase Item or Catalog Item).</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Invoice_Types_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing the Invoice Type reference for update and all Invoice Type data items.</xsd:documentation>
<xsd:appinfo>
