<xsd:documentation>Search for Receipts Last Updated On or After this Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Last_Updated_Date_On_or_Before" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Search for Receipts last updated On or Before this Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Receipt_Response_GroupType">
