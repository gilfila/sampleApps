<wd:Validation_Message>Bank Account Name is required for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Branch name is required for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Branch ID is required for this country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Country field is required for this bank account</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[digit_format_error_msg]</wd:Validation_Message>
