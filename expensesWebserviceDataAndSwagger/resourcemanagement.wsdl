<xsd:documentation>Contains a reference to the transaction tax status. This describes how the business entity is classified in taxation for a given location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Withholding_Tax_Status_Reference" type="wd:Withholding_Tax_StatusObjectType" minOccurs="0">
