<xsd:documentation>Project Portfolio Request Criteria</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is a unique identifier for Project Portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Portfolio_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text for a meaningful Project Portfolio Name. Project Portfolio Name must be unique.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Parent_Portfolio_Reference" type="wd:Project_PortfolioObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The parent of this project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
