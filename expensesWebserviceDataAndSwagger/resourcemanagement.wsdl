<wd:Validation>
<wd:Validation_Message>This budget line has matching Ledger Account Summaries/Ledger Accounts and Accounting Worktags with another line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Budget Template Line Reference ID. This is the Project Budget Template Line unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Project Budget Template Line Reference that is valid for the Project Budget Template.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ledger_Account_Summary_Reference" type="wd:Financial_Report_GroupObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Ledger Account/Summary to apply to this Project Budget Template Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a Ledger Account or Ledger Account Summary that is valid for the Budget Structure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Neither Ledger Account nor Ledger Account Summary may be specified since Ledger Account is not a Structured Dimension on the Budget Structure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Ledger Account or Ledger Account Summary that is in common with the Account Types specified on the Plan Structure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Ledger Account or Ledger Account Summary.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_Worktag_and_Aggregation_DimensionObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The worktag Budget Dimensions to apply to this Project Budget Template Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can only specify one value for each worktag type per line. These worktag types have multiple values: [worktag type].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify Project, Project Phase, Project Task or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>These worktag types must be included for the specified plan structure: [worktag types].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are lines with inactive worktags. Remove the inactive worktags or select Allow Inactive Worktags on Plan lines on the Plan Structure [budget_structure].Inactive worktags: [values]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify an Employee worktag and a Contingent Worker worktag for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>These worktags aren't valid for the specified plan structure: [worktags].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a value for the Organizing Dimension: [Organization Dimension Type].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Selecting this will cause the referenced Project Budget Template Line to be deleted.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Valid ID must be provided when Delete flag is set.</xsd:documentation>
<wd:Validation_Message>Valid ID must be provided when Delete flag is set.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Delete is set to true, Replace All must be set to false.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, Replace All must be set to false.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
