</wd:Validation>
<wd:Validation>
<xsd:documentation>Confidence level percentage must between 0 and 100.</xsd:documentation>
<wd:Validation_Message>Confidence level percentage must between 0 and 100.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Travel Booking Record matches should only include 1 match of either an Origin City, Destination City, or Merchant (Hotel, Airline, or Car Rental Agency).</xsd:documentation>
