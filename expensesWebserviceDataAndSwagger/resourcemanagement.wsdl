<wd:contextualSecurity>No Information</wd:contextualSecurity>
</wsdl:documentation>
<wsdl:input name="Get_Requisition_Sourcing_RulesInput" message="wd-wsdl:Get_Requisition_Sourcing_Rules_RequestInputMsg"/>
