<xsd:documentation>Receipt Number. Allows for search for a partial sub-string match.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="513"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Receipt_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Receipt Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Receipt Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Receipt Status. Examples of valid statuses are In Progress, Canceled, Approved, Denied</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Creating_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Creating Worker for the Receipt</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
