<xsd:complexType name="Cancel_Expense_Report_RequestType">
<xsd:annotation>
<xsd:documentation>Element encapsulating the reference to the expense report that should be canceled.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>You can't cancel your expense report for project billable lines with a status of Billed, marked To Bill, or Revenue Recognized. Cancel any Billed invoices or Completed Revenue Recognition installments, clear any lines marked To Bill, or both.</xsd:documentation>
<wd:Validation_Message>You can't cancel your expense report for project billable lines with a status of Billed, marked To Bill, or Revenue Recognized. Cancel any Billed invoices or Completed Revenue Recognition installments, clear any lines marked To Bill, or both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot cancel your expense report or lines with an intercompany status of Billed. Cancel any billed intercompany invoices to update the expense report.</xsd:documentation>
<wd:Validation_Message>You cannot cancel your expense report or lines with an intercompany status of Billed. Cancel any billed intercompany invoices to update the expense report.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Project Transaction Adjustment Event is in progress for this expense report. You can't cancel or update the expense report until the event completes.</xsd:documentation>
<wd:Validation_Message>The Project Transaction Adjustment Event is in progress for this expense report. You can't cancel or update the expense report until the event completes.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only certain Expense Reports are cancelable.</xsd:documentation>
<wd:Validation_Message>Expense Report is not cancelable.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
