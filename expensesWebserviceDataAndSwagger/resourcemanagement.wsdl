<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amount]) must equal the extended amount on the procurement card transaction verification line: [amount].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The company on purchase order line [line] doesn't match the company on the verification line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't associate a procurement card verification to supplier contract lines of the type Consignment.</xsd:documentation>
<wd:Validation_Message>You can't associate a procurement card verification to supplier contract lines of the type Consignment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't associate a procurement card verification to purchase order line of the type Consignment or Bill and Replace.</xsd:documentation>
<wd:Validation_Message>You can't associate a procurement card verification to purchase order line of the type Consignment or Bill and Replace.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Tax Applicability Reference is required is Tax Code is specified.</xsd:documentation>
<wd:Validation_Message>Tax Applicability Reference is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select Calculate Self Assessed Tax option</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line Number [po line number] is closed and can't be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Automatic_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Intercompany_Affiliate_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Intercompany Affiliate Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Purchase_Order_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Order Line Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Only Purchase Order Lines for the associated Purchase Order [po] are allowed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If the Procurement Card Transaction Verification is associated with a Supplier Contract, Purchase Order Lines are not allowed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit purchase order lines that aren't in Closed for Receiving status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line_Reference" type="wd:Supplier_Contract_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract Line Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select Supplier Contract Lines that are valid for the Supplier Contract [sc].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If the Procurement Card Transaction Verification is associated with a Purchase Order, Supplier Contract Lines are not allowed.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Item Description</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Line Item Description field should be left blank if an Item is specified.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Spend Category field should be left blank if an Item is specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Spend Category must be used for Procurement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a quantity for procurement card lines when the allocated line value is greater than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a value in the Quantity field for procurement card lines allocating to a service line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a unit of measure for procurement card lines when an allocated line has a unit of measure value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a value in the Unit Of Measure field for procurement card lines allocating to a service line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a unit cost for procurement card lines when an allocated line value is greater than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a value in the Unit Cost field for procurement card lines allocating to a service line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If Quantity or Unit Cost do not equal zero, the Extended Amount must equal Quantity * Unit Cost</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a procurement card transaction verification line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Conversion_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Conversion RateThis information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="24"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Credit_Card_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Credit Card AmountThis information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Converted_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Converted AmountThis information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Credit_Card_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Credit Card Currency ReferenceThis information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Taggable_Type_Reference" type="wd:Taggable_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Taggable Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Company on Procurement Card Transaction Verification line must match Company of Grants Worktag</xsd:documentation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktag types are invalid: [invalid].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Distribution_Method_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Distribution Method Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Business Document Line Split Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Option" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Procurement_Card_Transaction_Verification_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Procurement Card Transaction Verification reference for update and all Procurement Card Transaction Verification data items.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot submit this procurement card transaction verification since the business document is canceled or closed.</xsd:documentation>
<wd:Validation_Message>You cannot submit this procurement card transaction verification since the business document is canceled or closed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot submit this procurement card transaction verification since the intercompany payment is in progress or paid.</xsd:documentation>
<wd:Validation_Message>You cannot submit this procurement card transaction verification since the intercompany payment is in progress or paid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot submit this procurement card transaction verification since there are credit card transactions in paid status and the checkbox 'pay unapproved procurement card transactions' option is unselected.</xsd:documentation>
<wd:Validation_Message>You cannot submit this procurement card transaction verification since there are credit card transactions in paid status and the checkbox 'pay unapproved procurement card transactions' option is unselected.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot submit this procurement card transaction verification since there are accounting adjustments in approved, in progress or draft status.</xsd:documentation>
<wd:Validation_Message>You cannot submit this procurement card transaction verification since there are accounting adjustments in approved, in progress or draft status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Procurement_Card_Transaction_Verification_Reference" type="wd:Procurement_Card_Transaction_VerificationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Procurement Card Transaction Verification for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Card_Transaction_Verification_Data" type="wd:Procurement_Card_Transaction_Verification_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Procurement Card Transaction Verification Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Procurement_Card_Transaction_Verification_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Submit Procurement Card Transaction Verification Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Procurement_Card_Transaction_Verification_Reference" type="wd:Procurement_Card_Transaction_VerificationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Procurement Card Transaction Verification Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Header_RequestType">
<xsd:annotation>
<xsd:documentation>Travel Booking Header Request.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Booking_File_Reference" type="wd:Travel_Booking_FileObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Travel Booking File for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Booking_File_Data" type="wd:Travel_Booking_File_DataType">
<xsd:annotation>
<xsd:documentation>Travel Booking Record Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Record_DataType">
<xsd:annotation>
<xsd:documentation>Travel Booking Record Data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid value for Travel Booking Record Destination Country. Text code should be either 2 character alpha code, 3 character alpha code or a 3 digit numeric code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid value for Travel Booking Record Origination Country. Text code should be either 2 character alpha code, 3 character alpha code or a 3 digit numeric code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ticket Type can only be submitted for travel booking records that relate to air and rail travel.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't update this travel booking record as it's closed: [id]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Travel Booking Record ID. This is the Travel Booking Record unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Employee_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the unique identifier of the Employee that is associated with the Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accountholder_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Accountholder name with the Travel Management Company.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Traveler_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Traveler Name for the Itinerary.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Booking_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date of this Travel Booking Record event.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company of the Employee on the Travel Booking Record</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Booking_Record_Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Import travel booking records as a closed expense.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ticket_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Ticket Number on Travel Booking Record</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Original_Ticket_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Original Ticket Number on Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reissued_Ticket_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reissued Ticket Number on Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Provider" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Identifying name of the Travel management provider.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Itinerary_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Itinerary description from the Travel Management Provider.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Itinerary_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Itinerary description from the Travel Management Provider.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reservation_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reservation number provided for this Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Record_Type_Reference" type="wd:Travel_Booking_Record_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Type of the Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Booking_Status_Reference" type="wd:Booking_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Booking Status of Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fare_Category_Reference" type="wd:Fare_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The fare categories available for use on travel booking records.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ticket_Type_Reference" type="wd:Ticket_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ticket type that's on the travel booking record. The type of fare determines the ticket type - a one-way, round-trip, or multi-destination fare.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Code_Destination" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Destination Location Code for Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Code_Origin" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Origination Location Code for Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Route" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Concatenate codes for this route, with each code representing a destination on the trip and separated by a dash. Example: For airports, SFO-ORD-GRR-DEN-SFO.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Class_Of_Service_Reference" type="wd:Class_of_ServiceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Class Of Service for Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchased" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Status of Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Date of Travel Booking.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_Base_Fare_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Identifies the value of the ticket in source currency. If a pre-existing credit has been applied at time of booking, then the extended amount may be different from the ticket value.Populated for Travel Type Air, Rail, and Other only.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Transaction_Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total amount for this Travel Booking item in source currency. Includes the Tax amount. This may be a refund amount or Fees.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Source_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The total amount paid for the Travel Booking Record, including base fare, tax, fees, and ancillaries.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Source_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
