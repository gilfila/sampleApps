<xsd:documentation>Expense Payee reference for Guest.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Company" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Title" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Title</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File__HV__DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Guest Listing File data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Guest_Listing_File_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Number. This is the Guest Listing File unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Data" type="wd:Guest__HV__DataType" minOccurs="0" maxOccurs="unbounded">
