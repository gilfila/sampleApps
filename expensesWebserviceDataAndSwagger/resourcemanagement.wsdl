</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid_Supplier_Invoice_Lines" type="wd:Supplier_Invoice_Lines_For_Amortization_Schedule_DataType" minOccurs="0" maxOccurs="unbounded"/>
