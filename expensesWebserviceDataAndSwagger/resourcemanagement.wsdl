<xsd:documentation>Preferred Picking Location for this Site for the purchase item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Status_for_Site_Reference" type="wd:Spend_Item_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Item Status for Item Inventory Site.Active: Available for spend transactions for this inventory site.Restricted from Purchasing: Item can't be added to purchase orders for this inventory site. This site can still fulfill requisitions for this item from available stock.Inactive: Item no longer available for use for this inventory site.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either update the item status or the item inventory site status. The current purchase item status doesn't allow for a less restrictive item inventory site status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Just_In_Time" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates if Item-Site is using Just In Time replenishment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Reservations" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item level Reservation Flag. Can only be changed if reservations are enabled for the site. Can be used to disable reservations for an item belonging to a site which uses reservations.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Reservations are disabled for site: [site]. Enable reservations in the site attributes in order to specify reservation settings for this item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are existing pick lists for this site. To make this change, first complete picking or cancel the pick list.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are existing reservations in this site. To make this change, first close or cancel all reservations.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Site_Default_Stocking_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Stocking Unit of Measure Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid Default Stocking Unit of Measure. Enter a valid active stocking unit of measure for the item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Valid_Issue_Units_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References a list of valid issue units of measure</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Valid Issue Units of Measure must be a subset of the Stocking Units of Measure associated with the item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Site_Default_Issue_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References the default issue unit of measure associated with the item/inventory site. It is required if a list of valid issue units of measure is provided.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Default Issue Unit of Measure is required when a list of Valid Issue Units of Measures is specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Default Issue Unit of Measure must be in the list of Valid Issue Units of Measure defined for the Item/Site.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Valid_Stocking_Location_Reference" type="wd:Inventory_Location_EnabledObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>When Valid Stocking Location is empty, all stocking locations for the Item/Site combinations are valid. When you assign a valid stocking location for the Item/Site combinations, Workday only considers those listed here as valid.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Stocking_Location_Reference" type="wd:Inventory_Location_EnabledObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Stocking Location for this Site for the purchase item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fulfillment_Attributes_Data" type="wd:Fulfillment_Attributes_DataType" minOccurs="0"/>
<xsd:element name="Replenishment_Policy_Data" type="wd:Replenishment_Policy_DataType" minOccurs="0"/>
<xsd:element name="Counting_Attributes_Data" type="wd:Counting_Attributes_DataType" minOccurs="0"/>
<xsd:element name="Patient_Chargeable_Reference" type="wd:Patient_ChargeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Patient Chargeable flag. This will be enabled only if Enable Healthcare Option is turned ON at the Edit Tenant Setup- Financials.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Replenishment_Option_Reference" type="wd:Replenishment_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Replenishment Option for this Item/Site combination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_Site_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Replenishment Source Site for this Item/Site combination</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Source Inventory Site for the Replenishment Option of 'Create Transfer Stock Request'.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Replenishment Option of 'Create Transfer Stock Request' for the Source Inventory Site.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_Requisition_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Replenishment Source Requisition Company for this Item/Site combination</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Source Requisition Company is allowed only for Sites having Replenishment Option as [ReplenishmentOption].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Source Requisition Company is required for Inventory Site having Replenishment Option as [ReplenishmentOption].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Source requisition company will need to be setup as inter-company affiliate of the inventory company</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Consigned_Reorder_Option_Type_Reference" type="wd:Consigned_Reorder_InitiationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Consigned Reorder Option Type for Purchase Item and Inventory Site Combination</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Consigned_Stocking_Location_Reference" type="wd:Inventory_Location_EnabledObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Sets the default consigned stocking location for an item in a particular site.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Consigned_Reorder_Point_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set Consigned Reorder Point Quantity.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="20"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Consigned_Maximum_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set Consigned Maximum Quantity.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="20"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Consolidate_Transactions" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set Consolidate Transactions Flag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lot_Control" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set this flag to True if you want to enable Lot Control at Item Inventory Site.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Lot Control setting can't be modified when there is an existing Inventory Transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An Asset Item can't be Lot Controlled.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Serial_Control_Method_Reference" type="wd:Serial_Control_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Set Serial Control Type at Item Inventory Site.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Serial Control Type setting can't be modified when Inventory exists for this item and site</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inbound_Alert_Period_in_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set Inbound Alert Period in Days</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="50"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Outbound_Alert_Period_in_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set Outbound Alert Period in Days</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="50"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Set this flag to True in order to delete Item Inventory Attribute Data.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Fulfillment_Attributes_DataType">
<xsd:annotation>
<xsd:documentation>Attributes related to fulfillment for the Site/Item combination.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Fulfillment_Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead time for the Site/Item combination.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Reference element that contains a specific instance set containing the requested Guest Listing File.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Guest_Listing_File_Reference" type="wd:Guest_Listing_FileObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Instance set containing the Guest Listing File object.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>The Request Criteria element lets you apply additional criteria to identify the specific instance(s) of Guest Listing Files.</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Wrapper element around a list of elements representing the amount of data that should be included in the Guest Listing File response. If this element is not included then ALL of the Response Groups are included in the response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the Guest Listing File Reference Data is to be included in the response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Guest_Listing_Files_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level request element for all Guest Listing Files "Get" operations</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Guest_Listing_File_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Guest Listing File Request Reference Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Guest_Listing_File_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Guest Listing File Request Criteria Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Guest_Listing_File_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element content contains the echoed Guest Listing File Response Group Element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File_WWSType">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes guest instance and data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Guest_Listing_File_Reference" type="wd:Guest_Listing_FileObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes guest instance and data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Number. This is the Guest Listing File unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Guest Listing File Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Data" type="wd:Guest_WWSType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all Guest data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Guest_Listing_File_Data" type="wd:Guest_Listing_File_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Guest Listing File Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Guest_Listing_File_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing Guest Listing Response Data for requested references or criteria and for requested response group.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Guest_Listing_File" type="wd:Guest_Listing_File_WWSType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Wrapper element that includes Guest Listing File instance and data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Guest_Listing_Files_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Guest Listing File response elements including echoed request data and request result data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Guest_Listing_File_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Guest_Listing_File_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Guest_Listing_File_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Guest_Listing_File_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Replenishment_Policy_DataType">
<xsd:annotation>
<xsd:documentation>Attributes related to Replenishment for the purchase item/site combination.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter Replenishment Unit of Measure for Fixed Reorder Quantity Replenishment Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Maximum Quantity that is greater than the Reorder Point Quantity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Replenishment Unit of Measure should be a valid Stocking unit of measure for the item when the inventory site has 'Create Transfer Stock Request' replenishment option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>"No Replenishment" is not a valid Replenishment Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The replenishment unit of measure should be a valid catalog unit of measure for the item when the inventory site has [ReplenishmentOption] replenishment option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Replenishment Unit of Measure must have a value when Replenishment type is Fixed or Min/Max, and Replenishment option is set to Notification Only, Create Stock Request, or Create Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Maximum Target Days on Hand quantity that's greater than the Target Days on Hand quantity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Replenishment_Type_Reference" type="wd:Replenishment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Replenishment type for the specified site for the purchase item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Average_Daily_Usage" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Inventory Average Daily Usage for item</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Preferred_Supplier_Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Preferred Supplier Lead Time for the specified site for the purchase item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Reorder_Point_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reorder point in base UOM.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Quantity must convert into a valid whole number in Base UOM.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must be a whole number for the UOM.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Maximum_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Maximum quantity in base UOM - only applicable if the replenishment policy is min-max.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Quantity must convert into a valid whole number in Base UOM.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must be a whole number for the UOM.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Safety_Stock" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Safety Stock for Replenishment Optimization.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Quantity must convert into a valid whole number in Base UOM.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must be a whole number for the UOM.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Target_Days_on_Hand" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Target Days on Hand for Replenishment Optimization.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Maximum_Target_Days_on_Hand" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Maximum Target Days on Hand for Replenishment Optimization.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Replenishment_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Replenishment Unit of Measure for the policy</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Inventory Replenishment UOM must be an active stocking UOM if JIT option is not selected. If JIT enabled then the UOM must be a valid JIT Unit of Measure.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Economic_Order_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Economic Order Quantity value in the UOM specified by Replenishment Unit of Measure - only applicable if the replenishment policy is Fixed Reorder Quantity.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Quantity must be a whole number for the UOM.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must convert into a valid whole number in Base UOM.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must be more than 0 if Replenishment Type is Fixed Reorder Quantity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Fixed_Reorder_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure for Economic Order Quantity - only applicable if the replenishment policy is Fixed Reorder Quantity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Contact_Information_RequestType">
<xsd:annotation>
<xsd:documentation>This element is used to submit Supplier Contact Information into the system from the web service.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>For Suppliers, the only valid value for Usage Type is Business. The Type Reference in all Usage Data elements must have type="Communication_Usage_ Type_ID" and value of BUSINESS.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Submit Supplier Contact Information for this Supplier is currently in progress. This new Supplier Contact Information cannot be submitted. Try again later after it is finished.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier must be in Approved state to submit Supplier Contact Information.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier Change is currently in Draft or In Progress by someone else. This Supplier Contact Information cannot be submitted. Try again later after it is finished.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier Connection Change for this Supplier is currently in progress. This Supplier Contact Information cannot be submitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType">
<xsd:annotation>
<xsd:documentation>Supplier containing Contact Information</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
