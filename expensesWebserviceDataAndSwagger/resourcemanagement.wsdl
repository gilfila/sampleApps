<xsd:element name="Project_Portfolio" type="wd:Project_PortfolioType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Portfolio</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
