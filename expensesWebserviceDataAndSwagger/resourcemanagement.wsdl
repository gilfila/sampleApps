<xsd:complexType name="Rate_Schedule_DataType">
<xsd:annotation>
<xsd:documentation>Contains the Rate Schedule data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify period ranges that start from period 1 with no overlaps or gaps. We've identified overlaps or gaps around these ranges: [range].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a From Period that is less than or equal to the To Period.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ID of the Rate Schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Rate_Schedule_Name" type="xsd:string">
<xsd:annotation>
<xsd:documentation>The Name of the Rate Schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Rate_Schedule_Line_Data" type="wd:Rate_Schedule_Line_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify depreciation percentages that total 100.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Rate_Schedule_Line_DataType">
<xsd:annotation>
<xsd:documentation>Contains the Rate Schedule Line data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ID of the Rate Schedule Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="From_Period" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Start Period for the range of the Rate Schedule Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="To_Period" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The End Period for the range of the Rate Schedule Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Rate_for_Range__Percent_" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The depreciation percent for the range of the Rate Schedule Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="15"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
