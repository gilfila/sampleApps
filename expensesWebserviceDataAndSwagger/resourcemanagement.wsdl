</xsd:element>
<xsd:element name="Order" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME__Project__Cost_Rate_Rule_Reference" type="wd:Project_Cost_Rate_RuleObjectType">
<xsd:annotation>
<xsd:documentation>Project Rate Rule</xsd:documentation>
</xsd:annotation>
</xsd:element>
