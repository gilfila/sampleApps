</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Lot Serial information on goods lines is supported only for Lot and Serial purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Prepaid, Retention, Due Date and Delivery Type aren't supported on Bill Only Purchase Order Goods lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
