</xsd:annotation>
<xsd:sequence>
<xsd:element name="XMLNAME__Project_Asset__Reference" type="wd:Project_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Project Asset associated with the asset removal events in the request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
