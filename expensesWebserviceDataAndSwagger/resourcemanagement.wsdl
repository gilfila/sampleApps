</xsd:annotation>
<xsd:sequence>
<xsd:element name="Worktag" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Text_Only_Line_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Supplier Invoice Text Only Line data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Line_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Optional line order. If specified, lines will be sorted by this value when displayed and when invoice is printed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Item or the Supplier's Default Purchase Item. Purchase items are goods and services that are purchased from suppliers</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional description of the item, especially useful if only a Spend Category is selected for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional reference to an existing Purchase Order Line in the Workday system. This is used to link the Supplier Invoice Line with a Purchase Order Line. If the invoice line is for an external Purchase Order (not available within Workday), leave this blank.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional reference to an existing Supplier Contract Line in the Workday system. This is used to link the Supplier Invoice Line with a Supplier Contract Line. Is not allowed for Ad Hoc Requests, Supplier Contract Adjustments, or Supplier Invoice Contracts (Recurring Supplier Invoices).</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Line_to_Adjust" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Original Supplier Invoice Line Reference Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Type" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This parent reference contains a unique identifier for an instance of a parent object if you provide Reference ID for the commodity code. If you provide text, this does not populate the commodity code, but is shown on the text only view/preview pages. This is not required if you enter WID for the commodity code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A reference to the Commodity Code for the invoice line. You can add WID or Reference ID to populate this field. If the Invoice originates from a related purchase order, it populates the value from the purchase order and is read-only. If you enter text, this does not populate the field but is shown on the text only view/preview pages.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Ship To Address Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Ship To Contact Reference Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-From_Address_Reference" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-From address reference text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Supplier Invoice Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit of Measure for the Supplier Invoice Line to be created or modified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost on the Supplier Invoice Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount on the Supplier Invoice Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Retention_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount Retained</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Budget Date for Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Line_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enter Invoice Line Delivery Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Line_Billing_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enter Invoice Line Billing Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Line_Billing_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enter Invoice Line Billing End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Applicability</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Withholding_Tax_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Withholding Tax Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Text_Only_Line_Tax_Data" type="wd:Supplier_Invoice_Text_Only_Line_Tax_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Text Only Line Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Invoice line. This is free form text.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Text_Only_Line_Worktag_Data" type="wd:Supplier_Invoice_Text_Only_Line_Worktag_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Text Only Line Worktags Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Split_Line_Data" type="wd:Supplier_Invoice_Text_Only_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
