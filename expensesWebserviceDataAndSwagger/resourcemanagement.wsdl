</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify worktags for active grants and not proposal grants. This worktag is for a proposal grant: [grant name]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Billable Flag at Invoice Line Level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The supplier invoice line can't be marked as Billable if the selected Worktag is not for a billable project</xsd:documentation>
