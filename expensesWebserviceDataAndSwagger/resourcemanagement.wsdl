<xsd:documentation>International Bank Account Number (IBAN)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="SWIFT_Bank_Identification_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Society for Worldwide Interbank Financial Telecommunication (SWIFT) Bank Identification Code (BIC)</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Bank Identification Code (BIC) standard format can be between 8 to 11 characters. Generally, it should not be less than 8 characters or exceed 11 characters.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Bank Identification Code (BIC) entry is not following a standard format. Please refer to SWIFT guidelines for the format details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Bank Identification Code (BIC) standard format can be between 8 to 11 characters. Generally, it should not be less than 8 characters or exceed 11 characters.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accepts_Payment_Types_Reference" type="wd:Payment_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Accepts Payment Types Reference is a reference to accepts payment types for a supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Types_Reference" type="wd:Payment_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only applicable for Suppliers. Reference to the Payment Types this Settlement Bank Account is intended for. Leave blank to designate this Settlement Bank Account as the default for all Payment Types.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Payment Types can only be specified for Settlement Bank Accounts for Suppliers.</xsd:documentation>
<wd:Validation_Message>Payment Types can only be specified for Settlement Bank Accounts for Suppliers.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="For_Supplier_Connections_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Designates this Settlement Bank Account to be used for Supplier Connections only.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You must use For Supplier Connections Only with settlement bank accounts for suppliers.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter values in Payment Types Reference when you select For Supplier Connections Only.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requires_Prenote" type="xsd:boolean" minOccurs="0" maxOccurs="1">
