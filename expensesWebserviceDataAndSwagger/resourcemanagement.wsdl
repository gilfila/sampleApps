<wd:Validation>
<wd:Validation_Message>Only Depreciable Capital assets can be placed in service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The asset must be in a Registered status to be placed in service. It may already be in service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cannot place an asset in service that is included in Composite Asset allocation. Assets that are components of a composite asset may not be placed in service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Depreciation has already been recorded for the asset.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Depreciation profile for the asset must start depreciation Manually or Upon Issue. Please verify that accounting has been assigned for the asset.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>There is a pending event for the asset that should be completed before this asset can be placed in service.</xsd:documentation>
<wd:Validation_Message>There is a pending event for the asset that should be completed before this asset can be placed in service.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
