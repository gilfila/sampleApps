<xsd:complexType name="Taxable_Code_Application_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Tax Details data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Tax Applicability from Tax Code Data is not included on any data input line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Tax Code from Tax Code Data is not included on any data input line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Tax by Tax Code amount that's equal to the sum of the corresponding Tax by Tax Rate amounts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ensure that all Tax Code Data elements have different combinations of tax applicabilities and tax codes.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax code.If this is blank, Workday will default in the default tax code from the invoice header if there is one. If the invoice line has a tax applicability value, Workday will validate that the invoice line also has a tax code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Tax Amount for Tax Code and Tax Applicability</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Rate_Data" type="wd:Tax_Rate_Application_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Tax Rate data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Tax_Rate_Application_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Tax Rate data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Provide a default tax recoverability for the tax applicability</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cannot select a Tax Recoverability for Customer Invoices.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cannot select Recoverable Recoverabilities when using a Non-Taxable Applicability, [applicability]. [SUBJECT TO CHANGE]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t enter Tax Recoverability for a Withholding Tax Code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must specify the Invoice/Adjustment Received Date if the Tax Point Date Type is Invoice/Adjustment Received Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter the Tax Point Date Type when you select the Enable Tax Point Date Configuration check box on the Edit Tenant Setup - Financials task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter the Tax Point Date when you select the Enable Tax Point Date Configuration check box on the Edit Tenant Setup - Financials task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't use Tax Point Date Type on a withholding tax code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t use Tax Point Date on a withholding tax code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must enter Tax Point Date when Tax Point Date Type is Goods/Service Delivery.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t use Tax Type on a withholding tax code.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t use Tax Type on Customer Invoice, Customer Invoice Adjustment, Cash Sale or Ad Hoc Bank Transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter Tax Point Date Type for Supplier Invoices, Supplier Invoice Adjustments, Customer Invoices and Customer Invoice Adjustments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter Tax Point Date for Supplier Invoices, Supplier Invoice Adjustments, Customer Invoices and Customer Invoice Adjustments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Don't specify a Goods or Service Delivery Date for a down payment invoice.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Tax_Rate_Reference" type="wd:Tax_RateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Rate</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Tax Rate: [taxrate] is not valid for Tax Code: [taxcode]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Tax Rate Reference is required if Tax Code is provided.</xsd:documentation>
<wd:Validation_Message>Tax Rate Reference is required if Tax Code is provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Tax Amount for Tax Rate</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Recoverability_Reference" type="wd:Tax_RecoverabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Recoverability</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Type_Reference" type="wd:Tax_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an Existing Tax Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Point_Date_Type_Reference" type="wd:Tax_Point_Date_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Point Date Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Point_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Point Date for Taxable Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Expense_Report_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Expense Report reference for update and all Expense Report data items</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Payee for Expense Report must be an employee.</xsd:documentation>
<wd:Validation_Message>[payee] is not an employee.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't use web services to change documents with fields and line amounts reported in 1 or more tax declarations.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't change this expense report because the ledger period for the transaction isn't open.</xsd:documentation>
<wd:Validation_Message>You can't change this expense report because the ledger period for the transaction isn't open.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Project Transaction Adjustment Event is in progress for this expense report. You can't cancel or update the expense report until the event completes.</xsd:documentation>
