</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Contract Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Provider_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Resource Provider Reference</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
