<xsd:documentation>Bulk UOM Data for Catalog or Supplier Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_JIT_Pricing_Data" type="wd:Priority_Ranked_Supplier_Catalog_Item_JIT_Pricing_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>JIT UOM Data for Catalog or Supplier Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Pricing_History" type="wd:Catalog_Item_Data_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Pricing History cannot be updated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Pricing_Data" type="wd:Supplier_Item_Advanced_Pricing_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Set this flag to True in order to delete Supplier Item Data.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
