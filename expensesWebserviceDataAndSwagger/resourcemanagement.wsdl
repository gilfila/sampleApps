</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ship To Address is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field Ship To Contact is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field Bill To Contact is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency for the Purchase Order must match the Currency for the Supplier Contract.</wd:Validation_Message>
