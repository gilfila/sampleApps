</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Add One-Way Daily Commute only when you also add Estimated Distance of Driving Route or [trip distance].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This field accepts only values related to these attributes: One-Way Daily Commute, Round Trip, and [trip distance].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Add Round Trip only when you also add Estimated Distance of Driving Route or [trip distance].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
