<xsd:documentation>Estimated Hours for the Project Task Resource</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Project Task Resource</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>This flag controls whether specified Project Task Resource should be deleted (When Replace All Flag is true,then value of delete flag is ignored)</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Delete Flag cannot be True if no Project Task Resource Reference is specified or provided Project Task Resource Reference doesn't exist(Project Task Resource:[tr id])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Task Resource cannot be deleted as its tied to Project(Project Task Resource:[tr],Project;[project])</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
