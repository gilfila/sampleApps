<xsd:annotation>
<xsd:documentation>Refund Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Refund_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Status for this refund. This field is read-only and the Submit Supplier Refund web service ignores it.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Refund_Application_Status" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Application Status for Supplier Refund. This field is read-only, and will be ignored on a Put or Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancel_Accounting_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The accounting date when the supplier refund was canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Refund_Accounting_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The accounting date for the supplier refund.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active supplier to create the supplier refund.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The supplier refund is already applied to 1 or more supplier invoice documents. You cannot change Company, Supplier, and Currency on this supplier refund.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency must be specified because neither Supplier nor Company has a default currency.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency entered is not listed as an Accepted Currency by Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Application_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Application Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an Application Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Type</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a Payment Type Reference.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Refund_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Refund Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Refund Amount that is greater than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Refund_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Refund Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deposit_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Deposit Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate_Data" type="wd:Currency_Rate_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Currency conversion rate data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Attachment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Refund_Application_Data" type="wd:Supplier_Refund_Application_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Refund Application Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Refund_Application_DataType">
<xsd:annotation>
<xsd:documentation>Supplier Refund Application Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Refund_Application_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Refund Application Reference ID. This is the Supplier Refund Application line unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a Supplier Refund Application ID that is related to the supplier refund. You can't use this Supplier Refund Application ID: [Line].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Document_Reference" type="wd:Supplier_Invoice_DocumentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify Supplier Invoice Document that are approved and not fully paid. This document can't be applied [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Supplier Invoice Document reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The company, supplier and currency on all supplier invoice documents must match the supplier refund header. The values on this document don't match the supplier refund [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier invoice adjustment. This invoice document is not supported [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify supplier invoice documents that aren't already in use on another transaction. This document is used on another transaction: [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier invoice document that has a negative total amount. You can't use this invoice document [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier invoice document that doesn't use VAT on payment or Withholding tax set to payment realization. You can't use this invoice document [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier invoice document that has a Matched status. You can't use this invoice document [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier invoice document that doesn't have lines that include grant worktags associated with a cost reimbursable, fixed amount, or prepaid award line type. You can't use this invoice document [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not include invoices which are direct intercompany</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Date for the Referenced Supplier Invoice Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Amount for the Referenced Supplier Invoice Document</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount_Applied" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount Applied for the Referenced Supplier Invoice Document</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify an Amount Applied that is less than or equal to the amount due on [SID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an Amount Applied that is greater than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Refund_RequestType">
<xsd:annotation>
<xsd:documentation>Element contains Supplier Refund Business Processing options, Supplier Refund Reference for update, Add Only to indicate if this operation is add-only, and all Supplier Refund data items required to create a complete Supplier Refund.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The supplier refund is already canceled, and you cannot resubmit it.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't modify a transaction that was created before the Alternate Ledger Currency was enabled for this company. Cancel the original transaction and create a new one with your changes.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't modify a transaction that was created before the Alternate Ledger Currency was enabled for this company. Cancel the original transaction and create a new one with your changes.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Refund_Reference" type="wd:Supplier_RefundObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>An existing supplier refund. Use this value for updates only.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Refund_Data" type="wd:Supplier_Refund_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Refund Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Refund_ResponseType">
<xsd:annotation>
<xsd:documentation>Element contains Submit Supplier Refund Response Data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Refund_Reference" type="wd:Supplier_RefundObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Refund.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Refund_Event_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Refund Event.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Currency_Rate_DataType">
<xsd:annotation>
<xsd:documentation>Currency conversion rate data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Ledger_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ledger Currency.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The ledger currency you entered is not defined in your company set up. Enter a defined ledger currency, or update your set up.</xsd:documentation>
<wd:Validation_Message>The ledger currency you entered, [LedgerCurrency], is not defined in your company set up. Enter a defined ledger currency, or update your set up.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't override currency because the transaction currency or one of the ledger currencies are the same.</xsd:documentation>
<wd:Validation_Message>You can't override currency [LedgerCurrency] because the transaction currency or one of the ledger currencies are the same.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter a ledger currency for any specified currency override.</xsd:documentation>
<wd:Validation_Message>Enter a ledger currency for any specified currency override.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Primary" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether this is the primary ledger. This field is read-only, and Workday ignores this field on a Put or Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Rate_Override" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates if the currency exchange rate has been overwritten or not.This information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Currency_Conversion_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier refund currency conversion rate</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The currency rate is zero for the Currency Rate Type, Currency Rate Date, Currency Rate Manual Override, or Default Currency Rate. Enter a currency rate greater than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="24"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Rate_Manual_Override" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency rate manual override.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a positive Currency Rate Manual Override value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="24"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default_Currency_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default currency rate.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="32"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Rate_Type_Override_Reference" type="wd:Currency_Rate_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Override rate type for Business Document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Rate_Type_Reference" type="wd:Currency_Rate_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default rate type reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate_Date_Override" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency rate date override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate_Lookup_Override" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency rate lookup override.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="24"/>
<xsd:fractionDigits value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Rate_Basis_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default rate basis date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manual_Override_Percent" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Manual override percent.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_External_Reference_on_Spend_Transaction_RequestType">
<xsd:annotation>
<xsd:documentation>Request Element that contains a reference to the Spend Transaction that will be updated to set External System ID Reference and External Source Reference ID.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't change External System ID Reference or External Reference ID on: [external sourceable abstract].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify the External Source Reference ID and the External System ID Reference to update the External Reference on: [external sourceable abstract].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit an External System ID Reference with a [valid external source] usage for: [external sourceable abstract].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Transaction_Reference" type="wd:External_Sourceable_AbstractObjectType">
<xsd:annotation>
<xsd:documentation>Spend Transaction Reference to update External Transaction Source and External Reference ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Source_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID of the spend transaction in the originating system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_System_ID_Reference" type="wd:External_Transaction_Source__All_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the External System from which this transaction originated from.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_External_Reference_on_Spend_Transaction_ResponseType">
<xsd:annotation>
<xsd:documentation>Response Element that contains a reference to the Spend Transaction that will be updated to set External Transaction Source and External Reference ID.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Spend_Transaction_Reference" type="wd:External_Sourceable_AbstractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Transaction Reference whose External Reference ID and External Source were updated by this WWS operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Requesting_Entity_Outbound_DataType">
<xsd:annotation>
<xsd:documentation>Element that includes Requesting Entity instance and Data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requesting_Entity_Reference" type="wd:Requesting_EntityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to existing Requesting Entity</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requesting_Entity_Data" type="wd:Requesting_Entity_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requesting Entity Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requesting_Entity_Response_DataType">
<xsd:annotation>
<xsd:documentation>Element that includes Requesting Entity Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requesting_Entity" type="wd:Requesting_Entity_Outbound_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requesting_Entity_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing Requesting Entity request criteria</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Get_Requesting_Entities_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Requesting Entity data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Requesting_Entity_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Requesting_Entity_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Requesting_Entity_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Requesting_Entity_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Requesting Entity data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a valid Ship-To Address.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Par or Inventory requisition types aren't supported for requesting entity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one worktag for each type is allowed for a Requesting Entity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Requesting Entity Name is Required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] worktag not valid for the requesting entity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an active Deliver-To location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Deliver-To location that doesn't have a Ship-To usage.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't assign an inactive requisition type as the default requisition type for the requesting entity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Request requisition types aren't supported for requesting entity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requesting_Entity_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unique Identifier for the Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requesting Entity Name.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a unique name for the Requesting Entity. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag to indicate that the Requesting Entity is Inactive.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company default for the Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requisition Type default for the Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-To address default for the Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Ship-To" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Workday automatically populates ship-to values based on the selected Company and Deliver-to Location. Select this flag to select a different ship-to value and override default ship-to values.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver-To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Deliver-To Location default for the Requesting Entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
