<xsd:documentation>Wrapper element for Internal Catalog Reference and Internal Catalog Data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Catalog_Reference" type="wd:Internal_Service_CatalogObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Internal Catalog.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Catalog_Data" type="wd:Internal_Catalog_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Internal Catalog data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Item_Data" type="wd:Catalog_Item_for_Internal_Catalog_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Catalog Item Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Catalog_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Internal Catalog data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>There is already an Internal Catalog with that Name and Internal Provider. Please change the Name or the Internal Provider before proceeding.</xsd:documentation>
<wd:Validation_Message>There is already an Internal Catalog with that Name and Internal Provider. Please change the Name or the Internal Provider before proceeding.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Catalog_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Catalog Reference ID.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Internal Catalog.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Provider_Reference" type="wd:Internal_Service_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Internal Service Provider.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Internal_Catalog_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Internal Catalog reference Internal Catalog data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Create a new Internal Catalog, or change 'Add Only' to 'false' to edit the Internal Catalog.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; but the Internal Catalog already exists.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Catalog already has catalog items loaded, only the Catalog Name can be updated.</xsd:documentation>
<wd:Validation_Message>The Catalog already has catalog items loaded, only the Catalog Name can be updated.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Catalog_Reference" type="wd:Internal_Service_CatalogObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Internal Catalog.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Catalog_Data" type="wd:Internal_Catalog_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Internal Catalog data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Internal_Catalog_ResponseType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing Internal Catalog response data for requested references.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Catalog_Reference" type="wd:Internal_Service_CatalogObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Internal Catalog.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Catalog_Item_for_Internal_Catalog_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Internal Catalog data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Catalog_Item_Reference" type="wd:Catalog_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Catalog Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Identifier" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Catalog Reference ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currently_Active" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Is the Catalog Item currently Active</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Current_Default_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The current rate of the default ordering unit of measure for the internal service catalog item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default_Ordering_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>The default ordering unit of measure for the catalog item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Base_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Base Unit of Measure Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item Lead Time</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Item_URL" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item URL</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Primary_Image_Data" type="wd:Primary_Image_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Primary Image for Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Image_Data" type="wd:Additional_Image_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional Image for Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UOM_Pricing_History" type="wd:Catalog_Item_Data_for_Catalog_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Catalog Item Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Credit_Card_Code_Mappings_RequestType">
<xsd:annotation>
<xsd:documentation>Get Credit Card Code Mappings Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Credit_Card_Code_Mapping_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Credit_Card_Code_Mapping_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Credit_Card_Code_Mapping_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Credit_Card_Code_MappingType">
<xsd:annotation>
<xsd:documentation>Credit Card Code Mapping Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Item_Reference" type="wd:Expense_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Code_Mapping_Data" type="wd:Credit_Card_Code_Mapping_DataType"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Credit_Card_Code_Mapping_Response_DataType">
<xsd:annotation>
<xsd:documentation>Credit Card Code Mapping Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Credit_Card_Code_Mapping" type="wd:Credit_Card_Code_MappingType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Credit Card Code Mapping</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Credit_Card_Code_Mappings_ResponseType">
<xsd:annotation>
<xsd:documentation>Get Credit Card Code Mappings Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Credit_Card_Code_Mapping_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Credit_Card_Code_Mapping_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Credit_Card_Code_Mapping_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Credit_Card_Code_Mapping_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Credit_Card_Code_Mapping_RequestType">
<xsd:annotation>
<xsd:documentation>Put Credit Card Code Mapping Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Item_Reference" type="wd:Expense_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Code_Mapping_Data" type="wd:Credit_Card_Code_Mapping_DataType"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Credit_Card_Code_Mapping_ResponseType">
<xsd:annotation>
<xsd:documentation>Put Credit Card Code Mapping Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Item_Reference" type="wd:Expense_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Expense Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Withholding_Tax_Code_Application_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Withholding Tax Details data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Withholding Tax Code from Withholding Tax Code Data is not included on any data input line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ensure that all Withholding Tax Code Data elements have different tax codes.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Withholding_Tax_Code_Reference" type="wd:Tax_CodeObjectType">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the withholding tax code.If this is blank, Workday will default in the default withholding tax code from the invoice header if there is one.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Withholding_Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Tax Amount for Withholding Tax Code</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Withholding_Tax_Rate_Data" type="wd:Tax_Rate_Application_DataType" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Item_Receipt_Line_Replacement_Lot_DataType">
<xsd:annotation>
<xsd:documentation>Receipt Line Item Lot Quantity Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The count of serial numbers does not match the receipt quantity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Lot_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lot Quantity for Lot Control Item</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't assign a lot identifier to a lot quantity of zero. Enter a lot quantity greater than zero or remove the lot.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't assign a lot serial quantity without lot or serial identifiers</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Item_Lot_Reference" type="wd:Item_LotObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Enter Lot for Lot Control Item</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't assign a lot identifier for items that are not lot control.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't assign a lot identifier that is not associated with the item</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Receipt_Line_Replacement_Serial_Data" type="wd:Item_Receipt_Line_Replacement_Serial_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item Receipt Line Replacement Serial Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing reference instances for a Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Reference" type="wd:Supplier_Invoice_RequestObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Invoice_Requests_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Supplier Invoice Request data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Supplier_Invoice_Request_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Supplier_Invoice_Request_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Supplier_Invoice_Request_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Request response grouping options</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag indicating if the attachment data within Supplier Invoice Request Data is to be included in the response</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Request request criteria</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Invoice Request Document Status. Examples of Document Status are Approved, Canceled and In Progress</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Due_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Due Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Due_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Due Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_by_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to a Worker who created the transaction.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approved_by_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to a Worker who approved the invoice request</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Invoice_Requests_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Request response elements including received criteria, references, data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Supplier_Invoice_Request_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Supplier_Invoice_Request_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Supplier_Invoice_Request_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Requests Response Results</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Data" type="wd:Supplier_Invoice_Request_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Topmost Response Element that represents the Reference to the Supplier Invoice Request along with its content</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Response_DataType">
<xsd:annotation>
<xsd:documentation>Topmost Response Element that represents the Reference to the Supplier Invoice Request along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request" type="wd:Supplier_Invoice_Request_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Supplier Invoice Request along with its content</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Supplier Invoice Request along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Reference" type="wd:Supplier_Invoice_RequestObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Data" type="wd:Supplier_Invoice_Request_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire Supplier Invoice Request, including Lines (with and without splits) and Attachments.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire Supplier Invoice Request, including Lines (with and without splits) and Attachments.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A unique Workday system generated Supplier Invoice Request Number. This value cannot be updated, but it can be used to reference the instance of the Supplier Invoice Request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Status of the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Date on the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Received_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Field to store the Invoice Received Date value</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Canceled_On_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date the Supplier Invoice Request was Canceled. Will not show if the request is not canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:ContactObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Creator of the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company on the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier on the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Connection_Reference" type="wd:Remit-To_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Business Connection.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency for the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Control_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expected total amount for Supplier Invoice Request. It is optional.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Suppliers_Invoice_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Reference text field on the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Request_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Amount for the Supplier Invoice Request. Includes Tax Amount, Freight Amount and the sum of the Extended Amount of the Lines</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Terms for the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Type_Reference" type="wd:Additional_Reference_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The type of reference used to encode key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Reference_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reference number that is encoded with key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="140"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Due Date for the Supplier Invoice Request. Format is MM/DD/YYYY.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Handling_Code_Reference" type="wd:Payment_Handling_InstructionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference code of the payment handling instructions for the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Statutory_Invoice_Type_Reference" type="wd:Invoice_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Class for Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This transaction header memo will print on the delivered transaction. It is optional freeform text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_Invoice_DocumentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Invoice for the Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Fields_Data_Reference" type="wd:Configurable_Attributes_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing additional fields data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Attachment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Data" type="wd:Supplier_Invoice_Request_Line_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Data. A Supplier Invoice Request may have multiple lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Line_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents Supplier Invoice Request Line information. A Supplier Invoice Request may have multiple Supplier Invoice Request Lines, with or without Splits.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Optional line order. If specified, lines will be sorted by this value when displayed and when invoice is printed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Reference" type="wd:Supplier_Invoice_Request_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Type" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Type. Either Goods line or Service line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Item on the Supplier Invoice Request Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description on the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category on the Supplier Invoice Request Line. If Item is referenced on the Line, then the Item's Spend Category is returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Packaging String associated with the Item specified on the Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Supplier Invoice Request Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure on the Supplier Invoice Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost on the Supplier Invoice Request Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount on the Supplier Invoice Request Line. If Unit Cost and Quantity are present on the line, Extended Amount is always equal to their product.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags entered on the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo on the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Memo on the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Billable Flag at Supplier Invoice Request Line Level</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Splits_Data" type="wd:Supplier_Invoice_Request_Line_Split_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Optional element that represents Split information for the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Line_Split_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element to capture Splits information for a parent Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Line_Split_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Split_Reference" type="wd:Supplier_Invoice_Request_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Split Reference. Only to be used with the Get Web Service to retrieve the Integration ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity for the split line. This is optional and will not be populated when the Supplier Invoice Request Line is split by amount.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended amount for the split line. This is an optional field ,but if present it is equal to Quantity times Unit Cost of parent Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Split memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags on the Supplier Invoice Request Line Split</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Billable Flag at Supplier Invoice Request Line Split Level</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Alternate_Item_Identifier_for_PO_issue_DataType">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifier name and value.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Value" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifier value.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Name" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifier name.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element used to capture information to create a Supplier Invoice Request. It includes subelements to create attachments, Supplier Invoice Request Lines and Line Splits.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</xsd:documentation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier reference is for a supplier that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Supplier reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter at least one invoice request line.</xsd:documentation>
<wd:Validation_Message>Enter at least one invoice request line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Define currency conversion rates between the invoice request currency and the default currency on the company before using the web service.</xsd:documentation>
<wd:Validation_Message>Define currency conversion rates between the invoice request currency and the default currency on the company before using the web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invoice Class must be active, have supplier accounts usage, and be for the same country as the company on this document.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>An Invoice Document cannot have a Reference Type without a Reference Number or a Reference Number without a Reference Type. The document must contain both or neither.</xsd:documentation>
<wd:Validation_Message>[missing field] is missing. The [missing field] is required when submitting an invoice with a [present field].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Reference ID. This is optional and will be auto-generated if left blank on the Web</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate whether the Supplier Invoice Request should be submitted to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Format is MM/DD/YYYY.If this is left blank, Workday will populate invoice date with the current date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Received_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Field to store the Invoice Received Date value</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requester for Supplier Invoice Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>This is the company that tranasction is for. This is the reference id value of the company.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>This is the reference id of currency of supplier invoice request.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>Currency entered is not listed as an Accepted Currency by Supplier.</xsd:documentation>
<wd:Validation_Message>Currency entered is not listed as an Accepted Currency by Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Reference is the reference to the Supplier the supplier invoice request is from.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contingent_Worker_Reference" type="wd:Contingent_WorkerObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Contingent Worker</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:choice>
<xsd:element name="Supplier_Connection_Reference" type="wd:Remit-To_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Business Connection.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Supplier Connection should be valid for the Supplier</xsd:documentation>
<wd:Validation_Message>Supplier Connection is not valid for Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier Connection should be active</xsd:documentation>
<wd:Validation_Message>Supplier Connection is Inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Default_Supplier_Connection" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>TRUE or FALSEIf this is set to 'TRUE' the default supplier connection will be derived.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Control_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the expected supplier invoice request total including freight amount. It is optional. A supplier invoice request cannot be submittted for approval if it has a non-zero control total that does not equal the sum of the extended amount for all supplier invoice request lines plus freight and tax amount.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The total invoice request amount does not match the control total amount.</xsd:documentation>
<wd:Validation_Message>The total invoice request amount does not match the control total amount.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Suppliers_Invoice_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field to provide a Supplier’s Invoice Number memo. The Supplier’s Invoice Number is not a Workday Reference ID, but a text field for providing additional information about the Supplier Invoice Request.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Enter a Supplier's Invoice Number that isn't already in use on another supplier invoice, invoice adjustment, or invoice request for this supplier.</xsd:documentation>
<wd:Validation_Message>Enter a Supplier's Invoice Number that isn't already in use on another supplier invoice, invoice adjustment, or invoice request for this supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id of the payment terms for the supplier invoice request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Type_Reference" type="wd:Additional_Reference_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The type of reference used to encode key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Reference_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reference number that is encoded with key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="140"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Handling_Code_Reference" type="wd:Payment_Handling_InstructionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference code of the payment handling instructions for the supplier invoice request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Statutory_Invoice_Type_Reference" type="wd:Invoice_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Statutory Invoice Type for Supplier Invoice Request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This transaction header memo will print on the delivered transaction. It is optional freeform text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Data" type="wd:Supplier_Invoice_Request_Line_Data_InboundType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures Supplier Invoice Request Line information. A Supplier Invoice Request may have multiple lines with or without splits.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Fields_Data_Reference" type="wd:Configurable_Attributes_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing additional fields data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a unique Configurable Attribute Reference. You can't use the same Configurable Attribute Reference more than once.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Attachment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Invoice_Request_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Request Business Processing Options, Supplier Invoice Request reference for update. Flag to indicate if this operation is add only, and all Supplier Invoice Request data items required to create a complete Supplier Invoice Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Updates are allowed only for Supplier Invoice Requests that are in Draft or In-Progress status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Reference" type="wd:Supplier_Invoice_RequestObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice Request for update only purpose</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Data" type="wd:Supplier_Invoice_Request_Data_InboundType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Invoice_Request_ResponseType">
<xsd:annotation>
<xsd:documentation>Element that contains the Supplier Invoice Request created or modified via the Submit Web Service operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Reference" type="wd:Supplier_Invoice_RequestObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Supplier Invoice Request created or modified via the Submit Web Service operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Event_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice Request Event</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Line_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element that captures Supplier Invoice Request Line information. A Supplier Invoice Request may have multiple lines with or without splits.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
<wd:Validation_Message>Spend Category must match the Spend Category for the Purchase Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Purchase Item selected [purchase item] is Inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following worktag type(s) are invalid: [invalid type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Service Lines cannot be split based on quantity.</xsd:documentation>
<wd:Validation_Message>Service Lines cannot be split based on quantity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Values for Quantity and Unit Cost are not allowed for Invoice Request Service Lines.</xsd:documentation>
<wd:Validation_Message>Values for Quantity and Unit Cost are not allowed for Invoice Request Service Lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Total of Quantity in Invoice Request line splits are not same as Quantity for Invoice Request Goods Line</xsd:documentation>
<wd:Validation_Message>Total of Quantity in Invoice Request line splits are not same as Quantity for Invoice Request Goods Line</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Total of Extended Amount in Invoice Request line splits are not same as Extended Amount for Invoice Request Line</xsd:documentation>
<wd:Validation_Message>Total of Extended Amount in Invoice Request line splits are not same as Extended Amount for Invoice Request Line</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity is required for a Purchase Item.</xsd:documentation>
<wd:Validation_Message>Quantity is required for a Purchase Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Request_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Reference ID. This is optional and will be auto-generated if left blank.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Setting of Supplier Invoice Request Line Reference ID is not allowed for add-only service requests</xsd:documentation>
<wd:Validation_Message>Setting of Supplier Invoice Request Line Reference ID is not allowed for add-only service requests</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Supplier Invoice Request for the referenced Supplier Invoice Request Line must be equal to the Supplier Invoice Request in this request</xsd:documentation>
<wd:Validation_Message>The Supplier Invoice Request for the referenced Supplier Invoice Request Line must be equal to the Supplier Invoice Request in this request</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Optional line order. If specified, lines will be sorted by this value when displayed and when invoice is printed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Quantity_Based_Line" type="xsd:boolean" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to determine if the supplier invoice request line is a goods line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Amount_Based_Line" type="xsd:boolean" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to determine if the supplier invoice request line is a service line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Item. Purchase items are goods and services that are purchased from suppliers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for the Supplier Invoice Request Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Splitting by quantity is not allowed when the quantity is not a whole number: [qty]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure for the Supplier Invoice Line to be imported.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a unit of measure that is already in use for the supplier item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the Unit Price.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Extended Amount. If Unit Cost and Quantity are also specified on the Supplier Invoice Request Line, then Extended Amount must equal Unit Cost * Quantity.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Worktags are not allowed when there are split lines.</xsd:documentation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following worktag type(s) are required: [missing types]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Supplier Invoice request line. This is free form text.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Memo on the Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Billable Flag at Supplier Invoice Request Line Level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Supplier Invoice Request Line can't be marked as Billable if the selected Worktag is not for a Billable Project.</xsd:documentation>
<wd:Validation_Message>The Supplier Invoice Request Line cannot be marked as Billable if the selected Worktag is not for a Project Plan, Phase, or Task from a Billable Project.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Request_Line_Splits_Data" type="wd:Supplier_Invoice_Request_Line_Splits_Data_InboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures Supplier Invoice Request Line Splits information</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Request_Line_Splits_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Request Line Split data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either Quantity must equal zero or not be present or the Extended Amount must equal Quantity * Unit Cost. Currently [Quantity] * [Unit Cost] does not equal [Extended].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Request Line Split ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Supplier Invoice Request Line Split. This is optional and must not be included when the Supplier Invoice Request Line is split by Amount.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The quantity must be a whole number: [qty]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount on the Supplier Invoice Request Line Split. This is always required and the total Line Split amount must equal the (Unit Cost * Quantity) of the parent Supplier Invoice Request Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Supplier Invoice Request Split line. This is free form text.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Billable" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Billable Flag at Supplier Invoice Request Line Split Level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Supplier Invoice Request Line Split can't be marked as Billable if the selected Worktag is not for a Billable Project.</xsd:documentation>
<wd:Validation_Message>The Supplier Invoice Request Line Split can't be marked as Billable if the selected Worktag is not for a Project Plan, Phase, or Task from a Billable Project.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requisition_Sourcing_Rule_Buyer_DataType">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of a buyer requisition sourcing rule</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Company is already included in one of the selected Company Hierarchies.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company Hierarchy is already included in one of the hierarchies selected.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Modify sourcing rule criteria to avoid creating a duplicate rule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company, Ship-to Address, Requisition Type, Spend Category, or Supplier is required to create a requisition sourcing rule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend Category is already included in the Spend Category Hierarchy selected.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend Category Hierarchy is already included in one of the hierarchies selected.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category must be active and have procurement usage. Remove or update spend category: [Spend Category Name].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>At least one spend category under spend category hierarchy must be active and have procurement usage. Remove or update spend category hierarchy: [Spend Category Hierarchy Name].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the invalid worktag types: [Invalid Worktag types].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for the buyer sourcing rule</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Must match one of these companies or company hierarchies to apply this rule. If empty, no match is required.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Organization_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Must match one of these Ship-To Addresses to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Active_Location_or_Location_Hierarchy_for_Procurement_Reference" type="wd:Asset_Location_or_Location_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Active Deliver-To Locations or Location Hierarchies that must match to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>These are Worktags that must match to apply the rule. If this is empty, no match is performed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Requisition Types that must match to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_Category_or_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Must match one of these spend categories or spend category Hierarchies to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tags_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item Tags that must match to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Group_Reference" type="wd:Supplier_GroupObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Groups that must match to apply this rule. If empty, no match is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Suppliers that must match to apply this rule. If empty, no match is required.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Resulting_Buyer_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>The resulting buyer to set on the requisition if the requisition rule criteria is met. If empty, then Use submitted by worker, or requisition sourcing buyer will be used.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Submitted_by_Worker_on_Requisition_as_Buyer" type="xsd:boolean" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use submitted by worker on the requisition as the resulting buyer if the requisition rule criteria is met.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Requisition_Sourcing_Buyer" type="xsd:boolean" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use sourcing buyer on the requisition as the resulting buyer if the requisition rule criteria is met.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Bill_To_Contact_Info_for_Issue_Purchase_Order_Outbound_Sub_ViewType">
<xsd:annotation>
<xsd:documentation>Contains Contact Information (Email, Phone, Fax) for Bill-To of Purchase Order</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Phone_Country_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Phone Country Code</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Phone_Country_Code_Alpha-2" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Phone Country Code Alpha-2</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Phone_Area_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Phone Area Code</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Phone_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Phone Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fax_Country_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Fax Country Code</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Fax_Country_Code_Alpha-2" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Fax Country Code Alpha-2</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fax_Area_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Fax Area Code</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Fax_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Fax Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Email" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Email</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Deliver To</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Ship_To_Contact_Info_for_Issue_Purchase_Order_Outbound_Sub_ViewType">
<xsd:annotation>
<xsd:documentation>Contains Contact Information (Email, Phone, Fax) for Ship-To of Purchase Order</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Phone_Country_Code" minOccurs="0" maxOccurs="1">
<xsd:annotation>
