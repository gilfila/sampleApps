<xsd:sequence>
<xsd:element name="Supplier_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier ID</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a supplier you have access to.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Reference ID. The Supplier Reference ID can be used to uniquely identify a Supplier Unlike Supplier ID, Workday will not automatically generate a Supplier Reference ID if one is not received. The recommended use for Supplier Reference ID is where the Workday is not the source system of the Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a supplier you have access to.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Sourceable_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier ID when object is coming from external source</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a supplier you have access to.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if supplier is used as a worktag only and not a complete supplier instance</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Restricted_To_Companies_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Restrict To Companies</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_By" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The person who created the supplier. It is retrieved using the System values and cannot be updated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_On" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the supplier was created. It is retrieved using the System values and cannot be updated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Last_Invoice_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The latest invoice date for the supplier. It is retrieved using the System values and cannot be updated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approval_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Approval Status. This field is read only.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the Supplier is to be submitted or saved in draft mode. If this flag is set, the Supplier will be submitted, otherwise the Supplier is saved in draft. Default to 1 if the Submit flag does not exist in the request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Create_Supplier_from_Customer_Reference" type="wd:Billable_EntityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Customer from which this Supplier is to be associated.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Customer_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Create_Supplier_from_Financial_Institution_Reference" type="wd:Financial_InstitutionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Financial Institution from which this Supplier is to be associated.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Financial_Institution_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Create_Supplier_from_Tax_Authority_Reference" type="wd:Tax_AuthorityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Authority from which this Supplier is to be associated.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Tax_Authority_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Create_Supplier_from_Investor_Reference" type="wd:InvestorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Investor from which this Supplier is to be associated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Tax_Authority_Form_Type_Reference" type="wd:Tax_Authority_Form_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tax form used by the appropriate taxing authority for the Payee.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Report 1099 MISC with parent cannot be checked unless Supplier and Parent Supplier are both 1099 MISC Suppliers.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may enter either a IRS 1099 Payee or a Tax Authority Form Type, but not both. If you do enter both, then they should match.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>1099 (MISC/NEC) must be selected in order to Check "Report 1099 with Parent".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>1099 MISC must be selected in order to Check "Report 1099 MISC with Parent".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Report 1099 with parent cannot be checked unless Supplier and Parent Supplier are both 1099 Suppliers.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A child Supplier is currently reporting their 1099 MISC with this Supplier. Uncheck 'Report 1099 MISC with Parent' on all children Suppliers.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A child Supplier is currently reporting their 1099 with this Supplier. Uncheck 'Report 1099 with Parent' on all children Suppliers.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="IRS_1099_Supplier" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier is 1099</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Report_1099_with_Parent" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier 1099 derived from parent</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_ID_Widget_Data" type="wd:Tax_ID_Widget_DataType" minOccurs="0"/>
<xsd:element name="Tax_Status_Widget_Data" type="wd:Tax_Status_Widget_DataType" minOccurs="0"/>
<xsd:element name="Supplier_Category_Reference" type="wd:Supplier_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Category Reference is a reference to a specific Supplier Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Group_Reference" type="wd:Supplier_GroupObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Group Reference is a reference to a specific Supplier Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Document Link URL entered does not comply with URL restrictions set for this Field.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the date the Tax Document (e.g. W-9, etc) was received.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>you cannot enter a Withholding Tax code in the Tax Code Reference.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Withholding_Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Withholding Tax Code Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You cannot enter a Transaction Tax code in the Withholding Tax Code Reference.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Source_Reference" type="wd:External_Transaction_Source__All_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Configures the Transaction Source for the supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This External Transaction Source is not valid for this web service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an active External Transaction Source for new suppliers.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Change_Source_Reference" type="wd:External_Transaction_Source__All_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Configures the Transaction Source for the supplier change</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify an active External Transaction Source for changes to the supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier onboarding ID for this External Transaction Source.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid External Transaction Source for this Web Service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Supplier Source Reference when you create a new supplier and specify a Supplier Change Source Reference when you update an existing supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="FATCA" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For 1099-MISC Reporting</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Certificate_of_Insurance_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date field for Certificate of Insurance Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Account_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for Customer Account Number. This is not a Workday Customer Account or ID number, but a free form text for a Supplier to enter their own Customer Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="DUNS_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>DUNS Number that uniquely identifies the Supplier.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unique_Entity_Identifier" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains the Unique Entity Identifier (UEI) assigned to the supplier by the US federal government.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="12"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Invoice_Any_Supplier" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates that the supplier can create invoices for any other supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Suppliers_for_Sending_Invoices_Widget" type="wd:Invoice_Specific_Suppliers_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Enables you to select additional suppliers to create invoices for when your purchase order supplier is different than your invoice supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Suppliers_for_Receiving_Invoices" type="wd:Receive_Invoice_From_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Shows "Additional Suppliers for Receiving Invoices" table</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Edit_Portal_Taxes" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enable your supplier contacts to enter or change the tax information on supplier invoices created from a purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Restricted_Companies_for_Supplier_Contacts_Reference" type="wd:CompanyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Enables Invoice Requests on the Supplier Portal for these companies.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Enable_Global_Location_Number" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier enabled for GLN use</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Disable_Change_Order" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>When Disable Change Order is True, a Change Order cannot be created from any Purchase Order for this Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Purchase Order Issue Option</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't use this PO Issue Option because there is no supplier link referencing this supplier, and there is not any multi-supplier supplier link for PO Issue.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Email cannot be chosen as a PO Issue Option if no Email Address is specified.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The default issue option on change orders for the supplier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submit the Change Order Issue Options with a supplier or multi-supplier link to reference the supplier. Clear the issue option when supplier links don't exist.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit an Email Address to also submit the Change Order Issue Option. Clear the Change Order Issue Option when an email address doesn't exist.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_PO_Issue_Email_WWS_Widget_Data" type="wd:Default_PO_Issue_Email_WWS_Widget_DataType" minOccurs="0"/>
<xsd:element name="Multi-Supplier_Supplier_Link_for_PO_Issue_Reference" type="wd:Supplier_LinkObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Preferred multi-supplier supplier link to be used to issue purchase orders for the supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submit the XML or XML Auto options for the Purchase Order Issue Option or Change Order Issue Option field attributes when there's also a value setup for the Multi-Supplier Supplier Link for PO Issue field attribute.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Terms for Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method for Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acknowledgement_Expected" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Acknowledgement expected for this supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Acknowledgement Expected cannot be set because Purchase Order Acknowledgements are not enabled for this tenant.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Enable_POA_Item_Substitution" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to enable item substitution for the automatic change order service schedule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enable POA Item Substitute cannot be set because Purchase Order Acknowledgements are not enabled for this tenant.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Minimum_Order_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enable Supplier to send Supplier Minimum Order Amount.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Minimum_Order_Amount_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Enable Supplier to send the Currency for the Supplier Minimum Order Amount.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enable Supplier to send Lead Time</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Enable_ASN" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enable Supplier to send ASN</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="ASN_Due_In_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The number of days the ASN is due.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="6"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Overrides_Tenant_Setup_for_Supplier_Invoice_Discount_Exclusion" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if you select to override the settings at the supplier level and tenant level.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Freight_Amount_from_Supplier_Invoice_Discount" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to true to indicate that you want to exclude Freight Amount from the supplier invoice discount calculation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Other_Charges_from_Supplier_Invoice_Discount" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to true to indicate that you want to exclude Other Charges from the supplier invoice discount calculation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Tax_Amount_from_Supplier_Invoice_Discount" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to true to indicate that you want to exclude Tax Amount from the supplier invoice discount calculation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Terms Reference is a reference to a specific Payment Term that is to be used as the default Payment Terms.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Terms_Based_on_Invoice_Received_Date" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to true to indicate that you want to calculate the supplier invoice payment due date and any discounts using the date from the Invoice Received Date instead of the Invoice Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Types_Accepted_Reference" type="wd:Payment_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Payment Types Accepted Reference is a reference to the accepted Payment Types by the Supplier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't delete a payment type that is in use on an active supplier remit to connection.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Payment Type Reference is a reference to the specific Payment Type that is to be the default Payment Type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Additional_Type_Reference" type="wd:Additional_Reference_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Additional Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Procurement Credit Card used for Supplier payments. The Credit Card supplied must be Active and must be from a Corporate Credit Card Account in the system with an Usage Indicator of Procurement.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Credit_Card_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>A Payment Type of Credit Card must be provided as one of the valid payment types for the Supplier if a Procurement Credit Card is to be assigned.</xsd:documentation>
<wd:Validation_Message>A Payment Type of Credit Card must be provided as one of the valid payment types for the Supplier if a Procurement Credit Card is to be assigned.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Procurement Credit Card provided is not Active.</xsd:documentation>
<wd:Validation_Message>The Procurement Credit Card provided is not Active.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Procurement Credit Card provided must be associated with a Corporate Credit Card Account with an Usage of Procurement.</xsd:documentation>
<wd:Validation_Message>The Procurement Credit Card provided must be associated with a Corporate Credit Card Account with an Usage of Procurement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Included_Children_Reference" type="wd:SupplierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Suppliers to be added as children. A child Supplier can only belong to one parent and a parent can not be self-referencing.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Remove or change child supplier, as it causes circular reference.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Children_Reference" type="wd:SupplierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Suppliers proposed Children of this supplier. if this field does not exist in the request, Included Children field will be used as the proposed ones.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Entity_Data" type="wd:Business_Entity_WWS_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Entity Data is the name, taxid and contact data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Settlement_Account_Widget_Data" type="wd:Settlement_Account_WWS_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Wrapper element to enable "Replace All" option for Settlement Bank Account.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Do_not_pay_during_Bank_Account_updates" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag to indicate not to pay while Settlement Bank Account changes are in progress. Exclude Supplier Invoices from Settlement.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Status_Data" type="wd:Supplier_Status_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Status data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Supplier_Status_Data" type="wd:Proposed_Supplier_Status_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing Proposed Supplier Status data. if this element does not exist in the request, Supplier Status Data element will be used as the proposed one.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Always_Separate_Payments" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Always Separate Payments</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Text_for_Default_Supplier_Payment_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For Supplier Payments from this Supplier, use the Default Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Supplier_Reference_as_Default_Supplier_Payment_Memo" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For Supplier Payments from this Supplier, use the Supplier Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Invoice_Memo_as_Default_Supplier_Payment_Memo" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For Supplier Payments from this Supplier, use the Supplier Invoice Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Supplier_Connection_Memo" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>For Supplier Payments from this Supplier, use the Supplier Connection Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Default Currency needs to be amongst accepted currencies for Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accepted_Currencies_Reference" type="wd:CurrencyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Accepted Currencies Reference. When no accepted currencies are passed in the web service, the bank account will accept all currencies.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Classification_Widget_Data" type="wd:Supplier_Classification_Widget_DataType" minOccurs="0"/>
<xsd:element name="Integration_System_Reference" type="wd:Integration_System__Audited_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Integration system to be used for remittance to this supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Do_Not_Reimburse_Contingent_Worker_Expense_Reports" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, do not reimburse contingent worker expense reports for contingent workers supplied by the supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Security_Segment_Reference" type="wd:Supplier_Security_SegmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Security Segment. If segmented security is implemented, this will control who has access to this Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Note_Follow-Up_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The follow-up date for the latest supplier note.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The supplier note follow-up date cannot be in the past.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Entity_Alternate_Name_Widget_Data" type="wd:Business_Entity_Alternate_Name_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A wrapper element that contains information about the alternate name for the business entity.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Financials_Attachment_Widget_Data" type="wd:Financials_Attachment_Widget_DataType" minOccurs="0"/>
<xsd:element name="Note_Widget_Data" type="wd:Note_Widget_DataType" minOccurs="0"/>
<xsd:element name="Spend_Category_or_Hierarchy_Reference" type="wd:Spend_Category_or_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Suppliers can be classified by a Spend Category or Hierarchy. This only represents the categories of goods and services they provide.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Procurement_Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The default procurement item of the Supplier.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Purchase_Item_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Default Spend Category of the Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Related_Worktag_Data" type="wd:Related_Worktag_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the existing Allowed or Default Related Worktags.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Areas_Changed" type="wd:Areas_Changed_WWS_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Areas Changed. These attributes indicate which areas have been updated by Supplier Data. Only applies to updating Suppliers after they have been fully approved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Financials_Attachment_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing all Business Document Attachment data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If a file name is specified for a Financial Attachment, File Content and Content Type are required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="File_Content" type="xsd:base64Binary" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>File content in binary format.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Comment" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Content_Type">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Content Type of the Attachment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="80"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:attribute>
<xsd:attribute name="Filename">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Filename of the Attachment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="255"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:attribute>
<xsd:attribute name="Encoding" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Encoding of the Attachment.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute name="Compressed" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Boolean attribute identifying whether the Attachment is compressed.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Expense_Item_Group_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Expense Item Group data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Item_Group_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Item Group ID. This is the Expense Item Group unique identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Item_Group_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text for a meaningful Expense Item Group Name</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Expense Item Group Name is already used.</xsd:documentation>
<wd:Validation_Message>Enter a unique Expense Item Group Name. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Expense_Item_DataType">
