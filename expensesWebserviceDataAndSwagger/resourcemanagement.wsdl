<xsd:element name="Project_Portfolio_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is a unique identifier for Project Portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Portfolio_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text for a meaningful Project Portfolio Name. Project Portfolio Name must be unique.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Parent_Project_Portfolio_Reference" type="wd:Project_PortfolioObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The parent of this project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reporting_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The currency used by the project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Portfolio_Owner_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The owner for this project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The project portfolio description.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The start date of the project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The end date of the project portfolio.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Funding_Amount" minOccurs="0">
