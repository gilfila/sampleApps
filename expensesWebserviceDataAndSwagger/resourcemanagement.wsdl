<wd:Validation>
<xsd:documentation>Resource Provider must be a Supplier or an Independent Contingent Worker.</xsd:documentation>
<wd:Validation_Message>Resource Provider must be a Supplier or an Independent Contingent Worker.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resource Provider must be active or on hold.</xsd:documentation>
<wd:Validation_Message>Resource Provider must be active or on hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resource Provider reference is for a supplier that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Resource Provider reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
