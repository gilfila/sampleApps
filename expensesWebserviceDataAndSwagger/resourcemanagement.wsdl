<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase item request type is in use. You can only inactivate or update the name of an in use purchase item request type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a unique Order for each row.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a different name for the request. You can't have more than 1 of the same name for active purchase item requests.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a workbook template with only item inventory site attributes. When Calculate Recommended Reorder Point is enabled, you must submit workbook templates that only use the Item Inventory Site Attributes template type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Request type cannot be enabled for Calculate Recommended Reorder Point and Request New Purchase Items.</wd:Validation_Message>
