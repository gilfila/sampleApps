</xsd:complexType>
<xsd:complexType name="Get_Travel_Booking_Records_RequestType">
<xsd:annotation>
<xsd:documentation>This element is the top-level request element for all Travel Booking Record "Get" operations.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Travel_Booking_Record_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Travel_Booking_Record_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Travel_Booking_Record_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Record_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Travel Booking Record Reference element contains the specific instance set containing the requested Travel Booking Record</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Booking_Record_Reference" type="wd:Travel_Booking_RecordObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Travel Booking Record Request References.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Record_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Travel Booking Record response elements including echoed request data and request result data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether to include the Travel Booking Record Reference in the response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Record_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing travel booking record response data for requested references or criteria and for requested response group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Travel_Booking_Record" type="wd:Travel_Booking_RecordType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_Record_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>This element is the wrapper around a list of elements representing the Travel Booking Record Request specific criteria needed to search for instances. All of the elements are "AND" conditions.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Load_Date_Starting_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The starting point of the range on the Load Date field, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Load_Date_Ending_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The ending point of the range on the Load Date field, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Booking_File_Reference" type="wd:Travel_Booking_FileObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the files used to load the travel booking records.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Date_Starting_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The starting point of the range for the transaction date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Date_Ending_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The ending point of the range for the transaction date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The employee on the travel booking record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company of the Employee on the Travel Booking Record</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Provider" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Identifying name of the Travel management provider.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_Starting_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The starting point of the range for the travel start date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_Ending_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The ending point of the range for the travel start date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date_Starting_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The starting point of the range for the travel end date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date_Ending_Range" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The ending point of the range for the travel end date, from which travel booking records are retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Travel_Record_Type_Reference" type="wd:Travel_Booking_Record_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Type of the Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchased" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Status of Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Status_Reference" type="wd:Expense_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The expense status on the travel booking record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Booking_Status_Reference" type="wd:Booking_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Booking Status of Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Merchant_Reference" type="wd:Abstract_Spend_Data_NameObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Merchant matching the merchant listed on the Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Merchant_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Merchant Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Merchant_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Merchant Name for Travel Booking.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Destination_Travel_City_Reference" type="wd:Abstract_Spend_Data_NameObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Workday Destination City matching the destination city on the Travel Booking Record.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Report_Reference" type="wd:Expense_ReportObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The expense reports that include lines linked to travel booking records.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Travel_Booking_Records_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Travel Booking Record response elements including echoed request data and request result</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Travel_Booking_Record_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Travel_Booking_Record_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Travel_Booking_Record_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Travel_Booking_Record_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Travel_Booking_RecordType">
<xsd:annotation>
<xsd:documentation>Travel Booking Record</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
