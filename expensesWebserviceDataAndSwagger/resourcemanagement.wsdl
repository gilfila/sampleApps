</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
<xsd:element name="Project_Asset_Reference" type="wd:Project_AssetObjectType">
<xsd:annotation>
<xsd:documentation>The existing project asset associated with the business assets to be removed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Asset cannot be removed because the related Business Assets have in progress event.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't remove this project asset because one or more of its associated business assets is ineligible for removal or not yet registered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t remove this business asset because the associated project asset has uncapitalized assigned transactions or pending asset adjustment events. Cancel the pending asset adjustment business process if there is any, unassign the uncapitalized transactions and then remove the business asset.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Remove_Associated_Business_Assets_Data" type="wd:Remove_Associated_Business_Assets_DataType"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Remove_Business_Assets_from_Project_Asset_ResponseType">
