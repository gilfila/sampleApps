</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[line type] cannot contain Worktag Split Template.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't have both Worktags and a Worktag Split Template on the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid company. This company is not valid for the Worktag Split template: [WST]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
