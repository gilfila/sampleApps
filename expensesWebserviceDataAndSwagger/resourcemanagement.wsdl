<wd:Validation>
<wd:Validation_Message>You can't change supplier classifications that are in use. To add attributes to an existing classification create a new field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't select External Supplier Site Field check boxes if you don't select the External Supplier Site Classification check box.</wd:Validation_Message>
