<xsd:annotation>
<xsd:documentation>Element containing Purchase Item request criteria</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select an Updated To Date that's in the past.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an Item Updated From date that's before or on the Item Updated To date</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>We return all purchase items associated with the supplier you enter. We also return all the information set up for the purchase item, including supplier information for all associated suppliers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>We return all purchase items that have the supplier contract defined as a Preferred Supplier Contract, or an attribute for Advanced Pricing</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Group_Reference" type="wd:Purchase_Item_GroupObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Item Group. Assign purchase items to item groups to make it easier to search for and select items. Purchase items can belong to multiple groups.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item tags for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_All_Advanced_Pricing" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select Yes to return all advance prices. When you don't select this and you don't enter an effective date, we return advance prices that are effective at the time this web service runs. When you don't select this and you enter an effective date, then we return prices that are active for the effective date entered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_Active_Advanced_Pricing" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Only retrieve Supplier Items considered active (that have active unit of measure pricing information.)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Pricing_Calculated_by_Conversion_Factor" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to exclude pricing that’s calculated based on the conversion factor. When you enable Calculate Price based on Conversion Factor, Workday only returns pricing that is not calculated based on the conversion factor and the also the default price. This enables you to quickly view and edit relevant pricing.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Updated_From" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select a date to return purchase items edited after this time.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Updated_To" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select a date to return purchase items edited before this time.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Status_Reference" type="wd:Spend_Item_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Select one or more purchase item statuses to return purchase items with the specified statuses.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacturer_Part_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>MPN as primary attribute of Purchase Item (starts from v44.0)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacturer_Reference" type="wd:ManufacturerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Manufacturer as primary Attribute for Purchase Item (starts from v44.0)</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Item_Response_GroupType">
<xsd:annotation>
