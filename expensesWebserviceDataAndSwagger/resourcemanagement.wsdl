<xsd:documentation>Reference to an existing Return Status. Examples of Document Status are Approved, Denied, Draft, In Progress</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Return Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Return Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_Reason_Reference" type="wd:Return_to_Supplier_ReasonObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Return Reason</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference of an Item on the Return</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_RMA" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier RMA on the Return</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_by_Person_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to a Person who created the Return</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approving_Worker_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to a Worker who approved the Return</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Return_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Return response grouping options</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Returns_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Return response elements including received criteria, references, data based on criteria and grouping, results filter and result summary</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Return_Request_ReferencesType" minOccurs="0"/>
