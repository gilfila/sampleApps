<xsd:documentation>Catalog Item Unique Identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Identifier" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item Identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Used to inactivate an existing Catalog Item via the Catalog Load WWS request. Please note that if this field is set, any updates to the Catalog Item included in the WWS request will not be carried over when the Catalog Load request is approved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_URL" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item URL</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item Lead Time</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Commodity Code Instances associated with the Purchase or Catalog Item. Commodity code is a standard code that identifies the type of goods or service. Example of standard commodity code types are UNSPSC, NIGP etc.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>Catalog Item Spend Category</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UNSPSC_Code" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Item UNSPSC code for Spend Category</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:choice>
<xsd:element name="Alternate_Item_Identifiers" type="wd:Catalog_Load_Alternate_Item_IdentifierType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifiers for Catalog Load items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Item for the Catalog Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item Tags for Catalog Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Primary_Image_Data" type="wd:Primary_Image_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Primary Image for Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Image_Data" type="wd:Additional_Image_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional Image for Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Base_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Base Unit of Measure Reference for Catalog Load Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UN_CEFACT_Base_UOM_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UN CEFACT Common Code to denote Base UOM of Catalog Load Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Catalog_Load_Item_Unit_of_Measure_Data" type="wd:Catalog_Load_Item_Unit_of_Measure_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Catalog Load Item Unit of Measure</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Load Item Packaging String.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Catalog_Load__HV__DataType">
<xsd:annotation>
<xsd:documentation>Element containing Catalog Load Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>A Catalog Load Request for this Supplier Catalog has already been saved as draft or is in progress. Complete or cancel the existing Catalog Load Request before creating a new one.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
