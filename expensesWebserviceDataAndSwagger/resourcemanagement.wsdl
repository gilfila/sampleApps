<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for the Supplier Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier for Supplier or Catalog Item. Select a Supplier that exists in your Workday tenant.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>There is already an update in progress for this supplier information.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Reference" type="wd:Supplier_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Item which is associated with the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Leave Supplier Item Reference blank. You can't submit Supplier Item Reference values when the purchase item isn't assigned this Supplier Item or when creating a new purchase item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Item_Reference" type="wd:Catalog_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Catalog Item which is associated with the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Catalog Item selected ([cat item]) does not have the same Spend Category as the Spend Category entered for the Purchase Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>([item]) is currently inactive as of the current date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Catalog Item selected does not have the same Base Unit of Measure as the Base Unit of Measure entered for the Purchase Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog or Supplier Item Identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier or Catalog Item Description.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Sourcing_Priority" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Sourcing Priority of the Catalog Item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="16"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Item_URL" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog or Supplier Item URL</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier contract(s) for the Catalog or Supplier item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Currency for the Catalog or Supplier item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog or Supplier Item Lead Time</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Packaging String for Catalog Item linked to Purchase Item. Solely used for the Get operation (not the Put operation).</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Used to inactivate an existing Catalog or Supplier Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Pricing_Effective_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Effective date for the UOM. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Calculate_Price_based_on_Conversion_Factor" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to calculate price for Ordering and Just in Time UOMs based on the price entered for the Default Unit of Measure. When advanced pricing applies to a transaction with an undefined UOM, we calculate the price based on the conversion factor of the price rule. This enables you to load 1 price for 1 UOM.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't have more than 1 unit of measure for the same price rule when you enable Calculate Price based on Conversion Factor.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Ordering_Pricing_Data" type="wd:Priority_Ranked_Supplier_Catalog_Item_Ordering_Pricing_DataType" minOccurs="0" maxOccurs="unbounded">
