<xsd:documentation>Ship To Address for RFQ Award PO Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Bill-To Contact Person for RFQ Award Purchase Order Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact_Detail" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill To Contact for RFQ Award PO Defaults</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Address_Reference" type="wd:Unique_IdentifierObjectType">
