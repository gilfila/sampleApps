<xsd:documentation>Notice Period Frequency</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Renewal_Term" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Renewal Term</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Include both Renewal Term and Frequency to Automatically Renew the contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove both Renewal Term and Frequency, or turn on Automatically Renew.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Renewal Term greater than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="3"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Renewal_Term_Frequency_Reference" type="wd:Unit_of_Time_for_ProcurementObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Renewal Term Frequency</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
