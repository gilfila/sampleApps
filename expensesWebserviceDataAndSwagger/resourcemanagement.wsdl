<xsd:complexType name="Supplier_Category_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Supplier Category data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Category_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Category Reference ID. This is the Supplier Category unique identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Category_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for a meaningful Supplier Category Name</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Supplier Category Name is already in use.</xsd:documentation>
<wd:Validation_Message>Enter a unique Supplier Category Name. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Group_DataType">
<xsd:annotation>
