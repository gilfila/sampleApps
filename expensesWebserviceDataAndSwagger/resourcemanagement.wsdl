</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Sourcing_Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Requisition Sourcing Buyer for the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Currency of the Requisition.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Date_On_or_After" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Date_On_or_Before" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Has_Unsourced_Lines" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this to search for Requisitions with unsourced lines</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fully_Sourced" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this to search for fully sourced Requisitions</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to an existing Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Order Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0" maxOccurs="unbounded">
