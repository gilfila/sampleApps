<xsd:sequence>
<xsd:element name="Purchase_Item_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Item ID. This is the Purchase Item unique identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for meaningful Purchase Item Name</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Purchase item name is already used.</xsd:documentation>
<wd:Validation_Message>Enter a unique Item Name. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Commodity Code Instances associated with the Purchase or Catalog Item. Commodity code is a standard code that identifies the type of goods or service. Example of standard commodity code types are UNSPSC, NIGP etc. The commodity code needs to be active and not a parent code to associate to the item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the spend category. A spend category is a classification of items and services that drive the accounting. All expense items are associated with a Spend Category and sales items are associated with a Revenue Category.If a value is provided for sales item, revenue category will default so it is recommended to provide a value for either sales item or revenue category but not both. It is required if sales item is blank.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a Spend Category that isn't used for inventory or do not Default as a Service Request.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot change the spend category for the item since it is used as an item substitute. Remove the item as an item substitute before changing the spend category.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend Category must have procurement usage</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an active spend category. [spend category] is inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Last_Updated" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The exact moment in time this purchase item was last functionally updated - Cannot be updated</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text for Purchase Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form test for Item Identifier. This is not the Item Reference ID, but a non-unique field for providing addition Item identification data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacturer_Part_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>MPN as primary attribute of Purchase Item (starts from v44.0)</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Manufacturer Part ID that isn’t already in use. Manufacturer Part ID is set to Unique in the Maintain Item Identifier Types task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacturer_Reference" type="wd:ManufacturerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Manufacturer as primary Attribute for Purchase Item (starts from v44.0)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_URL" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Item URL</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Document Link URL entered does not comply with URL restrictions set for this Field.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item tags for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Classification_Type_Reference" type="wd:Classification_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Select goods or services for your item. Workday uses this classification for reporting purposes only.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Packaging String for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Currency field for Item Unit Price</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Currency</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id value of the tax applicability.If this is blank and there invoice line has a sales item, Workday will default tax applicability from the sales item. If the invoice line has a tax code then tax applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accounting_Treatment_Reference" type="wd:Accounting_TreatmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Accounting Treatment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_as_Service_Request" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Create as a Service Request Line on the Requisition if adding the Purchase Item via Search Catalog or Add to Cart button. If the flag is false, it will create as a Goods Request Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Group_Reference" type="wd:Purchase_Item_GroupObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Item Group. Assign purchase items to item groups to make it easier to search for and select items. Purchase items can belong to multiple groups.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Related_Worktags_Data" type="wd:Related_Worktag_Widget_DataType" minOccurs="0"/>
<xsd:element name="Preferred_Item" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Controls whether the purchase item is preferred in requisition search.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Set_Reference" type="wd:Unit_of_Measure_SetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to existing Unit of Measure Set</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Base_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Base Unit of Measure Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Base Unit of Measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Item is associated with 1 or more Catalog Items. To change the base unit of measure, first remove any Catalog Item associated with the item</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lot_Control" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if a Purchase Item is Lot Control.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Serial_Control_Method_Reference" type="wd:Serial_Control_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Serial Control Method</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Manufacturer_Required" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if Manufacturer is required on the Lot for the Purchase Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Item_Manufacturers_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if the Item Lot can have only Item Manufacturers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Expiration_Date_Required" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean to indicate if Expiration Date is required for an item lot.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inbound_Alert_Period_in_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Numeric Field to define Tolerance Periods for Purchase Items on Inbound tasks.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="50"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Outbound_Alert_Period_in_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Numeric field to define alert period in days for purchase items on outbound tasks.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="50"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requisition_Fulfillment_Source_Reference" type="wd:Requisition_SourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Fulfillment Requisition Source for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Item_Identifiers_Data" type="wd:Alternate_Item_Identifiers_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Purchase Item Alternate Item Identifiers Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Unit_of_Measure_Data" type="wd:Purchase_Item_Unit_of_Measure_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Purchase Item Stocking Unit of Measures</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Widget_Data" type="wd:Supplier_Item_Widget_Data_for_Purchase_Item_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Item Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Inventory_Attributes_Widget_Data" type="wd:Item_Inventory_Attributes_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Contains information about the Item Inventory Attributes Data associated with the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Substitute_Data" type="wd:Purchase_Item_Substitute_DataType" minOccurs="0"/>
<xsd:element name="Primary_Image_Data" type="wd:Primary_Image_DataType" minOccurs="0"/>
<xsd:element name="Additional_Image_Data" type="wd:Additional_Image_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Maps_To_Sales_Item_Reference" type="wd:Sales_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Sales Item being mapped.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Status_Reference" type="wd:Spend_Item_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Associated Item Status of the Purchase Item.Active: Available for spend transactions.Restricted from Purchasing: Item can't be purchased but can still be requested and fulfilled from available stock.Inactive: Item no longer available for use.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This item can't be inactivated or restricted from purchasing because it's an active item substitute.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requesting_Entity_Reference" type="wd:Requesting_EntityObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Active requesting entities for purchase item. Inactive requesting entities are allowed if requesting entities were inactivated after assigned to a purchase item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more requesting entities are inactive. [InactiveEntities] is/are inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_List_Reference" type="wd:Restricted_Purchase_Item_ListObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Active purchase item lists for purchase item. Inactive purchase item lists are allowed if purchase item lists were inactivated after assigned to a purchase item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more purchase item lists are inactive. [InactivePurchaseItemList] is/are inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Comments" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Comments for purchase item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Attachment_Widget_Data" type="wd:Purchase_Item_Attachment_Widget_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A wrapper element that contains data for Purchase Item Attachments</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="External_Integration_ID_DataType">
<xsd:annotation>
<xsd:documentation>Integration ID Help Text</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="wd:IDType" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="IDType">
<xsd:annotation>
<xsd:documentation>External ID that uniquely identifies the integratable object within the context of the integration system identified by the System ID attribute.</xsd:documentation>
</xsd:annotation>
<xsd:simpleContent>
<xsd:extension base="xsd:string">
<xsd:attribute name="System_ID" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Integration system identifier, part of a two part key (including the text value of the ID element) that uniquely identify integratable object.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>A valid instance of Integration ID must exist for the given System ID.</xsd:documentation>
<wd:Validation_Message>Integration System ID does not exist.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:attribute>
</xsd:extension>
</xsd:simpleContent>
</xsd:complexType>
