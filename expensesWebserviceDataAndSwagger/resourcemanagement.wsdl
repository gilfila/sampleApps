<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="XMLNAME_1st_Priority_Reference" type="wd:Project_Worker_Rate_Standard_Cost_Rate_PriorityObjectType">
<xsd:annotation>
<xsd:documentation>1st Priority for Project Standard Cost Rate Sheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME_2nd_Priority_Reference" type="wd:Project_Worker_Rate_Standard_Cost_Rate_PriorityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>2nd Priority for Project Standard Cost Rate Sheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME_3rd_Priority_Reference" type="wd:Project_Worker_Rate_Standard_Cost_Rate_PriorityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>3rd Priority for Project Standard Cost Rate Sheet</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Cost_Rate_Rule_Standard_Cost_Rate_Detail_Data" type="wd:Project_Cost_Rate_Rule_Standard_Cost_Rate_DetailsType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Cost Rate Rule Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Worker_Rate_Standard_Cost_Rate_Detail_Data" type="wd:Project_Worker_Rate_Standard_Cost_Rate_DetailsType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Worker rates</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Role_Standard_Cost_Rate_Detail_Data" type="wd:Project_Role_Standard_Cost_Rate_DetailsType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Role rates</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element that contains references to existing Internal Service Deliveries to be retrieved.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to existing Internal Service Deliveries to be retrieved via the Get Internal Service Deliveries Web Service operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing criteria used to retrieve Internal Service Deliveries.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing companies.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Provider_Reference" type="wd:Internal_Service_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Internal Service Providers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Document Statuses.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Intercompany_Internal_Service_Delivery" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Is Internal Service Delivery for Intercompany</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Created_by_Workers_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to Workers that created Internal Service Deliveries</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approved_by_Workers_Reference" type="wd:WorkerObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to Workers that approved Internal Service Deliveries</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Catalog_Reference" type="wd:Internal_Service_CatalogObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Internal Service Catalogs</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing the Internal Service Delivery response group.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether attachments should be included when retrieving Service Deliveries.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Internal_Service_Deliveries_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing sub elements for Request Reference, Request Criteria, Response Filter and Response Group to retrieve Internal Service Deliveries</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Internal_Service_Delivery_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that contains references to existing Internal Service Deliveries to be retrieved. Please note that this is mutually exclusive with the Request Criteria element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Internal_Service_Delivery_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing criteria used to retrieve Internal Service Deliveries. Please note that this is mutually exclusive with the Request References element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Parameters that let you filter the data returned in the response. You can filter returned data by dates and page attributes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Internal_Service_Delivery_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing the Internal Service Delivery response group.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Internal Service Delivery Document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Data" type="wd:Internal_Service_Delivery_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire Internal Service Delivery, including Lines (with and without splits) and Attachments.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Response_DataType">
<xsd:annotation>
<xsd:documentation>Topmost Response Element that represents the Reference to the Internal Service Delivery Document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery" type="wd:Internal_Service_Delivery_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Internal Service Delivery Document along with its content</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Internal_Service_Deliveries_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Internal Service Delivery information, including Request References and Criteria.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Internal_Service_Delivery_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that contains references to Service Deliveries to be retrieved via the Get Service Deliveries Web Service operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Internal_Service_Delivery_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that contains criteria used to search for Service Deliveries. It includes Company, Internal Service Provider, Document Status and Document Date range.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Parameters that let you filter the data returned in the response. You can filter returned data by dates and page attributes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Internal_Service_Delivery_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing the Internal Service Delivery Response group.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The "Response_Results" element contains summary information about the data that has been returned from your request including "Total_Results", "Total_Pages", and the current "Page" returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Data" type="wd:Internal_Service_Delivery_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Topmost Response Element that represents the Reference to the Internal Service Delivery Document along with its content</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire Internal Service Delivery, including Lines (with and without splits) and Attachments.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A unique Workday system generated Internal Service Delivery Number. This value cannot be updated, but it can be used to reference the instance of the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company on the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Provider_Reference" type="wd:Internal_Service_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Internal Service Provider that is supplying the services referenced on the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency on the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Date on the Internal Service Delivery. This is the date used to generate accounting.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default Service Date on the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo on the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Status of the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Approved_On_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date on which the Internal Service Delivery was approved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Intercompany_Internal_Service_Delivery" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Internal Service Delivery is Intercompany or not.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Data" type="wd:Internal_Service_Delivery_Line_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents Internal Service Delivery Line information. A Internal Service Delivery may have multiple lines, with or without Splits.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element contains attachments for business document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Line_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents Internal Service Delivery Line information. An Internal Service Delivery may have multiple lines, with or without Splits.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Reference" type="wd:Internal_Service_Delivery_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Number</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Intercompany_Affiliate_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Intercompany Affiliate on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Item_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Catalog Item on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description on the Internal Service Delivery Line. If a Catalog Item is used on the line, then the description of the catalog item is returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category on the Internal Service Delivery Line. If Item is referenced on the Line, then the Item's Spend Category is returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Revenue_Category_Reference" type="wd:Revenue_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Revenue Category on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure on the Internal Service Delivery Line. This is optional and is relevant only if Quantity is also present on the line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost on the Internal Service Delivery line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount on the Internal Service Delivery Line. If Unit Cost and Quantity are present on the line, Extended Amount is always equal to their product.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requester on the Internal Service Delivery line. This could be either an Employee or a Contingent Worker.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date on which the service was requested.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags entered on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Splits_Data" type="wd:Internal_Service_Delivery_Line_Split_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Optional element that represents Split information for the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Line_Split_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element to capture Splits information for a parent Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Line_Split_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Split_Reference" type="wd:Internal_Service_Delivery_Line_SplitObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Split Reference. Only to be used with the Get Web Service to retrieve the Integration ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity for the split line. This is optional and will not be populated when the Internal Service Delivery Line is split by amount.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended amount for the split line. This is an optional field ,but if present it is equal to Quantity times Unit Cost of parent Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Split Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktags on the Internal Service Delivery Line Split</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Expense_Report_for_Non-Worker_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Expense Report reference for update and all Expense Report data items</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Expense Payee for Expense Report must be a non-worker</xsd:documentation>
<wd:Validation_Message>[payee] is not a ~non-worker~.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't change this expense report because the ledger period for the transaction isn't open.</xsd:documentation>
<wd:Validation_Message>You can't change this expense report because the ledger period for the transaction isn't open.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Project Transaction Adjustment Event is in progress for this expense report. You can't cancel or update the expense report until the event completes.</xsd:documentation>
<wd:Validation_Message>The Project Transaction Adjustment Event is in progress for this expense report. You can't cancel or update the expense report until the event completes.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You don't have the permissions required to submit expense reports for payee type.</xsd:documentation>
<wd:Validation_Message>You don't have the permissions required to submit expense reports for [payee type].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Reference" type="wd:Expense_ReportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Expense Report for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
<xsd:element name="Expense_Report_Data" type="wd:Expense_Report_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Submit Expense Report for Non-Worker Request</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Expense_Report_for_Non-Worker_ResponseType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Expense Report Instance</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Report_Reference" type="wd:Expense_ReportObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing expense report.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element used to capture information to create an Internal Service Delivery. It includes subelements to create attachments, Internal Service Delivery Lines and Line Splits.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Line Numbers must be unique within the Internal Service Delivery Document.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Internal Service Provider is either inactive or not valid for the Company selected on the Internal Service Delivery.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one worktag for each type is allowed for the Internal Service Delivery header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type] on Internal Service Delivery header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting worktags are not valid for this transaction - [list of worktag types].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned - [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Reference ID. This is optional and will be auto-generated if left blank on the Web Service request.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate whether the Internal Service Delivery should be submitted to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company to create the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Provider_Reference" type="wd:Internal_Service_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Internal Service Provider (ISP) for the Internal Service Delivery. The ISP should be active and also be associated with the Company specified on the Web Service request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Currency for the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date used to generate accounting for the Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default Service Date for the Internal Service Delivery. If left blank, it is defaulted to the Current System Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Data" type="wd:Internal_Service_Delivery_Line_Data_InboundType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures Internal Service Delivery Line information. An Internal Service Delivery may have multiple lines, with or without Splits.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing all Business Document Attachment data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Internal_Service_Delivery_RequestType">
<xsd:annotation>
<xsd:documentation>Topmost element encapsulating everything needed to create an Internal Service Delivery. It includes a flag to indicate if this operation is add only, Business Process parameters, Reference to an existing Internal Service Delivery and the Internal Service Delivery Data sub-element which represents the contents of the document (including lines, splits and attachments).</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Updates are allowed only for Internal Service Delivery documents that are in Draft, In-Progress or Approved status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Internal Service Delivery, used in update operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Data" type="wd:Internal_Service_Delivery_Data_InboundType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that captures information used to create an Internal Service Delivery. It includes Internal Service Delivery Lines (with or without Splits) and attachments information.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Internal_Service_Delivery_ResponseType">
<xsd:annotation>
<xsd:documentation>Element that contains the Internal Service Delivery created or modified via the Submit Web Service operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Internal Service Delivery document created or modified via the Submit Web Service operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Line_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element that captures Internal Service Delivery Line information, with optional Line Splits.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The following Accounting worktags are not valid for this transaction - [list of worktag types].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog Item [catalog item] on Internal Service Delivery Line [line number] is inactive and cannot be included on the Internal Service Delivery.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Quantity and Unit Cost on Internal Service Delivery Line [line number] or remove item [catalog item] from the line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify UOM on Internal Service Delivery Line [line number] or remove Quantity from the line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Item or Spend Category on Internal Service Delivery Line [line number].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend Category on Internal Service Delivery Line [line number] does not match the Spend Category of item [catalog item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[Service Delivery Company] is not configured to allow intercompany transactions with [I/C affiliate] specified on Internal Service Delivery Line [line number].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Quantity or Unit Cost do not equal zero, the Extended Amount must equal Quantity * Unit Cost</xsd:documentation>
<wd:Validation_Message>Either Quantity and Unit Cost must equal zero or the Extended Amount must equal Quantity * Unit Cost. Currently [Quantity] * [Unit Cost] does not equal [Extended] on Service Delivery Line [Line Number]. Expected Amount: [Calculated Extended Amount].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Total Quantity of Internal Service Delivery Line splits does not match Quantity on Internal Service Delivery Line [line number]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Total Amount of Internal Service Delivery Line splits does not match Extended Amount on Internal Service Delivery Line [line number].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Internal Service Delivery Line [line number] cannot have Splits by Quantity because the Quantity on the line is not a whole number.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Quantity on Internal Service Delivery Line [line number] cannot be less than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Extended Amount on Internal Service Delivery Line [line number] cannot be less than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Internal Service Provider associated with Catalog Item [catalog item] on Service Delivery Line [line number] does not match the Internal Service Provider specified on the document.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Reference ID. This is optional and will be auto-generated if left blank.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Number" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Number. This should be unique for each Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Intercompany_Affiliate_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company. If left blank, Workday will default the Company from the Internal Service Delivery header. If a value is provided, then Workday validates that an appropriate intercompany relationship exists.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Item_Reference" type="wd:Catalog_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Catalog Item. This is optional but if a value is provided then Workday validates that the Catalog Item is active and belongs to the Internal Catalog specified on the Internal Service Delivery Header.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Description of the Service provided.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Revenue_Category_Reference" type="wd:Revenue_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Revenue Category for the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Internal Service Delivery Line. If the Internal Service Delivery Line references a Catalog Item, then Quantity cannot be blank.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Unit of Measure. This is required only if Quantity is also specified on the Internal Service Delivery Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure is invalid for the catalog item. Only defined ordering units of measure for the catalog item can be used.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost of the Service provided. This is required only if Quantity is also specified on the Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Amount. If Unit Cost and Quantity are also specified on the Internal Service Delivery Line, then Extended Amount must equal Unit Cost * Quantity.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Employee or Contingent Worker that requested the Service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date on which the Service was provided. This is optional and if left blank, Workday will default the Delivery Date from the Internal Service Delivery Header.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You have chosen an invalid combination of header company, line company, and intercompany affiliate.</xsd:documentation>
<wd:Validation_Message>The intercompany affiliate [worktag] may not be chosen when specifying header company [header company] and line company [line company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned - [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Line_Splits_Data" type="wd:Internal_Service_Delivery_Line_Splits_Data_InboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures Internal Service Delivery Line Splits information. Populate both Quantity and Extended Amount for Quantity based splits. For Amount based Splits, Quantity should not be entered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Internal_Service_Delivery_Line_Splits_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element that captures Internal Service Delivery Line Splits information. Populate both Quantity and Extended Amount for Quantity based splits. For Amount based Splits, Quantity should not be entered.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The following Accounting worktags are not valid for this transaction - [list of worktag types].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one worktag of each type is allowed</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The quantity on the Internal Service Delivery Line Split must be a whole number. [quantity]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Either Quantity must equal zero or not be present or the Extended Amount must equal Quantity * Unit Cost. Currently [Quantity] * [Unit Cost] does not equal [Extended] on the Service Delivery Line Split.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Quantity on the Internal Service Delivery Line Split cannot be less than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Extended Amount on Internal Service Delivery Line Split cannot be less than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Line_Split_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Split ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on the Internal Service Delivery Line Split. This is optional and must not be included when the Internal Service Delivery Line is split by Amount.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Amount on the Internal Service Delivery Line Split. This is always required and the total Line Split amount must equal the (Unit Cost * Quantity) of the parent Internal Service Delivery Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Internal Service Delivery Line Split Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The intercompany affiliate [worktag] may not be chosen when specifying header company [header company] and line company [line company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned - [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Internal_Service_Delivery_DataType">
<xsd:annotation>
<xsd:documentation>Element that captures the Internal Service Delivery to be canceled, along with a cancellation memo.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Cancellation_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Cancellation memo.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Internal_Service_Delivery_RequestType">
<xsd:annotation>
<xsd:documentation>Start element for canceling an Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Internal Service Delivery being canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Service_Delivery_Data" type="wd:Cancel_Internal_Service_Delivery_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cancel_Internal_Service_Delivery_ResponseType">
<xsd:annotation>
<xsd:documentation>The response element for Cancel Internal Service Delivery.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Internal_Service_Delivery_Reference" type="wd:Internal_Service_DeliveryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Internal Service Delivery being canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Item_Tag_RequestType">
<xsd:annotation>
<xsd:documentation>The element used for creating or updating the item tag.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This Web Service is set to Add Only, but the Item Tag already exist.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference to item tag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Tag_Data" type="wd:Item_Tag_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The data associated to the item tag that you're creating or updating.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Item_Tag_ResponseType">
<xsd:annotation>
<xsd:documentation>The put item tag response element.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item Tag Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Item_Tag_DataType">
<xsd:annotation>
<xsd:documentation>The element that contains the item tag data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The alphanumeric identifier for the item tag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The name of the item tag.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a unique Item Tag Name. [name] is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The description of the item tag.</xsd:documentation>
