<xsd:annotation>
<xsd:documentation>Submit Advanced Ship Notice Response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_Reference" type="wd:Advanced_Ship_NoticeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Advanced Ship Notice Data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>A Purchase Order Goods line is required on Advanced Ship Notice.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase order goods line cannot be referenced more than once in a Advanced Ship Notice.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order is not in Issued status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't submit an advanced ship notice when there's a condition rule to block this action.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Advanced Ship Notice Reference ID. This is optional and will be auto-generated if left blank on the Web Service request.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate whether the Advanced Ship Notice should be submitted to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Auto_Submit_Receipt_for_Approval" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Auto Submit Receipt for Approval</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_Of_Lading" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill Of Lading</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Carrier_Tracking_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Carrier Tracking Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origin_Reference" type="wd:Document_Creation_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References how the how Advance Ship Notice document got created. Possible values for the reference id (Source_Name) are 'Web Service' , 'EDI', 'Manual' .</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Contact</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Order_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType">
<xsd:annotation>
<xsd:documentation>Reference to Purchase Order for which the Advanced Ship Notice is created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comment at ASN document level.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="License_Plate" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>License Plate Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_of_Lading_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill of Lading Quanatity</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="20"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Shipment_Date" type="xsd:dateTime" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-To Address for Advance Ship Notice. If value is not provided defaults to Ship-To Address of Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Ship-To_Address_Global_Location_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>User can provide Global Location Number here; the Location assigned to it will be used to populate the Ship-to Address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Customer_Account_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>User can provide EDI Customer Account Number here; the Location assigned to it will be used to populate the Ship-to Address</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="30"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:choice>
<xsd:element name="Advanced_Ship_Notice_Line_Data" type="wd:Advanced_Ship_Notice_Line_Data_InboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures Advanced Ship Notice Line information. An Advanced Ship Notice can have one or more Advanced Ship Notice Lines</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Document_Attachment_Data" type="wd:Financials_Attachment_with_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Line_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element that captures Advanced Ship Notice Line information.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Goods line [line] does not belong to Purchase Order [po].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Goods Line [line] is fully shipped.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Lot Identifier cannot be referenced more than once for a given Advanced Ship Notice Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Total Lot Quantity should match the Advance Ship Notice Line Shipped Quantity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Shipped Unit Cost cannot be negative</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Conversion Factor has to be greater than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Goods Line [line] is fully received.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line has negative unit cost.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location is invalid for the selected Delivery Type and/or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Can't receive an advanced ship notice against a purchase order line that's Closed for Receiving</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line Number [po line number] is closed and can't be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Shipped Quantity is Required</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Quantity cannot be negative</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Advanced Ship Notice Line Reference ID. This is optional and will be auto-generated if left blank.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Line_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Line Reference.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipped_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipped Quantity on Advanced Ship Notice Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Shipped_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of the Unit Of Measure for the Shipped Quantity. If value is not provided, it defaults to Unit of Measure from the corresponding Purchase Order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipped_Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unit cost of the item specified in the currency associated to the Purchase Order currency. If value is not provided, defaults to unit cost of corresponding line in Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Positive numeric value used to calculate the Ordered Quantity that is shipped from Shipped Quantity provided at Advance Shipment Line. If Shipped Quantity is five and Conversion Factor is two , then Quantity shipped is calculated as Ten. Default value for Conversion Factor is one.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The location where the items will be delivered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Deliver_To_Location_Global_Location_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>User can provide Global Location Number here; the Location assigned to it will be used to populate the Deliver-to Location</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Customer_Account_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>User can provide EDI Customer Account Number here; the Location assigned to it will be used to populate the Deliver-To Location</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="30"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:choice>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Item_Order_LineObjectType">
<xsd:annotation>
<xsd:documentation>Goods line from a Purchase Order for which the Advanced Ship Notice Line is created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Item_Identifier_Data" type="wd:Line_Alternate_Item_Attribute_Value_Data_InboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifiers for Item on Advance Ship Notice Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lot_Information_Data" type="wd:ASN_Line_Lot_Information_Data_InboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that contains Lot Information for Item on Advance Ship Notice Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Resource_Forecast_Configuration_DataType">
<xsd:annotation>
<xsd:documentation>Resource Forecast Configuration Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Set forecast level to either project or task, but not both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not change resource forecast configuration forecast level during update.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set forecast source to percent allocation or estimated hours, but not both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not change resource forecast configuration forecast source during update.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set the forecast frequency to either day, week, or month.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Do not change resource forecast configuration forecast frequency during update.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set Forecast Hours to Decimal or Whole, but not both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Don’t change the resource forecast configuration for whole numbers or decimals during the update.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Forecast_Level" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Level Project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Forecast_Level" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Level Task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Month" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Month.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Day" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Day.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Week" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Week.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_Allocation_Forecast_Source" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Source Percent Allocation</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Estimated_hours_Forecast_Source" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Source Estimated hours</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Hours_Whole" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Whole Number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Hours_Decimal" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Decimal.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Resource_Forecast_Configuration_Get_Webservice_DataType">
<xsd:annotation>
<xsd:documentation>Resource Forecast Configuration data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Forecast_Level" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Level Project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Task_Forecast_Level" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Level Task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Month" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Month.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Day" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Day.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Frequency_Week" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Frequency Week.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_Allocation_Forecast_Source" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Source Percent Allocation</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Estimated_hours_Forecast_Source" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Source Estimated hours</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Whole_Number" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Whole Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Forecast_Decimal" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean representing Forecast Decimal</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Resource_Plan_Detail_for_Template_DataType">
<xsd:annotation>
<xsd:documentation>Contains project resource plan detail template information, such as worker, percent allocation, currency, etc.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Element Content 'Project_Role_Reference' is required, on internal element 'Resource Plan Detail for Template Data'</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Resource Plan Detail cannot be deleted because its used by a Task Resource. Resource Plan Detail:[rpd]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Delete Flag cannot be True if Project Resource Plan Line Reference is not specified or reference doesn't exist.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Resource Plan Line End Date Offset cannot be less than Resource Plan Line Start Date Offset</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot create Unnamed Resource when the To Be Hired Flag is true (Resource Plan Detail: [rpd] Create Additional Unnamed Resources: [UR])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot create Unnamed Resource when the Association Flag is true (Resource Plan Detail: [rpd] Create Additional Unnamed Resources: [UR])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cannot change Resource Plan Detail for Unnamed Resource. Resource Plan Detail: [rpd]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot reference Unnamed Resources if To Be Hired Flag is true. Resource Plan Detail [rpd]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Percent Allocation must be 1 (100%) when Association Flag is True(Resource Plan Line:[rpd] Percent Allocation:[allocation])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worker Group Reference cannot be entered if Association Flag is False (Worker Group Reference:[worker group reference])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Standard Cost Currency Reference is required if Standard Cost Rate is specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot set To Be Hired to true when the Association Flag is true (Resource Plan Detail: [rpd])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Estimated hours not available for association type, only available for assignment type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't reference unnamed resources if the Association Flag is true. Resource Plan Detail [rpd]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Delete" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the resource plan line in the resource plan template is to be deleted.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Plan_Detail_for_Template_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Detail ID. This is the project resource plan detail unique identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Detail Data is not valid for the specified Project Resource Plan. Please specify a new Detail ID or Project Resource Plan. (Detail ID: [detail])</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Role_Reference" type="wd:Project_RoleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The project role associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Role_Category_Reference" type="wd:Project_Role_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The project role category associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date_Offset" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The start date offset associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="End_Date_Offset" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The end date offset associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="isAssociation" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, resource type is 'association' for the resource plan line in the resource plan template, otherwise, resource type is 'assignment'.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Add_Additional_Unnamed_Resources" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Adds the number of unnamed resources in sequence of unnamed resources specified for "Unnamed Resources"</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unnamed_Resource_Data" type="wd:Unnamed_Resource_WWS_Data_for_Resource_Plan_TemplateType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing unnamed resource data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="isToBeHired" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the assigned worker is to be hired for the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_Allocation" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent in decimal format, ex: enter 1 for 100%, .5 for 50%, etc</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Hours" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The estimated hours associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The memo details associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Booking_Status_Reference" type="wd:Project_Booking_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The project booking status associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worker_Group_Reference" type="wd:Project_Member_ResourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The worker group associated to the resource plan line in the resource plan template if ‘association’ type is true. A worker group can be a Job Profile, Resource Pool, Cost Center, or Talent Pool.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Standard_Cost_Rate" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The standard cost rate override associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Standard_Cost_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The standard cost rate currency override associated to the resource plan line in the resource plan template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Advanced_Ship_Notices_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing sub elements for Request Reference, Request Criteria, Response Filter and Response Group to retrieve Advanced Ship Notices</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Advanced_Ship_Notice_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that contains references to existing Advanced Ship Notices to be retrieved. This is mutually exclusive with the Request Criteria element.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Advanced_Ship_Notice_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing criteria used to retrieve Advanced Ship Notices.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Parameters that let you filter the data returned in the response. You can filter returned data by dates and page attributes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Advanced_Ship_Notice_Response_GroupType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing the Advanced Ship Notice response group.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Get_Advanced_Ship_Notices_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Advanced Ship Notice information, including Request References and Criteria.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Advanced_Ship_Notice_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Advanced_Ship_Notice_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Advanced_Ship_Notice_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Advanced_Ship_Notice_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element that contains references to existing Advanced Ship Notices to be retrieved.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_Reference" type="wd:Advanced_Ship_NoticeObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to existing Advanced Ship Notices to be retrieved via the Get Advanced Ship Notices Web Service operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing criteria used to retrieve Advanced Ship Notices. This is mutually exclusive with the Request References element.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company or Company Hierarchy</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing Purchase Orders</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_DateTime_On_or_After" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Date Time On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_DateTime_On_or_Before" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Date Time On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing the Advanced Ship Notice response group.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Attachment_Data" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether attachments should be included when retrieving Advanced Ship Notices.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Response_DataType">
<xsd:annotation>
<xsd:documentation>Root Response Element that represents the Reference to the Advanced Ship Notice Document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice" type="wd:Advanced_Ship_Notice_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Advanced Ship Notice Document along with its content</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the Reference to the Advanced Ship Notice Document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_Reference" type="wd:Advanced_Ship_NoticeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Ship_Notice_Data" type="wd:Advanced_Ship_Notice_Data_OutboundType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire Advanced Ship Notice, Lines and Attachments.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>A unique Workday system generated Advanced Ship Notice Number. This value cannot be updated, but it can be used to reference an instance of Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company on the Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency on the Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Status of the Advanced Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancellation_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Cancellation memo.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Canceled_On_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Cancellation Date of the Business Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_Of_Lading" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill Of Lading</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Carrier_Tracking_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Carrier Tracking Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Order_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Auto-submit_Receipt_for_Approval" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Auto Submit Receipt for Approval</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origin_Reference" type="wd:Document_Creation_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References how the how Advance Ship Notice document got created. Possible values for the reference id (Source_Name) are 'Web Service' , 'EDI', 'Manual' .</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Contact</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-To Address for Advance Ship Notice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="License_Plate" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>License Plate Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_of_Lading_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill of Lading Quanatity</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="20"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comment at ASN document level.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Indicates the Requisition Types for the backing Requisitions</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Ship_Notice_Line_Data" type="wd:Advanced_Ship_Notice_Line_Data_OutboundType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that represents Advanced Ship Notice Line information. An Advanced Ship Notice may have multiple lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_with_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Advanced_Ship_Notice_Line_Data_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that represents Advanced Ship Notice Line information. An Advanced Ship Notice may have multiple lines.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Ship_Notice_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Advanced Ship Notice Line Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Ship_Notice_Line_Reference" type="wd:Advanced_Ship_Notice_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Advanced Ship Notice Line Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Identifier for the Purchase or Catalog Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Purchase Item linked to the Catalog or Punch-out Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipment_Line_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipment Line Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipped_Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of the Unit Of Measure for the Shipped Quantity. If value is not provided, it defaults to Unit of Measure from the corresponding Purchase Order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipped_Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The unit cost of the item specified in the currency associated to the Purchase Order currency. If value is not provided, defaults to unit cost of corresponding line in Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Positive numeric value used to calculate the Ordered Quantity that is shipped from Shipped Quantity provided at Advance Shipment Line. If Shipped Quantity is five and Conversion Factor is two , then Quantity shipped is calculated as Ten. Default value for Conversion Factor is one.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Shipped_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipped Quantity on Advanced Ship Notice Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount on the Advanced Ship Notice Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The location where the items will be delivered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Item_Order_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Goods line from a Purchase Order for which the Advanced Ship Notice Line is created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Item_Identifier_Data" type="wd:Line_Alternate_Item_Attribute_Value_Data_OutboundType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Lot_Information_Data" type="wd:ASN_Line_Lot_Information_Data_OutboundType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Acknowledgement_DataType">
<xsd:annotation>
<xsd:documentation>Contains purchase order acknowledgement header and line data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Purchase Order cannot be acknowledged via this web service if any of the following are true: 1) it is not in an Issued status, 2) it contains contingent worker lines, 3) it is canceled, or 4) It contains lines closed for receiving.</xsd:documentation>
<wd:Validation_Message>This Purchase Order cannot be acknowledged because it is not Issued, has no eligible unacknowledged lines, is for a Contract (Contingent) Worker, or has lines that are closed for receiving.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Acknowledgement_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Refers to the unique purchase order acknowledgement identifier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether or not the POA should be submitted to the business process.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>At least one line must have an acknowledgement status other than unacknowledged.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must provide a purchase order acknowledgement line on the POA.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Refers to a unique, non-editable purchase order acknowledgement number generated by Workday.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType">
<xsd:annotation>
<xsd:documentation>Refers to the purchase order for which the POA is created.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase order must match in both POA line and header.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Acknowledgement_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Acknowledgement Number. This attribute along with purchase order is used to identify the Acknowledgement.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Refers to the Document Status on the Purchase Order Acknowledgement.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="PO_Acknowledgement_Type_Reference" type="wd:PO_Acknowledgement_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Refers to the Acknowledgement Type Code status in the EDI855 specification for POA.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Origin_Reference" type="wd:Document_Creation_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References how the Purchase Order Acknowledgement document got created. Possible values for the reference id (Origin_Reference_ID) are 'Web Service' , 'EDI', 'Manual'.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Refers to POA document comment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Indicates the Requisition Types for the backing Requisitions</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="PO_Acknowledgement_Line_Data" type="wd:PO_Acknowledgement_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Refers to purchase order acknowledgement lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_with_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_Acknowledgement_RequestType">
<xsd:annotation>
<xsd:documentation>Contains purchase order reference and all purchase order acknowledgement data items.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Purchase Order Acknowledgement cannot be submitted. Acknowledgement is not in In Progress or Draft status.</xsd:documentation>
<wd:Validation_Message>The Purchase Order Acknowledgement cannot be submitted. Acknowledgement is not in In Progress or Draft status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Purchase Order Acknowledgements cannot be submitted when the tenant is not set to use this feature.</xsd:documentation>
<wd:Validation_Message>Purchase Order Acknowledgements cannot be submitted when the tenant is not set to use this feature.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Purchase Order Acknowledgement cannot be submitted in invalid status.</xsd:documentation>
<wd:Validation_Message>The Purchase Order Acknowledgement cannot be submitted in invalid status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Acknowledgement_Reference" type="wd:Purchase_Order_AcknowledgementObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Refers to an existing Purchase Order Acknowledgement for update only.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>PO_Acknowledgement_Number</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
