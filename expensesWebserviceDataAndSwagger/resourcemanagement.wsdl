<xsd:documentation>Shipping Terms Reference for Request for Quote Award</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method Reference for Request for Quote Award</xsd:documentation>
