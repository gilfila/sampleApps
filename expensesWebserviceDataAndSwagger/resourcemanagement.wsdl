</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Requisition_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Submit Requisition Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Reference" type="wd:RequisitionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
