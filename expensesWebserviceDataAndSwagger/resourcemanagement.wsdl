<xsd:documentation>Supplier Contract Amendment Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_Amendment_Response_DataType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Amendment" type="wd:Supplier_Contract_AmendmentType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Defaults_for_Supplier_Contract_Amendment_DataType">
<xsd:annotation>
<xsd:documentation>Element that contains purchase order information for supplier contracts</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_for_Purchase_Order_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company for Purchase Order Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType">
<xsd:annotation>
<xsd:documentation>Purchase Order Issue Option</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Payment_Terms_Reference" type="wd:Payment_TermsObjectType">
<xsd:annotation>
<xsd:documentation>Purchase Order Payment Terms Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact_Detail" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bill-To Contact</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Address_Reference" type="wd:Address_ReferenceObjectType">
<xsd:annotation>
<xsd:documentation>Bill-To Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Bill-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Contact_Detail" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Ship-To Contact</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Address_ReferenceObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Ship-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_Amendment_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>This element contains criteria to find Supplier Contract Amendments</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference for Amendment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_Amendment_Service_Line_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Services Lines Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You cannot add and cancel the contract line on the same operation.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The same Line Number cannot be used by more than one Amendment Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Provide a default tax recoverability for the tax applicability</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please specify an Item or an Item Description.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot include Renewal Terms on Supplier Contract Line when the contract type does not support it.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an Extended Amount that has the same negative or positive sign as the requisition line extended amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Line_Number" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Number</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Line Number with 5 characters or less. Only system generated line numbers can be longer.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Line Number must be new or reference a Service Line on the Active Supplier Contract</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't amend a contract line that was auto-renewed.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="20"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Company_for_Invoices_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company for Invoices Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a Company for the supplier contract line that matches the company already used on a generated business document or schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The provided Supplier Contract Type does not allow Scheduled or Manual Invoices. You may not submit an Intercompany Affiliate for Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The line company must have an intercompany profile with the header company/hierarchy.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If Supplier Contract creates obligations, then Supplier Contract Line Company must be the same as the Header company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You entered an invalid Company for Invoices or the contract doesn't support Company for Invoices. When the contract is for company hierarchy or participants, leave the Company for Invoices field blank.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancel_Supplier_Contract_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Line Canceled</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Line On Hold</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there are any Transactions against a Contract Line it cannot be placed On Hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If there is a Schedule against a Contract Line it cannot be placed On Hold.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select an Item that isn't already in use on another contract for the same company or company hierarchy, supplier, and date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot change the Item for a line which already exists on the active Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog items are not allowed on Service Lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You already have pricing setup for the purchase item "[purchase item]" on the purchase item task. You can't set up pricing in 2 different places. View all pricing history on the Supplier Item Contract Pricing tab on the View Supplier Contract report.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>An Item has been provided for this line. You may not submit a Line Item Description different than the one provided by the Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Spend Category is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An Item has been provided for this line. You may not submit a Spend Category other than the expected Spend Category. Either enter the valid Spend Category or leave the field blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot modify the Spend Category for a line which already exists on the active Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tax Applicability Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there is a Tax Code at the line level then the Tax Applicability is Required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tax Code Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an Extended Amount equal to or greater than zero for line number [Line Number]. You can’t enter a negative Extended Amount when there are purchase orders, invoices, or receipts for the contract line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract Line Extended Amount is Required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an Extended Amount that is equal to or greater than: [Consumed Amount] for line number [Line Number]. You’ve already used this amount on purchase orders, invoices, or receipts.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Charge_Control_Data" type="wd:Charge_Control_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Service line charge control amounts for amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention flag at the Line level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Cannot change line level retention if contract line relates to invoice line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't set Retention on supplier contract lines if the contract type configuration does not allow it.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Line Start Date can't be changed because it was Auto Renewed by another contract line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Contract Line Start Date must be less than End Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter contract line end dates.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Line End Date can't be changed because it was Auto Renewed by another contract line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Contract Line End Date that is before the Contract header end date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line_Renewal_Data" type="wd:Supplier_Contract_Line_Renewal_DataType" minOccurs="0"/>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Address Reference for an existing Ship-To Address. If not specified on the Amendment Line, Workday applies defaulting rules to persist a value in this field.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Ship-To Address is not valid for use on the Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may not modify the Ship-To Address Reference for a canceled Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker that will be the designated Ship-To Contact. If not specified on the Amendment line, Workday applies defaulting rules to persist a value in this field.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You may not modify the Ship-To Contact for a canceled Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Location Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The submitted Supplier Contract Type does not allow Receive Contract Lines or Scheduled Purchase Orders. You may not submit a location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The provided location's usage must be set to Business Asset when the line level spend category tracks items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Inactive Location entered</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktags not allowed for companies or hierarchy]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For supplier contract lines tagged with a capital project worktag, the company of the supplier contract must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The intercompany affiliate [worktag] may not be chosen when specifying header company [header company] and line company [line company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove these worktag types that aren't valid for this transaction: [list of worktag types].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_AmendmentType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Amendment_Reference" type="wd:Supplier_Contract_AmendmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Version" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier contract version number</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amendment_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier contract amendment status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Amendment_Data" type="wd:Supplier_Contract_Amendment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Contract_Amendments_RequestType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a supplier contract that is not a lease-type contract. To view lease-type contract amendment information, Use Get Supplier Contract Lease Amendments web service.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Supplier_Contract_Amendment_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Supplier_Contract_Amendment_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Contract_Amendment_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Contract_Amendments_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Contract Amendment response elements including received criteria, references, data based on criteria, results filter and result summary.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Supplier_Contract_Amendment_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Supplier_Contract_Amendment_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Contract_Amendment_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Supplier_Contract_Amendment_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Contract_Amendment_RequestType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can only update amendments with a Draft or In Progress status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid Reference ID for this Web Service</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't amend a supplier contract with an amendment already in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't amend a supplier contract that isn't approved.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't create a new supplier contract amendment when you already have an active supplier contract amendment and the web service is set to Add Only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid Reference ID for this Web Service</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Amendment_Reference" type="wd:Supplier_Contract_AmendmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract Amendment for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Amendment_Data" type="wd:Supplier_Contract_Amendment_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_Amendment_Goods_Line_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Goods Lines Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Provide a default tax recoverability for the tax applicability</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The same Line Number cannot be used by more than one Amendment Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot add and cancel the contract line on the same operation.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter any line renewal data for a consignment supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter line start date, line end date, in service date option, in service date or retention for a consignment supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a consigned quantity for a non-consignment supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a unit cost with a positive value greater than zero. You can't have values less than or equal to zero on consignment supplier contracts, requisitions and purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot include Renewal Terms on Supplier Contract Line when the contract type does not support it.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter stocking or ordering UOMs on a consignment supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Conversion Factor greater than 0. To reduce data discrepancies, you can update the Conversion Factor on purchase item tasks or web services.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Line_Number" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Number</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Line Number with 5 characters or less. Only system generated line numbers can be longer.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Line Number must be new or reference a Goods Line on the Active Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't amend a contract line that was auto-renewed.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="20"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Company_for_Invoices_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company for Invoices Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The provided Supplier Contract Type does not allow Scheduled or Manual Invoices. You may not submit an Intercompany Affiliate for Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a Company for the supplier contract line that matches the company already used on a generated business document or schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When commitment accounting is configured, the company on the supplier contract line must match the header company. Change the company header or cancel the contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The line company must have an intercompany profile with the header company/hierarchy.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If Supplier Contract creates obligations, then Supplier Contract Line Company must be the same as the Header company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You entered an invalid Company for Invoices or the contract doesn't support Company for Invoices. When the contract is for company hierarchy or participants, leave the Company for Invoices field blank.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancel_Supplier_Contract_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Line Canceled</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Line On Hold</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there is a Schedule against a Contract Line it cannot be placed On Hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If there are any Transactions against a Contract Line it cannot be placed On Hold.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Item Reference is not valid because the Catalog Item has been inactivated or has expired. The Line must be Canceled if it is existing, or removed if it is new.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot change the Item for a line which already exists on the active Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract Line Item Reference is required for this Contract Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an Item that isn't already in use on another contract for the same company or company hierarchy, supplier, and date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You already have pricing setup for the purchase item "[purchase item]" on the purchase item task. You can't set up pricing in 2 different places. View all pricing history on the Supplier Item Contract Pricing tab on the View Supplier Contract report.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>An Item has been provided for this line. You may not submit a Line Item Description different than the one provided by the Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If the Spend Category selected for a Contract Line is Intangible the Contract Line's Start Date and End Date are required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If the Spend Category selected for a Contract Line is Intangible the Quantity on that Line must be equal to one.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Spend Category is required for the item on this line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Contract Type selected does not allow Contract Lines to have Intangible Spend Categories.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An Item has been provided for this line. You may not submit a Spend Category other than the expected Spend Category. Either enter the valid Spend Category or leave the field blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot modify the Spend Category for a line which already exists on the active Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tax Applicability Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there is a Tax Code at the line level then the Tax Applicability is Required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tax Code Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Quantity cannot be negative</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Quantity must be 1 when the Spend Category is Intangible.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There is a limit of 500 assets that you can create for this Supplier Contract Line and no Asset Pooling Rule applies. You must either reduce the number of assets or create an Asset Pooling Rule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract Line Quantity is required for this Contract Type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Consigned_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Consigned quantity represents the maximum quantity available to be on hand at a given moment for the consigned product.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure cannot be changed on existing supplier contract lines when the supplier contract type creates obligations.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure is invalid for the catalog item. Only defined ordering units of measure for the catalog item can be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may not modify the Unit of Measure for a canceled Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract Line Unit of Measure Reference is required for this Contract Type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Conversion Factor from Ordering Unit of Measure to Purchase Item's Base Unit of Measure.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Contract Line Unit Cost is required for this Contract Type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Extended Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an extended amount that equals the unit cost multiplied by the quantity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an Extended Amount that is equal to or greater than: [Consumed Amount] for line number [Line Number]. You’ve already used this amount on purchase orders, invoices, or receipts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter an Extended Amount equal to or greater than zero for line number [Line Number]. You can’t enter a negative Extended Amount when there are purchase orders, invoices, or receipts for the contract line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract Line Extended Amount is Required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Charge_Control_Data" type="wd:Charge_Control_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Goods line charge control amounts for amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention flag at the Line level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Cannot change line level retention if contract line relates to invoice line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Line Start Date can't be changed because it was Auto Renewed by another contract line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter contract line end dates.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Contract Line End Date that is before the Contract header end date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Contract Line Start Date must be less than End Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Line End Date can't be changed because it was Auto Renewed by another contract line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="In_Service_Date_Option_Reference" type="wd:Procurement_Date_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the In Service Date Option. Please choose from one of the following options:Supplier Contract cannot be updated using this Web Service. It has either already been Amended, or there are related Schedules or Business Documents using the Contract. Or the Contract has been denied, closed or canceled.In Service Dates are only available for Spend Categories tracking Intangible Assets.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Contract Signed Date must be present if selected as In Service Date Option.</xsd:documentation>
<wd:Validation_Message>Contract Signed Date must be present if selected as In Service Date Option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>In Service Date Options are not allowed when Spend Category does not track Intangible Assets.</xsd:documentation>
<wd:Validation_Message>In Service Date Options are not allowed when Spend Category does not track Intangible Assets.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Selected In Service Date must be greater than or equal to the Contract Start Date.</xsd:documentation>
<wd:Validation_Message>Selected In Service Date must be greater than or equal to the Contract Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Selected In Service Date must be greater than or equal to the Contract Start Date.</xsd:documentation>
<wd:Validation_Message>Selected In Service Date must be greater than or equal to the Contract Start Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Specified_In_Service_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specified In Service Date. Use this field when you wish to specify an In Service Date that isn't one of the available options in the In Service Date Option. In Service Dates are only available for Spend Categories tracking Intangible Assets.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Specified In Service Date must be greater than or equal to the Contract Start Date.</xsd:documentation>
<wd:Validation_Message>Specified In Service Date must be greater than or equal to the Contract Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>In Service Date Options are not allowed when Spend Category does not track Intangible Assets.</xsd:documentation>
<wd:Validation_Message>In Service Date Options are not allowed when Spend Category does not track Intangible Assets.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Supplier_Contract_Line_Renewal_Data" type="wd:Supplier_Contract_Line_Renewal_DataType" minOccurs="0"/>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Address Reference for an existing Ship-To Address. If not specified on the Amendment Line, Workday applies defaulting rules to persist a value in this field.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Ship-To Address is not valid for use on the Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may not modify the Ship-To Address Reference for a canceled Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must submit a Ship-To-Address for this Contract Type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker that will be the designated Ship-To Contact. If not specified on the Amendment line, Workday applies defaulting rules to persist a value in this field.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You may not modify the Ship-To Contact for a canceled Supplier Contract Line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Item_Identifiers_Data" type="wd:Alternate_Item_Identifiers_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Item_Tag_Reference" type="wd:Item_TagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Item tags for Procurement Item on Item Order Line.This field is read-only, and will be ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Line Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Location Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The submitted Supplier Contract Type does not allow Receive Contract Lines or Scheduled Purchase Orders. You may not submit a location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The provided location's usage must be set to Business Asset when the line level spend category tracks items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Inactive Location entered</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktags not allowed for companies or hierarchy]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For supplier contract lines tagged with a capital project worktag, the company of the supplier contract must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The intercompany affiliate [worktag] may not be chosen when specifying header company [header company] and line company [line company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove these worktag types that aren't valid for this transaction: [list of worktag types].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Patient_Charge_Information_ResponseType">
<xsd:annotation>
<xsd:documentation>Put Patient Charge Information Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Item Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Patient_Charge_Information_RequestType">
<xsd:annotation>
<xsd:documentation>Put Patient Charge Information Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This web service is only available if "Enable Patient Charge Information" is enabled on the tenant.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Patient_Charge_Information_Data" type="wd:Patient_Charge_Information_DataType"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Item_Advanced_Pricing_DataType">
<xsd:annotation>
<xsd:documentation>Supplier specific Advanced Pricing rule. Can be an update of existing rule or a new one.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Advanced Pricing is not allowed for a Catalog Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an active Ordering Unit of Measure. This one is either inactive or not defined for this supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an active Just In Time Unit of Measure. This one is either inactive or not defined for this supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a Ship-To Location when you enter a Multi-Participant type Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a Company, Ship-To Location, Supplier Contract, or End Date before you enter a Unit Price.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't have more than 1 unit of measure for the same price rule when you enable Calculate Price based on Conversion Factor.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a currency that matches the currency for the item or the supplier contract. You can leave Currency blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a Supplier Contract when you enter a Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an approved Supplier Contract for the supplier that supports manual invoices or manual purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For different supplier contracts, create a new price rule. You can't change the Supplier Contract for an existing price rule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove or change the price rule. You can’t have more than 1 active price rule with the same combination of Supplier Contract, Ship-To Location, Company, Just In Time, UOM, and an overlapping date range.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You don't have access to this Supplier Contract Reference</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You don't have access to this company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Advanced_Pricing_Reference" type="wd:Supplier_Item_Advanced_PricingObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier specific Advanced Pricing rule being updated.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Advanced Pricing Reference must be for the same supplier and purchase item used for this update.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Advanced_Pricing_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Advanced Pricing rule ID. This is a unique identifier. For imports, if both Advanced Pricing Reference and Advanced Pricing ID are present, the Advanced Pricing Reference is the one being updated, and ID will be used to replaced the ID value on that rule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Advanced Pricing ID must be for the same supplier and purchase item used for this update.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Advanced Pricing ID is already in use. Leave blank, enter a unique ID, or the exact ID used by this Advanced Pricing rule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date for Advanced Pricing. The document date must be on or after this date for the Advanced Pricing rule to apply.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Start Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date for Advanced Pricing. If present, the document date must be on or before this date for the Advanced Pricing rule to apply.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Start Date must be less than the End Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract for Supplier Item Advanced Pricing</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You already have pricing setup for the purchase item on the supplier contract. You can't set up pricing in 2 different places. View all pricing on the Pricing History link on the View Purchase Item report.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>One or more companies for Advanced Pricing. If any is a match for the document company, it is used to determine when to apply an advanced pricing rule.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Organization_Reference_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>One or more entries is not a company or is not on the Supplier ([supplier]) Restricted to Companies list.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid Company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Location_Reference" type="wd:Asset_Location_or_Location_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>One or more locations for Advanced Pricing. If there is a match for the location associated with the Ship-To Address on a transaction line, it is used to determine when to apply an advanced pricing rule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an Active Ship To Location.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Just_In_Time" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Advanced Pricing rule is used for Just In Time document lines, or if not set, for bulk ordering lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>Unit of Measure for Advanced Pricing rule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Price for Advanced Pricing Rule. The currency is the same as the supplier information detail.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Contract_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Price of the Catalog or Supplier Item. This is for informational purposes when using Get Purchase Item web service.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency for Supplier Item Advanced Pricing - Cannot be Updated</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True is the Advanced Pricing rule is inactive.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Priority_Ranked_Supplier_Catalog_Item_JIT_Pricing_DataType">
<xsd:annotation>
<xsd:documentation>Associated JIT Pricing Data for Catalog or Supplier Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't mark a default unit of measure as Inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item_Pricing_Data_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Item JIT Pricing Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>JIT Unit of Measure Reference for the Catalog or Supplier Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Conversion Factor for the JIT UOM of the Catalog or Supplier Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Workday requires Conversion Factor when you have a Base Unit of Measure defined and no Catalog Item is linked.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Price for the JIT UOM of the Catalog or Supplier Item. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Contract_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Price of the Catalog or Supplier Item. This is for informational purposes when using Get Purchase Item web service.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead time for the JIT UOM of the Catalog or Supplier Item. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether this Unit of Measure is the default UOM. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Unit of Measure is inactive. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Priority_Ranked_Supplier_Catalog_Item_Ordering_Pricing_DataType">
<xsd:annotation>
<xsd:documentation>Associated Ordering Pricing Data for Catalog or Supplier Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't mark a default unit of measure as Inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item_Pricing_Data_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Item Ordering Pricing Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>Bulk Unit of Measure Reference for the Catalog or Supplier Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Conversion Factor for the Bulk UOM of the Catalog or Supplier Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Workday requires Conversion Factor when you have a Base Unit of Measure defined and no Catalog Item is linked.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Price of the Ordering UOM of the Catalog or Supplier Item. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Contract_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Price of the Catalog or Supplier Item. This is for informational purposes when using Get Purchase Item web service.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead time for the Bulk UOM of the Catalog or Supplier Item. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether this Unit of Measure is the default UOM. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Minimum_Order_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Minimum order quantity. This field can only be updated for catalog items when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Unit of Measure is inactive. For Supplier items, this field can be updated at anytime, but for Catalog Items, this field can only be updated when you enable catalog data and pricing for your purchase items.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Alternate_Contract_Interest_Rate_DataType">
<xsd:annotation>
<xsd:documentation>Alternate Contract(s) Reference for Interest Rate Modification</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Alternate_Supplier_Contract_ID" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Alternate Supplier Lease Contract Reference for Lease Contract Amendment</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Please enter a valid alternate contract associated with your lease type supplier contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Interest_Rate" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Alternate Contract Interest Rate for Lease Contract Amendment</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Shared_Requisition_Template_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that contains Requisition Template Instance and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template" type="wd:Requisition_Template_WWSType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Invoice_Line_Additional_Data_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Invoice Line additional data response elements, including echoed request data and request result data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Supplier_Invoice_Line_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Supplier_Invoice_Line_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Invoice_Line_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Get_Supplier_Invoice_Line_Additional_Data_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Line_Additional_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper element containing the Supplier Invoice Line additional data for requested references or criteria.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_Reference" type="wd:Supplier_Invoice_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Supplier Invoice Line reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Object_Additional_Data" type="wd:Non_Effective_Dated_Web_Service_Additional_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Supplier_Invoice_Line_Additional_Data_ResponseType">
<xsd:annotation>
<xsd:documentation>Contains the Supplier Invoice Line additional data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_Reference" type="wd:Supplier_Invoice_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Supplier Invoice Line reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Object_Additional_Data" type="wd:Non_Effective_Dated_Web_Service_Additional_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Line_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>This element is the wrapper around a list of elements representing the supplier invoice-specific criteria needed to search for instances.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_Invoice_DocumentObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Supplier Invoice reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Line_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Line Response Group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Supplier_Invoice_Line_Additional_Data_RequestType">
<xsd:annotation>
<xsd:documentation>Contains the Supplier Invoice Line additional data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_Data" type="wd:Supplier_Invoice_Line_Additional_DataType">
<xsd:annotation>
<xsd:documentation>Contains the Supplier Invoice Line additional data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Invoice_Line_Additional_Data_Response_DataType">
<xsd:annotation>
<xsd:documentation>The element contains the Supplier Invoice Line additional data response data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_Additional_Data" type="wd:Supplier_Invoice_Line_Additional_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Line_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>This element contains the specific instance set containing the requested supplier invoice line. The type attribute is either Reference ID type or Workday ID and the ID is the value for the instance of the supplier invoice line.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_Reference" type="wd:Supplier_Invoice_LineObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Supplier Invoice Line reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Invoice_Line_Additional_Data_RequestType">
<xsd:annotation>
<xsd:documentation>Contains the Supplier Invoice Line additional data request data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Supplier_Invoice_Line_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element contains the specific instance set containing the requested supplier invoice line. The type attribute is either Reference ID type or Workday ID and the ID is the value for the instance of the supplier invoice line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Supplier_Invoice_Line_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This element is the wrapper around a list of elements representing the supplier invoice-specific criteria needed to search for instances.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Parameters that enable you to filter the data returned in the response. You can filter returned data by dates and page attributes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Supplier_Invoice_Line_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Invoice Line Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Worker_Utilization_Target_Sheet_DataType">
<xsd:annotation>
<xsd:documentation>Element Container for Worker Utilization Target Sheet Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't edit an inactive Worker Utilization Target Sheet.</wd:Validation_Message>
