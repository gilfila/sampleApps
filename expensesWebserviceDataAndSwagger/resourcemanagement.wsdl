<xsd:complexType name="Purchase_Order_Installment_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Installment Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Please select "Use Installment Overrides" flag if you wish to override the Buyer, Tax Code, Purchase Order Issue Option, Payment Terms,Bill-To Contact, Bill-To Address, Ship-To Contact, Ship-To Address, Payment Type, Procurement Card or Memo.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When creating a new Installment, please provide a unique Installment Number. If updating an existing Installment Please provide an Installment Number, an Installment ID or an Installment Reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Installment Line Data is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You may not update installments with status Canceled, Completed, or In Progress.</xsd:documentation>
<wd:Validation_Message>Cannot update an installment if its status is Canceled, Completed, or In Progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a non-terminated worker for the Buyer Reference field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Ship-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Payment Type for the Purchase Order must be Credit Card in order to assign a Procurement Card to the transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Bill-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Procurement Card isn't valid for Supplier, Buyer, Supplier Contract Specialist or Processing workers. Please select a valid credit card.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a different credit card. The current card is for company [CCCompany] and can't be used on supplier contracts for [TransCompany].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Installment_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Installment Reference ID. This is the Purchase Order Installment unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Installment_Reference" type="wd:Purchase_Order_InstallmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Installment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Installment_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Installment Number for Schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Installment status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Installment Date. This will be the Purchase Order Date for the Installment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="From_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Installment From date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="To_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Installment To date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Purchase Order created from this Installment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Installment On Hold flag</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Installment_Overrides" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Override Line flag. Use this to specify values on the installment line instead of using values derived from either the installment, the schedule, or the contract line. This must be on to specify overrides.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named buyer for the purchase order to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Code to be use as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Issue Option to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Payment Terms to be use as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Bill-To Address to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Contact" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To Address to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Payment Type to be use as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Procurement Card to be used as an override.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Override Installment Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Override Installment Internal Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Installment_Line_Data" type="wd:Supplier_Contract_Installment_Line_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Purchase_Order_Schedule_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Purchase Order Schedule Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Only Distribution Method of "CUSTOM" is currently allowed for Supplier Contract type Schedules.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract Lines provided are for a Supplier Contract that does not allow Purchase Order Schedules.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Either a Date Option or a Day of Month is required if Distribution Method is not Custom.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may provide either the Number of Installments or the To Date but not both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You may provide either a Date Option Reference or a Day of the Month but not both.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Lines must be for the same Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>At Least one Supplier Contract Line provided is used by a different Supplier Contract Schedule. Each Supplier Contract Line may only be used by a single Supplier Contract Schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must submit at least one contract line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>"Automatically regenerate installments" may only be used with Spread Even Distribution Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>In Order to use "Automatically submit schedules" you must also use "Automatically regenerate installments".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Schedule Start Date can't be changed with completed installments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Schedule Number of Installments can't be less than the number of Installments already completed or in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Frequency Behavior can't be changed with already completed Installments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>End Date can't be before the date of completed installments or installments in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Billing Frequency is required unless Billing Method is Custom.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When Schedule Method is not Custom, then Schedule From Date and either Number of Installments or To Date are required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A To Date must be entered when the Date Option is Use To Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A From Date must be entered when the Date Option is Use From Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Contract does not have a Signed Date therefore you cannot select the Contract Signed Date Option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Contract Type does not allow Receipts therefore you cannot select the Receipt Date Option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Day of Month can only be selected with Monthly, Quarterly, or Yearly frequencies.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a Purchase Order Type that is marked Bill Only on the Purchase Order Schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a Purchase Order Type that is marked Consignment on the Purchase Order Schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't specify a third party tax code in the transaction tax code reference.</xsd:documentation>
<wd:Validation_Message>You can't specify a third party tax code in the transaction tax code reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot specify a Withholding tax code in the transaction tax code reference</xsd:documentation>
<wd:Validation_Message>You cannot specify a Withholding tax code in the transaction tax code reference</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a purchase order type that is inactive for the purchase order schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a non-terminated worker for the Buyer Reference field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Ship-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Provided Purchase Order Bill-To Address is Invalid for the Provided Company for Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a different credit card. The current card is for company [CCCompany] and can't be used on supplier contracts for [TransCompany].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Payment Type for the Purchase Order must be Credit Card in order to assign a Procurement Card to the transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Procurement Card isn't valid for Supplier, Buyer, Supplier Contract Specialist or Processing workers. Please select a valid credit card.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Schedule_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Schedule Reference ID. This is the Purchase Order Schedule unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit flag. The service will attempt to submit the schedule if this is on.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Schedule_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Schedule Status</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference element representing the schedule company.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Company provided does not match the Supplier Contract Company from the Supplier Contract Lines provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference element representing the schedule supplier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier provided does not match the Supplier Contract Supplier from the Supplier Contract Lines provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference element representing the schedule currency.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Currency provided does not match the Supplier Contract Currency from the Supplier Contract Lines provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference element representing the schedule supplier contract.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided does not match the Supplier Contract from the Supplier Contract Lines provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Lines_Reference" type="wd:Installment_ItemObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>This is a reference to an existing Supplier Contract Line that isn't used by another Supplier Contract type Schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Schedule_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Schedule Description.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Schedule_On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Schedule On Hold flag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Purchase Order Type for the Supplier Contract Purchase Order Schedule. Note that Purchase Order types that are marked Bill Only cannot be used on the Purchase Order Schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named buyer for the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Issue Option</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType">
<xsd:annotation>
<xsd:documentation>Reference element representing a unique instance of Payment Terms.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Auto-submit_for_Approval" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Auto-Submit Purchase Orders for Approval Flag.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the override Supplier Invoice Payment Type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Procurement Card for the Purchase Order. If provided, the Payment Type reference must be set to Credit Card. If no Override Payment Type is supplied, then the Default Payment Type for the Supplier needs to be Credit Card. Additionally, the Procurement Card must be valid for the Supplier or the Buyer.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Bill-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Ship-To address.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Distribution_Method_Reference" type="wd:Schedule_Distribution_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Supplier Contract type Schedule Distribution Method. Valid values are: - Custom (CUSTOM). - Defined Installment (RECURRING). - Spread Even (EVEN).</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Frequency_Reference" type="wd:Frequency_BehaviorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference element representing the schedule Installment Frequency.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="From_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>From date. The system generates installments based on this value.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="To_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>To date. The system generates installments based on this value.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Number_of_Installments" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Number of installments. The system generates installments based on this value.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either a To Date or a Number of Installments is required if Distribution Method is not Custom.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Date_Option_Reference" type="wd:Procurement_Date_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Date Option used for Installment generation. Valid values are: - Contract Line Start Date (LINE_START). - Contract Signed Date (CONTRACT_SIGNED). - Contract Start Date (CONTRACT_START). - Receipt Date (RECEIPT). - Use From Date (SCHEDULE_FROM_DATE). - Use To Date (SCHEDULE_TO_DATE).</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>None of the Contract Lines selected have a Start Date therefore you cannot select the Contract Line Start Date Option.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Day_of_Month" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Day of Month. The system generates installments based on this value.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Automatically_Regenerate_Installments" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Automatically Regenerate Installments Flag. Use this flag to Regenerate installments when Supplier Contract Amendments are completed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Automatically_Submit_Schedules" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Automatically Submit Schedules Flag. Use this flag when automatically regenerating installments when Supplier Contract Amendments are completed to automatically submit the Supplier Contract type Schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="System_Generated" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Purchase Order Schedule was System Generated. Not enterable for Submit Purchase Order Schedule web service. It is used only by Get Purchase Order Schedule web service.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>System Generated can't be changed. Used only for Get Web Services.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Installment_Replacement_Data" type="wd:Purchase_Order_Installment_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Remove_Supplier_Contract_Line_Hold_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Contract Reference and Lines which are being taken off Hold.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Remove_Supplier_Contract_Line_Hold_Data" type="wd:Remove_Supplier_Contract_Line_Hold_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Add_Supplier_Contract_Line_Hold_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Contract Reference and Lines which are being placed on Hold.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Add Supplier Contract Line Hold Data is Required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_Contract_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Add_Supplier_Contract_Line_Hold_Data" type="wd:Add_Supplier_Contract_Line_Hold_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Add_Supplier_Contract_Line_Hold_ResponseType">
<xsd:annotation>
<xsd:documentation>Response Element to hold Supplier Contract Reference.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Amendment_Reference" type="wd:Supplier_Contract_AmendmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Reference of the new Supplier Contract Amendment created for putting Supplier Contract Lines On Hold.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Remove_Supplier_Contract_Line_Hold_ResponseType">
<xsd:annotation>
<xsd:documentation>Response Element to Hold Supplier Contract Reference.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Amendment_Reference" type="wd:Supplier_Contract_AmendmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Reference of the new Supplier Contract Amendment created when Removing Hold from Supplier Contract Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_Schedule_RequestType">
<xsd:annotation>
<xsd:documentation>Submit Purchase Order Schedule Request</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; documents cannot be resubmitted.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Schedule_Reference" type="wd:Purchase_Order_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Schedule</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Purchase_Order_Schedule_Data" type="wd:Purchase_Order_Schedule_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update. If an existing instance is found and this flag is set there will be an error.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Purchase_Order_Schedule_ResponseType">
<xsd:annotation>
<xsd:documentation>Submit Purchase Order Schedule Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Schedule_Reference" type="wd:Purchase_Order_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Purchase Order Schedule</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_Schedule_DataType">
<xsd:annotation>
<xsd:documentation>An element containing a set of installments.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The number of installments submitted does not match the number of installments requested on the schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The total amounts of the installments must equal the amount of the invoice: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the installment lines must equal the amount of the associated invoice line: [lines]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reference id of the prepaid spend amortization schedule. If this is entered, then the Supplier Invoice ID cannot.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reference id of the supplier invoice this schedule is connected to. If this is entered than the Schedule ID cannot.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Prepaid_Spend_Amortization_Installment_Data" type="wd:Prepaid_Spend_Amortization_Installment_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The set of installments that make up this schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Prepaid_Spend_Amortization_Schedule_RequestType">
<xsd:annotation>
<xsd:documentation>The request for creating/updating a Prepaid Spend Amortization Schedule</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Unable to proceed. A Supplier Invoice or Prepaid Spend Amortization Schedule must be referenced.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Reference" type="wd:Prepaid_Spend_Amortization_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to a Prepaid Spend Amortization Schedule. This is used to update an existing schedule. If this is entered, then the Supplier Invoice reference cannot.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_InvoiceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to a Supplier Invoice. If this is used then the Prepaid Spend Amortization Schedule Reference cannot.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Data" type="wd:Prepaid_Spend_Amortization_Schedule_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Prepaid_Spend_Amortization_Schedule_ResponseType">
<xsd:annotation>
<xsd:documentation>The complete response from the get request.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Reference" type="wd:Prepaid_Spend_Amortization_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The schedule returned by the search criteria.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_Installment_DataType">
<xsd:annotation>
<xsd:documentation>Data representing one installment for the Prepaid Spend Amortization Schedule. An installment can be made up of many installment lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an installment reference ID to update existing Prepaid Spend Amortization Installments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Prepaid Spend Amortization Installment Reference provided doesn't belong to the Schedule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Prepaid_Spend_Amortization_Installment_Reference" type="wd:Prepaid_Spend_Amortization_InstallmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference to the installment that is being updated.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accounting_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date that accounting will use. This must match the start date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid_Spend_Amortization_Installment_Line_Data" type="wd:Prepaid_Spend_Amortization_Installment_Line_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>A set of lines that make up this installment</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_Installment_Line_DataType">
<xsd:annotation>
<xsd:documentation>Data representing one installment line for an installment.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Line_or_Accounting_Adjustment_Line_Reference" type="wd:Installment_ItemObjectType">
<xsd:annotation>
<xsd:documentation>The supplier invoice line or accounting adjustment line this installment line references. The supplier invoice line can also be a split line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The selected Invoice Line is not Prepaid. Please select only prepaid lines for creating the Spend Amortization installments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Referenced Supplier Invoice ([invoice]) does not match entered line: [invoice line].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The selected Account Adjustment Line is not Prepaid. Please select only prepaid lines for creating the Spend Amortization installments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Referenced Accounting Adjustment ([accounting adjustment]) does not match entered line: [accounting adjustment line].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount of the installment line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Accounting Worktags of the installment line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company Selected: [comp] does not match on an Award Line in effect for Grant Worktag: [grant]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Transactions for contingent workers cannot have contingent worker worktags on lines. Please remove the contingent worker worktag.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For supplier invoice lines tagged with a capital project worktag, the company of the invoice line must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't add or remove billable project worktags to installments on a prepaid spend amortization schedule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Remove_Supplier_Contract_Line_Hold_DataType">
<xsd:annotation>
<xsd:documentation>Element that Contains Remove Supplier Contract Line Hold Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>When Removing Lines from Hold the Line Extended Amount cannot exceed the Total Contract Amount. If this change is necessary make an Amendment to the Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided may not be used because it is Closed, Terminated or Locked in Workday.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided must be in Approved Status and must not be changeable to be used by this Web Service task. You may use the Submit Supplier Contract Web Service task to set the lines on hold for this contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided may not be used because it is related to an inactive Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Line Remove Hold Data is Required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Workday doesn't support the Remove Supplier Line Hold web service for consignment contract types. Workday suggests you use the Submit Supplier Contract web service for this supplier contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a charge control for this contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot Remove Hold from a Supplier Contract Line if it is not already on Hold, at least one of the Supplier Contract Lines submitted is not On Hold.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_Contract_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submit the currency that matches the original currency of the supplier contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Line_Remove_Hold_Data" type="wd:Supplier_Contract_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Contract Goods Line Hold Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Line_Remove_Hold_Data" type="wd:Supplier_Contract_Service_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Goods_Line_Add_Hold_DataType">
<xsd:annotation>
<xsd:documentation>Goods Line Add Hold Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there are any transactions or schedules against the contract line, that line cannot be placed On Hold</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Line Number, representing the Supplier Contract Line to be put On Hold, is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A valid Line Number for the provided Supplier Contract is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Line Number provided is already on Hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a unique value for the Line Number attribute.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the Supplier Contract Line Number for the Supplier Contract Line you wish to put on Hold.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="20"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Add_Supplier_Contract_Line_Hold_DataType">
<xsd:annotation>
<xsd:documentation>Add Supplier Contract Line Hold Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided may not be used because it is related to an inactive Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided does not have any lines eligible for putting on Hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided must be in Approved Status and must not be changeable to be used by this Web Service task. You may use the Submit Supplier Contract Web Service task to set the lines on hold for this contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[validation text]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A valid Supplier Contract reference or ID is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract provided may not be used because it is Closed, Terminated or Locked in Workday.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Lines Hold status can't be changed for Financial or Operating Lease Contract Types.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The current user doesn't have permission to access information for the Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Line_Add_Hold_Data" type="wd:Goods_Line_Add_Hold_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_Schedule_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>List all the references to the schedules that should be returned.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Reference" type="wd:Prepaid_Spend_Amortization_ScheduleObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>A set of references to schedules to return.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Prepaid_Spend_Amortization_Schedules_RequestType">
<xsd:annotation>
<xsd:documentation>Specify which criteria to use to find all the requested schedules.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Prepaid_Spend_Amortization_Schedule_Request_ReferencesType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Prepaid_Spend_Amortization_Schedule_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_ScheduleType">
<xsd:annotation>
<xsd:documentation>One schedule that was found along with the installments.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Reference" type="wd:Prepaid_Spend_Amortization_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The reference of this schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid_Spend_Amortization_Schedule_Data" type="wd:Prepaid_Spend_Amortization_Schedule_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Prepaid_Spend_Amortization_Schedule_Response_DataType">
<xsd:annotation>
<xsd:documentation>A list of all the schedules that were found.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Prepaid_Spend_Amortization_Schedule" type="wd:Prepaid_Spend_Amortization_ScheduleType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>One schedule that was found along with the installments.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Prepaid_Spend_Amortization_Schedules_ResponseType">
<xsd:annotation>
<xsd:documentation>The complete response. It shows the references used in the search along with the results.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Prepaid_Spend_Amortization_Schedule_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Prepaid_Spend_Amortization_Schedule_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Prepaid_Spend_Amortization_Schedule_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Asset_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Project Asset Reference</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Asset_Reference" type="wd:Project_AssetObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Project Asset Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Asset_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Get Project Asset Request Criteria</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Containing_Project_Asset_Reference" type="wd:ProjectObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Project that contains the Asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Asset_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Group</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Include_Project_Asset_Data" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Project Asset Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Project_Asset_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Project Asset data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Project_Asset_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Project_Asset_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Project_Asset_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_AssetType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Project Risk Instance and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Asset_Reference" type="wd:Project_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Asset_Data" type="wd:Project_Asset_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project_Asset_Response_DataType">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Asset" type="wd:Project_AssetType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Project Asset Instance and Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Project_Asset_ResponseType">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Project_Asset_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Project_Asset_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Project_Asset_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Project_Asset_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Asset Response Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_Asset_DataType">
<xsd:annotation>
<xsd:documentation>Project Asset Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Specify the rule evaluation order for the project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Asset_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for the project asset</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType">
<xsd:annotation>
<xsd:documentation>Project reference for the project asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for a meaningful Project Asset Name - this is required for creating a project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field containing the description of the project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>Tracking Spend Category Reference for the project asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Asset_Assignment_Rule_Reference" type="wd:Capital_Project_Asset_Assignment_RuleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Specify an existing assignment rule for auto-assigning the project asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Asset_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The number of business assets that will be generated when the project asset is capitalized.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Uncapitalized_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>READ ONLY: Total cost associated with the project asset that has not been capitalized. Amount returned in the associated project's currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Capitalized_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>READ ONLY: Total capitalized cost of project asset returned in the associated project's currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Project_Asset_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>READ ONLY: Total cost associated with the project asset returned in the associated project's currency.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Capitalization_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Capitalization date for the project asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Assets_Detail" type="wd:Business_Assets_Detail_WWS_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>READ ONLY: Business assets for the project asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acquisition_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>READ ONLY: Acquisition date for the project asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Project_Asset_RequestType">
<xsd:annotation>
<xsd:documentation>Request Element for Putting a Project Asset via a Web Service</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; but the Project Asset already exists.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; but the Project Asset already exists.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Project assigned to existing Project Asset cannot be edited.</xsd:documentation>
<wd:Validation_Message>Project assigned to existing Project Asset cannot be edited.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Category cannot be modified for Project Asset with Business Asset</xsd:documentation>
<wd:Validation_Message>Spend Category cannot be modified for Project Asset with Business Asset</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>To add a project asset, the project must be a capital project.</xsd:documentation>
<wd:Validation_Message>To add a project asset, the project must be a capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Specify a Capitalization Date for assets in Pending Registration status.</xsd:documentation>
<wd:Validation_Message>Specify a Capitalization Date for assets in Pending Registration status.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can only change the Capitalization Date when the asset status is Pending Registration.</xsd:documentation>
<wd:Validation_Message>You can only change the Capitalization Date when the asset status is Pending Registration.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't modify quantities for project assets that contain capitalized costs.</xsd:documentation>
<wd:Validation_Message>You can't modify quantities for project assets that contain capitalized costs.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Project Asset Quantity must be between 1 and 500. Enter a valid quantity.</xsd:documentation>
<wd:Validation_Message>The Project Asset Quantity must be between 1 and 500. Enter a valid quantity.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Asset_Reference" type="wd:Project_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project Asset for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Asset_Data" type="wd:Project_Asset_DataType"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Project_Asset_ResponseType">
<xsd:annotation>
<xsd:documentation>Response after Putting a Project Asset.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Asset_Reference" type="wd:Project_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Asset Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Resume_Asset_Depreciation_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing data needed to resume asset depreciation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Resume_Asset_Depreciation_Data" type="wd:Resume_Asset_Depreciation_for_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Resume_Asset_Depreciation_for_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Business Asset data to resume an asset.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>There is a pending event for the asset that should be completed before this asset transaction can be processed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Resume date cannot be EARLIER than last suspend date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When depreciation is based on the number of days per period, all the fiscal years / periods for an asset's useful life must already be created in order to calculate the depreciation amount for each period correctly. In order to complete the accounting setup for this asset, you will first need to create additional fiscal years / periods for the fiscal schedule of this asset's company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The date for suspending depreciation is in the future. To resume depreciation, enter the same future date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Cannot resume this asset since it is not in out of service.</xsd:documentation>
<wd:Validation_Message>Cannot resume this asset since it is not in out of service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Depreciation has been posted for periods affected by resume date</xsd:documentation>
<wd:Validation_Message>Depreciation has been posted for periods affected by resume date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You cannot resume asset depreciation for a book that is not suspended.</xsd:documentation>
<wd:Validation_Message>You cannot resume asset depreciation for a book that is not suspended.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Resume Date cannot be earlier than the last depreciation start date for any asset lifecycle event that records depreciation (such as Issue or Transfer).</xsd:documentation>
<wd:Validation_Message>Resume Date cannot be earlier than the last depreciation start date for any asset lifecycle event that records depreciation (such as Issue or Transfer).</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>The Asset one would like to resume depreciation for.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The asset is part of a lease contract. You can't resume depreciation on leased assets.</xsd:documentation>
<wd:Validation_Message>The asset is part of a lease contract. You can't resume depreciation on leased assets.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Effective_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Resume depreciation transaction date is required for all requests.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Fiscal period must exist for the resume depreciation transaction date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Restricted_to_Books_Reference" type="wd:Asset_BookObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Resume depreciation restricted to books is required for all requests.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Resume_Asset_Depreciation_ResponseType">
<xsd:annotation>
<xsd:documentation>Returns the asset that had its depreciation resumed.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reference" type="wd:Business_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Returns the asset that had its depreciation resumed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_Rule_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing request references for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule_Reference" type="wd:Asset_Pooling_RuleObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing asset pooling rule to which the asset pooling rule data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_Rule_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing request criteria for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_Rule_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing response group for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference boolean element</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Asset_Pooling_Rules_RequestType">
<xsd:annotation>
<xsd:documentation>Request element for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Asset_Pooling_Rule_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Asset_Pooling_Rule_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing request criteria for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Asset_Pooling_Rule_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing response group for the asset pooling rules operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_Rule_Response_DataType">
<xsd:annotation>
<xsd:documentation>Response element for the Asset Pooling Rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule" type="wd:Asset_Pooling_RuleType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all Asset Pooling Rules</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Asset_Pooling_Rules_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing request and response elements for the asset pooling rule operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Asset_Pooling_Rule_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Asset_Pooling_Rule_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Asset_Pooling_Rule_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Asset_Pooling_Rule_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_Rule_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing asset pooling rule replacement data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either Spend Category or Item must be specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Put Asset Pooling Rule web service cannot be used to edit an existing rule; it can only add rules, or replace all rules.</xsd:documentation>
<wd:Validation_Message>Use another ID for the Asset Pooling Rule or unset the Add Only attribute. An Asset Pooling Rule Rule already exists for the ID [ID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Rule order must be unique.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is a unique reference identifier to the set of asset pooling rules.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Pooling_Rule_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Used to define the order of the rules (ascending).</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing companies or company hierarchies to which the asset pooling rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more companies for a rule for Spend Category ([spend category]) have a company currency that does not match the currency specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Organization ID. The ID you submitted is invalid for your request.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Company or company hierarchy type of organization.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_or_Hierarchy_Reference" type="wd:Spend_Category_or_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing spend categories or spend category hierarchies to which the asset pooling rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid Spend Category. This spend category cannot be tracked in Business Assets</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Items_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing item to which the asset pooling rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more items is invalid because it does not belong to a trackable Spend Category.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing currency to which the asset pooling rule applies. This is required if Less Than Amount is specified.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Currency is required when Unit Cost Less Than is specified.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity_Greater_Than" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The quantity above which the asset pooling rule applies. Quantity must be greater than zero.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Quantity must be greater than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The amount entered has too many digits beyond the decimal point.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Cost_Threshold" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount below which the asset pooling rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Unit Cost cannot be negative</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Pooling_RuleType">
<xsd:annotation>
<xsd:documentation>Element containing a reference to an existing asset pooling rule and its asset pooling rule data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule_Reference" type="wd:Asset_Pooling_RuleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing asset pooling rule to which the asset pooling rule data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Pooling_Rule_Data" type="wd:Asset_Pooling_Rule_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all the Asset Pooling Rules</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Asset_Pooling_Rule_RequestType">
<xsd:annotation>
<xsd:documentation>Root element for the Request on the Asset Pooling Rules operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule_Data" type="wd:Asset_Pooling_Rule_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing all Asset Pooling Rules</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Enable to ensure that the request will not delete or modify any existing Asset Pooling Rules.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Asset_Pooling_Rule_ResponseType">
<xsd:annotation>
<xsd:documentation>Root element for the Response on the Put operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Pooling_Rule_Reference" type="wd:Asset_Pooling_RuleObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to all Asset Pooling Rules</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Intermediary_Bank_Account_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Intermediary Bank Account information including Order, Bank Account Type, Currency, Routing Transit Number, etc.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Multiple Intermediary Banks cannot share the same Order value. More than one Intermediary Bank currently has an order of [order].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid IBAN number.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Country field is required for this bank account</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify only 1 intermediary bank address as primary.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify the same country for the intermediary bank account and the associated intermediary bank addresses.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a primary intermediary bank address.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Business for Type. Business is the only valid value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify Remit To in the Use For and Use For Tenanted fields.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Support for submitting intermediary bank accounts is only on the Put Ad Hoc Payee, Miscellaneous Payee, Submit Supplier and Submit Customer web services.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an IBAN in uppercase characters without spaces.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Intermediary_Bank_Account_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Intermediary Bank Account ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Intermediary_Bank_Order" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Alphanumeric order of the Intermediary Banks. Two Intermediary Banks for the same Settlement Account cannot share the same order value.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Two Intermediary Banks cannot share the same Order value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Country_Reference" type="wd:CountryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Country Reference is a unique reference to a Country</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference is a unique reference to a Currency</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Account_Nickname" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bank Account Nickname</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Account_Type_Reference" type="wd:Bank_Account_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Bank Account Type Reference is a unique reference to a Bank Account</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bank Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Routing_Transit_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Routing Transit Number must adhere to bank routing account standards.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Branch_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Branch ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Branch_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Branch Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Account_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bank Account Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Check_Digit" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Collects the check digit when it is not part of the bank id number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Account_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Collects the bank account name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Roll_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Collects the Roll number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="IBAN" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>International Bank Account Number (IBAN)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="SWIFT_Bank_Identification_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Society for Worldwide Interbank Financial Telecommunication (SWIFT) Bank Identification Code (BIC)</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Bank Identification Code (BIC) standard format can be between 8 to 11 characters. Generally, it should not be less than 8 characters or exceed 11 characters.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Bank Identification Code (BIC) entry is not following a standard format. Please refer to SWIFT guidelines for the format details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Bank Identification Code (BIC) standard format can be between 8 to 11 characters. Generally, it should not be less than 8 characters or exceed 11 characters.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
