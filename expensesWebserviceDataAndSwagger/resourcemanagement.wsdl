<xsd:annotation>
<xsd:documentation>Origin for the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company. Sets the Company for the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver-To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Deliver-To Location. Sets the Deliver-To Location for the Requisition. If Requisition Type is Par Replenishment, Par Location will be Deliver-To Location and this field will be ignored. If not specified on the Requisition, Workday will default the workspace or the business site of the Requisition Worker as the Deliver-To Location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Data" type="wd:Ship_to_Address_for_RequisitionType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship To Address Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reason_Code_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Reason Code for a Closed or Canceled requisition. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Comments" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comments for a Closed or Canceled Requisition. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requester_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Requesting Worker for the Requisition</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requesting_Entity_Reference" type="wd:Requesting_Entity_AbstractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requesting Entity Reference for Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo_to_Suppliers" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional Memo for the Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Link for Requisition</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Document Link URL entered does not comply with URL restrictions set for this Field.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional internal memo for the Requisition.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional addition of Freight Amount for the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a positive Freight Amount value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Other_Charges" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional addition of Other Charges for the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a positive Other Charges value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Procurement_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Procurement Card to be used in consideration for paying for the goods and services on the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Credit_Card_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>The Procurement Credit Card Reference provided is not valid for the Requisition. Please use an active procurement card valid for the Requestor or Processing Worker valid for the Company on the Requisition.</xsd:documentation>
<wd:Validation_Message>The Procurement Credit Card Reference provided is not valid for the Requisition. Please use an active procurement card valid for the Requestor or Processing Worker valid for the Company on the Requisition.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="High_Priority" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Is Requisition High Priority?</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Consolidate_Requisition_on_PO" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contains consolidation option of purchase orders for requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Ship_To_Address_When_Consolidating_Requisition_Lines" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Dictates whether Requisition Lines will be not consolidated by Ship-To Address when creating a Purchase Order during the sourcing process. If set to true, the result will be a Purchase Order with different line Ship-To Addresses.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procedure_Information_Data" type="wd:Procedure_Information_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Procedure Information associated with the Bill Only Requisition.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Request_Line_Data" type="wd:Item_Request_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing all Goods Requisition Line data. A Requisition may have multiple goods requisition lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Request_Line_Data" type="wd:Service_Request_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Service Requisition Line data. A Requisition may have multiple service requisition lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliverables_Line_Data" type="wd:Project-Based_Requisition_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Project-Based Requisition Line data. A Requisition may have multiple Project-Based requisition lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_And_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Refers to a requisition attachment. Multiple attachments are allowed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ad_Hoc_Address_Replacement_Data" type="wd:Address_Information_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing Ad Hoc Address information. Including address information will delete any existing address from the requisition and create a new address instance. If updating a requisition that currently contains an ad hoc address, omitting the ad hoc address element will leave the existing ad hoc address unaffected, which is likely the desired behavior. Only include the ad hoc address information when updating the requisition if the desired affect is to replace the current address with a new address instance.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Book_Rule_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing request references for the asset book rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing asset book to which the asset book rule data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Asset_Book_Rules_RequestType">
<xsd:annotation>
<xsd:documentation>Request element for the asset book rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Asset_Book_Rule_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Asset_Book_Rule_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing request criteria for the asset book rules operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Asset_Book_Rule_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing response group for the asset book rules operation</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Book_RuleType">
<xsd:annotation>
<xsd:documentation>Element containing a reference to an existing asset book and all its asset book rule data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing asset book to which the asset book rule data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Book_Rule_Data" type="wd:Asset_Book_Rule_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Book_Rule_Response_DataType">
<xsd:annotation>
<xsd:documentation>Response element for the Asset Book Rules operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Rule" type="wd:Asset_Book_RuleType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Asset_Book_Rules_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing request and response elements for the asset book rule operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Asset_Book_Rule_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Asset_Book_Rule_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Asset_Book_Rule_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Asset_Book_Rule_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Book_Rule_DataType">
<xsd:annotation>
<xsd:documentation>Element containing the Asset Book and all its corresponding Asset Book Rules</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an asset book to which the asset bool rules apply.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Book_Rule_Replacement_Data" type="wd:Asset_Book_Rule_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Book_Rule_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing asset book rule replacement data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Put Asset Book Rules web service cannot be used to edit an existing rule; it can only add rules, or replace all rules.</xsd:documentation>
<wd:Validation_Message>Use another ID for the Asset Book Rule or unset the Add Only attribute. An Asset Book Rule already exists for the ID [ID].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Rule order must be unique.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is a unique reference identifier to the set of asset book rules.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Book_Rule_Order" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Used to define the order of the rules (ascending).</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_or_Hierarchy_Reference" type="wd:Spend_Category_or_HierarchyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing spend categories or spend category hierarchies to which the asset book rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid Spend Category. This spend category cannot be tracked in Business Assets</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Class_Reference" type="wd:Asset_ClassObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing asset classes to which the asset book rule applies.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Type_Reference" type="wd:Asset_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing asset types to which the asset book rule applies.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing companies or company hierarchies to which the asset book rule applies.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more companies for a rule for Spend Category ([spend category]) have a company currency that does not match the currency specified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Organization ID. The ID you submitted is invalid for your request.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Company or company hierarchy type of organization.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing currency to which the asset book rule applies. This is required if Greater than Amount is specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Amount_Threshold" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount above which the asset book rule applies.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Amount_Basis_Reference" type="wd:Business_Asset_Amount_BasisObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to UNIT or EXTENDED Amount basis reference. This is required when specifying 'Greater Than Amount'.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Either amount, currency and amount basis must all be entered, or all three fields must be blank.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accounting_Treatment_Reference" type="wd:Accounting_TreatmentObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the resulting accounting treatment for the asset book rule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>When spend category is intangible, asset book rules should return accounting treatment of Depreciable Capital.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a valid accounting treatment. The Inventory Asset accounting treatment isn’t valid for assets.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Depreciation_Profile_Reference" type="wd:Depreciation_ProfileObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the resulting depreciation profile for the asset book rule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Depreciation profile is required for depreciable capital accounting treatments. If accounting treatment is expense or non-depreciable capital, then depreciation profile should be blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active depreciation profile. This depreciation profile is inactive: [depreciation profile].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Asset_Book_Rules_RequestType">
<xsd:annotation>
<xsd:documentation>Root element for the Request on the Asset Book Rules operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Rule_Data" type="wd:Asset_Book_Rule_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Enable to ensure that the request will not delete or modify any existing Asset Book Rules.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Asset_Book_Rules_ResponseType">
<xsd:annotation>
<xsd:documentation>Root element for the Response on the Put operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing asset book to which the asset book rule data applies</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Item_Request_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Goods Requisition Line data. A Requisition may have multiple goods requisition lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Quantity cannot be negative</xsd:documentation>
<wd:Validation_Message>Quantity cannot be negative</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Please specify an Item or a Spend Category.</xsd:documentation>
<wd:Validation_Message>Please specify an Item or a Spend Category.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the quantities on the split lines ([split qty]) must equal the quantity of the summary line: [qty]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity must be greater than zero and cannot be partial when the document line's spend category is Tracked (unless related to a supplier contract line).</xsd:documentation>
<wd:Validation_Message>Quantity must be greater than zero and cannot be partial when the document line's spend category is Tracked (unless related to a supplier contract line).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For Punchout Line (WID:[wid]), if a Supplier Contract is entered, it must match the one configured for the Supplier Link for Punchout. If none is configured, no Supplier Contract can be entered. Entered Supplier Contract: ([contract]). Configured Supplier Contract: ([expected contract]).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog Item: ([item]) is not valid for the Company, Supplier, and Requisition Date or the entered Supplier Contract: ([contract]) does not match the expected Supplier Contract: ([expected contract]). The contract must also allow manual requisitioning and purchasing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract is not valid for the Company, Supplier, and Requisition Date. The contract must also allow manual requisitioning and purchasing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must use "Source This Line" to use "Mark Purchase Order As Issued".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier Reference is required to use "Source This Line".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source cannot have value when RFQ required is enable for Item Goods Line</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source needs to be purchase order when Requisition Type is Inventory Replenishment enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ad-hoc Item Goods Line needs to have Fulfillment source as Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source cannot be 'Inventory' when Spend Category is not enabled for stock items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Negative priced line(s) cannot be included on an Inventory Replenishment Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Requisition Line Splits cannot be split by amount on Inventory Replenishment Requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier catalog item must be associated to a purchase item for it to be used on inventory replenishment requisition</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Requested Delivery Date that is on or after the Document Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Non-Catalog items are not allowed for the selected requisition type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Ship-To Address is not valid for use on the Requisition Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location is invalid for the selected Delivery Type and/or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location for a Par Replenishment Requisition must match the Par Location specified on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location for an Inventory Replenishment Requisition must either be the Requesting Inventory Site or one of its stocking locations.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Unit of measure is required on item lines.</xsd:documentation>
<wd:Validation_Message>Unit of measure is required on item lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only the purchase item unit of measure on the supplier contract line is valid.</xsd:documentation>
<wd:Validation_Message>Only the purchase item unit of measure on the supplier contract line is valid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>For stock items, only the Ordering, Base or Stocking Unit of Measure is valid.</xsd:documentation>
<wd:Validation_Message>For stock items, only the Ordering, Base or Stocking Unit of Measure is valid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The field Tax Applicability is required and must have a value.</xsd:documentation>
<wd:Validation_Message>The field Tax Applicability is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Provide a default tax recoverability for the tax applicability</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For requisition lines tagged with a capital project worktag, the company of the requisition must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier Item Identifiers cannot be set or updated for lines with no items or having non-catalog items. Catalog Items also have Supplier Item Identifiers, but we cannot change the existing value using this web service. For this web service, Web items will not trigger this validation, but any entered Supplier Item Identifier will be ignored and the original value from the web item will be kept.</xsd:documentation>
<wd:Validation_Message>Supplier Item Identifier cannot be changed for catalog items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select an item with a valid Just In Time Unit of Measure for Just In Time requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only the issue Unit of Measure is valid.</xsd:documentation>
<wd:Validation_Message>Only the issue Unit of Measure is valid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Unit Cost submitted ([submitted]) must match Unit Cost calculated from Unit of Measure and Purchase Item Unit Cost ([calculated]).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the purchase item ordering unit of measure is a valid unit of measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the default issue Unit of Measure is valid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select Purchase Order as the Fulfillment Source for goods lines that belong to a Bill Only requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't select RFQ Required on goods or service lines that belong to a Bill Only requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Lot and Serial Information on goods lines is supported only for Lot and Serial requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify Requested Delivery Date on goods lines that belong to a Bill Only requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For Bill Only Requisitions, Ship-To Address on the line must match the header Ship-To Address. When using ad-hoc addresses for Bill Only requisitions, leave Ship-To Address blank on the line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enable Multi-Company on Requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't set RFQ Required on consignment requisition lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Inventory site location cannot be specified on consignment requisition lines, since such requisitions are always fulfilled via purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a unit cost with a positive value greater than zero. You can't have values less than or equal to zero on consignment supplier contracts, requisitions and purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Deliver-To location that's an inventory site or stocking location setup for consigned goods.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only Ordering UOMs for Purchase item are supported on consignment requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't use catalog items that aren't associated to purchase items on par replenishment requisitions. Associate the item to a purchase item, remove the item, or use a different item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source must be Purchase Order if Requisition Type is Par Replenishment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Non-Catalog items are not allowed for the selected requisition type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the splits from the lines. You can't split goods lines with a unit cost of zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a valid commodity code or leave the commodity code field blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a valid commodity code or leave the commodity code field blank. This commodity code isn't set up for the item ‘[Procurement Item]‘: ‘[Invalid Commodity Code]’</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a unit cost of zero for no charge lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only submit no charge goods lines for purchase items or catalog items. Remove the No Charge field attribute or include an item on the requisition line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the splits from the no charge lines. You can't split requisition lines for which you won't be charged.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove this location which is invalid for the company: [location]. Submit an inventory site location with the same Fulfillment Procurement Company that's on the requisition line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove this location because it's not an inventory site: [location]. Submit an inventory site or leave blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit an inventory site that's setup to stock this purchase item [Purchase Item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove inventory site for requisition line item [Item]. You can only submit inventory site for procurement items that has spend category marked for stock items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the line, or select a different item or inventory site. You can't add items that are restricted from purchasing or inactive for the inventory site.</xsd:documentation>
<wd:Validation_Message>Remove the line, or select a different item or inventory site. You can't add items that are restricted from purchasing or inactive for the inventory site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Extended Amount cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Item Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Item Description cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Spend Category Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure cannot be changed when updating a requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Unit Cost Amount cannot be changed when updating a Requisition created from a Workday Strategic Sourcing Award. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Just In Time is not setup for Item-Site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier. A supplier is required when the External System ID Reference refers to Workday Strategic Sourcing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set the RFQ Required field to false. RFQ Required can't be true when the External System ID refers to Workday Strategic Sourcing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source needs to be Supplier Contract when Requisition Type is Supplier Contract Request enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Request requisitions do not support these fields on Goods Lines: [Supplier Contract, No Charge, RFQ Required, Deliver-To Location, Requested Delivery Date, Supplier Item Identifier, Commodity Code, Splits, Mark Purchase Order As Issued].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Inactive Catalog Item [Catalog Item].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Goods_Line_Reference" type="wd:Item_Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an existing Goods Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Requisition_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company at the line level that has an intercompany relationship with the company at the header level.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Set up an intercompany relationship between [hdr company] and [line company] using the Edit Company Intercompany Profile task.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid line company for the Par Location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid line company for the Inventory Site.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an Item on the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Catalog_Item_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>You do not have access to the provided requesting entity or the requesting entity is invalid for one or more of the requested items.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The supplier item identifier for a Requisition Goods Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional description of the item, especially useful if only a Spend Category is selected for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The commodity code on spend transactions lines. This is a standard code that identifies a type of good or service you order. For example, the United Nations Standard Products and Services Code (UNSPSC) or the National Institute for Governmental Purchasing (NIGP) code. For purchase items and catalog items, you can only submit active commodity codes already associated to the item. For ad hoc based lines, you can submit any active commodity code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Spend Category must match the Spend Category for the Procurement Item.</xsd:documentation>
<wd:Validation_Message>Spend Category must match the Spend Category for the Procurement Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fulfillment_Source_Reference" type="wd:Requisition_SourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Fulfillment source on Requisition goods Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inventory_Site_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Inventory Site Location for the Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the supplier on the requisition line. While the Create Requisition task sometimes populates a supplier automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The Resource Provider provided must match the Resource Provider for the Item supplied.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid Supplier for the item's Multi-Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The currency on the requisition is not one of the acceptable currencies by [supplier]. Please select an acceptable currency or select a different supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order-From_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the order-from supplier connection on the requisition line. While the Create Requisition task sometimes populates an order-from supplier connection automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the supplier contract on the requisition line. While the Create Requisition task sometimes populates a supplier contract automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Catalog and contract line items must have the same currency as the contract currency.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Applicability for the Purchase Item. If the item has Tax Code defined, then the Tax Applicability is required.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Tax Applicability Reference is required is Tax Code is specified.</xsd:documentation>
<wd:Validation_Message>Tax Applicability Reference is required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Code for the Purchase Item. The Tax Code is defaulted from the Requisition Data element if one is specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Rate Recoverabilities for the Tax Code. Tax Recoverability required for each Tax Rate in the Tax Code, otherwise defaulted.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Packaging_String" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Packaging String associated with the Item specified on the Line. This information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for Requisition Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Splitting by quantity is not allowed when the quantity is not a whole number: [qty]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Unit of Measure</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Unit of Measure is invalid for the catalog item. Only defined units of measure for the catalog item can be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid Unit of Measure for the purchase item. This unit of measure is not defined for the supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the default ordering unit of measure for the supplier is a valid unit of measure. Enter a valid default Unit of Measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only the catalog item default unit of measure is a valid unit of measure.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost for Requisition Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The unit cost isn't valid for the selected unit of measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Unit Cost submitted must match Unit Cost calculated from Unit of Measure and Supplier Pricing for the Purchase Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="No_Charge" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit the new No Charge field attribute to change the unit cost of an item to zero on goods lines. You must submit items on goods lines to also submit No Charge.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Requisition line. This amount is automatically calculated by multiplying the Quantity by the Unit Cost in the currency specified on the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The control value Entered for Extended Amount does not match calculated Extended Amount. Extended Amount is an optional field but it can be used to control the anticipated line amount. If you do not wish to control the line amount, please leave this field blank.</xsd:documentation>
<wd:Validation_Message>Entered Extended Amount does not match calculated Extended Amount.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The line extended amount can't be zero. Please enter a value higher or lower than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lot_Serial_Information_Data" type="wd:Lot_Serial_Information_DataType" minOccurs="0"/>
<xsd:element name="RFQ_Required" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Request for Quote required for Requisition Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines with related catalog or web items.</xsd:documentation>
<wd:Validation_Message>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines with related catalog or web items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Negative or zero amount lines can't be marked RFQ Required.</xsd:documentation>
<wd:Validation_Message>Negative or zero amount lines can't be marked RFQ Required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines unless RFQ is configured for use.</xsd:documentation>
<wd:Validation_Message>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines unless RFQ is configured for use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requested_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requested delivery date for a Goods Line on a Requisition</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a requisition line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Address Reference for an existing Ship-To Address. If not specified on the Requisition Line, Workday will default the Ship-To Address Reference from the Requisition Header.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker, who will be the designated Ship-To contact. If not specified on the Requisition Line, Workday will default the Requisition Requester as the Ship-To Contact.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Location, where the Goods or Services will be delivered. If not specified on the Requisition Line, Workday will default the workspace or the business site of the Requisition Worker as the Deliver-To Location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Requisition Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Worktags provided are not valid for this transaction</xsd:documentation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Multi-Company is enabled, this validation compares against the Line Company and requires that the line Company is provided when Grant is supplied.</xsd:documentation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_This_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Mark this line for auto-sourcing. A supplier reference must also be provided.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Purchase_Order_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Purchase Order Line sourced from the Requisition Line. This field is READ ONLY.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line Reference must be empty.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Mark_Purchase_Order_As_Issued" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Sets the resulting Purchase Order Issue Option to External which automatically issued the Purchase Order. This can only be used with "Source This Line". Additionally, all Requisition Lines for the resulting Purchase Order must have this set or the Purchase Order will not be auto-issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Requisition_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Is_Line_Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if requisition line is closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Information" type="wd:Requisition_Line_Close_Status_InformationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional information on the status of the closed requisition line. Includes information such as the date the requisition line was closed, who closed the line, and the reason it was closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Project-Based_Requisition_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Project-Based Requisition Line data. A Requisition may have multiple Project-Based requisition lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Project reference is for a project that can be used as a basic worktag only.</xsd:documentation>
<wd:Validation_Message>Project reference is for a project that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</xsd:documentation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier Reference is required to use "Source This Line".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must use "Source This Line" to use "Mark Purchase Order As Issued".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For requisition lines tagged with a capital project worktag, the company of the requisition must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enable Multi-Company on Requisitions.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Deliverables_Line_Reference" type="wd:Project-Based_Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Project-Based Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliverables_Requisition_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company at the line level that has an intercompany relationship with the company at the header level.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Set up an intercompany relationship between [hdr company] and [line company] using the Edit Company Intercompany Profile task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Project.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The currency on the requisition is not one of the acceptable currencies by [supplier]. Please select an acceptable currency or select a different supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Requisition Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Spend Category.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Phase_Data" type="wd:Project_Plan_Phase_Requisition_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element Containing Project Plan Phase Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Project-Based Requisition Line. This amount is automatically calculated by adding the amounts of the multiple subtasks of the Project-Based Requisition Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Worktags provided are not valid for this transaction</xsd:documentation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Multi-Company is enabled, this validation compares against the Line Company and requires that the line Company is provided when Grant is supplied.</xsd:documentation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a requisition line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_This_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Mark this line for auto-sourcing. A supplier reference must also be provided.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Mark_Purchase_Order_As_Issued" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Sets the resulting Purchase Order Issue Option to External which automatically issued the Purchase Order. This can only be used with "Source This Line". Additionally, all Requisition Lines for the resulting Purchase Order must have this set or the Purchase Order will not be auto-issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Purchase_Order_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Purchase Order Line sourced from the Requisition Line. This field is READ ONLY.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line Reference must be empty.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliverables_Requisition_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Is_Line_Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if requisition line is closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Information" type="wd:Requisition_Line_Close_Status_InformationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional information on the status of the closed requisition line. Includes information such as the date the requisition line was closed, who closed the line, and the reason it was closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Requisition_RequestType">
<xsd:annotation>
<xsd:documentation>Cancel Requisition Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_to_Cancel_Reference" type="wd:RequisitionObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference of Requisition to be Canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reason_Code_Reference" type="wd:Reason_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of Reason Code for Requisition to be Canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Comments" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comments for Requisition to be Canceled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cancel_Requisition_ResponseType">
<xsd:annotation>
<xsd:documentation>Cancel Requisition Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Reference" type="wd:RequisitionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Canceled Requisition.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Issue_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Business Asset Issue details.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The following Asset Worktags are required but have not been assigned: [missing]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Asset Worktag types are invalid: [invalid]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>To issue assets that share accounting worktags, select the Keep Worktags of Asset Shares field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the values in the Worktags field if you want to issue assets that share accounting worktags or enter zero in the Keep Worktags of Asset Shares field if you want to override share accounting worktags.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't issue assets using both the Default Location and Worktags from Worker and Keep Worktags of Asset Shares. Enter zero in the Default Location and Worktags from Worker field to issue assets using the share accounting worktags or enter zero in the Keep Worktags of Asset Shares field if you want to override share accounting worktags.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Transaction_Effective_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The transaction effective date of the asset issue. The date must be greater than or equal to the asset's acquisition date. If the asset is depreciable, the Ledger Period must exist for the date specified.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select an Issue or Transfer Date that is on or between the asset's acquisition date and today.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Ledger Period must exist for the Issue or Transfer Date specified for Depreciable Assets.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Asset cannot be Placed in Service/Issued at this time. Your asset accountant must ensure all fiscal years / periods for this asset's useful life are set up in the fiscal schedules of all asset books where the asset's depreciation profile has 'Number of Days' as the rate basis.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Issue Date cannot be prior to last issue or transfer date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The fiscal Period for the transaction date must exist in the fiscal schedule of every company asset book where this is a depreciable asset in order to do this transaction</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Transaction effective date of this transaction cannot be prior to last reclassification date for asset</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Transaction effective date of this transaction cannot be prior to last partial disposal date for asset</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_To_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing worker or custodian of the business asset</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Location_and_Worktags_from_Worker" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Location and Worktags values will be defaulted from the Worker specified. 1=default; 2=do not defaultIf defaulting is requested, a Worker must be specified while Location and Worktags are blank.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>In order to use default values, a Worker must be specified while Location and Worktags are blank.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Keep_Location_and_Worktags_from_Business_Asset" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>You must first configure the Maintain Worktag Type Precedences task to Not Default Worker Organization Assignments as Worktags for Business Asset.Indicates whether the Location and Worktags of the Business Asset remain.If you set this field to True, Location and Worktags must be blank. If Default Location and Worktags from Worker are also set to True, Workday merges the Asset Worktags with the Worker Worktags.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't retain values from Business Asset. You must first configure the Maintain Worktag Type Precedences task to Not Default Worker Organization Assignments as Worktags for Business Asset.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>To retain values from Business Asset, the Location and Worktags fields must be blank.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the location of the business asset</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more of the worktags selected are of an invalid type for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[non-allowed worktags for asset web service]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing worktags for business asset web service]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>'[worktag value]' is not permitted as an allowed value for worktag type: [worktag type] because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[partitionable] is not allowed to be used by [company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Keep_Worktags_of_Asset_Shares" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Boolean that when checked will keep the current Asset Share Worktags, if unchecked the worktags will be overridden.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Issue_Asset_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Business Process Parameters, Business Asset Reference and Issue details.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
