<xsd:documentation>Reference to an existing Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Reference" type="wd:Supplier_InvoiceObjectType" minOccurs="0">
