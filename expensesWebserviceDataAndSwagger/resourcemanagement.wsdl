<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The submitted Supplier Contract Type does not allow Receive Contract Lines or Scheduled Purchase Orders. You may not submit a location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The provided location's usage must be set to Business Asset when the line level spend category tracks items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Inactive Location entered</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't submit a location for Financial or Operating Lease Contract types.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Worktag Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For supplier contract lines tagged with a capital project worktag, the company of the supplier contract must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktags not allowed for companies or hierarchy]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The intercompany affiliate [worktag] may not be chosen when specifying header company [header company] and line company [line company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove these worktag types that aren't valid for this transaction: [list of worktag types].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Related_Document_Lines_Reference" type="wd:Business_Document_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Represents all the lines this contract line is related to. This field is used for view purposes only.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Service_Request_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Service Requisition Line data. A Requisition may have multiple service requisition lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>A Supplier Reference is required to use "Source This Line".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must use "Source This Line" to use "Mark Purchase Order As Issued".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract is not valid for the Company, Supplier, and Requisition Date. The contract must also allow manual requisitioning and purchasing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog items are not allowed on Service Lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Can not have any combination of Project, Project Phase or Project Task worktags for the same line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please specify an Item or a Spend Category.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>End Date cannot be before the Service Line Start Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please specify an Item or an Item Description.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Use Item Identifier only for non-catalog items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Ship-To Address is not valid for use on the Requisition Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location is invalid for the selected Delivery Type and/or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The field Tax Applicability is required and must have a value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Provide a default tax recoverability for the tax applicability</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For requisition lines tagged with a capital project worktag, the company of the requisition must equal the company on the capital project.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Spend category "[spend category]" is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't select RFQ Required on goods or service lines that belong to a Bill Only requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For Bill Only Requisitions, Ship-To Address on the line must match the header Ship-To Address. When using ad-hoc addresses for Bill Only requisitions, leave Ship-To Address blank on the line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enable Multi-Company on Requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a valid commodity code or leave the commodity code field blank. This commodity code isn't set up for the item ‘[Procurement Item]‘: ‘[Invalid Commodity Code]’</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a valid commodity code or leave the commodity code field blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the line, or select a different item or inventory site. You can't add items that are restricted from purchasing or inactive for the inventory site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Extended Amount cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Item Description cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Spend Category Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Item Reference cannot be changed when updating a Requisition created from Workday Strategic Sourcing. Please ensure the value in the request matches the existing value on the Requisition.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a supplier. A supplier is required when the External System ID Reference refers to Workday Strategic Sourcing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Set the RFQ Required field to false. RFQ Required can't be true when the External System ID refers to Workday Strategic Sourcing.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Request requisitions do not support these fields on Service Lines: [Supplier Contract, RFQ Required, Deliver-To Location, Commodity Code, Splits, Mark Purchase Order As Issued].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Fulfillment Source [fs] entered for Service Requisition Line is Invalid.Please enter [expected fs] as Fullfilment Source.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Service_Line_Reference" type="wd:Service_Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Service Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Requisition_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company at the line level that has an intercompany relationship with the company at the header level.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Set up an intercompany relationship between [hdr company] and [line company] using the Edit Company Intercompany Profile task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an Item on the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You do not have access to the provided requesting entity or the requesting entity is invalid for one or more of the requested items.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional description of the item, especially useful if only a Spend Category is selected for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The commodity code on spend transactions lines. This is a standard code that identifies a type of good or service you order. For example, the United Nations Standard Products and Services Code (UNSPSC) or the National Institute for Governmental Purchasing (NIGP) code. For purchase items and catalog items, you can only submit active commodity codes already associated to the item. For ad hoc based lines, you can submit any active commodity code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Spend Category must match the Spend Category for the Procurement Item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fulfillment_Source_Reference" type="wd:Requisition_SourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Fulfillment source on Service Line.This is defaulted to Purchase Order for Service Requisition Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the supplier on the requisition line. While the Create Requisition task sometimes populates a supplier automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a valid Supplier for the item's Multi-Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Resource Provider provided must match the Resource Provider for the Item supplied.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The currency on the requisition is not one of the acceptable currencies by [supplier]. Please select an acceptable currency or select a different supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order-From_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the order-from supplier connection on the requisition line. While the Create Requisition task sometimes populates an order-from supplier connection automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Identifies the supplier contract on the requisition line. While the Create Requisition task sometimes populates a supplier contract automatically when you don't select one, this operation does not populate a value automatically.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Document Date that is between the supplier contract start date and end date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Applicability for the Purchase Item. If the item has Tax Code defined, then the Tax Applicability is required.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Tax Applicability Reference is required is Tax Code is specified.</xsd:documentation>
<wd:Validation_Message>Tax Applicability Reference is required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Code for the Purchase Item. The Tax Code is defaulted from the Requisition Data element if one is specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Recoverabilities_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Rate Recoverabilities for the Tax Code. Tax Recoverability required for each Tax Rate in the Tax Code, otherwise defaulted.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Service Line Extended Amount should be greater than zero.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The line extended amount can't be zero. Please enter a value higher or lower than zero.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="RFQ_Required" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Request for Quote required for Requisition Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines with related catalog or web items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Negative or zero amount lines can't be marked RFQ Required.</xsd:documentation>
<wd:Validation_Message>Negative or zero amount lines can't be marked RFQ Required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines unless RFQ is configured for use.</xsd:documentation>
<wd:Validation_Message>Remove the RFQ Required option from the Requisition Line. You can't mark RFQ Required on requisition lines unless RFQ is configured for use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Address Reference for an existing Ship-To Address. If not specified on the Requisition Line, Workday will default the Ship-To Address Reference from the Requisition Header.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker, who will be the designated Ship-To contact. If not specified on the Requisition Line, Workday will default the Requisition Requester as the Ship-To Contact.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Location, where the Goods or Services will be delivered. If not specified on the Requisition Line, Workday will default the workspace or the business site of the Requisition Worker as the Deliver-To Location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a requisition line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Requisition Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Multi-Company is enabled, this validation compares against the Line Company and requires that the line Company is provided when Grant is supplied.</xsd:documentation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Source_This_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Mark this line for auto-sourcing. A supplier reference must also be provided.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Purchase_Order_LineObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>The Purchase Order Line sourced from the Requisition Line. This field is READ ONLY.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase Order Line Reference must be empty.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Mark_Purchase_Order_As_Issued" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Sets the resulting Purchase Order Issue Option to External which automatically issued the Purchase Order. This can only be used with "Source This Line". Additionally, all Requisition Lines for the resulting Purchase Order must have this set or the Purchase Order will not be auto-issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Requisition_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Refers to requisition line split information. Multiple line splits are allowed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Quantity splits are not allowed for Service Lines.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Line_Closed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if requisition line is closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Close_Status_Information" type="wd:Requisition_Line_Close_Status_InformationType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Additional information on the status of the closed requisition line. Includes information such as the date the requisition line was closed, who closed the line, and the reason it was closed. This field is read-only and ignored when you submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Reclassify_Asset_RequestType">
<xsd:annotation>
<xsd:documentation>Contains data used to process the asset reclassification</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the asset that should be reclassified</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>You can't reclassify removed assets, disposed assets, assets that have no posted depreciation, or assets that have been impaired.</xsd:documentation>
<wd:Validation_Message>You can't reclassify removed assets, disposed assets, assets that have no posted depreciation, or assets that have been impaired.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The asset specified cannot currently be reclassified because it has other activities in progress.</xsd:documentation>
<wd:Validation_Message>The asset specified cannot currently be reclassified because it has other activities in progress.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Discrete Composite Asset or Components of Non-Discrete Composite Asset cannot be reclassified.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The asset is part of a lease contract. You can't reclassify leased assets.</xsd:documentation>
<wd:Validation_Message>The asset is part of a lease contract. You can't reclassify leased assets.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
<xsd:element name="Reclassify_Asset_Data" type="wd:Reclassify_Asset_DataType"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Reclassify_Asset_DataType">
<xsd:annotation>
<xsd:documentation>Contains data used to process the asset reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You must specify all, and only all, asset books in which the asset is depreciable.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Transaction_Effective_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The transaction effective date for the asset reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date in an existing Ledger Period.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The asset has an event with a transaction date after the reclassify transaction effective date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date for the reclassification that isn't later than today.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The transaction effective date is prior to this asset's conversion into Workday. The portion of accumulated depreciation that represents depreciation taken in a prior system will not be included in the depreciation recalculation in Workday.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date isn't after the end date of the last period in the depreciation schedule when useful life is adjusted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date that isn't before the last resume date when useful life is changed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Depreciation Start Date that is after this asset's conversion into Workday when the useful life is changed.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Item_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Proposed Item Descriptor Reference for the reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>One or more items is invalid because it does not belong to a trackable Spend Category.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Spend_Category_Reference" type="wd:Spend_CategoryObjectType">
<xsd:annotation>
<xsd:documentation>The proposed Spend Category Reference for the reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't reclassify an asset that you register from a supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must change the item, spend category, asset class, or asset type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Asset cannot be assigned a Lease Spend Category.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The spend category of the item ([item]) must be Tracked and the item must relate to the spend category ([SpendCat]).</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Asset_Class_Reference" type="wd:Asset_ClassObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed Asset Class for the reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This is a Shared Business Asset that is shared by Asset Class. The Asset Class for the Asset Shares can be modified via the Maintain Asset Shares task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Asset_Type_Reference" type="wd:Asset_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The purposed Asset Type for the reclassification</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This is a Shared Business Asset that is shared by Asset Type. The Asset Type for the Asset Shares can be modified via the Maintain Asset Shares task.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Useful_Life_Per_Book" type="wd:Asset_Useful_Life_for_Reclassify_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference data to enter useful life per asset book for reclassification</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Reclassify_Asset_ResponseType">
<xsd:annotation>
<xsd:documentation>Root element for the Response on the Reclassification Asset operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reclassification_Event_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>A reference to the Asset Reclassification Event that was created by the request.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="RFQ_Response_DataType">
<xsd:annotation>
<xsd:documentation>Element that represents the contents of the entire RFQ Response Document</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference ID for RFQ Response Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Reference" type="wd:Request_for_QuoteObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Request for Quote document that is associated with the RFQ Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company on the RFQ Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier who responded to the RFQ.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Response_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The status of the RFQ Response document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date on which the RFQ Response was created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The currency on the Request for Quote document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Recorded_By" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Contact who recorded the response to the RFQ.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping terms on Request for Quote Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping method on Request for Quote Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Instruction" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipping instructions on Request for Quote Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Document_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date on which the RFQ was created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Request for Quote Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Request for Quote End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Sourcing_Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Sourcing Buyer on RFQ</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Document_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo recorded on Request for Quote</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Terms_and_Conditions" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Terms and conditions on Request for Quote.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Response_Line_Data" type="wd:RFQ_Response_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures information related to RFQ response lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Response_Bid_Response_Data" type="wd:RFQ_Header_or_Line_Bid_Response_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that contains information related to RFQ Bid responses.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Response_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>The RFQ Response Request References element contains instances of RFQ Responses for get operation.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_Reference" type="wd:Request_for_Quote_ResponseObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Request for Quote Response Document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Response_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element that contains criteria to search for RFQ Response Documents</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Company Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Reference" type="wd:Request_for_QuoteObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Request for Quote Reference to query RFQ Responses.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Abstract_Request_for_Quote_ParticipantObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Date_On_or_After" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Date On or After</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Date On or Before</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Response_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>RFQ Response Status Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Response_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing RFQ Response grouping options.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Request_for_Quote_Responses_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing sub elements for Request Reference, Request Criteria, Response Filter and Response Group to retrieve RFQ Response data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Request_for_Quote_Response_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The RFQ Response References element contains the instances of RFQ Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Request_for_Quote_Response_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Request_for_Quote_Response_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element that contains RFQ Response Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Response_OutboundType">
<xsd:annotation>
<xsd:documentation>Element that captures a reference to RFQ Response Document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_Reference" type="wd:Request_for_Quote_ResponseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Response document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Response_Data" type="wd:RFQ_Response_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Request_for_Quote_Response_Response_DataType">
<xsd:annotation>
<xsd:documentation>Topmost element that captures a reference to a RFQ response document along with its content</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response" type="wd:Request_for_Quote_Response_OutboundType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Request_for_Quote_Responses_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing RFQ Response elements including request data and request result data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Request_for_Quote_Response_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Request_for_Quote_Response_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Request_for_Quote_Response_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Request_for_Quote_Response_Response_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Element containing RFQ Response Document Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="RFQ_Response_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element that captures RFQ Response Line information</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Response_Line_Reference" type="wd:Request_for_Quote_Response_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the RFQ Response Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Reference" type="wd:Request_for_Quote_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the RFQ line to which the response was recorded for.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Type_Reference" type="wd:Request_for_Quote_Line_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Request for Quote Line Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Request for Quote Line Number.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Item_Descriptor_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Item on the Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Description on the Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Line_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Response Line Item Description on the RFQ Response Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Accounting_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Spend Category on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="No_Bid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag to indicate where bid is made for a RFQ line when submitting the response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Target_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Target Price recorded on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Requested_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enter a Requested Delivery Date that is on or after the RFQ Document Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo recorded on Request for Quote Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Price recorded on RFQ Response Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Quantity recorded on RFQ Response Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead Time recorded on RFQ Response Line.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo recorded on RFQ Response Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Bid_Response_Data" type="wd:RFQ_Header_or_Line_Bid_Response_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element that captures responses to line level bid requirements.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="RFQ_Header_or_Line_Bid_Response_DataType">
<xsd:annotation>
<xsd:documentation>Element that captures header and line level bid responses on RFQ Response Document.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Bid_Response_Reference" type="wd:Abstract_Request_for_Quote_Bid_ResponseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Bid response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Bid_Requirement_Reference" type="wd:Abstract_Request_for_Quote_Bid_RequirementObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the original bid requirement recorded on RFQ.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bid Requirement Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bid Requirement Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Required" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether a response is required on this bid requirement.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Type_Reference" type="wd:Request_for_Quote_Bid_Requirement_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Bid Requirement Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Value" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bid Response Value recorded against bid requirement.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Bid_Response_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bid Response Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Request_for_Quote_Response_RequestType">
<xsd:annotation>
<xsd:documentation>Topmost element to record RFQ Response Document. Includes header, lines and bid responses.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Web Service is set to Add Only; documents cannot be resubmitted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only update RFQ Responses that are in Draft or In Progress Status.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_Reference" type="wd:Request_for_Quote_ResponseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Response Document to edit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
<xsd:element name="Request_for_Quote_Response_Data" type="wd:RFQ_Response_Data_InboundType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Submit_Request_for_Quote_Response_ResponseType">
<xsd:annotation>
<xsd:documentation>Element that shows the RFQ Response Document worked upon.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_Reference" type="wd:Request_for_Quote_ResponseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Response Document</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exceptions_Response_Data" type="wd:Application_Instance_Related_Exceptions_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="RFQ_Response_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element used to capture a response to a Request for Quote document. It includes responses to RFQ Lines and header level bid requirements.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a approved and posted RFQ to record a response against.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Response Date must be on or after the RFQ Start Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An active response to this RFQ already exists for this supplier. Change the supplier and submit the document again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid supplier for the RFQ Response. If the RFQ is restricted, please verify that the supplier is invited to bid on this RFQ.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company on RFQ differs from what is used on RFQ Response.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Include all bid requirements classified as "Document" in the RFQ Response.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company on RFQ Response cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>RFQ Reference cannot be modified from its original value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Response should have all RFQ lines. Missing RFQ lines are [lines].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Response Date must be on or before the RFQ End Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't access the supplier due to your current segment security configuration.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_for_Quote_Response_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to RFQ Response Document.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a valid Reference ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company used to record RFQ Response.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Reference" type="wd:Request_for_QuoteObjectType">
<xsd:annotation>
<xsd:documentation>Reference to RFQ for which the response is created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Reference to Supplier for which the response is created.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Recorded_By" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Recorded By</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Date" type="xsd:dateTime" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Date with time precision up to minute.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Terms for the Request For Quote Response</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method for the Request For Quote Response</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Instruction" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipping Instruction for the Request For Quote Response</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_for_Quote_Response_Line_Data" type="wd:RFQ_Response_Line_Data_InboundType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="RFQ_Header_Bid_Response_Data" type="wd:RFQ_Header_Or_Line_Bid_Response_Data_InboundType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="RFQ_Response_Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="RFQ_Response_Line_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element to capture responses to Request for Quote Lines. It also includes responses to line level bid requirements</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Response Quantity and Lead Time are not applicable for a service line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Response Quantity is required on a response to a Goods Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Lead Time is required on the RFQ response line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Response Price is required on the RFQ Response line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>RFQ Line does not belong to the RFQ to which you're recording a response. Please check and submit again.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Include all bid requirements applicable to the RFQ Line on the response.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Line_Reference" type="wd:Request_for_Quote_LineObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the RFQ Line to which a response is recorded.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="No_Bid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Flag to indicate where bid is made for a RFQ line when submitting the response.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Bid response is required for RFQ line [RFQ Line].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Line_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Response Line Item Description on the RFQ Response Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can only provide Response Line Description for Ad hoc Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't provide Response Line Description for no bid response line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Quantity as entered by the supplier..</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Price provided by the supplier.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Lead_Time_in_Days" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Lead Time provided by the supplier.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Response_Line_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Response Line Memo provided by the supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="RFQ_Line_Bid_Response_Data" type="wd:RFQ_Header_Or_Line_Bid_Response_Data_InboundType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="RFQ_Response_Line_Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="RFQ_Header_Or_Line_Bid_Response_Data_InboundType">
<xsd:annotation>
<xsd:documentation>Element used to capture header and line level bid responses</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Choose either Yes or No as a response to the boolean bid requirement.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please provide a response to the mandatory bid requirement.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enter a valid bid response to the bid requirement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="RFQ_Bid_Requirement_Reference" type="wd:Abstract_Request_for_Quote_Bid_RequirementObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the RFQ Bid Requirement.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Date_Response" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Date Response provided by supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Numeric_Response" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Numeric Response provided by supplier.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Text_Response" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text Response provided by Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Boolean_Yes_Response" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean Yes Response provided by supplier. Enter Y to indicate that the supplier has answered 'Yes' to the bid requirement. Leave blank otherwise.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Boolean_No_Response" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean No Response provided by supplier. Enter Y to indicate that the supplier has answered 'No' to the bid requirement. Leave blank otherwise.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bid_Response_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Bid Response Memo provided by supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Catalog_Load_Alternate_Item_IdentifierType">
<xsd:annotation>
<xsd:documentation>Alternate Item Identifiers for Catalog Load items.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Can't enter duplicate Item Identifier Type if the Allow Multiples flag is false.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Manufacturer is not Active. Please enter an active manufacturer reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only numeric values are allowed for GTIN.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only alphanumeric values are allowed for UPN.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[type] has to be less than or equal to [length] characters in length</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Alternate Item Identifiers Value is required for non-manufacturer Item Identifier Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Can't have Alternate Item Identifiers Value for Manufacturer Item Identifier Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid GTIN</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Item Identifier Type is Inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a unit of measure for item identifier types that aren't unit of measure related.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Unit of Measure for item identifier types that are unit of measure related.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter only 1 alternate identifier for the same identifier type, value, and unit of measure combination.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Item_Identifier_Type_Reference" type="wd:Item_Identifier_TypeObjectType">
<xsd:annotation>
<xsd:documentation>Item Identifier Type for the Alternate Item Identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Identifier_Value" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Item Identifier Value for the Alternate Item Identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacturer_Reference" type="wd:ManufacturerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Please enter an active Manufacturer instance as Alternate Item Identifier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Unit of Measure Reference for Item Identifier Type that supports UOM.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UN_CEFACT_UOM_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UN CEFACT Common Code for Item Identifier Type that supports UOM.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Credit_Card_Header__HV__RequestType">
<xsd:annotation>
<xsd:documentation>Credit Card Header Request.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Web Service is set to Add Only; but the Card Holder Listing File already exists.</xsd:documentation>
<wd:Validation_Message>The Web Service is set to Add Only; but the Card Holder Listing File already exists.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Card_Holder_Listing_File_Reference" type="wd:Cardholder_Listing_FileObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Card Holder Listing File for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Card_Holder_Listing_File_Data" type="wd:Cardholder_Listing_File__HV__DataType">
<xsd:annotation>
<xsd:documentation>Card Holder Listing File Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Credit_Card__HV__DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Expense Credit Card data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>This credit card has an invalid payment responsibility and is unavailable for reassignment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This credit card has an invalid usage and is unavailable for reassignment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The corporate credit card account for credit card reference ID [credit card identifier] cannot be modified because there are credit card transactions associated with this credit card.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Credit Card Category can only be Central Travel Card if the Corporate Credit Card Account Usage is for Expenses, the Payment Responsibility is Corporate, and Electronic Load Only is set to True.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Cardholder for credit card reference ID [credit card identifier] cannot be modified because there are credit card transactions associated with this credit card.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An expense credit card that's already assigned to this cardholder has the same last 4 digits as the card you're trying to assign.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Multiple people have the cardholder ID [cardholder ID] and an expense credit card already has the same corporate billing account number and last 4 digits.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Organization. The Organization you submitted is invalid for your request.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Expense_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Expense Credit Card for update only purposes.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card ID. This is the Expense Credit Card unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Corporate_Credit_Card_Account_Reference" type="wd:Corporate_Credit_Card_AccountObjectType">
<xsd:annotation>
<xsd:documentation>Corporate Credit Card Account Reference for the Expense Credit Card.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Category_Reference" type="wd:Credit_Card_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Central Travel Card boolean for Worker Credit Card</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Cardholder_Reference" type="wd:Expense_PayeeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Cardholder Reference for the Expense Credit Card.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cardholder_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Cardholder ID for the Expense Credit Card. This will only be used by the Integrations Web Service for a standard card holder listing file where the reference to an Cardholder (Expense Payee) in Workday is not available.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Credit_Card_Organizations_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Organizations for Central Travel Card</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Description.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Last_4_Digits_of_Credit_Card_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Number Last 4 Digits.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="4"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Credit_Card_Expiration_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Expiration Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Monthly_Limit" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Monthly Limit.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Transaction_Limit" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Transaction Limit.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Billing_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Billing Currency Reference for Expense Credit Card.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cash_Access_Allowed" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Cash Access Allowed boolean for Expense Credit Card.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancel_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Cancel Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cardmember_Embossed_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Cardmember Embossed Name.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType">
<xsd:annotation>
<xsd:documentation>Document Status Reference for Expense Credit Card. The statuses are Error (this can occur if the standard card holder listing file does not provide all needed data), Active, Canceled, Deleted, and Suspended.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expense_Credit_Card_Token" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expense Credit Card Token will only be set by the Integrations Web Service for PCI. This Token will be a unique identifier for each Expense Credit Card. It will be used to represent the Expense Credit Card Numbers. It will get generated by Integrations.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Alternate_Account_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Configure this field if you use remittance files. Provide the alternate account identifier from your financial institution's incoming credit card file. Workday uses this value in the Get Payments web service response, ensuring that it's included in the remittance file that you send to your financial institution.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reassignment_Enabled" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Manual Reassignment Allowed boolean for Expense Credit Card</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cardholder_Listing_File__HV__DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Card Holder Listing File data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Card_Holder_Listing_File_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Card Holder Listing File Number. This is the Card Holder Listing File unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Card_Holder_Listing_File_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Card Holder Listing File Name.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Card_Holder_Listing_File_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Card Holder Listing File Date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Data" type="wd:Credit_Card__HV__DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Credit Card Data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Business_Document_Attachment_with_External_Option_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing all Business Document Attachment data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If a file name is specified for a Financial Attachment, File Content and Content Type are required.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="File_Content" type="xsd:base64Binary" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>File content in binary format.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Comment" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Comment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Field to mark the attachments that can are shared with Suppliers.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Content_Type">
<xsd:annotation>
<xsd:documentation>Text attribute identifying Content Type of the Attachment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="80"/>
</xsd:restriction>
