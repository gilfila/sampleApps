<wd:Validation>
<wd:Validation_Message>Repayment amount of [Repayment Amount in Repayment Currency] is greater than outstanding Receivable balance of [Outstanding Balance in Repayment Currency].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the Company or Expense Payee. Match the fields to the original receivable payment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Payee does not have an outstanding receivable repayment balance.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Expense Repayment is in Cancelled status. You can't update it.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The currency must match the reimbursement currency of the expense payee.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Receivable_Repayment_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
