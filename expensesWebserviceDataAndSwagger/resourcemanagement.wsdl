<xsd:documentation>Element containing reference instances for a Return</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Return_Reference" type="wd:Return_to_SupplierObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Return</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Return_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Utilize the following element to find returns in the Workday system.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Return Date On or After must be earlier than Return Date On or Before</xsd:documentation>
<wd:Validation_Message>Return Date On or After must be earlier than Return Date On or Before</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Return_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Number</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="513"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Return_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0" maxOccurs="unbounded">
