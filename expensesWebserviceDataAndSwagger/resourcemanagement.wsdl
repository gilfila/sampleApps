<xsd:element name="Range_From" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The UNSPC Code Range Start. It is a numeric field that is the start of a range.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Range_To" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UNSPC Code Range To. The end range of the UNSPC code.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Use_on_PO" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The UNSPC Code can be used on POs if the Range From and To codes are the same.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Settlement_Account_WWS_DataType">
