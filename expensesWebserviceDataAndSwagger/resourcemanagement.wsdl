</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This project resource[ppt] and resource plan line are not valid for the resource plan: [project resource], [rpl][task].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a valid Project Role ID. This ID is restricted to a different project hierarchy. Project Role ID: [id]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a value for the resource plan line field.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
