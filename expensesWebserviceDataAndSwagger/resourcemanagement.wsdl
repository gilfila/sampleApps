<xsd:complexType name="Catalog_Load_Item_Unit_of_Measure_DataType">
<xsd:annotation>
<xsd:documentation>Element used to capture multiple Units of Measure for a Catalog Load Item</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Provide a valid UN CEFACT UOM Code.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Catalog_Load_Item_UOM_Reference" type="wd:Catalog_Load_Item_Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Catalog Load Item Unit of Measure Instance. Only applicable when invoked via Get Catalog Loads Web Service operation.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType">
<xsd:annotation>
<xsd:documentation>Unit of Measure Reference for the Catalog Load Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="UN_CEFACT_UOM_Code" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>UN CEFACT Common Code for Catalog Load Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Item_Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Price.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Conversion Factor between the Ordering Unit of Measure and the Base Unit of Measure of Catalog Load Item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether this Unit of Measure is the default UOM.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Just_In_Time" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Unit Of Measure is applicable for Just In Time.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead time for the UOM of the Catalog Item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Minimum_Order_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The minimum quantity per unit of measure for Item. A value of zero means that there is no minimum order quantity.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You cannot set Minimum Order Quantity for Just in Time items.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Unit of Measure is inactive.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>A default Unit of Measure cannot be marked inactive.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Unnamed_Resource_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Element containing unnamed resource data.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You cannot change the sequence for an existing unnamed resource reference ID: [reference id].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit sequence number greater than zero for unnamed resource reference ID: [reference id].</wd:Validation_Message>
