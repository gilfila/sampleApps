</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Procurement Item must match the Procurement Item on the Purchase Order Line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Company act as Supplier on Supplier Invoice Line must have the same Company as the Customer Invoice Line.</wd:Validation_Message>
