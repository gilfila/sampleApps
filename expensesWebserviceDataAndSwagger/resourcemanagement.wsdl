<xsd:complexType name="Web_Item_Attributes_DataType">
<xsd:annotation>
<xsd:documentation>Web Item Attributes Data Element</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a purchase item that belongs to the web item spend category ( [spend_cat] ).</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The description of the web item. This data is not used for inbound requests and any data provided in this element will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The supplier associated with the web item. This data is not used for inbound requests and any data provided in this element will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The supplier's item identifier associated with the web item. This data is not used for inbound requests and any data provided in this element will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The spend category associated with the web item. This data is not used for inbound requests and any data provided in this element will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The purchase item linked to the web item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ordering unit of measure of the web item. This data is not used for inbound requests and any data provided in this element will be ignored.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion factor of the web item's ordering unit of measure to the linked purchase item's base unit of measure.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
