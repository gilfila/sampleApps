<wd:Validation_Message>The Purchase Order Provided may not be canceled because it has Supplier Invoices that have not been canceled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Purchase Order Provided may not be canceled because it has Receipts that have not been canceled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Purchase Order Provided is already canceled and may not be canceled again.</xsd:documentation>
