</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Acknowledgement_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Acknowledgement Date On or Before</xsd:documentation>
