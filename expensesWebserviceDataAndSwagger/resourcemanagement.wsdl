</xsd:annotation>
</xsd:attribute>
<xsd:attribute name="Type" type="xsd:string">
<xsd:annotation>
<xsd:documentation>The city subdivision part of the address.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:extension>
</xsd:simpleContent>
</xsd:complexType>
<xsd:complexType name="Subregion_Information_DataType">
