<xsd:annotation>
<xsd:documentation>Element containing all Guest data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Guest_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
