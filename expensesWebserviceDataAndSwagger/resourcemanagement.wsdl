</xsd:annotation>
</xsd:element>
<xsd:element name="Manufacture_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Manufacturer Date for the Item Lot</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expiration_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Expiration Date for the Item Lot</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shipped Quantity for Lot</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
