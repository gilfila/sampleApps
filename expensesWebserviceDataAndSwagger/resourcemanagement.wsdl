<xsd:element name="Origin_Address" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The origin address on the expense report line, used to estimate the distance of the driving route.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Round_Trip" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Representing the Round Trip for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Destination_Address" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The destination address on the expense report line, used to estimate the distance of the driving route.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Estimated_Distance_of_Driving_Route" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Estimated Distance of Driving Route</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="1"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Trip_Distance_Including_Diversions" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The enterable trip distance values.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="1"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="One-Way_Daily_Commute_Distance" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The One-Way Daily Commute Distance to be deducted from the Distance to Expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="1"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Distance_to_Expense" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The distance that you can expense based on a daily commute or round trip.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="7"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="1"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Account_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the account number for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Account Number is required for the selected Expense Item and must have a value.</xsd:documentation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Topics" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the business topics for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Reason" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
