<xsd:documentation>Reference to an existing Supplier Invoice</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receipt_Last_Updated_Date_On_or_After" type="xsd:dateTime" minOccurs="0" maxOccurs="1">
