<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Business Asset that will be used for the Issue transaction.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Asset_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Business Asset status ([asset status]) is not valid for Issue. Status must be 'In Service' or 'Registered'.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>There is a pending event for the asset that should be completed before this asset transaction can be processed.</xsd:documentation>
<wd:Validation_Message>There is a pending event for the asset that should be completed before this asset transaction can be processed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>An Asset cannot be issued if it has Contract information.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Discrete Composite Asset or Components of Non-Discrete Composite Asset cannot be issued.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't issue assets for the Type and Accounting Method of the Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
