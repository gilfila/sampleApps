<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project Task Resource MLV Webservice Criticals</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Task_Reference" type="wd:Project_Plan_TaskObjectType">
