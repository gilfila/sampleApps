<xsd:complexType name="Catalog_Item_Data_DataType">
<xsd:annotation>
<xsd:documentation>Catalog Item Data Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item_Pricing_Data_Effective_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Effective date of the Catalog Item Data used for pricing.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ordering unit of measure of catalog item pricing history instance.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Price" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Price of Catalog Item starting on the Effective Date.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Conversion_Factor" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The conversion factor to be used when converting the unit of measure to the base unit of measure for the catalog item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="9"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Default_Unit_of_Measure" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether this Unit of Measure is the default UOM.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Just_In_Time" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Just In Time flag for the UOM for this Catalog Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Lead_Time" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Lead time for the UOM of the Catalog Item.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Minimum_Order_Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Minimum Order Quantity for the UOM for this Catalog Item</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Unit of Measure is inactive.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
