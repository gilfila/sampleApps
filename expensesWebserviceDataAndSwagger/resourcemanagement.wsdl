<xsd:sequence>
<xsd:element name="Delete" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Delete</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Role_Standard_Cost_Rate_Detail_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project Role Standard Cost Rate ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME__Project_Role__Reference" type="wd:Project_RoleObjectType">
<xsd:annotation>
<xsd:documentation>Project Role</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Hourly_Rate" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Project rate rule hourly rate</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Change_Depreciation_Accounting_Status_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing the data Element for the Override Depreciation Period Response</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Override_Depreciation_Period_Status_Data" type="wd:Override_Depreciation_Period_Status_Data_ResponseType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Element containing the Processed Asset Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Override_Depreciation_Period_Status_DataType">
<xsd:annotation>
<xsd:documentation>Element Containing the Data for Override Depreciation Period Status</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>Specify the Business Asset that needs to be processed.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Business Asset [asset] has an Event in progress. You can submit the transaction after the in-progress event for this asset completes.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only Accounting Company Books are allowed.If no Books are specified then all the valid books are processed. All the books that were processed are returned in the Response Message.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Business Asset [asset] has asset books [asset book] with Posted transactions. You can only select asset books with transactions that aren't Posted.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Books [books] aren't valid accounting books.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Asset [asset] has Invalid status. You must check the status of the asset before you can reprocess this asset.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Clear_Accounted_Status" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This field is mutually exclusive with the Accounted Status On or Before Date field. If a value of 1 is specified in this field then the all the periods which have period status set to Accounted will become available.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Asset [business asset] should have at least one of the values specified for the status; Clear, Accounted, or Accounted On or Before date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Asset [business asset] can't have these as the status simultaneously; Clear, Accounted, and a specified Accounted On or Before date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accounted_Status_On_or_Before_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This field is mutually exclusive with the Accounted Status On or Before Date field. This field is used to specify the Date till which you want to Accounted Status to be set.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Override_Depreciation_Period_Status_Data_ResponseType">
<xsd:annotation>
<xsd:documentation>Element for Override Depreciation Period Status Data Response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reference" type="wd:Business_AssetObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Asset that will be processed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>List of all the Books that were processed. This list may be different from the Input list as not All books specified on the Input Request Message will be processed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Clear_Accounted_Status" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This field is displayed if the Clear Accounted Date field is set to 1 on the Request message.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Installment_Date_On_or_Before" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This message is displayed when the Installment On or Before date on the Request message is selected.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Change_Depreciation_Accounting_Status_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing the data Element for the Override Depreciation Period Web Service</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Override_Depreciation_Period_Status_Data" type="wd:Override_Depreciation_Period_Status_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Requisition_Template_ResponseType">
<xsd:annotation>
<xsd:documentation>This response includes the Workday ID and Reference ID of the Template Requisition.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Reference" type="wd:Requisition_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Shared Requisition Template</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Requisition_Template_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing Shared Requisition Template reference for update. Flag to indicate if this operation is add only, and all Shared Requisition Template data items required to create a complete Shared Requisition Template</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The 'Add Only' flag is set. But the Requisition Template ID already exists.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Reference" type="wd:Requisition_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Requisition Template for update only purposes</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Data" type="wd:Requisition_Template_DataType">
<xsd:annotation>
<xsd:documentation>Shared Requisition Template Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Add Only Flag. Indicates that the service is an add only, not an update.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_DataType">
<xsd:annotation>
<xsd:documentation>Data required to create a Shared Requisition Template</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Owned By Reference must be an active Worker.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The ID for the requistion Template to update</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:OrganizationObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Requisition Template Company. This value will be used set the Company on Requisitions created via this Requisition Template</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Company is already included in one of the selected Company Hierarchies.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Company Hierarchy is already included in one of the hierarchies selected.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Shared Template Name is used to provide a human friendly option for searching and finding Requisition Templates</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Audited_Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Requisition Template Worktags.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Type_Reference" type="wd:Requisition_TypeObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Requisition Type of the Requisition Template</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't create a requisition template with a requisition type that includes Supplier Contract Request, or a combination of Bill Only and Consignment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a requisition template with an active requisition type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver-To_Reference" type="wd:LocationObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to the Deliver-To locations of the Requisition Template</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Owned_By_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>The worker who owns the Shared Requisition Template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date the Shared Requisition Document was created.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>The Currency for the Requisition Template. This will be set on Requisitions created via this Template. This should be a currency that is valid for the Company. If no Currency is provided the default Currency for the Owner of The Template will be used.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a currency conversion rate between the currency and the company’s default currency.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Job_Profile_Reference" type="wd:Job_ProfileObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to New Hire Template for Job Profile</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Public" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>One of Four options for Sharing a Requisition Template. If this option is set to True then access level is Public.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Security_Group_for_Template_Reference" type="wd:Security_GroupObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>One of Four options for sharing a Requisition Template. This option allows you to select Security Groups that should be allowed to use the Template when creating Requisitions.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="User_Reference" type="wd:System_UserObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>One of Four options for sharing a Requisition Template. This option allows you to select Specific Users that should be allowed to use the Template when creating Requisitions.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Not_Shared" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>One of Four options for sharing a Requisition Template. This option restricts access to the Requisition Template when creating Requisitions to everyone except the Owner of the Requisition Template.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Requisition_Template_Goods_Line_Data" type="wd:Requisition_Template_Goods_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Requisition Template Goods Line data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Service_Line_Data" type="wd:Requisition_Template_Service_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Supplier Invoice Line data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_Service_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Service Requisition Line data. A Requisition may have multiple service requisition lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Item Description is Required</xsd:documentation>
<wd:Validation_Message>Item Description is Required</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Category is required.</xsd:documentation>
<wd:Validation_Message>Spend Category is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier is required if Order-From Connection exists</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Ship-To Contact Reference must be for an active worker in the company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>End Date cannot be before the Service Line Start Date</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Order From Connection is not valid for the Supplier</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enable Multi-Company on Requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location is invalid for the selected Delivery Type and/or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't select Supplier Contract as a Fulfillment Source on this transaction type.</xsd:documentation>
<wd:Validation_Message>You can't select Supplier Contract as a Fulfillment Source on this transaction type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Service_Line_Reference" type="wd:Service_Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Service Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company at the line level that has an intercompany relationship with the company at the header level.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a valid Line Company for 1 of the companies on the template header</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an Item on the Requisition.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can’t add Contract items to Service lines.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional description of the item, especially useful if only a Spend Category is selected for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Spend Category Usage Type for this Spend Category must be Procurement.</xsd:documentation>
<wd:Validation_Message>The Spend Category Usage Type for this Spend Category must be Procurement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Fulfillment_Source_Reference" type="wd:Requisition_SourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Fulfilment source on Service Line.This is defaulted to Purchase Order for Service Requisition Lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to an existing Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select another currency or supplier. This supplier doesn’t accept the currency on the requisition: [supplier].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order-From_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a valid Order-From Supplier Connection</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You need to add a Supplier before you can add an Order-From Connection.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Service Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Optional Address Reference for an existing Ship-To Address.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a valid Ship-To Address Reference for the Company and Worker on the Requisition Template.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker, who will be the designated Ship-To Contact.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver-To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Location, where the Goods or Services will be delivered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Requisition Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[not allowed worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Multi-Company is enabled, this validation compares against the Line Company and requires that the line Company is provided when Grant is supplied.</xsd:documentation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You have selected an invalid worktag. Select a valid worktag for any of the company or company hierarchies on the requisition template.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Service_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Quantity splits are not allowed for Service Lines.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Patient_Charge_Information_DataType">
<xsd:annotation>
<xsd:documentation>Element Containing Purchase Item HCPCS value and Patient Charge Information Row subelement</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select the Enable Healthcare Options checkbox under the Procurement Options section on the Edit Tenant Setup - Financials task to set the Patient Chargeable option for the inventory site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There is already an update in progress for this purchase item. Complete the current request, [event], before maintaining the item’s patient charge information.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Item_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Item ID. This is the Purchase Item unique identifier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="HCPCS" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Item HCPCS Code</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Remove HCPCS from alternate item identifiers. HCPCS already exists for Item ([item]) on the Alternate Item Identifiers tab.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:string">
<xsd:maxLength value="5"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Patient_Chargeable_Reference" type="wd:Patient_ChargeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Added Patient Chargeable field on Purchase Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Patient_Charge_Information_Row_Data" type="wd:Patient_Charge_Information_Row_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Patient Charge Information Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Patient_Charge_Information_Row_DataType">
<xsd:annotation>
<xsd:documentation>Patient Charge Information Row Data instance.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The combination of CDM ([ccode]), Company ([company]), and Revenue Center ([revcenter]) for this item ([item]) is already in use.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Patient_Charge_Information_Reference" type="wd:Patient_Charge_InformationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Patient Charge Information Row Data instance.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Patient_Charge_ID" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Patient Charge ID. This is the Patient Charge unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="CDM" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>CDM Value</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Organization_Reference" type="wd:OrganizationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Refers to existing Company associated with the Patient Charge Information</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Revenue_Center_Reference" type="wd:Revenue_CenterObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Refers to existing Revenue Center associated with the Patient Charge Information</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Revenue Center ([revenue center]) is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Revenue Center ([revenue center]) is not valid for Company ([company])</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't submit a Revenue Center without an associated Company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>If True is entered, the Patient Charge Information for the supplied Purchase Item reference will be deleted.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing filter criteria for Requisition Templates</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Company for Requisition Template. This value will be used as a filter criteria for Requisition Templates</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Template_Name" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Requisition Template Name. This value will be used as a filter criteria for Requisition Templates</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Owned_by_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Requisition Template Owned By. This value will be used as a filter criteria for Requisition Templates</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Defines the data to include in the response. By default, the response includes: Response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_WWSType">
<xsd:annotation>
<xsd:documentation>Element including Requisition Template Instance and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Reference" type="wd:Requisition_TemplateObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Requisition Template</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Data" type="wd:Requisition_Template_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Requisition_Templates_RequestType">
<xsd:annotation>
<xsd:documentation>Root element for the Request on the Get operation. Contains references, criteria, filter and response group for specifying which instances to return in the Response.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Requisition_Template_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Requisition_Template_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Requisition_Template_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Get_Requisition_Templates_ResponseType">
<xsd:annotation>
<xsd:documentation>Nature of Actions Request References Element</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Requisition_Template_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Requisition_Template_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Requisition_Template_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Shared_Requisition_Template_Response_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Nature of Actions Secondary Request Reference Element</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Reference" type="wd:Requisition_TemplateObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Requisition Template</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Requisition_Template_Goods_Line_DataType">
<xsd:annotation>
<xsd:documentation>Element containing all Requisition Goods Line data. A Requisition may have multiple Goods Lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Item Description is Required</xsd:documentation>
<wd:Validation_Message>Item Description is Required</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Spend Category is required.</xsd:documentation>
<wd:Validation_Message>Spend Category is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity must be greater than zero and cannot be partial when the document line's spend category is Tracked (unless related to a supplier contract line).</xsd:documentation>
<wd:Validation_Message>Quantity must be greater than zero and cannot be partial when the document line's spend category is Tracked (unless related to a supplier contract line).</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Quantity cannot be negative</xsd:documentation>
<wd:Validation_Message>Quantity cannot be negative</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Supplier Item Identifiers cannot be set or updated for lines with no items or having non-catalog items. Catalog Items also have Supplier Item Identifiers, but we cannot change the existing value using this web service. For this web service, Web items will not trigger this validation, but any entered Supplier Item Identifier will be ignored and the original value from the web item will be kept.</xsd:documentation>
<wd:Validation_Message>Supplier Item Identifiers cannot be set or updated for lines with no items or having non-catalog items. Catalog Items also have Supplier Item Identifiers, but we cannot change the existing value using this web service. For this web service, the value will not be changed (but will not fire an error) if there is a Web Item (punchout item) associated with the Purchase Order Line Reference and the Supplier Item Identifier is different.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the quantities on the split lines ([split qty]) must equal the quantity of the summary line: [qty]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the extended amounts on the split lines ([split amt]) must equal the extended amount of the summary line: [amt]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Order From Connection is not valid for the Supplier</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier is required if Order-From Connection exists</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Only one worktag for each type is allowed for each document line.</xsd:documentation>
<wd:Validation_Message>Only one worktag for each type is allowed for each document line.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Please enable Multi-Company on Requisitions.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Deliver-To Location is invalid for the selected Delivery Type and/or Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't select Supplier Contract as a Fulfillment Source on this transaction type.</xsd:documentation>
<wd:Validation_Message>You can't select Supplier Contract as a Fulfillment Source on this transaction type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Requisition_Template_Goods_Line_Reference" type="wd:Item_Requisition_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an existing Goods Requisition Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company at the line level that has an intercompany relationship with the company at the header level.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a valid Line Company for 1 of the companies on the template header</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference of an Item on the Requisition.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Item_Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>An optional description of the item, especially useful if only a Spend Category is selected for this line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Identifier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The supplier item identifier for a Requisition Goods Line</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Spend Category Usage Type for this Spend Category must be Procurement.</xsd:documentation>
<wd:Validation_Message>The Spend Category Usage Type for this Spend Category must be Procurement.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Fulfillment_Source_Reference" type="wd:Requisition_SourceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to Fulfillment source on Requisition goods Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inventory_Site_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References the Inventory Site on the Requisition Template Goods Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't enter an Inventory Site when the Fulfillment Source is Purchase Order.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>References to an existing Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select another currency or supplier. This supplier doesn’t accept the currency on the requisition: [supplier].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a Supplier when the Fulfillment Source is Inventory.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order-From_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a valid Order-From Supplier Connection</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Quantity for Requisition Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="22"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Unit_Of_Measure_Reference" type="wd:Unit_of_MeasureObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Unit of Measure</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Unit_Cost" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Unit Cost for Requisition Line</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Requisition line. This amount is automatically calculated by multiplying the Quantity by the Unit Cost in the currency specified on the Requisition.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Ship-To_Address_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Address Reference for an existing Ship-To Address. If not specified on the Requisition Line, Workday will default the Ship-To Address Reference from the Requisition Header.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a valid Ship-To Address Reference for the Company and Worker on the Requisition Template.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to a Worker, who will be the designated Ship-To contact. If not specified on the Requisition Line, Workday will default the Requisition Requester as the Ship-To Contact.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Ship-To Contact Reference must be for an active worker in the company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver-To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Location, where the Goods or Services will be delivered. If not specified on the Requisition Line, Workday will default the workspace or the business site of the Requisition Worker as the Deliver-To Location.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Requisition Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktag_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Worktags are not allowed when there are split lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You have selected an invalid worktag. Select a valid worktag for any of the company or company hierarchies on the requisition template.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Requisition_Template_Goods_Line_Split_Data" type="wd:Business_Document_Line_Split_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Items_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria, filter and response group for getting Supplier Item data. Important: For integration systems where we want to limit updates to only a single supplier, do not allow any Request References, and the Supplier field in the Request Criteria should be a required field and singular and defaulted by the integration system to only be the exact supplier that the user has permission to get pricing information. Note: Response Filter has field to specify 'As Of Effective Date'. If entered, the results of unit of measure pricing and advanced pricing rows will be filtered by whether the pricing is effective on or before that date. If no effective date entered the current date will be used as filter criteria. 'As of Entry datetime' Response Filter is not supported by this operation</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Supplier_Item_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Items Request References. Important: For integration systems where we want to limit updates to only a single supplier, do not allow any Request References to be sent. The Request Criteria should be used instead and the Supplier field in the Request Criteria should be singular and defaulted by the integration system to only be the exact supplier that the user has permission to get pricing information. If both Request References and Request Criteria are empty, no pricing information will be returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Supplier_Item_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Items Request Criteria. Important: For integration systems where we want to limit updates to only a single supplier, do not allow any Request References to be sent. The Request Criteria should be used instead and the Supplier field in the Request Criteria should be singular and defaulted by the integration system to only be the exact supplier that the user has permission to get pricing information. If both Request References and Request Criteria are empty, no pricing information will be returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Item_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Supplier Items Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Get_Supplier_Items_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Item Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Supplier_Item_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Supplier_Item_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Supplier_Item_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Supplier_Item_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Item_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper Element including Supplier Item Instance and data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item" type="wd:Supplier_ItemType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_ItemType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Item Reference and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item_Reference" type="wd:Supplier_Item_Details_AbstractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to Supplier Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Item_Data" type="wd:Supplier_Item_Price_Update__HV__DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Item Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Item_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element Containing Supplier Item Request Criteria</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Supplier reference is for a supplier that can be used as a basic worktag only.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter one or more Purchase Items, Suppliers, Supplier Contracts, or Spend Categories to retrieve supplier items or linked catalog items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You don't have access to this Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Item_Reference" type="wd:Purchase_ItemObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only retrieve supplier items specific to these Purchase Items. If empty, no restriction is applied</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only retrieve supplier items specific to these Suppliers. Important: For integration systems where we want to limit updates to only a single supplier, the Supplier field should be singular and defaulted by the integration system to only be the exact supplier that the user has permission to get pricing information. If empty, no supplier restriction is applied. Suppliers in the list cannot be for a supplier that can be used as a basic worktag only</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only retrieve supplier items specific to these Supplier Contracts. Important: For integration systems where we want to limit updates to only a single supplier contract, the Supplier Contract field should be singular and defaulted by the integration system to only be the exact supplier contract that the user has permission to get pricing information.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Only retrieve supplier items specific to these Spend Categories. If empty, no restriction is applied</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Only_Default_UOM_and_Price" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Only retrieve pricing information from the default unit of measure (bulk and just in time defaults). If empty or false, all pricing information is retrieved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Only_Active_Supplier_Items" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Only retrieve Supplier Items considered active (that have active unit of measure pricing information.)</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Only_Default_UOMs_with_Calculate_Price_Enabled" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Return default units of measure when you enable Calculate Price based on Conversion Factor. When you don't enable Calculate Price based on Conversion Factor, we return all Ordering and Just in Time UOMs.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Exclude_Pricing_Calculated_by_Conversion_Factor" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Select to exclude pricing that’s calculated based on the conversion factor. When you enable Calculate Price based on Conversion Factor, Workday only returns pricing that is not calculated based on the conversion factor and the also the default price. This enables you to quickly view and edit relevant pricing.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Item_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing references to Supplier Item</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Item_Reference" type="wd:Supplier_Item_Details_AbstractObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>References to Supplier Item</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Item_Response_GroupType">
<xsd:annotation>
<xsd:documentation>Element containing Supplier Item response options</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Include_Reference" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Include Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Show_All_Pricing" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>When 1, will return all Unit of Measure Pricing and Advance Pricing data, including future dated, past dated, and pricing not valid as of current day. Pricing marked Inactive will be returned as well. The value "As of Effective Day" from the Response Filter will be ignored. If 'Only Default UOM and Price' filter criteria is also 1, only default pricing is returned, and no Advanced Pricing is returned, but historical and future default Unit of Measure pricing will still appear. If used with 'Only Active Supplier Items' is 1, only pricing not marked inactive is returned.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Revenue_Center_Request_ReferencesType">
<xsd:annotation>
<xsd:documentation>Element containing reference instances for a Revenue Center</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Revenue_Center_Reference" type="wd:Revenue_CenterObjectType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to an existing Revenue Center</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Revenue_Centers_RequestType">
<xsd:annotation>
<xsd:documentation>Contains request reference, criteria and filter for getting Revenue Center data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Request_References" type="wd:Revenue_Center_Request_ReferencesType" minOccurs="0"/>
<xsd:element name="Request_Criteria" type="wd:Revenue_Center_Request_CriteriaType" minOccurs="0"/>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Revenue_Center_Response_GroupType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Revenue_Center_Response_DataType">
<xsd:annotation>
<xsd:documentation>Wrapper Element that includes Revenue Center Instance and Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Revenue_Center" type="wd:Revenue_CenterType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Revenue_Center_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Element containing Revenue Center request criteria</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Get_Revenue_Centers_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Revenue Center response elements.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Revenue_Center_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Revenue Centers Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Revenue_Center_Request_CriteriaType" minOccurs="0"/>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0"/>
<xsd:element name="Response_Group" type="wd:Revenue_Center_Response_GroupType" minOccurs="0"/>
<xsd:element name="Response_Results" type="wd:Response_ResultsType" minOccurs="0"/>
<xsd:element name="Response_Data" type="wd:Revenue_Center_Response_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Revenue_CenterType">
<xsd:annotation>
<xsd:documentation>Element containing Revenue Center reference for GET Revenue Center data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Revenue_Center_Reference" type="wd:Revenue_CenterObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Revenue Center</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Revenue_Center_Data" type="wd:Revenue_Center_DataType" minOccurs="0"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Pending_Supplier_Change_RequestType">
<xsd:annotation>
<xsd:documentation>Contains reference to Supplier with a pending Supplier Change to cancel.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Supplier does not have a pending Supplier Change.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType">
<xsd:annotation>
<xsd:documentation>Supplier with a pending Supplier Change to cancel.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Cancel_Pending_Supplier_Change_ResponseType">
<xsd:annotation>
<xsd:documentation>Contains Reference to Supplier with canceled Supplier Change.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier with canceled Supplier Change.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Supplier_Contract_Amendment_DataType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submitted new Contract Type for existing Supplier Contract is not of the same shape as the Contract Type to be replaced. A new Supplier Contract Type may be submitted for this Supplier Contract, but it must match the current Supplier Contract Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Use a Supplier Contract Type that allows Multi-Supplier Data or remove that data.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract Amendments are not allowed for Financial or Operating Lease Contract Types.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select at least one line for retention if percent to retain is entered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract cannot be amended. It has either been terminated or the Supplier has been inactivated.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Contract End Date or Total Contract Amount are required for Contract Types allowing either Scheduled Invoices or Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Use a Supplier Contract Type that supports Renewal Terms, or remove it from the contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog Discount Percent cannot be greater than 100 or less than 0.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Both the override payment type for scheduled invoices and the override payment type for the contract cannot be present at the same time.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Start Date must be less than the End Date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Document Link URL entered does not comply with URL restrictions set for this Field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>External Document Links are currently not enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For contracts with scheduled purchase orders, provide Purchase Order Data. For contracts without scheduled purchase orders, remove Purchase Order Data.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>For contracts with scheduled supplier invoices, provide Supplier Invoice Data. For contracts without scheduled supplier invoices, remove Supplier Invoice Data.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t enter service lines on consignment supplier contract</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Based on the contract document date, the Unit of Measure on these lines are invalid: [errorLines]. Change the Document Date or the Units of Measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't include service lines on a supplier contract that supports Scheduled Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Cost Center is invalid for the Company on these lines: [errorLines].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You cannot use amendment type of Add Hold or Remove Hold on Submit Supplier Contract Amendment WWS operation.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A contract type that includes retention must be used to enter retention details.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Spend Category is inactive on these lines: [errorLines].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter valid worktags on these lines: [errorLines].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The catalog items are inactive or expired. Activate or change the effective date of the items in catalog load or cancel the items in the contract on these lines: [errorLines]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter valid Ship-To Address on these lines: [errorLines].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select companies from the Restricted to Companies list for the supplier. You selected participant companies that aren't valid for the supplier: [InvalidCompanies]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a GPO reference for this contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>One or more of the participant companies are inactive. Select active companies as participant companies.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't select participant companies without a currency conversion rate setup between the contract currency and company currency: [InvalidCompanies]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only enter participant companies on multi-participant type supplier contracts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select at least 1 active participant for a multi-participant type supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A non-zero Catalog Percent Discount requires a Catalog.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a different catalog, date range, or participant company for the supplier contract. You already have [duplicate contract] for [catalog]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Either remove the markup, or remove the contract lines. Markups can't be added to multisupplier contracts with goods, service, or project-based lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter a charge control for this contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a non-terminated worker for Contract Specialist Reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>At least 1 active supplier must exist on the header or within the Supplier List</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove contract line. Contract lines are not supported on Multi-Participant Multi-Supplier Contracts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove Tax Code. Tax Codes are not supported on Multi-Participant Multi-Supplier Contracts.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter required worktags on these lines: [errorLines].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Contract_To_Amend_Reference" type="wd:Supplier_ContractObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Reference for Amendment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Amendment_Information" type="wd:Supplier_Contract_Amendment_InformationType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Information Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Amendment_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Contract Amendment Reference ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You may not modify the Company for a Supplier Contract within this amendment.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Hierarchy_Reference" type="wd:OrganizationObjectType">
<xsd:annotation>
<xsd:documentation>Company Hierarchy Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You may not modify the Company Hierarchy for the Supplier Contract in this amendment.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You may not modify the Supplier for the Supplier Contract in this amendment.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order_From_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Order-From Connection is a specific supplier site or division where you issue the purchase order. Accepted Order-From Connections must be active and belong to the Supplier. Contract Type must allow either Scheduled Purchase Order or Manual Purchase Order to use Order-From Connection. In addition, Consignment, Multi-Supplier and Lease Contract Types are not compatible with Order-From Connection.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter an active order-from connection for the supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier contract type doesn't support order-from connection.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Specialist_Reference" type="wd:WorkerObjectType">
<xsd:annotation>
<xsd:documentation>Contract Specialist Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Type_Reference" type="wd:Supplier_Contract_TypeObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Contract Type Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Status of Supplier Contract or Supplier Contract Amendment. This information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Buyer Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The chosen Supplier Contract Type does not allow Scheduled Purchase Orders or Manual Purchase Orders. You may not submit a Buyer for Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The chosen Supplier Contract Type requires that you submit a Buyer for Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Name" type="xsd:string" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Name</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="GPO_Contract_Reference" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Group Purchasing Organization (GPO) Contract Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't change the GPO Contract Reference when you submit an amendment for the supplier contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Link to the external document captured on the contract.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Start_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_Signed_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Signed Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contract_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract End Date</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract Amendment Type is 'Terminated'. This type requires you to enter a Supplier Contract End Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Charge_Control_Data" type="wd:Charge_Control_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Header charge control amounts for amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Total_Contract_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Total Contract Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Total Contract Amount must be greater than or equal to the Entered Contract Line Amount.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Original_Contract_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Original Supplier Contract Amount. This information is for outbound purposes only and is not processed on inbound Workday Web Services requests.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Currency on the Amendment must be the same as the Currency on the original Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency entered is not listed as an Accepted Currency by Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment terms for non-scheduled types of contracts.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't submit the Payment Terms Reference, as the Supplier Contract Type you selected only allows Scheduled Purchase Orders. Please use Purchase Order Payment Terms Reference to submit Payment Terms for this Supplier Contract Type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't submit the Payment Terms Reference, as the Supplier Contract Type you selected only allows Scheduled Invoices. Please use Supplier Invoice Payment Terms Reference to submit Payment Terms for this Supplier Contract Type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The payment type to use if it differs from the default payment type from the Supplier. This is used for all contract types except ones that have scheduled invoices</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The override payment type is not allowed when there are scheduled invoices. You must use the "Scheduled Invoice Override Payment Type Reference" field.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The selected payment type ([pay type]) is not allowed for supplier: [supplier].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The credit card to default on POs. This can only be set if the default payment type or override payment type is set to Credit Card.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The credit card reference is not allowed when there are scheduled invoices.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The credit card is not valid. It must be associated with the supplier, buyer, contract specialist or the user submitting the contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The credit card selected is for company [CCCompany] and cannot be used on supplier contracts for the company/company hierarchy.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A credit card is only allowed if the supplier's default payment type or the override payment type is credit card.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Renewal_Terms_Data" type="wd:Renewal_Terms_DataType" minOccurs="0"/>
<xsd:element name="Contract_Overview" type="wd:RichText" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Contract Overview</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Reference" type="wd:Supplier_CatalogObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Catalog Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Catalog's Supplier must match that of the Supplier Contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Catalog Currency does not match Supplier Contract Currency.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The provided Supplier Contract Type does not allow catalogs. You may not submit a Supplier Contract Catalog.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Catalog_Discount_Percent" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Catalog Discount Percent</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The provided Supplier Contract Type does not allow catalogs. You may not submit a Catalog Discount Percent.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Supplier_Invoice_Data" type="wd:Supplier_Invoice_Defaults_for_Supplier_Contract_Amendment_DataType" minOccurs="0"/>
<xsd:element name="Purchase_Order_Data" type="wd:Purchase_Order_Defaults_for_Supplier_Contract_Amendment_DataType" minOccurs="0"/>
<xsd:element name="On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>On Hold Flag</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="System_Generated" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Amendment was System Generated. Not enterable for Submit Suplier Contract Amendment web service. It is used only by Get Supplier Contract Amendment web service.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_to_Retain" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent to Retain for Supplier Contract Amendment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Retention_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Estimated Retention Release Date for Supplier Contract Amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Third_Party_Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>3rd Party Retention for Supplier Contract Amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention memo for Supplier Contract Amendment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Lines_Replacement_Data" type="wd:Supplier_Contract_Amendment_Goods_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Goods Lines Replacement Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Lines_Replacement_Data" type="wd:Supplier_Contract_Amendment_Service_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Service Lines Replacement Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Multi_Supplier_Data" type="wd:Multi-Supplier_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Multi-Supplier Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Multi_Participant_Data" type="wd:Multi-Participant_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Multi-Participant Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_with_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_Defaults_for_Supplier_Contract_Amendment_DataType">
<xsd:annotation>
<xsd:documentation>Element that contains supplier invoice information for supplier contracts</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Company_for_Supplier_Invoice_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Company for Supplier Invoice Reference</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>For Supplier Invoice Defaults, enter a Company that is on the contract or on the contract's company hierarchy.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_for_Supplier_Invoice_Reference" type="wd:SupplierObjectType">
<xsd:annotation>
<xsd:documentation>Supplier for Supplier Invoice Reference. This is the Pay To Supplier that will be used as a default when creating Supplier Invoice Schedules.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:choice>
<xsd:element name="Supplier_Connection_for_Supplier_Invoice_Reference" type="wd:Remit-To_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Business Connection.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Supplier Connection is Inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Connection is not valid for Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Default_Supplier_Connection" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>TRUE or FALSEIf this is set to 'TRUE' the default supplier connection will be derived.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Supplier_Invoice_Payment_Terms_Reference" type="wd:Payment_TermsObjectType">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Payment Terms Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Scheduled_Invoice_Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The payment type to be used when the default payment from the Supplier is not preferred. This is only acceptable when there are scheduled invoices for this contract type.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The provided Supplier Invoice Payment type is not a valid method of payment for the current Supplier or Remit-To Supplier Connection. Modify the Supplier Invoice Payment Type or the Supplier or Remit-To Supplier Connection for this Supplier Contract.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Reference_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Reference Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Submit_Supplier_Contract_Amendment_ResponseType">
