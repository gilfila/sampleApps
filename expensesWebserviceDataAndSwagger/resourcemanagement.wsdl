<xsd:documentation>Requires Prenote Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Type_Prenote_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Type Prenote Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accepts_Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Indicates the Currency values accepted by this Settlement Bank Account</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Leave the Accepts Currency Reference field empty. You can only specify accepted currencies for supplier settlement bank accounts.</xsd:documentation>
<wd:Validation_Message>Leave the Accepts Currency Reference field empty. You can only specify accepted currencies for supplier settlement bank accounts.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates whether the Settlement Bank Account is inactive or active. A true value indicates the account is Inactive.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bank_Instructions" type="xsd:string" minOccurs="0" maxOccurs="1">
