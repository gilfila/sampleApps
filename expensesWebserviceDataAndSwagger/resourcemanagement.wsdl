<xsd:documentation>Element that captures Alternate Item Identifiers for a Line</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Enter a 14 digit numeric value for GTIN Alternate Item Identifier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only alphanumeric values are allowed for UPN.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Value needs to be provided for Manufacturer.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Value needs to be provided for [ExternalName].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a valid GTIN</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Manufacturer Reference not allowed for [ExternalName]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Can't enter duplicate External Name if Allow Multiples flag is not enabled for Item Identifier mapped to [ExternalName].</wd:Validation_Message>
