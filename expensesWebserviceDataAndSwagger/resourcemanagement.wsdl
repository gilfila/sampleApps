<xsd:complexType name="Adjust_Asset_RequestType">
<xsd:annotation>
<xsd:documentation>Contains data used to process Asset Adjustment.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Business_Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>A reference to the asset that should be adjusted.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Reference" type="wd:Financials_Business_Process_ParametersType" minOccurs="0"/>
