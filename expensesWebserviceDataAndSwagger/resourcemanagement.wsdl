</xsd:annotation>
<xsd:sequence>
<xsd:element name="Request_References" type="wd:Project_Plan_Request_ReferencesType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project references in GET request</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Project_PlanType">
<xsd:annotation>
<xsd:documentation>Element containing all project plan information requested.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Reference" type="wd:ProjectObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Project Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Plan_Data" type="wd:Project_Plan_DataType" minOccurs="0">
