<xsd:documentation>List of defined ordering and JIT units of measure along with pricing history for the Catalog Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Cancel_Purchase_Order_RequestType">
<xsd:annotation>
<xsd:documentation>Cancel Purchase Order Request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Reference" type="wd:Purchase_OrderObjectType" minOccurs="0">
