<xsd:documentation>Element containing the data requested in the GET Project Plan web service request</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Project_Plan" type="wd:Project_PlanType" minOccurs="0" maxOccurs="unbounded">
