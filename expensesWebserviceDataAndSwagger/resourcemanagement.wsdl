<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify suppliers that aren't basic. This supplier is basic: [supplier].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify valid suppliers for the Additional Suppliers for Sending Invoices table. The suppliers you submitted are invalid for your request.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
