<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't access this receivable repayment as it belongs to a company to which you don't have access.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
