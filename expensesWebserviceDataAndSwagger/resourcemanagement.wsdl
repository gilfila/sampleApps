</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Catalog_Load_Item__HV__DataType">
<xsd:annotation>
<xsd:documentation>Element containing Catalog Load Item Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Cannot use Catalog Item ID as it is used for a different Catalog Item</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Provide a valid Spend Category when you specify the Purchase Item for the Catalog Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Item Tag is Inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>No more than four additional images can be assigned to an item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify duplicate Item Identifiers on Catalog Load.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify Item Tags for internal service catalog loads.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify duplicate ordering units of measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a default ordering unit of measure for the catalog load item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a Purchase Item reference for internal service catalog loads.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't mark units of measure as inactive when loading new catalog items.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify alternate item identifiers for internal service catalog loads.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter the same base Unit of Measure of the purchase item when there is a purchase item reference.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one unit of measure can be selected as the default.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a default Just In Time ordering unit of measure for the catalog load item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter duplicate Just In Time units of measure.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Only one Just In Time unit of measure can be selected as the default.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can’t set catalog items as Inactive when they haven’t been loaded into the catalog.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select an active spend category with procurement usage. [Spend Category or UNSPSC code] is not a valid entry.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't select a UNSPSC or NIGP type alternate item identifier when you select a commodity code. Either remove the commodity code or the alternate item identifier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't specify a Commodity Code reference for internal service catalog loads.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a valid commodity code or leave the commodity code field blank. [Commodity Codes] is/are invalid.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can select only 1 code for each commodity code type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Purchase Item that has the same Spend Category as the Catalog Item.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There is already an update in progress for the related purchase item.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Catalog_Item_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
