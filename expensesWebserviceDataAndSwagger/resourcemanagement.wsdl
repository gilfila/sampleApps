<wd:Validation>
<wd:Validation_Message>Service requests are not allowed for the selected company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Project-based service requests are not allowed for the selected company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Service lines or deliverable service lines are not allowed for the selected requisition type.</wd:Validation_Message>
