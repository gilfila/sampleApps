<xsd:documentation>The subregion part of the address.</xsd:documentation>
</xsd:annotation>
<xsd:simpleContent>
<xsd:extension base="xsd:string">
<xsd:attribute name="Descriptor" type="xsd:string">
<xsd:annotation>
<xsd:documentation>The descriptor is an optional serialized attribute that shows the text Override Label (such as Municipality or District) that helps describe the usage of the type (such as REGION_SUBDIVISION_1 or REGION_SUBDIVISION_2) for each country.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute name="Type" type="xsd:string">
<xsd:annotation>
<xsd:documentation>Enter the region subdivision type, such as REGION_SUBDIVISION_1, or REGION_SUBDIVISION_2.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:extension>
</xsd:simpleContent>
