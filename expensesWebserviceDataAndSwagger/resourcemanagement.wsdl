<xsd:complexType name="Put_Rate_Schedule_RequestType">
<xsd:annotation>
<xsd:documentation>Contains data for creating and updating a Rate Schedule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The web service is set to add only, but the Rate Schedule already exists.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Rate_Schedule_Reference" type="wd:Rate_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Rate Schedule to modify.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Rate_Schedule_Data" type="wd:Rate_Schedule_DataType"/>
</xsd:sequence>
<xsd:attribute name="Add_Only" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Prevents the request from deleting or modifying any existing Rate Schedules.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Rate_Schedule_Request_CriteriaType">
<xsd:annotation>
<xsd:documentation>Contains additional criteria for identifying specific Rate Schedule instances.</xsd:documentation>
</xsd:annotation>
</xsd:complexType>
<xsd:complexType name="Rate_Schedule_Response_DataType">
<xsd:annotation>
<xsd:documentation>Contains the Rate Schedule Instance data.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Rate_Schedule" type="wd:Rate_Schedule_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Get_Rate_Schedules_RequestType">
<xsd:annotation>
