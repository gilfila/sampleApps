</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter the Identification # for the Transaction Tax ID.</xsd:documentation>
<wd:Validation_Message>Enter the Identification # for the Transaction Tax ID.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Transaction Tax ID can only be selected when the Tax ID Type is selected as a Transaction Tax ID. Otherwise it must be blank.</xsd:documentation>
<wd:Validation_Message>Transaction Tax ID can only be selected when the Tax ID Type is selected as a Transaction Tax ID. Otherwise it must be blank.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Tax ID Type selected for this Tax ID cannot be used in this webservice.</xsd:documentation>
<wd:Validation_Message>Tax ID Type cannot be used for a [businessEntityType]: [Tax ID Type].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid ABN format. ABN must not start with 0.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid ABN format. ABN must be 11 digits with no special characters.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Tax_ID_Text" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Enter the Tax ID value for the respective Tax Type.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ECON.ECON is nine characters in length and is formatted as follows:1. Character 1 must be alpha - "E".2. Characters 2 - 8 must be numeric in the range 3000000 - 3999999.3. Character 9 must be Alpha.4. The 9th character must pass the modulus 19 check.5. Character 9 may not be "G", "I", "O", "S", "U", "V" or "Z".</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid Employer Accounts Office Reference number:Characters 1-3 of Employer Accounts Office Reference number must be numeric.Character 4 of Employer Accounts Office Reference number must be 'P'.Character 5 of Employer Accounts Office Reference number must be alpha.Characters 6-12 of Employer Accounts Office Reference number must be numeric.Last digit of Employer Accounts Office Reference number must be numeric or ‘X’.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid Employer PAYE Reference number.Employer PAYE Reference must not exceed 10 characters, and must contain only alphanumeric or special characters.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Invalid HMRC Office Number.HMRC Office Number must be 3 characters, numeric and in the range 001 – 999. Where applicable, leading zeroes must be present.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_ID_Type_Reference" type="wd:Tax_ID_TypeObjectType">
<xsd:annotation>
<xsd:documentation>Enter the Tax Type tied to the Tax ID value entered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Tax_ID" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates if the Tax ID is used as the Transaction Tax ID for the country.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Primary_Tax_ID" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates if the Tax ID is used as the Primary Tax ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Validation_Service_Data" type="wd:Validation_Status_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
<xsd:attribute name="Delete" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Set this flag to true in order to delete Tax ID.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Tax_ID_Widget_DataType">
<xsd:annotation>
<xsd:documentation>Tax ID Widget Element to include 1 or more Tax ID Data WSS elements</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>If HMRC Office Number, Employer PAYE Reference, or Employer Accounts Office Reference Number is defined, the three Tax IDs need to be defined.</xsd:documentation>
<wd:Validation_Message>If HMRC Office Number, Employer PAYE Reference, or Employer Accounts Office Reference Number is defined, the three Tax IDs need to be defined.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can only have 1 Primary Tax ID.</xsd:documentation>
<wd:Validation_Message>You can only have 1 Primary Tax ID. Check Tax ID Types [Tax ID Types] in both request and Target Supplier</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Delete is set to true, Replace All must be set to false in Tax ID Widget Data.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, Replace All must be set to false in Tax ID Widget Data.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can only select the Tax ID Type once for a Country.</xsd:documentation>
<wd:Validation_Message>You can only select the Tax ID Type once for a Country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You entered conflicting tax ID types. Specify only 1 of these tax ID types for the country: [taxIdTypes]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify True on the transaction tax ID for only 1 tax ID type per country.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Tax_ID_Data" type="wd:Tax_ID_WWS_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Tax ID Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute name="Replace_All" type="xsd:boolean">
<xsd:annotation>
<xsd:documentation>Replace All boolean to replace (True) or update (False) Tax ID information for a Supplier.</xsd:documentation>
</xsd:annotation>
</xsd:attribute>
</xsd:complexType>
<xsd:complexType name="Tax_Status_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Contains country level tax status information for the business entity.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The selected Country is already in use.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a Transaction Tax Status or Withholding Tax Status for the Country.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>If Delete is set to true, a valid transaction or withholding tax status must exist for the specified country.</xsd:documentation>
<wd:Validation_Message>If Delete is set to true, a valid transaction or withholding tax status must exist for the specified country.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Country_Reference" type="wd:CountryObjectType">
<xsd:annotation>
<xsd:documentation>Contains a reference to the country of the tax status.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Tax_Status_Reference" type="wd:Transaction_Tax_StatusObjectType" minOccurs="0">
