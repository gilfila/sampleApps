<wd:Validation>
<wd:Validation_Message>If there are Freight Charges, you must use a company with procurement options enabled for freight.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>If there are Other Charges, you must use a company with procurement options enabled for other charges.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
