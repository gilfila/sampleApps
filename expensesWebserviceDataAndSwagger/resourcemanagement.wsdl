<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Reservation_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text representing the reservation number for the expense.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The field [field] is required and must have a value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
