<xsd:complexType name="Tax_ID_WWS_DataType">
<xsd:annotation>
<xsd:documentation>Tax ID Data WWS element to specify 1 or more Tax IDs for a company.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>If Delete is set to true, existing Tax ID Type must be included.</xsd:documentation>
