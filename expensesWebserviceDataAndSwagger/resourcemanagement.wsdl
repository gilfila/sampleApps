<xsd:complexType name="Netting_Transaction_DataType">
<xsd:annotation>
<xsd:documentation>Netting Transaction Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submit a Netting Rule set up for the Company.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Netting_Transaction_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Netting Transaction ID</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>This is the company that tranasction is for. This is the reference id value of the company.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This is the reference id of currency of the transaction If no currency is specified, Workday will first look to see if the payer/payee has a preferred currency and if not, currency will be populated with the company base currency. If the company base currency is not allowed currency for payer/payee then transaction will not be able to be submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Netting_Rule_Reference" type="wd:Netting_RuleObjectType">
<xsd:annotation>
<xsd:documentation>Reference an existing Netting Rule for the Netting Transaction.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Netting_Rule_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Netting_Transaction_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Format is MM/DD/YYYY.If this is left blank, Workday will populate transaction date with the current date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Date_On_or_After_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Document Date on or after Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Date_On_or_Before_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Document Date on or before Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Invoice_Date_On_or_After_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Customer Invoice Document Date on or after Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Invoice_Date_On_or_Before_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Customer Invoice Document Date on or before Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Attachment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_for_Netting_Data" type="wd:Supplier_Invoice_For_Netting_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Invoice for Netting Data. A Netting Transaction should have at least one Supplier Invoice for Netting.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Supplier Invoice References and Supplier Invoice Adjustment Reference must be unique. Cannot use the same Supplier Invoice Reference or Supplier Invoice Adjustment Reference more than once.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>One or more of your supplier invoice or invoice adjustments is invalid for the netting transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the supplier invoices that aren't part of the netting rule set up for the Company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the supplier invoices that have an invoice date which doesn't match the criteria in the # of Days Invoices are Open Before Netting field. You can also change the field set up in the Invoice Eligibility Rule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Total Amount to Net that is greater than zero on both the supplier invoice document and customer invoice document.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Add supplier invoice adjustments to the invoice eligibility rule on the Netting Rule or remove the supplier invoice adjustments to submit this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit supplier invoices with dates on or before the transaction date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the supplier invoices that aren't part of the netting rule set up for the Supplier.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the invoices with an inactive Remit-To Connection.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Customer_Invoice_for_Netting_Data" type="wd:Customer_Invoice_for_Netting_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Customer Invoice for Netting Data. A Netting Transaction should have at least one Customer Invoice for Netting.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Customer Invoice References and Customer Invoice Adjustment Reference must be unique. Cannot use the same Customer Invoice Reference or Customer Invoice Adjustment Reference more than once.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>One or more of your customer invoice or invoice adjustments is invalid for the netting transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the customer invoices that aren't part of the netting rule set up for the company.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit customer invoices with dates on or before the transaction date.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the customer invoices that aren't part of the netting rule set up for the Customer.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Add the Customer Invoice Types to the invoice eligibility rule on the Netting Rule or remove the invalid Customer Invoice Types to submit this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Total Amount to Net that is greater than zero on both the supplier invoice document and customer invoice document.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Add customer invoice adjustments to the invoice eligibility rule on the Netting Rule or remove the customer invoice adjustments to submit this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the customer invoices that have an invoice date which doesn't match the criteria in the # of Days Invoices are Open Before Netting field. You can also change the field set up in the Invoice Eligibility Rule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_Invoice_For_Netting_DataType">
