<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Multi-Supplier_DataType">
<xsd:annotation>
<xsd:documentation>Multi-Supplier Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Submit a value for either the Catalog Discount or the Markup Percent. You can’t submit a discount and a markup for 1 supplier contract.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only submit Markup for All Suppliers when Allow All Suppliers option is enabled.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:choice>
<xsd:element name="Allow_All_Suppliers" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If the Allow All Suppliers flag is true, then the Supplier List Entry Data elements are ignored.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Include 1 or more active suppliers in the Supplier List.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="From_Supplier_List_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>From Supplier List Only</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Markup_for_All_Suppliers" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>You can use this field to submit the markup percentage for the pricing of goods on multi-supplier contracts, which are enabled for all the suppliers in your tenant. Submit a negative percentage to apply a discount. Markups aren't applied to service and project-based contract lines.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Supplier_List_Entry_Data" type="wd:Supplier_List_Entry_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier List Entry Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Supplier_List_Entry_DataType">
<xsd:annotation>
<xsd:documentation>Multi-Supplier Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Reference" type="wd:SupplierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier List Entry.for Supplier</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Add suppliers to list that are either Active or Hold.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Cannot change a new supplier to inactive on a supplier contract amendment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>One or more Suppliers selected in Multi-Supplier list are Restricted to Companies but are not restricted to either Company or the Company Hierarchy.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>1 or more suppliers selected in the multi-supplier list are restricted to companies that are not listed.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Inactive_as_List_Entry" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Inactive as List Entry</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Markup_Percent" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>You can use this field to submit the markup percentage for the pricing of goods provided by a supplier on a multi-supplier contract. Enter a negative percentage to apply a discount. Markups aren't applied to service and project-based contract lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>For inactive suppliers, remove the Markup Percent or submit the existing Markup Percent already setup on the contract. You cannot change markups for inactive suppliers.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="5"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Renewal_Terms_DataType">
<xsd:annotation>
<xsd:documentation>Element that contains renewal terms for supplier contracts</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Automatically_Renew" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Automatically Renew</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Send_Expiration_Notification" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Send Expiration Notification</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Notice_Period" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Notice Period</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You cannot have a value for Notice Period, if you do not opt into either 'Automatically Renew' or 'Send Expiration Notification'.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="3"/>
<xsd:minInclusive value="0"/>
