<xsd:documentation>Project Portfolio Reference for Put Project Portfolio Web Service Task.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Project_Portfolio_Data" type="wd:Project_Portfolio_WWS_DataType" minOccurs="0">
