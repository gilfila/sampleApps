<xsd:documentation>Get Project Portfolio Request References</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Request_Criteria" type="wd:Project_Portfolio_Request_CriteriaType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Project Portfolio Request Criteria</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:choice>
<xsd:element name="Response_Filter" type="wd:Response_FilterType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Response Filter</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Response_Group" type="wd:Project_Portfolio_Response_GroupType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Get Response Group</xsd:documentation>
</xsd:annotation>
</xsd:element>
