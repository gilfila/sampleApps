<wd:Validation>
<wd:Validation_Message>The supplied Supplier Contract is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must select a tax applicability with a default tax recoverability. The default tax recoverability that you specify must be Nonrecoverable and Allocates Nonrecoverable Tax.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Don't provide email addresses when Issue Option isn't Email.</xsd:documentation>
