<xsd:complexType name="Adjust_Asset_ResponseType">
<xsd:annotation>
<xsd:documentation>Responds with asset adjustment event.</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Adjustment_Event_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The asset adjustment event.</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Adjust_Asset_Book_Level_DataType">
<xsd:annotation>
<xsd:documentation>Contains data for the adjustments per book.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[asset book] isn't mapped to the [adjustment type].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following field(s) require a non-zero value: [fields].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the following field(s) for [adjustment type] adjustment types: [fields].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Book_Reference" type="wd:Asset_BookObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to asset book that you want to adjust.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Cost_Adjustment_Amount" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The amount of the asset adjustment cost.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Fair_Market_Value_Adjustment_Amount" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The adjustment amount in the fair market value.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Asset_Residual_Value_Adjustment_Amount" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The adjustment amount to the residual value of the asset.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Accounting_Treatment_Reference" type="wd:Accounting_TreatmentObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed accounting treatment for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Depreciation_Profile_Reference" type="wd:Depreciation_ProfileObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation profile for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Depreciation_Method_Reference" type="wd:Abstract_Depreciation_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation method for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Depreciation_Percent" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation percent for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Depreciation_Threshold" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation threshold for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Depreciation_Convention_Reference" type="wd:Depreciation_Convention__Mixed_ObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation convention for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Useful_Life" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed useful life for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Remaining_Depreciation_Periods_for_Schedule_from_WWS" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed remaining useful life for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Date_Placed_in_Service" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed date placed in service for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Depreciation_Start_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed depreciation start date for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Historical_Bonus_Depreciation_for_Schedule" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed historical bonus depreciation amount for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Accumulated_Depreciation_for_Schedule" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed historical accumulated depreciation amount for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Year_to_Date_Depreciation_for_Schedule" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed year to date depreciation amount for the asset depreciation schedule.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Bonus_Depreciation_Percent" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed bonus depreciation percent.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="14"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="2"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Max_Bonus_Depreciable_Basis" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed maximum bonus depreciation basis.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Rate_Schedule_Reference" type="wd:Rate_ScheduleObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed Rate Schedule Override for the asset depreciation schedule.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>When you select a Rate Schedule Override, ensure you are adjust an Asset Book Configuration using Rate Schedule Depreciation Method.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When you specify a Rate Schedule Override, ensure you are adjusting an Asset Book Configuration that is in service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>When you select a Rate Schedule, your transaction date must be after the Asset Depreciation Schedule's last Resume Date.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Adjust_Asset_DataType">
<xsd:annotation>
<xsd:documentation>Contains data related to Business Asset for Adjustment.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[adjustment reason] isn't mapped to the [adjustment type].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[adjustment type] is inactive and can't be used.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[adjustment type] is restricted to assets with [supp cont type] supplier contract type.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following field(s) require a non-zero value: [fields].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't change the following field(s) for [adjustment type] adjustment types: [fields].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Correct the adjustment reason to proceed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[adjustment type] is restricted to the following asset source(s): [asset sources].</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Adjustment_Type_Reference" type="wd:Asset_Adjustment_TypeObjectType">
<xsd:annotation>
<xsd:documentation>The adjustment type for the asset adjustment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Adjustment_Reason_for_Asset_Adjustment_Type_Reference" type="wd:Asset_Adjustment_ReasonObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The adjustment reason for the asset adjustment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Effective_Date" type="xsd:date">
<xsd:annotation>
<xsd:documentation>The transaction date for the asset adjustment.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Specify a Transaction Effective Date that’s after the Acquisition Date on the asset.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Accounting_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The accounting date for the asset adjustment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The memo for the asset adjustment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acquisition_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The asset acquisition date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Spend_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed spend category for the asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Class_Reference" type="wd:Asset_ClassObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed asset class.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Type_Reference" type="wd:Asset_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed asset type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Descriptor_Reference" type="wd:Item_DescriptorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed item descriptor.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Line_Reference" type="wd:Business_Document_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed supplier invoice line for the business asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Quantity" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed quantity for the asset adjustment.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Business_Use_Percent" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The percentage of business use for the asset.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Supplier_Contract_Start_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed supplier contract start date for the business asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_End_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed supplier contract end date for the business asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Contract_Number" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed external contract number for the asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Contract_Start_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed external contract start date for the asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Contract_End_Date" type="xsd:date" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The proposed external contract end date for the asset.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Proposed_Adjustment_Per_Book" type="wd:Adjust_Asset_Book_Level_DataType" minOccurs="0" maxOccurs="unbounded">
