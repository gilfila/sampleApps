<xsd:complexType name="Item_Inventory_Attributes_DataType">
<xsd:annotation>
<xsd:documentation>Inventory specific attributes for the purchase item.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Replenishment options are not allowed at the item when No Replenishment is set at the inventory site [site].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The replenishment type is required.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select the Enable Healthcare Options checkbox under the Procurement Options section on the Edit Tenant Setup - Financials task to set the Patient Chargeable option for the inventory site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a stocking location under the specified Inventory Site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a default stocking location that isn't consigned.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a default stocking location under the specified Inventory Site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a stocking location that has Quantity Available to Issue enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Default Consigned Stocking Location cannot be an owned location.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Item Inventory Attribute is in use and cannot be selected for deletion.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must specify a valid Item Inventory Attribute Reference if the Delete flag is set to True.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Source Inventory Site that does not create a dependency cycle for [site].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Serial-controlled items can only be stocked in Base Unit of Measure. Alternate Stocking Units of measure are not allowed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>This Item Inventory Site Attribute is not eligible for deletion because the lot option does not match the lot at the header or there is inventory still available for this item and site.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Consigned Maximum quantity that's greater than the Consigned Reorder Point quantity.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Stocking Location that isn't inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify a Stocking Location that isn't inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are available on-hand quantity in [Inventory Sites]. You can not delete the Item Site Attributes.</wd:Validation_Message>
