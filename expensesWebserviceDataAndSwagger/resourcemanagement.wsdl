<wd:Validation>
<wd:Validation_Message>You can't create a purchase order with down payment terms if you have worktag balancing enabled.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Submit a purchase order type that has the same configuration as the current purchase order type. For example, if the original purchase order type was marked Bill Only, you can’t remove it from the purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can only create a Purchase Order with a Purchase Order type that has a similar configuration as the associated Requisition type.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order ID. This is the Purchase Order unique identifier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Submit" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Submit for Approval is a boolean flag indicating if the transaction is to be submitted or saved in draft mode. If this flag is set, the transaction will be submitted, otherwise the transaction is saved in draft. If Purchase Order Issue Option is External, the Purchase will automatically be submitted and marked as Issued.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Locked_in_Workday" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set to True to disable editing the purchase order inside the Workday application.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Number of Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Invoice Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Status_Reference" type="wd:Document_Payment_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Payment Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Receiving_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Receiving Status for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Status_Reference" type="wd:Document_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Status for Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tracking_Status_Reference" type="wd:PO_Acknowledgement_StatusObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Tracking Status for Purchase Order. This field is read-only and ignored on Submit.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company_Reference" type="wd:CompanyObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company. Sets the Company for the Purchase Order.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Company_Reference_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Reference" type="wd:Resource_ProviderObjectType">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier supplying the goods or services for the Purchase Order.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Suppliers that are restricted to company must be restricted to either the document header company or the Company Hierarchy for which it is a subordinate.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Type_Reference" type="wd:Order_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing tenanted Purchase Order Type in the system.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an External Purchase Order Number.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Order_From_Supplier_Connection_Reference" type="wd:Order-From_Supplier_ConnectionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Order-from Connection tied to an existing Supplier supplying the goods.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The date of the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can only enter a tax amount in the header if you select Enter Tax Due to Supplier as the tax option.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Tax Amount must be positive if the Tax Option is 'Enter Tax Due to Supplier'.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight Amount</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there are Freight Charges, then there must be at least one line with a Spend Category that has Allocate Freight.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a positive Freight Amount value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Other_Charges" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Other Charges</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>If there are Other Charges, then there must be at least one line with a Spend Category that has Allocate Other Charges.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a positive Other Charges value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Payment_Terms_Reference" type="wd:Payment_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference for the Payment Terms you associate with the purchase order. Workday defaults the Payment Terms when you specify terms for a referenced supplier contract, remit-to-connection from a referenced order-from-connection, or from the supplier specified on the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type_Reference" type="wd:Payment_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Override Payment Type acceptable for the Supplier referenced on the Purchase Order. If provided, it must be a valid payment type for the Supplier.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>The Override Payment Type Reference provided is not an acceptable payment type for the Supplier.</xsd:documentation>
<wd:Validation_Message>The Override Payment Type Reference provided is not an acceptable payment type for the Supplier.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procurement_Credit_Card_Reference" type="wd:Worker_Credit_CardObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Procurement Card for the Purchase Order. If provided, the Payment Type reference must be set to Credit Card. If no Override Payment Type is supplied, then the Default Payment Type for the Supplier needs to be Credit Card. Additionally, the Procurement Card must be valid for the Supplier or the Buyer.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Expense_Credit_Card_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<xsd:documentation>The Payment Type for the Purchase Order must be Credit Card in order to assign a Procurement Card to the transaction.</xsd:documentation>
<wd:Validation_Message>The Payment Type for the Purchase Order must be Credit Card in order to assign a Procurement Card to the transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>The Procurement Card is not valid for the Company and the Supplier, Buyer or Processing Worker. Please select a valid Credit Card from the prompt provided.</xsd:documentation>
<wd:Validation_Message>The Procurement Card is not valid for the Company and the Supplier, Buyer or Processing Worker. Please select a valid Credit Card from the prompt provided.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Terms_Reference" type="wd:Shipping_TermsObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Terms Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Method_Reference" type="wd:Shipping_MethodObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Shipping Method Request Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Shipping_Instruction" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Puts Shipping Instruction data for Purchase Order WWS</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_Contract_BaseObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Supplier_Contract_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract field is required if there are any Contract Lines referenced.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Supplier Contract referenced cannot be an Amendment or History.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract field is required if there are any Contract Lines referenced.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Reference" type="wd:CurrencyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Currency Reference</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Currency_ID</wd:Common_Reference_ID_Type>
<wd:Validation>
<wd:Validation_Message>Currency Conversion Rates between currency and company's default currency are not defined.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Acknowledgement_Expected" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>True if this Purchase Order is expecting a POA</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The acknowledgement expected flag is not allowed when it is turned off in the tenant.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Option_Reference" type="wd:Tax_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Tax Option. If left blank, will default from the Company.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Default Tax Code for the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Issue_Option_Reference" type="wd:Purchase_Order_Issue_OptionObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Issue Option. If not entered, this will be defaulted to XML if the selected Supplier has a Supplier Link and Print otherwise. If Purchase Order Issue Option is External, the Purchase Order will automatically be submitted and marked as Issued.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Purchase Order Issue Option "External" may only be used on new or Draft Purchase Orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Purchase Order Issue Option "External" may not be used with Check Spend Budget tasks on the Purchase Order Issue Business Process.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The PO's issue option is “EDI/EDI Auto", but there is no integration system configured.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Issue Option “EDI/EDI Auto" can only be used if the supplier or order-from connection's default issue option matches EDI/EDI-Auto.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Purchase_Order_Issue_Email_Data" type="wd:Default_PO_Issue_Email_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Default PO Issue Email Data allows the user to select emails specified on Purchase Order Issue Email Data to be used as the default Issue Email address on all Purchase Orders.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Buyer_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the named buyer for the purchase order.</xsd:documentation>
<xsd:appinfo>
<wd:Common_Reference_ID_Type>Employee_ID</wd:Common_Reference_ID_Type>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Bill-To Contact. If value is not provided, Bill-To Contact will default to the name of the person submitting the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill_To_Address_Data" type="wd:Bill_To_Address_ReferenceType" minOccurs="0"/>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact for the Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Detail" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Name of the Ship-To Contact. If value is not provided, Ship-To Contact will default to the name of the person submitting the purchase order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Data" type="wd:Ship_To_Address_ReferenceType" minOccurs="0"/>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Link for Purchase Order</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Document Link URL entered does not comply with URL restrictions set for this Field.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text describing the purpose of the Purchase Order</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Internal_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for internal notes that cannot be viewed by the supplier.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Set the Prepaid value to true for Prepaid Purchase Order where all lines are Prepaid. If set, the lines cannot be also set to Prepaid individually</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepayment_Release_Type_Reference" type="wd:Prepaid_Amortization_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Prepaid Amortization Type</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Prepaid Amortization Type is only allowed if the prepaid boolean is set in header level or in line level.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Expected_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Expected Amortization Date is used when the Prepaid Amortization Type is set to "Manual"</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The expected amortization date is only allowed if the prepaid boolean is set in header or lines, and the prepaid amortization type is "Manual". It must also take place in the future.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Frequency_Reference" type="wd:Frequency_BehaviorObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Frequency to be used when generating the next prepaid accounting entry.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Frequency is not allowed when the Prepaid flag is not set and the Release Type is not Schedule.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Frequency entered is not a valid value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Number_of_Prepayment_Installments" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Number of Installments to use when accounting for the Prepaid Amortization.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Number of Prepaid Installments is not allowed when the Prepaid flag is not set and the Amortization Type is not Schedule.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Use_Invoice_Date" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use the Invoice Date as the starting date for the first installment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Specified_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use the Specified Date as the starting date for the first installment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Prepaid_Posting_Rules_for_Receipt_Accruals" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use Prepaid Accounting Posting Rules for Receipt Accruals option.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Use Prepaid Posting Rules for Receipt Accruals is only allowed if the Prepaid boolean is set.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Percent_to_Retain" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Percent to Retain for Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Estimated_Retention_Release_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Estimated Retention Release Date for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="XMLNAME_3rd_Party_Retention" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>3rd Party Retention for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention_Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention Memo for Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment_Terms_Data" type="wd:Down_Payment_Terms_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Down Payment Terms Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Procedure_Information_Data" type="wd:Procedure_Information_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Procedure Information associated with the Bill Only Purchase Order.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Goods_Line_Replacement_Data" type="wd:Item_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Goods Purchase Order Line data.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Line_Replacement_Data" type="wd:Service_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Deliverables_Line_Replacement_Data" type="wd:Project-Based_Order_Line_Replacement_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Tax_Code_Data" type="wd:Taxable_Code_Application_NO_INPUT_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Tax Data by Tax Authority and Tax Code. For Customer Invoice Documents and Cash Sales tax data will always be calculated from the line data regardless of what is populated in Tax Rate Application Data. For Purchase Orders, Supplier Invoice Documents and Ad hoc Payments, if data is in Tax Rate Application Data, then that will be the tax information that is saved. Otherwise, the tax will be calculated from the lines.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Business_Document_Attachment_with_External_Option_And_Attachment_Category_DataType" minOccurs="0" maxOccurs="unbounded"/>
<xsd:element name="Purchase_Order_Prepaid_Spend_Amortization_Schedule" type="wd:PO_Prepaid_Amortization_Schedule_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Item_Order_Line_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Goods Purchase Order Line data. A Purchase Order may have multiple goods purchase order lines.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Quantity cannot be negative</xsd:documentation>
<wd:Validation_Message>Quantity cannot be negative</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
