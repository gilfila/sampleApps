<wd:Validation>
<xsd:documentation>Select only Down Payments or Retention, but not both, in the same purchase order line or within the same purchase order.</xsd:documentation>
<wd:Validation_Message>Select only Down Payments or Retention, but not both, in the same purchase order line or within the same purchase order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Change order must have a spend category with Spend Category Usage type of Procurement.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the commodity code or submit the value that already exists for the purchase order (PO) line. You can't change the code for purchase order lines that are fully or partially invoiced, canceled, or closed.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Specify an active tax applicability.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Purchase_Order_Line_Reference" type="wd:Order_Service_LineObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>ID of Purcahse Order Line that is being changed</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Line_Reference_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Purchase Order Line Reference ID on the change order. If provided, this ID needs to be different from the Reference ID on the purchase order line being changed</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Cancel_PO_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Purchase Order Line will be canceled</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Service_Order_Line_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This value becomes Purchase Order Line Reference ID of the Purchase Order Line when change order is approved.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Line_Number" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The line number of the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="4"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="0"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Line_Company_Reference" type="wd:CompanyObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The company of the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Item_Reference" type="wd:Procurement_ItemObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing purchase item. Specifying the purchase item will default values for the Item Description, Spend Category, Tax Applicability, Unit of Measure, and Unit Cost if these options are defined on the purchase item itself.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Catalog items are not allowed on Service Lines.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Remove the line or select a different item. You can't submit an item that is Restricted from Purchasing.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text description of the purchase item. The description will default from the item if the description is left blank.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Commodity_Code_Reference" type="wd:Commodity_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The commodity code on spend transactions lines. This is a standard code that identifies a type of good or service you order. For example, the United Nations Standard Products and Services Code (UNSPSC) or the National Institute for Governmental Purchasing (NIGP) code. For purchase items and catalog items, you can only submit active commodity codes already associated to the item. For ad hoc based lines, you can submit any active commodity code.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Resource_Category_Reference" type="wd:Spend_CategoryObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Spend Category. The Spend Category will default from the Purchase Item if the item is specified. This Spend Category must match the Spend Category for the Purchase Item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Applicability_Reference" type="wd:Tax_ApplicabilityObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Applicability for the Purchase Item. If the item has Tax Code defined, then the Tax Applicability is required.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Code_Reference" type="wd:Tax_CodeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the Tax Code for the Purchase Item. The Tax Code is defaulted from the Change Order Header if one is specified.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Tax_Rate_Options_Data" type="wd:Tax_Rate_Options_DataType" minOccurs="0"/>
<xsd:element name="Extended_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The Extended Amount for the Purchase Order line. This amount is automatically calculated by multiplying the Quantity by the Unit Cost in the currency specified on the Purchase Order.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Due_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The anticipated date by which the Purchase Order Line should be fulfilled.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Retention_Line" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Retention flag at the Line level</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't change Retention field as the line is already Invoiced</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Down Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Prepaid" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Prepaid flag at the Line level</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Use this field to override the Budget Date on a change order line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Memo for the Purchase Order Line.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Address_Reference" type="wd:Address_ReferenceObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Contains a reference instance or a Address Reference ID for an existing address</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship_To_Contact_Reference" type="wd:WorkerObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The ship-to contact worker associated to the line item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Deliver_To_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The location where the items will be delivered.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract_Reference" type="wd:Supplier_ContractObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>This field is only enabled for Companies and Tenants which are Opted-In to Consolidate Requisition Lines by Supplier regardless of Supplier Contract.Use this field to assign a specific Supplier Contract to this Spend Line.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The entered Purchase Order Date is not within the effective date range of the Supplier Contract: [Supplier Contract]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Currency for the Supplier Contract on the Purchase Order Line must match Currency for the Purchase Order.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract on the Document Line is Closed or Pending Close.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract selected on the Document Line must be for the Supplier on the Document Header.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You selected an invalid supplier contract for this purchase order line. Select a supplier contract that's valid for the company, supplier, and document date; not undergoing an amendment; and supports manual purchase orders.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Supplier Contract on the PO Line cannot be removed or edited.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>A Supplier Contract cannot be added to the PO line as an active Supplier Invoice exists for this line.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Storage_Location_Reference" type="wd:LocationObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing location for the item.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[list of worktag types] not valid for this transaction.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The [type] is/are not available for use with the company/s: [partitionable] [company]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a company that matches on the award line in effect for grant: [grant]. This company doesn't match the grant on the award line: [comp].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[worktag value] is not permitted as an allowed value for worktag type: [worktag type], because it is inactive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Accounting Worktags are required but have not been assigned: [missing].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[missing required worktag types on Spend Transactions]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Remove_Line_Splits" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Indicates that the splits for the Purchase Order Line will be removed.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Change_Order_Service_Line_Split_Data" type="wd:Change_Order_Line_Split_WWS_DataType" minOccurs="0" maxOccurs="unbounded"/>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Maintain_Asset_Shares_RequestType">
<xsd:annotation>
<xsd:documentation>Root element for the Request for Put Asset Shares</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Put_Asset_Shares_Data" type="wd:Asset_Share_DataType" minOccurs="0"/>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Asset_Share_Replacement_DataType">
<xsd:annotation>
<xsd:documentation>Element containing asset share replacement data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>There are 2 or more asset share rows that use the same Asset Class, Asset Type, and Worktags. Enter a single row for the Asset Class, Asset Type, and Worktags that consolidates the Percent and Amount of the duplicate rows or remove the duplicate rows</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>There are 2 or more asset share rows that use the same combination of Worktags. Enter a different worktag combination for one of the rows or remove the row.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must create at least 2 asset shares.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is a unique reference identifier for the asset share.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Share_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The amount of the asset share.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>The Asset Share Amount entered has too many digits beyond the decimal point.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Amount cannot be positive.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Amount cannot be negative.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Share_Percentage" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The percent of the asset share.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Share Percent must be less than 100%.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Share Percent must be greater than zero.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't enter both Asset Share Amount and Asset Share Percentage on the Maintain Asset Share Web Service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You must enter either Asset Amount or Share Percentage.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="8"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="5"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Asset_Class_Reference" type="wd:Asset_ClassObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the asset class.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Type_Reference" type="wd:Asset_TypeObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to the asset type.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Worktags_Reference" type="wd:Accounting_WorktagObjectType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Reference to existing worktags. Worktags are a way to mark tasks and business objects to make them easier to access and summarize. Each transaction can include one value for each worktag type and is subject to configurable validation when submitted for approval.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>[missing worktags for spend and item]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[non-allowed worktags for spend, item and location]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[partitionable] is not allowed to be used by [company].</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Select a balancing worktag for Worktags of the following type: [type]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Asset Worktag types are invalid: [invalid]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The following Asset Worktags are required but have not been assigned: [missing]</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>[invalid worktag value message]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Asset_Share_DataType">
<xsd:annotation>
<xsd:documentation>Element containing the business asset and its corresponding asset shares</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Asset_Reference" type="wd:Business_AssetObjectType">
<xsd:annotation>
<xsd:documentation>Reference to the business asset for which the asset shares will be created or maintained.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares for discrete composite assets.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares for removed assets.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares when the asset has pending events.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares for assets that aren't registered.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares for disposed assets.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>You can't maintain asset shares for assets that are components of a nondiscrete composite asset.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>You can't maintain asset shares for assets with a lease spend category.</xsd:documentation>
<wd:Validation_Message>You can't maintain asset shares for assets with a lease spend category.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Business_Process_Parameters" type="wd:Financials_Business_Process_ParametersType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Business Process Parameters provide the ability to auto-submit to the business process.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Transaction_Effective_Date" type="xsd:date" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The effective date of the newly created or changed shares.</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Select a Transaction Effective Date that is on or between the asset's acquisition date and today.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date for the transfer that is on or between the last issue date and today.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The fiscal Period for the transaction date must exist in the fiscal schedule of every company asset book where this is a depreciable asset in order to do this transaction</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Transaction effective date of this transaction cannot be prior to last partial disposal date for asset</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Transaction effective date of this transaction cannot be prior to last reclassification date for asset</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Enter a Transaction Effective Date for an existing ledger period.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Asset_Share_Replacement_Data" type="wd:Asset_Share_Replacement_DataType" maxOccurs="unbounded">
<xsd:annotation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>You can't enter both Asset Share Amount and Asset Share Percentage on the Maintain Asset Share Web Service.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The Total Asset Share percentage should equal 100.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>The sum of the asset share amounts ([share amounts]) must equal the cost of the asset: [asset cost]</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
