<xsd:complexType name="Supplier_Invoice_Text_Only_DataType">
<xsd:annotation>
<xsd:documentation>Encapsulating element containing Supplier Invoice Text Only Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice ID. This is the Supplier Invoice unique identifier</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<wd:Validation_Message>Invalid ID value.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
</xsd:element>
<xsd:element name="Original_Supplier_Invoice" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field to provide a Supplier Reference memo. The Supplier Reference is not a Workday Reference ID, but a text field for providing additional information about the Supplier Invoice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Suppliers_Invoice_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Number of the Supplier</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Increase_Liability" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag for Increase Liability. In most cases, adjustments are used to decrease the liability to the supplier, in which case they are called credit memos. However, there are some circumstances where an adjustment is needed to increase the liability. In this case, set this value.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Adjustment_Reason" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Adjustment Reason.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_Supplier_Invoice_Source" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>External Transaction Source</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Contract" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Contract</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Number</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Company" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Company</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Practices" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Payment Practices</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to Currency</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Reference is the reference to the Supplier the invoice is from.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Contingent_Worker" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to an existing Contingent Worker</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Connection" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Connection Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Use_Default_Supplier_Connection" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>TRUE or FALSEIf this is set to 'TRUE' the default supplier connection will be derived.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Accounting_Date_Override" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Accounting Date Override</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Address Reference Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-To_Address_ID" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Ship-To Address For Supplier Invoice Text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Bill-From_Address_Reference" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Bill-From address reference text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Ship-From_Address_Reference" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Ship-From address reference text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Option" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Reference to Tax Option</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Tax_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default Tax Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Default_Withholding_Tax_Code" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Default Withholding Tax Code</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Due_Date_Override" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Due Date Override</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Separate_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Separate Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Format is MM/DD/YYYY.If this is left blank, Workday will populate invoice date with the current date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Received_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Field to store the Invoice Received Date value</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Delivery_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Delivery Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Billing_Start_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Billing Start Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Invoice_Billing_End_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Invoice Billing End Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Budget_Date" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Budget Date</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="On_Hold" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>On Hold</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Hold_Reason" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Text field to specify a Supplier invoice Hold Reason</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Control_Total_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This is the expected invoice total including tax. It is optional. An invoice cannot be submittted for approval if it has a non-zero control total that does not equal the sum of the extended amount for all invoice lines plus tax.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Freight_Amount" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Freight Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Other_Charges" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Other Charges</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="18"/>
<xsd:fractionDigits value="3"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Tax_Only" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Tax-Only Invoice</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Amount_Inclusive_of_Tax" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>If true, the value specified for Extended Amount is the amount inclusive of tax.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Down Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment_Purchase_Order" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>The Purchase Order for this Down Payment</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="External_PO_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Free form text field for providing addition information on the Purchase Order that the Supplier Invoice is for. This is not a Workday Purchase Order Reference ID.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Document_Received" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Document Received</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Referenced_Invoices" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Referenced Invoice Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Document_Link" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Document Link</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Statutory_Invoice_Type" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Statutory Invoice Type for Supplier Invoice.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Memo" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>This transaction header memo will print on the delivered transaction. It is optional freeform text</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Payment_Terms" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Payment Terms Reference</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Discount_Amount_Override" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Overrides calculated payment discounts.</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="26"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Discount_Date_Override" type="xsd:date" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Overrides default discount date.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Override_Payment_Type" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Override Payment Type</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Is_Adjustment" type="xsd:boolean" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>Boolean flag to indicate inbound invoice is a Supplier Invoice Adjustment.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Type" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The type of reference used to encode key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Additional_Reference_Number" type="xsd:string" minOccurs="0" maxOccurs="1">
<xsd:annotation>
<xsd:documentation>The reference number that is encoded with key payment information on the invoice document.</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Down_Payment_Application_Data" type="wd:Down_Payment_Application_Data_Text_OnlyType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Encapsulates Data Pertaining to a Down Payment being applied</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Currency_Rate_Data" type="wd:Currency_Rate_Data_for_Text_Only_InvoiceType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Currency Rate Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Attachment_Data" type="wd:Financials_Attachment_Data_for_Text_Only_InvoiceType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Financials Attachment Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
<xsd:element name="Supplier_Invoice_Text_Only_Line_Data" type="wd:Supplier_Invoice_Text_Only_Line_DataType" minOccurs="0" maxOccurs="unbounded">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Text Only Line Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
</xsd:complexType>
<xsd:complexType name="Put_Supplier_Invoice_Text_Only_ResponseType">
<xsd:annotation>
<xsd:documentation>Element containing Put Supplier Invoice Text Only Response Data</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Text_Only_Reference" type="wd:Unique_IdentifierObjectType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Reference to an existing Supplier Invoice Text Only</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Put_Supplier_Invoice_Text_Only_RequestType">
<xsd:annotation>
<xsd:documentation>Element containing all data items required to create a Supplier Invoice Text Only</xsd:documentation>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Supplier_Invoice_Text_Only_Data" type="wd:Supplier_Invoice_Text_Only_DataType" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Supplier Invoice Text Only Data</xsd:documentation>
</xsd:annotation>
</xsd:element>
</xsd:sequence>
<xsd:attribute ref="wd:version"/>
</xsd:complexType>
<xsd:complexType name="Down_Payment_Terms_DataType">
<xsd:annotation>
<xsd:documentation>Element containing Down Payment Terms Data</xsd:documentation>
<xsd:appinfo>
<wd:Validation>
<xsd:documentation>Enter either percent or amount for a down payment.</xsd:documentation>
<wd:Validation_Message>Enter either percent or amount for a down payment.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<xsd:documentation>Enter a down payment amount that is equal to or less than the sum of the purchase order lines that you select for down payments.</xsd:documentation>
<wd:Validation_Message>Enter a down payment amount that is equal to or less than the sum of the purchase order lines that you select for down payments.</wd:Validation_Message>
</wd:Validation>
<wd:Validation>
<wd:Validation_Message>Down Payment Percentage must be less than or equal to 100.</wd:Validation_Message>
</wd:Validation>
</xsd:appinfo>
</xsd:annotation>
<xsd:sequence>
<xsd:element name="Down_Payment_Amount" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Down Payment Amount</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="21"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Down_Payment_Percentage" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Down Payment Percentage</xsd:documentation>
</xsd:annotation>
<xsd:simpleType>
<xsd:restriction base="xsd:decimal">
<xsd:totalDigits value="12"/>
<xsd:minInclusive value="0"/>
<xsd:fractionDigits value="6"/>
</xsd:restriction>
</xsd:simpleType>
</xsd:element>
<xsd:element name="Down_Payment_Memo" type="xsd:string" minOccurs="0">
<xsd:annotation>
<xsd:documentation>Down Payment Memo</xsd:documentation>
</xsd:annotation>
</xsd:element>
