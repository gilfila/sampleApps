<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
                  xmlns:wd="urn:com.workday/bsvc">
  <soapenv:Header>
    <!-- Add your Workday authentication headers here -->
  </soapenv:Header>
  <soapenv:Body>
    <wd:Get_Expense_Credit_Card_Transactions_Request wd:version="v46.0">
