      </wd:Response_Filter>
      <wd:Response_Group>
        <wd:Include_Reference>true</wd:Include_Reference>
        <wd:Include_Expense_Credit_Card_Transaction_Data>true</wd:Include_Expense_Credit_Card_Transaction_Data>
      </wd:Response_Group>
    </wd:Get_Expense_Credit_Card_Transactions_Request>
  </soapenv:Body>
</soapenv:Envelope>
