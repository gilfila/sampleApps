# Output directory for downloaded podcasts
OUTPUT_DIR=./podcasts

# Podcast generation settings
# Audio style: deep-dive | brief | critique | debate
AUDIO_STYLE=deep-dive

# Custom instructions for the AI hosts (optional)
AUDIO_INSTRUCTIONS=Make it engaging and accessible for a general tech audience. Highlight the most impactful stories first.

# Maximum number of news articles to include per podcast
MAX_ARTICLES=10
