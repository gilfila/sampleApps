# Hackathon App — Backend environment variables
# Copy to .env and fill in your values.
#
# Workday Extend URL pattern: https://api.workday.com/apps/<WORKDAY_APP_NAME>/v1/<collection_name>
# Set WORKDAY_EXTEND_BASE_URL (optional), WORKDAY_APP_NAME, and collection name vars for each CBO.

# Database
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Flask
SECRET_KEY=your-secret-key
FLASK_ENV=development
PORT=5000

# CORS (comma-separated origins; production should set explicitly)
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.render.com

# ---------------------------------------------------------------------------
# Workday Extend — two REST data sources (custom business objects)
# URL pattern: {WORKDAY_EXTEND_BASE_URL}/apps/{WORKDAY_APP_NAME}/v1/{collection_name}
# ---------------------------------------------------------------------------

# Workday OAuth (required for both APIs)
WORKDAY_TENANT=your-tenant
WORKDAY_CLIENT_ID=your-client-id
WORKDAY_CLIENT_SECRET=your-client-secret
WORKDAY_REFRESH_TOKEN=your-refresh-token

# Extend API base and app (extensible)
WORKDAY_EXTEND_BASE_URL=https://api.workday.com
WORKDAY_APP_NAME=your-extend-app-name

# Hacker/participant data — collection name for the participant CBO
WORKDAY_HACKER_COLLECTION_NAME=participants

# Ticket data — collection name for the ticket CBO (enables ticket sync when set)
WORKDAY_TICKET_COLLECTION_NAME=tickets

# Legacy / override: full URLs if you prefer not to use the app+collection pattern
# WORKDAY_REST_BASE_URL=https://your-tenant.../ccx/api
# WORKDAY_TICKETS_BUSINESS_OBJECT_URL=https://api.workday.com/apps/myapp/v1/tickets

# Custom object names (if your sync uses object names)
WORKDAY_CUSTOM_OBJECT_NAME=your-hacker-cbo-name
WORKDAY_TICKET_CUSTOM_OBJECT_NAME=your-ticket-cbo-name

# Sync intervals (seconds)
WORKDAY_SYNC_INTERVAL=3600
WORKDAY_TICKET_SYNC_INTERVAL=300
WORKDAY_TICKET_SYNC_RETRY_ATTEMPTS=3

# MFA (production: set strong values)
# MFA_ENCRYPTION_KEY=64-char-hex
# MFA_JWT_SECRET=your-mfa-jwt-secret
