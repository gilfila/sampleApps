# Workday OAuth — non-expiring refresh token (primary) or client credentials
# Copy to .env and fill in your tenant values.
#
# Extend API URL pattern: https://api.workday.com/apps/<WORKDAY_APP_NAME>/v1/<collection_name>
# Set WORKDAY_EXTEND_BASE_URL (optional), WORKDAY_APP_NAME, and the collection name vars below.

# Primary flow: non-expiring refresh token
WORKDAY_CLIENT_ID=your_client_id
WORKDAY_CLIENT_SECRET=your_client_secret
WORKDAY_TOKEN_URL=https://wcpdev-services1.wd101.myworkday.com/ccx/oauth2/hack116_wcpdev1/token
WORKDAY_REFRESH_TOKEN_NONEXPIRE=

# Optional for code exchange: WORKDAY_REDIRECT_URI (must match client registration)

# ---------------------------------------------------------------------------
# Extend API base and app (extensible URL pattern)
# ---------------------------------------------------------------------------
# Base URL for Workday Extend API (default: https://api.workday.com).
# Full URL for a collection: {WORKDAY_EXTEND_BASE_URL}/apps/{WORKDAY_APP_NAME}/v1/{collection_name}
WORKDAY_EXTEND_BASE_URL=https://api.workday.com
WORKDAY_APP_NAME=your-extend-app-name

# ---------------------------------------------------------------------------
# Hacker / participant data — Extend CBO collection name
# ---------------------------------------------------------------------------
# Collection name for the participant/hacker custom business object.
# Resolved URL: {WORKDAY_EXTEND_BASE_URL}/apps/{WORKDAY_APP_NAME}/v1/{WORKDAY_HACKER_COLLECTION_NAME}
WORKDAY_HACKER_COLLECTION_NAME=participants

# ---------------------------------------------------------------------------
# Ticket data — Extend CBO collection name
# ---------------------------------------------------------------------------
# Collection name for the ticket custom business object.
# Resolved URL: {WORKDAY_EXTEND_BASE_URL}/apps/{WORKDAY_APP_NAME}/v1/{WORKDAY_TICKET_COLLECTION_NAME}
WORKDAY_TICKET_COLLECTION_NAME=tickets

# ---------------------------------------------------------------------------
# Workday Orchestrate API — launch orchestrations (e.g. CreateTicket)
# ---------------------------------------------------------------------------
# Base URL for the Orchestrate API (no trailing slash).
# Example: https://api.us.wcp.workday.com
WORKDAY_ORCHESTRATE_BASE_URL=https://api.us.wcp.workday.com
# Default app name for orchestration launch (optional; default: hackathontickets_svfbfp).
# WORKDAY_ORCHESTRATE_APP_NAME=hackathontickets_svfbfp

# ---------------------------------------------------------------------------
# Legacy / override (optional)
# ---------------------------------------------------------------------------
# If set, these override the Extend app+collection pattern above.
# WORKDAY_REST_BASE_URL + WORKDAY_TENANT — for hacker/worker (legacy CCX path)
# WORKDAY_TICKETS_BUSINESS_OBJECT_URL — full URL for ticket CBO
# WORKDAY_REST_BASE_URL=https://wcpdev-services1.wd101.myworkday.com/ccx/api
# WORKDAY_TENANT=hack116_wcpdev1
# WORKDAY_TICKETS_BUSINESS_OBJECT_URL=https://api.workday.com/apps/myapp/v1/tickets
# WORKDAY_WSDL_PATH=/path/to/staffingwsdl.xml
